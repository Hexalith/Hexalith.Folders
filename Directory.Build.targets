<Project>

  <!-- Microsoft.Testing.Platform coverage collection is provided by this extension.
       Add it after each project body so the root props path remains stable across ProjectReference builds. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests'))">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Local source graphs must use one EventStore assembly identity across this root and its Tenants
       source edges. Tenants keeps its own published package cohort default and carries that value to
       its EventStore source references, so pass this root's selection to Tenants source references.
       Package graphs and verified workspace mappings, which own their reserved version inputs, are unchanged. -->
  <PropertyGroup>
    <_FoldersCarriesEventStoreVersionToTenants Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(HexalithTenantsFromSource)' == 'true' and '$(HexalithTenantsRoot)' != '' and '$(HexalithEventStoreVersion)' != '' and '$(HexalithSourceMappingHash)' == '' and '$(HexalithSourceMappingMode)' != 'source' and '$(HEXALITH_SOURCE_MAPPING_HASH)' == '' and '$(HEXALITH_SOURCE_MAPPING_PATH)' == ''">true</_FoldersCarriesEventStoreVersionToTenants>
    <_FoldersSelectedTenantsSourceRoot Condition="'$(_FoldersCarriesEventStoreVersionToTenants)' == 'true'">$([MSBuild]::NormalizeDirectory('$(HexalithTenantsRoot)', 'src'))</_FoldersSelectedTenantsSourceRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(_FoldersCarriesEventStoreVersionToTenants)' == 'true'">
    <ProjectReference Update="$(HexalithTenantsRoot)/src/Hexalith.Tenants*/Hexalith.Tenants*.csproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- The .NET SDK promotes transitive project references after item evaluation and without edge
       metadata. Keep promoted Tenants source nodes on the same EventStore identity. -->
  <Target Name="CarryEventStoreVersionToPromotedTenantsSources"
          AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(_FoldersCarriesEventStoreVersionToTenants)' == 'true'">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'%(ProjectReference.Extension)' == '.csproj' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(_FoldersSelectedTenantsSourceRoot)')) and $([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('Hexalith.Tenants')) and !$([System.String]::Copy('%(ProjectReference.AdditionalProperties)').Contains('HexalithEventStoreVersion='))">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!--
    Container image defaults (.NET SDK container support).
    Opt in per service with:
      <EnableContainer>true</EnableContainer>
      <ContainerRepository>stable-image-repository</ContainerRepository>
      <HexalithContainerServiceName>stable-service-name</HexalithContainerServiceName>
    CI/CD may override ContainerImageTag/ContainerImageTags and SourceRevisionId with release values.
  -->
  <PropertyGroup Condition="'$(EnableContainer)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
    <ContainerBaseImage Condition="'$(TargetFramework)' == 'net11.0'">mcr.microsoft.com/dotnet/aspnet:11.0-alpine</ContainerBaseImage>
    <ContainerFamily>alpine</ContainerFamily>
    <ContainerImageTag Condition="'$(ContainerImageTags)' == '' and '$(ContainerImageTag)' == ''">local</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
    <HexalithContainerProjectName Condition="'$(HexalithContainerProjectName)' == ''">Hexalith.Folders</HexalithContainerProjectName>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableContainer)' == 'true'">
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="$(RepositoryUrl)" />
    <ContainerLabel Include="org.opencontainers.image.revision" Value="$(SourceRevisionId)" />
    <ContainerLabel Include="org.opencontainers.image.version" Value="$(Version)" />
    <ContainerLabel Include="org.opencontainers.image.title" Value="$(ContainerRepository)" />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="$(Company)" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="$(PackageLicenseExpression)" />
    <ContainerLabel Include="io.hexalith.project" Value="$(HexalithContainerProjectName)" />
    <ContainerLabel Include="io.hexalith.service" Value="$(HexalithContainerServiceName)" />
  </ItemGroup>

  <Target Name="ValidateHexalithContainerMetadata"
          BeforeTargets="PublishContainer"
          Condition="'$(EnableContainer)' == 'true'">
    <Error Condition="'$(ContainerRepository)' == ''"
           Text="ContainerRepository is required for Hexalith service container publishing." />
    <Error Condition="'$(HexalithContainerServiceName)' == ''"
           Text="HexalithContainerServiceName is required for Hexalith service container publishing." />
  </Target>

</Project>
