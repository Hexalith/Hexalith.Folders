diff --git a/tests/Hexalith.McpCli.Cli.Tests/PlatformScopeCommandTests.cs b/tests/Hexalith.McpCli.Cli.Tests/PlatformScopeCommandTests.cs
new file mode 100644
index 0000000..ff0d3e0
