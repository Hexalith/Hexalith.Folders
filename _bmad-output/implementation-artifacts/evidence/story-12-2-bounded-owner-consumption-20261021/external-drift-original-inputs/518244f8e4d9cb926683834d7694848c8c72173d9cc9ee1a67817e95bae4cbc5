    private void SetSnapshot(TenantRemoveMemberCommandSnapshot snapshot)
    {
        if (snapshot.State is TenantCommandLifecycleState.Idle
            || (snapshot.AuditState is not TenantCommandAuditState.AuditAvailable
                && snapshot.State is TenantCommandLifecycleState.AlreadyApplied
                    or TenantCommandLifecycleState.UnableToVerify
                    or TenantCommandLifecycleState.Rejected
                    or TenantCommandLifecycleState.Failed
                    or TenantCommandLifecycleState.DuplicatePrevented))
        {
            _removalProof = null;
            _receiptDismissed = false;
        }

        snapshot = snapshot with { RemovalProof = _removalProof };
        if (_retainedAttempt is { } attempt && !Attempts.TryUpdate(attempt, _snapshot, snapshot))
        {
            return;
        }

        _snapshot = snapshot;
        SynchronizeRetainedAttempt();
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _snapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle)
        {
            _focusLifecyclePending = true;
        }
    }

    /// <summary>Keeps an explicitly undispatched refusal recoverable without claiming a command or audit attempt.</summary>
    /// <param name="reason">The localized reason that currently prevents submission.</param>
    /// <param name="preview">The original undispatched preview evidence.</param>
    /// <param name="safetyRefusal">Whether current safety evidence can establish that the refusal has resolved.</param>
    /// <returns>The retained preview or idle state with its refusal feedback.</returns>
    private TenantRemoveMemberCommandSnapshot RefuseBeforeDispatch(
        string reason,
        TenantRemoveMemberCommandSnapshot preview,
        bool safetyRefusal = true)
    {
        _hasUndispatchedSafetyRefusal = safetyRefusal;
        return preview with
        {
            State = preview.IsPreviewComplete ? TenantCommandLifecycleState.Previewed : TenantCommandLifecycleState.Idle,
            MessageId = null,
            CorrelationId = null,
            SafeMessage = reason,
            SafeMessageKey = null,
            AuditState = TenantCommandAuditStates.NotStarted,
            FocusTarget = TenantCommandFocusTarget.Submit,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        };
    }

    // A refused retry keeps the failed attempt it retried: that identity may already have reached the server, so
    // its status stays unknown and the next submit must reuse it rather than mint a new ULID for a removal that
    // may already have happened.
    private static TenantRemoveMemberCommandSnapshot RefuseRetry(
        string reason,
        TenantRemoveMemberCommandSnapshot retriedAttempt)
        => retriedAttempt with
        {
            SafeMessage = reason,
            SafeMessageKey = null,
            AuditState = TenantCommandAuditStates.Unverifiable,
            FocusTarget = TenantCommandFocusTarget.Submit,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        };

    private async Task<bool> SetCommandActivityRaisedAsync(bool isActive)
    {
        if (_disposed || isActive && _dismissed)
        {
            return !isActive;
        }
        if (isActive && _retainedAttempt is null)
        {
            _attemptMemberUserId = Member.UserId;
        }
        if (isActive && _retainedAttempt is null
            && !Attempts.TryBegin(Detail.TenantId, this, _snapshot, out _retainedAttempt))
        {
            return false;
        }
        if (_hasRaisedCommandActivity == isActive)
        {
            return true;
        }

        int generation = _attemptGeneration;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        TenantCommandAttemptTracker tracker = Attempts;
        bool accepted;
        try
        {
            if (CommandActivityLease is { } lease)
            {
                accepted = await lease(isActive).ConfigureAwait(false);
            }
            else
            {
                await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
                accepted = true;
            }
        }
        catch (Exception)
        {
            if (!isActive)
            {
                throw;
            }
            tracker.Detach(attempt, this);
            if (!_disposed && generation == _attemptGeneration && ReferenceEquals(_retainedAttempt, attempt))
            {
                _retainedAttempt = null;
            }
            return false;
        }
        if (_disposed || generation != _attemptGeneration || !ReferenceEquals(_retainedAttempt, attempt))
        {
            return !isActive;
        }
        if (isActive && !accepted)
        {
            tracker.Detach(attempt, this);
            _retainedAttempt = null;
            return false;
        }
        _hasRaisedCommandActivity = isActive;
        return true;
    }

    private async Task UpdateCommandActivityForSnapshotAsync()
