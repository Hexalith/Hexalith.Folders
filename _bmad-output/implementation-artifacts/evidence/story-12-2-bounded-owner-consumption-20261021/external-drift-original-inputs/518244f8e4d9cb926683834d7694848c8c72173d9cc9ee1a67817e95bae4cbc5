    [Parameter]
    public bool AuditProofCapabilityAvailable { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<bool, Task<bool>>? CommandActivityLease { get; set; }

    [Parameter]
    public Func<RemoveUserFromTenant, Task<TenantDetailSnapshot?>>? ProjectionEvidenceProvider { get; set; }


    private long _admissionGeneration;
    private bool _authorityResolutionInProgress;
    private readonly Lock _authorityCancellationLock = new();
    private CancellationTokenSource? _authorityCancellation;
    private object? _admissionParameters;
    private TenantLifecycleAuthorizationReflectionState? _submissionAuthority;

    private string AuthorizationUnavailableReason
        => Localizer[_submissionAuthority is TenantLifecycleAuthorizationReflectionState.MissingPermission
            || AuthorizationReflection is TenantLifecycleAuthorizationReflectionState.MissingPermission
            || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
                ? "Tenants.RemoveMember.Unavailable.Authorization"
                : "Tenants.Mutation.Unavailable.AuthorityIndeterminate"].Value;

    private void ObserveAdmissionParameters()
    {
        object current = (Detail, Member, CurrentCallerScope, IsAuthorized, AuthorizationReflection, AuthorizationVersion, SurfaceKind, Freshness, ProjectionVersion, AuthorizationReflectionProvider);
        if (!Equals(current, _admissionParameters))
        {
            _admissionParameters = current;
            InvalidateAdmission();
            _submissionAuthority = null;
        }
    }

    private void InvalidateAdmission()
    {
        Interlocked.Increment(ref _admissionGeneration);
        lock (_authorityCancellationLock)
        {
            _authorityCancellation?.Cancel();
        }
    }

    private async Task<bool> ReauthorizeInitialAdmissionAsync(long generation)
    {
        _authorityResolutionInProgress = true;
        try
        {
            return await ReauthorizeAdmissionAsync(generation).ConfigureAwait(false);
        }
        finally
        {
            _authorityResolutionInProgress = false;
        }
    }

    private async Task<bool> ReauthorizeAdmissionAsync(long generation)
    {
        TenantLifecycleAuthorizationReflectionState authority = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        // Bound admission independently of provider cooperation; cancellation never cancels dispatched work.
        using var source = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        lock (_authorityCancellationLock)
        {
            _authorityCancellation?.Cancel();
            _authorityCancellation = source;
        }
        try
        {
            if (AuthorizationReflectionProvider is { } provider)
            {
                authority = await provider(source.Token).WaitAsync(source.Token).ConfigureAwait(false);
                source.Token.ThrowIfCancellationRequested();
            }
        }
        catch (Exception)
        {
            // Missing, cancelled or faulted current authority never permits a dispatch.
            authority = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        finally
        {
            lock (_authorityCancellationLock)
            {
                if (ReferenceEquals(_authorityCancellation, source))
                {
                    _authorityCancellation = null;
                }
            }
        }

        if (_disposed || generation != Volatile.Read(ref _admissionGeneration))
        {
            return false;
        }
        _submissionAuthority = authority;
        return !_disposed && generation == _admissionGeneration && IsAuthorized
            && HasSafeMeasuredViewport && AuthorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized
            && authority is TenantLifecycleAuthorizationReflectionState.Authorized;
    }

    private void RefuseAuthorityAdmission()
        => SetSnapshot(_snapshot with
        {
            SafeMessage = !HasSafeMeasuredViewport ? Localizer["Tenants.RemoveMember.Unavailable.Narrow"].Value : AuthorizationUnavailableReason,
            SafeMessageKey = null,
            FocusTarget = TenantCommandFocusTarget.Submit,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        });

    internal TenantRemoveMemberCommandSnapshot Snapshot => _snapshot;

    private void SynchronizeRetainedAttempt()
    {
        if (_retainedAttempt is { } attempt
            && Attempts.TryRead<TenantRemoveMemberCommandSnapshot>(attempt, this, out TenantRemoveMemberCommandSnapshot? latest) && latest is not null)
        {
            _snapshot = latest;
        }
    }

    private void OnRetainedAttemptChanged(object? sender, EventArgs args)
    {
        if (_disposed || _retainedAttempt is null)
        {
            return;
        }
        _ = RenderRetainedAttemptAsync();
    }

    private async Task RenderRetainedAttemptAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    SynchronizeRetainedAttempt();
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
        }
    }


    private TenantCommandAttemptTracker Attempts
        => Services.GetRequiredService<TenantCommandAttemptTracker>();

    private bool CanRetryDelivery
        => !_isSubmitting && _snapshot.State is TenantCommandLifecycleState.RequestSent
            && _snapshot.MessageId is not null && _snapshot.CorrelationId is null
            && _retainedAttempt?.DeliveryInFlight is not true;

    private void RestoreRetainedAttempt()
    {
        if (_retainedAttempt is { } current && (!string.Equals(current.TenantId, Detail.TenantId, StringComparison.Ordinal) || !string.Equals(_attemptMemberUserId, Member.UserId, StringComparison.Ordinal)))
        {
            Attempts.Detach(current, this);
            _retainedAttempt = null;
            _attemptGeneration++;
            _hasRaisedCommandActivity = false;
            _isSubmitting = false;
            _snapshot = TenantRemoveMemberCommandSnapshot.Idle();
            _confirmationText = null;
            _validationMessage = null;
            _hasUndispatchedSafetyRefusal = false;
        }
        if (_readOnlyDetached || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null || !IsAuthorized)
        {
            return;
        }
        SynchronizeRetainedAttempt();
        if (_retainedAttempt is null && Attempts.Find<TenantRemoveMemberCommandSnapshot>(Detail.TenantId) is { } candidate && string.Equals(candidate.Intent?.UserId, Member.UserId, StringComparison.Ordinal)
            && Attempts.TryAdopt<TenantRemoveMemberCommandSnapshot>(Detail.TenantId, this, out TenantRetainedCommandAttempt? attempt, out TenantRemoveMemberCommandSnapshot? retained)
            && retained is not null)
        {
            _retainedAttempt = attempt;
            _attemptMemberUserId = retained.Intent?.UserId;
            _attemptGeneration++;
            _snapshot = retained;
            _removalProof = retained.RemovalProof;
        }
    }

    private bool PublishResult(TenantRetainedCommandAttempt? attempt, int generation,
        TenantRemoveMemberCommandSnapshot expected, TenantRemoveMemberCommandSnapshot result, bool delivery = false)
    {
        bool retained = attempt is null || (delivery
            ? Attempts.TryCompleteDelivery(attempt, expected, result)
            : Attempts.TryUpdate(attempt, expected, result));
        if (!retained || _disposed || generation != _attemptGeneration
            || !ReferenceEquals(_retainedAttempt, attempt)
            || attempt is not null && !Attempts.IsAttached(attempt, this)
            || attempt is null && !delivery && !TenantCommandAttemptTracker.HasSameEvidence(_snapshot, expected) && !ReferenceEquals(_snapshot, result))
        {
            return false;
        }
        _snapshot = result;
        SynchronizeRetainedAttempt();
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || result.FocusTarget is TenantCommandFocusTarget.Lifecycle)
        {
            _focusLifecyclePending = true;
        }
        return true;
    }

    private bool IsCurrentContinuation(int generation, TenantRemoveMemberCommandSnapshot expected)
        => !_disposed && generation == _attemptGeneration
            && (_retainedAttempt is { } attempt
                ? Attempts.IsAttached(attempt, this) && Attempts.IsExpectedEvidence(attempt, expected)
                : TenantCommandAttemptTracker.HasSameEvidence(_snapshot, expected));


    private int OwnerCount
        => Detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private bool TargetIsVisibleMember
        => Detail.Members.Any(member => string.Equals(member.UserId, Member.UserId, StringComparison.Ordinal));

    private bool LastOwnerRiskVisible
        => OwnerCount == 1 && Member.Role is TenantRole.TenantOwner;

    private bool ElevatedRiskVisible
        => LastOwnerRiskVisible || TargetGlobalAdministratorFriction;

    private bool IsPreviewComplete
        => string.IsNullOrWhiteSpace(UnavailableReason) && IsPreviewEvidenceComplete;

    private bool IsPreviewEvidenceComplete
        => !string.IsNullOrWhiteSpace(Detail.TenantId)
        && !string.IsNullOrWhiteSpace(Member.UserId)
        && Member.Role is TenantRole.TenantOwner or TenantRole.TenantContributor or TenantRole.TenantReader
        && Freshness is ReadModelFreshnessState.Current
        && TargetIsVisibleMember
        && IsPreviewFullyPopulated;

    // The ten-item consequence preview is only complete when every required item actually carries a
    // value. Counting a fixed collection expression was a compile-time constant and proved nothing.
    private const int RequiredPreviewItemCount = 10;

    private bool IsPreviewFullyPopulated
    {
        get
        {
            IReadOnlyList<(string Label, string Value, string TestId)> items = PreviewItems;
            return items.Count == RequiredPreviewItemCount
                && items.All(static item => !string.IsNullOrWhiteSpace(item.Value));
        }
    }

    /// <summary>
    /// Preview-blocked is only rendered when incomplete for a reason other than the unavailable alert,
    /// so the same text is never shown twice.
    /// </summary>
    private bool ShowPreviewBlockedBanner
        => !IsPreviewComplete && string.IsNullOrWhiteSpace(UnavailableReason);

    private string? EligibilityUnavailableReason
        => !IsAuthorized || AuthorizationReflection is not TenantLifecycleAuthorizationReflectionState.Authorized
            || _submissionAuthority is TenantLifecycleAuthorizationReflectionState.MissingPermission or TenantLifecycleAuthorizationReflectionState.Indeterminate
            || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
            ? AuthorizationUnavailableReason
            : !HasSafeMeasuredViewport
                ? Localizer["Tenants.RemoveMember.Unavailable.Narrow"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Stale
                or TenantDetailSurfaceKind.Unavailable
                or TenantDetailSurfaceKind.Unknown
                or TenantDetailSurfaceKind.Degraded
                || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.RemoveMember.Unavailable.Freshness"].Value
                : Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown
                    ? Localizer["Tenants.RemoveMember.Unavailable.TenantLifecycle"].Value
                    : (!IsCommandSurfaceAvailable && !IsOwnAggregateAdmissionUnavailable) || CommandGateway is null || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null
                        ? CommandSurfaceUnavailableReason ?? Localizer["Tenants.RemoveMember.Unavailable.CommandSurface"].Value
                        : (!AuditProofCapabilityAvailable || !HasAuditProofGateway) && !IsOwnedCommandInFlight
                            ? Localizer["Tenants.Members.UnavailableReason.MissingAuditProof"].Value
                            : string.IsNullOrWhiteSpace(Detail.TenantId) || string.IsNullOrWhiteSpace(Member.UserId)
                                    ? Localizer["Tenants.RemoveMember.Unavailable.Identity"].Value
                                    : Member.Role is TenantRole.Unknown
                                        ? Localizer["Tenants.RemoveMember.Unavailable.UnknownRole"].Value
                                        : !TargetIsVisibleMember && !HasTerminalOutcome
                                            ? Localizer["Tenants.RemoveMember.Unavailable.TargetAbsent"].Value
                                            : null;

    // After a confirmed or already-applied removal the target is absent by design. Reporting that
    // absence as an assertive unavailability would contradict the success the lifecycle just announced.
    private string? UnavailableReason
        => EligibilityUnavailableReason ?? (_isSubmitting ? Localizer["Tenants.RemoveMember.Unavailable.InFlight"].Value : null);

    private bool HasTerminalOutcome
        => _snapshot.State is TenantCommandLifecycleState.Confirmed
            or TenantCommandLifecycleState.AlreadyApplied;

    private bool IsSubmitDisabled
        => _authorityResolutionInProgress || (IsOwnedCommandInFlight && !CanRetryDelivery)
        || !IsPreviewComplete
        || !string.IsNullOrWhiteSpace(UnavailableReason);

    private bool IsOwnAggregateAdmissionUnavailable
        => _retainedAttempt is { } attempt && Attempts.IsAttached(attempt, this)
