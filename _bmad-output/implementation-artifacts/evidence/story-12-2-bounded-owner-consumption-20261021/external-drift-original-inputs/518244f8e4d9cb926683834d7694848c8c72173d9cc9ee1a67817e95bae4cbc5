    private async Task SubmitAsync()
    {
        SynchronizeRetainedAttempt();
        if (_disposed || _isSubmitting || _authorityResolutionInProgress)
        {
            return;
        }
        TenantRemoveMemberCommandSnapshot initialEvidence = _snapshot;
        TenantRetainedCommandAttempt? initialAttempt = _retainedAttempt;
        int initialAttemptGeneration = _attemptGeneration;
        long admissionGeneration = _admissionGeneration;
        // Admission reads and refusal publication share the renderer with input and parameter updates.
        if (!await ReauthorizeInitialAdmissionAsync(admissionGeneration).ConfigureAwait(true))
        {
            if (!_disposed && admissionGeneration == Volatile.Read(ref _admissionGeneration)
                && initialAttemptGeneration == _attemptGeneration && ReferenceEquals(initialAttempt, _retainedAttempt)
                && TenantCommandAttemptTracker.HasSameEvidence(initialEvidence, _snapshot))
            {
                RefuseAuthorityAdmission();
            }
            return;
        }
        if (_disposed || admissionGeneration != Volatile.Read(ref _admissionGeneration)
            || initialAttemptGeneration != _attemptGeneration
            || !ReferenceEquals(initialAttempt, _retainedAttempt)
            || !TenantCommandAttemptTracker.HasSameEvidence(initialEvidence, _snapshot))
        {
            return;
        }

        _readOnlyDetached = false;
        RestoreRetainedAttempt();
        if (CanRetryDelivery)
        {
            if (!IsPreviewComplete)
            {
                SetSnapshot(_snapshot with
                {
                    SafeMessage = UnavailableReason ?? Localizer["Tenants.RemoveMember.Preview.Blocked.Required"].Value,
                    FocusTarget = TenantCommandFocusTarget.Submit,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
                return;
            }
            if (!string.Equals(_confirmationText, Member.UserId, StringComparison.Ordinal))
            {
                _validationMessage = ElevatedRiskVisible
                    ? Localizer["Tenants.RemoveMember.Validation.ElevatedConfirmationRequired", Member.UserId]
                    : Localizer["Tenants.RemoveMember.Validation.ConfirmationRequired", Member.UserId];
                _focusConfirmationPending = true;
                return;
            }
            await RetryDeliveryAsync().ConfigureAwait(false);
            return;
        }
        _validationMessage = null;

        if (_isSubmitting)
        {
            SetSnapshot(_snapshot.DuplicatePrevented(Localizer["Tenants.RemoveMember.DuplicatePrevented.Message"].Value));
            return;
        }

        if (IsOwnedCommandInFlight)
        {
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            SetSnapshot(_snapshot.DuplicatePrevented(Localizer["Tenants.RemoveMember.DuplicatePrevented.Message"].Value));
            return;
        }

        if (_snapshot.State is TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded)
        {
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            // Tracking is gone, so this attempt can neither be re-queried nor safely re-dispatched. Say so:
            // returning silently left the enabled submit button doing nothing at all -- no state change, no
            // message, no announcement -- which reads as a broken control rather than a safety stop.
            SetSnapshot(_snapshot with
            {
                SafeMessage = null,
                SafeMessageKey = "Tenants.Members.Submit.TrackingLost",
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            });
            return;
        }

        RemoveUserFromTenant request = new(Detail.TenantId, Member.UserId);
        if (!TargetIsVisibleMember
            && SurfaceKind is TenantDetailSurfaceKind.Ready
            && Freshness is ReadModelFreshnessState.Current
            && !string.IsNullOrWhiteSpace(Detail.TenantId)
            && !string.IsNullOrWhiteSpace(Member.UserId))
        {
            SetSnapshot(_snapshot.AlreadyApplied(
                request,
                Member.Role,
                OwnerCount,
                Detail,
                Localizer["Tenants.RemoveMember.AlreadyApplied.BeforeSubmit", Member.UserId].Value));
            return;
        }

        if (!string.IsNullOrWhiteSpace(UnavailableReason) || !IsPreviewComplete)
        {
            string reason = UnavailableReason ?? Localizer["Tenants.RemoveMember.Preview.Blocked.Required"].Value;
            bool undispatched = _snapshot.State is TenantCommandLifecycleState.Idle or TenantCommandLifecycleState.Previewed
                && string.IsNullOrWhiteSpace(_snapshot.MessageId) && string.IsNullOrWhiteSpace(_snapshot.CorrelationId);
            SetSnapshot(undispatched ? RefuseBeforeDispatch(reason, _snapshot) : RefuseRetry(reason, _snapshot));
            return;
        }

        if (!string.Equals(_confirmationText, Member.UserId, StringComparison.Ordinal))
        {
            _validationMessage = ElevatedRiskVisible
                ? Localizer["Tenants.RemoveMember.Validation.ElevatedConfirmationRequired", Member.UserId]
                : Localizer["Tenants.RemoveMember.Validation.ConfirmationRequired", Member.UserId];
            _focusConfirmationPending = true;
            return;
        }

        string? retryMessageId = _snapshot.State is TenantCommandLifecycleState.Failed
            && string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
            && !string.IsNullOrWhiteSpace(_snapshot.MessageId)
            && Equals(_snapshot.Intent, request)
                ? _snapshot.MessageId
                : null;
        TenantRemoveMemberCommandSnapshot retriedAttempt = _snapshot;
        Attempts.Detach(_retainedAttempt, this);
        _retainedAttempt = null;
        _attemptGeneration++;
        _snapshot = _snapshot.RequestSent(
            ResolveCurrentProjectionVersion(),
            baselinePostconditionMet: !TargetIsVisibleMember,
            attemptStartedAtUtc: retryMessageId is null ? null : _snapshot.AttemptStartedAtUtc) with
        {
            MessageId = retryMessageId ?? Services.GetService<Hexalith.FrontComposer.Contracts.Lifecycle.IUlidFactory>()?.NewUlid()
                ?? NUlid.Ulid.NewUlid().ToString(),
            CorrelationId = null,
        };

        int submitGeneration = _attemptGeneration;
        _isSubmitting = true;
        bool admitted = await SetCommandActivityRaisedAsync(true).ConfigureAwait(true);
        if (_disposed || submitGeneration != _attemptGeneration)
        {
            return;
        }
        bool authorityAdmitted = admitted && await ReauthorizeAdmissionAsync(admissionGeneration).ConfigureAwait(true)
            && admissionGeneration == Volatile.Read(ref _admissionGeneration);
        if (_disposed || submitGeneration != _attemptGeneration)
        {
            return;
        }
        // An obsolete admission generation refuses dispatch without claiming that authority was denied.
        string? eligibilityReason = EligibilityUnavailableReason;
        if (admitted && (!authorityAdmitted || eligibilityReason is not null || !IsPreviewEvidenceComplete || !string.Equals(_confirmationText, Member.UserId, StringComparison.Ordinal)))
        {
            TenantRetainedCommandAttempt? refusedAttempt = _retainedAttempt;
            try
            {
                _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(true);
            }
            catch (Exception)
            {
                // No delivery began. Restore the refusal below and require fresh activity admission.
            }
            if (_disposed || submitGeneration != _attemptGeneration || !ReferenceEquals(_retainedAttempt, refusedAttempt))
            {
                return;
            }
            _hasRaisedCommandActivity = false;
            Attempts.Detach(refusedAttempt, this);
            _retainedAttempt = null;
            _isSubmitting = false;
            // Cleanup can await parent work while the current safety evidence changes again.
            eligibilityReason = EligibilityUnavailableReason;
            bool confirmationMatches = string.Equals(_confirmationText, Member.UserId, StringComparison.Ordinal);
            bool currentSafetyRefusal = eligibilityReason is not null || !IsPreviewEvidenceComplete || !confirmationMatches;
            string reason = eligibilityReason
                ?? (!authorityAdmitted && admissionGeneration == Volatile.Read(ref _admissionGeneration)
                    ? AuthorizationUnavailableReason
                    : !IsPreviewEvidenceComplete
                        ? Localizer["Tenants.RemoveMember.Preview.Blocked.Required"].Value
                        : !confirmationMatches
                            ? Localizer[ElevatedRiskVisible
                                ? "Tenants.RemoveMember.Validation.ElevatedConfirmationRequired"
                                : "Tenants.RemoveMember.Validation.ConfirmationRequired", Member.UserId].Value
                            : Localizer["Tenants.RemoveMember.Admission.Changed"].Value);
            SetSnapshot(retryMessageId is null
                ? RefuseBeforeDispatch(reason, retriedAttempt, safetyRefusal: currentSafetyRefusal)
                : RefuseRetry(reason, retriedAttempt));
            return;
        }
        if (!admitted)
        {
            _isSubmitting = false;

            // Nothing was dispatched on a first refusal: keep the preview resubmittable with its intent.
            // UnableToVerify would send the next submit through the tracking-loss guard. A refused retry
            // keeps the possibly delivered failed attempt instead (see RefuseRetry).
            string reason = CommandSurfaceUnavailableReason ?? Localizer["Tenants.RemoveMember.Unavailable.InFlight"].Value;
            SetSnapshot(retryMessageId is null
                ? RefuseBeforeDispatch(reason, retriedAttempt, safetyRefusal: false)
                : RefuseRetry(reason, retriedAttempt));
            return;
        }

        try
        {
            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                Attempts.Detach(_retainedAttempt, this);
                _retainedAttempt = null;
                string reason = Localizer["Tenants.RemoveMember.Unavailable.CommandSurface"].Value;
                SetSnapshot(retryMessageId is null
                    ? RefuseBeforeDispatch(reason, retriedAttempt)
                    : RefuseRetry(reason, retriedAttempt));
                return;
            }

            TenantRemoveMemberCommandSnapshot expected = _snapshot;
            TenantRetainedCommandAttempt? attempt = _retainedAttempt;
            int generation = _attemptGeneration;
            if (attempt is null || !Attempts.TryStartDelivery(attempt, this))
            {
                return;
            }
            TenantCommandSubmissionResult result;
            try
            {
                result = await gateway.RemoveUserFromTenantAsync(request, expected.MessageId, CancellationToken.None).ConfigureAwait(false);
            }
            catch (Exception)
            {
                result = TenantCommandSubmissionResult.Failed(Localizer["Tenants.RemoveMember.Unavailable.CommandSurface"].Value)
                    with { MessageId = expected.MessageId, IsAmbiguousFailure = true };
            }
            TenantRemoveMemberCommandSnapshot completion = result.State is TenantCommandLifecycleState.Accepted
                ? expected.Accepted(result)
                : expected with
                {
                    State = result.IsAmbiguousFailure ? TenantCommandLifecycleState.RequestSent : result.State,
                    MessageId = result.MessageId ?? expected.MessageId,
                    CorrelationId = result.CorrelationId ?? expected.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = result.SafeMessageKey,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result, retryMessageId),
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            if (PublishResult(attempt, generation, expected, completion, delivery: true)
                && completion.CorrelationId is not null && !TenantCommandAttemptTracker.IsTerminal(completion))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed && submitGeneration == _attemptGeneration)
            {
                _isSubmitting = false;
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
        }
    }

    private async Task RetryDeliveryAsync()
    {
        if (_disposed || _authorityResolutionInProgress)
        {
            return;
        }
        TenantRemoveMemberCommandSnapshot expected = _snapshot;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        int generation = _attemptGeneration;
        long admissionGeneration = _admissionGeneration;
        // Consume retry authority on the renderer, where safety changes invalidate its generation.
        if (!await ReauthorizeInitialAdmissionAsync(admissionGeneration).ConfigureAwait(true))
        {
            if (!_disposed && admissionGeneration == Volatile.Read(ref _admissionGeneration))
            {
                RefuseAuthorityAdmission();
            }
            return;
        }
        ITenantCommandGateway? gateway = CommandGateway;
        if (_disposed || admissionGeneration != Volatile.Read(ref _admissionGeneration)
            || generation != _attemptGeneration || !ReferenceEquals(attempt, _retainedAttempt)
            || !TenantCommandAttemptTracker.HasSameEvidence(expected, _snapshot) || !CanRetryDelivery
            || _isSubmitting || expected.Intent is null || attempt is null || gateway is null
            || !IsPreviewComplete || !string.Equals(_confirmationText, Member.UserId, StringComparison.Ordinal)
            || !string.IsNullOrWhiteSpace(UnavailableReason)
            || !Attempts.TryStartDelivery(attempt, this))
        {
            return;
        }
        _isSubmitting = true;
        try
        {
            TenantCommandSubmissionResult result;
            try
            {
                result = await gateway.RemoveUserFromTenantAsync(expected.Intent, expected.MessageId, CancellationToken.None).ConfigureAwait(false);
            }
            catch (Exception)
            {
                result = TenantCommandSubmissionResult.Failed(Localizer["Tenants.RemoveMember.Unavailable.CommandSurface"].Value)
                    with { MessageId = expected.MessageId, IsAmbiguousFailure = true };
            }
            TenantRemoveMemberCommandSnapshot completion = result.State is TenantCommandLifecycleState.Accepted
                ? expected.Accepted(result)
                : expected with
                {
                    State = result.IsAmbiguousFailure ? TenantCommandLifecycleState.RequestSent : result.State,
                    MessageId = result.MessageId ?? expected.MessageId,
                    CorrelationId = result.CorrelationId ?? expected.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = result.SafeMessageKey,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result, expected.MessageId),
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            if (PublishResult(attempt, generation, expected, completion, delivery: true)
                && completion.CorrelationId is not null && !TenantCommandAttemptTracker.IsTerminal(completion))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed && generation == _attemptGeneration)
            {
                _isSubmitting = false;
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
        }
    }

    private Task RefreshStatusAsync()
        => RefreshCommandStatusAsync(requestProjectionRefresh: true);

    private async Task RefreshCommandStatusAsync(bool requestProjectionRefresh, bool waitForRunningRefresh = true)
    {
        SynchronizeRetainedAttempt();
        if (_disposed || TenantCommandAttemptTracker.IsTerminal(_snapshot) && _snapshot.State is not TenantCommandLifecycleState.Confirmed and not TenantCommandLifecycleState.Rejected)
        {
            return;
        }
        int refreshGeneration = _attemptGeneration;
        // The running refresh doubles as the in-flight gate, so a merged request can wait for exactly the
        // refresh (and replay) that will serve it. The replay requests are written before the gate is tried: an
        // owner finishing between a failed gate and a later write would release this caller without running it.
        // An owner consumes them in its own loop.
        Volatile.Write(ref _refreshPending, 1);
        if (requestProjectionRefresh)
        {
            Volatile.Write(ref _projectionRefreshPending, 1);
        }

        TaskCompletionSource completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        if (Interlocked.CompareExchange(ref _refreshCompletion, completion, null) is { } running)
        {
            // A request merged into the refresh already running is served by that refresh's replay. Waiting for
            // it keeps the caller (for example the shared audit control's bounded Refresh) from observing an
            // unchanged state before the replay has run. A SignalR nudge does not wait.
            if (waitForRunningRefresh)
            {
                await running.Task.ConfigureAwait(false);
            }

            return;
        }

        try
        {
            try
            {
                bool refreshProjection = requestProjectionRefresh;
                while (!_disposed && refreshGeneration == _attemptGeneration)
                {
                    refreshProjection |= Interlocked.Exchange(ref _projectionRefreshPending, 0) != 0;
                    Volatile.Write(ref _refreshPending, 0);
                    await RefreshCommandStatusCoreAsync(refreshProjection).ConfigureAwait(false);
                    bool refreshPending = Interlocked.Exchange(ref _refreshPending, 0) != 0;
                    refreshProjection = Interlocked.Exchange(ref _projectionRefreshPending, 0) != 0;
                    if (!refreshPending && !refreshProjection)
                    {
                        break;
                    }
                }
            }
            finally
            {
                Volatile.Write(ref _refreshCompletion, null);
            }

            bool followUpProjectionRefresh = Interlocked.Exchange(ref _projectionRefreshPending, 0) != 0;
            if (Interlocked.Exchange(ref _refreshPending, 0) != 0 || followUpProjectionRefresh)
            {
                await RefreshCommandStatusAsync(followUpProjectionRefresh).ConfigureAwait(false);
            }
        }
        finally
        {
            completion.TrySetResult();
        }
    }

    private async Task RefreshCommandStatusCoreAsync(bool requestProjectionRefresh)
    {
        if (_disposed || TenantCommandAttemptTracker.IsTerminal(_snapshot) && _snapshot.State is not TenantCommandLifecycleState.Confirmed and not TenantCommandLifecycleState.Rejected)
        {
            return;
        }
        // Delivery ambiguity has a reusable message id but no status correlation. A nudge cannot
        // turn that recovery basis into a status lookup or a different attempt.
        if (_snapshot.State is TenantCommandLifecycleState.RequestSent && _snapshot.MessageId is not null
            && _snapshot.CorrelationId is null && _retainedAttempt?.Lease.IsDispatchMarked is true)
        {
            return;
        }
        int generation = _attemptGeneration;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        TenantRemoveMemberCommandSnapshot expected = _snapshot;
        if (_snapshot.Intent is null)
        {
            return;
        }

        ITenantCommandGateway? gateway = CommandGateway;

        // A tracked command (accepted/projection-pending) re-queries its authoritative status
        // first. A submission-time rejection (for example UserNotInTenant) carries no tracking
        // handle, so skip the status lookup and rely on the projection re-query below to reconcile
        // it to already-applied when the target is proven absent (AC4).
        if (_snapshot.State is not TenantCommandLifecycleState.Confirmed
            && !string.IsNullOrWhiteSpace(_snapshot.MessageId) && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
        {
            if (gateway is null)
            {
                SetSnapshot(_snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(Localizer["Tenants.RemoveMember.Unavailable.CommandSurface"].Value)));
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
                return;
            }

            TenantCommandStatusResult status = await gateway
                .GetStatusAsync(new TenantCommandTrackingHandle(_snapshot.MessageId, _snapshot.CorrelationId, _snapshot.Intent?.TenantId) { ExpectedDomain = TenantIdentity.Domain }, CancellationToken.None)
                .ConfigureAwait(false);
            if (!PublishResult(attempt, generation, expected, expected.ApplyStatus(status)))
            {
                return;
            }
            expected = _snapshot;
        }
        else if ((TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State)
                || _snapshot.State is TenantCommandLifecycleState.UnableToVerify
                    or TenantCommandLifecycleState.Degraded)
            && _snapshot.State is not TenantCommandLifecycleState.Rejected)
        {
            SetSnapshot(_snapshot with
            {
                State = TenantCommandLifecycleState.UnableToVerify,
                SafeMessage = Localizer["Tenants.RemoveMember.Unavailable.CommandSurface"].Value,
                SafeMessageKey = null,
                AuditState = TenantCommandAuditStates.Unverifiable,
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            });
            await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            return;
        }

        if (requestProjectionRefresh)
        {
            _isProjectionRefreshCallback.Value = true;
            try
            {
                await InvokeAsync(() => OnProjectionRefreshRequested.InvokeAsync()).ConfigureAwait(false);
            }
            finally
            {
                _isProjectionRefreshCallback.Value = false;
            }
        }

        if (!IsCurrentContinuation(generation, expected))
        {
            return;
        }
        if (ProjectionEvidenceProvider is not null && expected.Intent is not null)
        {
            TenantDetailSnapshot? evidence = await ProjectionEvidenceProvider(expected.Intent).ConfigureAwait(false);
            if (!PublishResult(attempt, generation, expected, expected.ConfirmProjection(evidence)))
            {
                return;
            }
        }

        await TryAssembleRemovalProofAsync().ConfigureAwait(false);

        await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
    }

    private async Task TryAssembleRemovalProofAsync()
    {
        long proofGeneration = Interlocked.Increment(ref _proofGeneration);
        _proofAttemptGeneration = _attemptGeneration;
        _proofMessageId = _snapshot.MessageId;
        _proofCorrelationId = _snapshot.CorrelationId;
        _proofCommittedEventSequence = _snapshot.CommittedEventSequence;
        _proofCallerScope = _snapshot.ProjectionProofCallerScope;
        if (_snapshot.Intent is null
            || _snapshot.State is not TenantCommandLifecycleState.Confirmed)
        {
            CancelProofSearch();
            return;
        }

        // Proof is already assembled and rendered. Re-walking the tenant audit trail (up to
        // MaximumAuditProofPageCount pages) on every subsequent refresh buys nothing and cannot improve
        // an Available state, so the walk stops here.
        if (_snapshot.AuditState is TenantCommandAuditState.AuditAvailable
            && _removalProof is { State: TenantAuditReceiptState.Ready })
        {
            CancelProofSearch();
            return;
        }

        RemoveUserFromTenant intent = _snapshot.Intent;
        ITenantQueryGateway? queryGateway = QueryGateway;
        if (queryGateway is null or UnavailableTenantQueryGateway)
        {
            CancelProofSearch();
            if (CanApplyProof(proofGeneration, intent))
            {
                SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditUnavailable));
            }

            return;
        }

        if (_snapshot.CommittedEventSequence is not > 0
            || string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
            || string.IsNullOrWhiteSpace(_snapshot.ProjectionProofCallerScope))
        {
            CancelProofSearch();
            if (CanApplyProof(proofGeneration, intent))
            {
                SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed));
            }

            return;
        }

        string correlationId = _snapshot.CorrelationId;
        long committedEventSequence = _snapshot.CommittedEventSequence.Value;
        string callerScope = _snapshot.ProjectionProofCallerScope;
        CancellationTokenSource source = ReplaceProofCancellation();
        // Exact correlation/sequence is causal proof; UI clock skew must not hide the exact event.
        TenantAuditRequest request = new(intent.TenantId);
        var visitedCursors = new HashSet<string>(StringComparer.Ordinal);
        bool weakMatchObserved = false;
        string? projectionVersion = null;
        bool? usesProjectionVersion = null;
        TenantAuditReceipt? matchedReceipt = null;
        int exactMatchCount = 0;
        try
        {
            for (int pageNumber = 0; pageNumber < MaximumAuditProofPageCount; pageNumber++)
            {
                source.Token.ThrowIfCancellationRequested();
                TenantAuditSnapshot audit = await queryGateway
                    .GetTenantAuditAsync(request, previous: null, source.Token)
                    .ConfigureAwait(false);
                source.Token.ThrowIfCancellationRequested();
                if (!CanApplyProof(proofGeneration, intent))
                {
                    return;
                }

                if (audit.Kind is TenantAuditSurfaceKind.Unauthorized
                    or TenantAuditSurfaceKind.Unavailable
                    or TenantAuditSurfaceKind.Error
                    or TenantAuditSurfaceKind.InvalidCursor
                    or TenantAuditSurfaceKind.Loading)
                {
                    // A read that failed (unauthorized, unavailable, or errored) leaves the audit status unreadable.
                    // A page that is still loading or whose cursor was refused is not ready yet, so proof is delayed.
                    TenantCommandAuditState failure = audit.Kind is TenantAuditSurfaceKind.Unauthorized
                            or TenantAuditSurfaceKind.Unavailable
                            or TenantAuditSurfaceKind.Error
                        ? TenantCommandAuditState.AuditUnavailable
                        : TenantCommandAuditState.AuditDelayed;
                    SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(failure));
                    return;
                }

                // Tenant audit models may expose only their strong state-store ETag. It is a consistent
                // snapshot marker, while command causation remains the exact correlation/sequence pair.
                string? pageVersion = audit.ProjectionVersion ?? audit.ETag;
                bool pageUsesProjectionVersion = audit.ProjectionVersion is not null;
                bool currentLifecycleBackedPage = audit.Kind is TenantAuditSurfaceKind.Ready
                        or TenantAuditSurfaceKind.Empty
                        or TenantAuditSurfaceKind.FilteredEmpty
                        or TenantAuditSurfaceKind.ListRefreshed
                    && audit.Freshness is ReadModelFreshnessState.Current
                    && audit.Lifecycle is ProjectionLifecycleState.Current
                    && audit.MatchesScope(request, callerScope)
                    && !string.IsNullOrWhiteSpace(pageVersion)
                    && (projectionVersion is null || string.Equals(projectionVersion, pageVersion, StringComparison.Ordinal))
                    && (!usesProjectionVersion.HasValue || usesProjectionVersion.Value == pageUsesProjectionVersion)
                    && audit.Rows.Count <= request.PageSize
                    && audit.HasMore != string.IsNullOrWhiteSpace(audit.NextCursor)
                    && audit.Rows.All(row => string.Equals(row.TenantId, intent.TenantId, StringComparison.Ordinal)
                        && row.Freshness is ReadModelFreshnessState.Current
                        && row.Lifecycle is ProjectionLifecycleState.Current
                        && row.Provenance is QueryResponseProvenance.ProjectionBacked);
                if (!currentLifecycleBackedPage)
                {
                    SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed));
                    return;
                }

                projectionVersion ??= pageVersion;
                usesProjectionVersion ??= pageUsesProjectionVersion;
                foreach (TenantAuditRow match in TenantRemoveMemberCommandSnapshot.EnumerateMatchingRemovalProofs(
                    audit.Rows,
                    intent.TenantId,
                    intent.UserId,
                    correlationId,
                    committedEventSequence))
                {
                    bool currentLifecycleBackedRow = match.Freshness is ReadModelFreshnessState.Current
                        && match.Lifecycle is ProjectionLifecycleState.Current
                        && match.Provenance is QueryResponseProvenance.ProjectionBacked;
                    if (++exactMatchCount > 1)
                    {
                        SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed));
                        return;
                    }

                    // Only the exact verified command correlation and committed sequence may supply a receipt.
                    TenantAuditReceipt receipt = TenantAuditReceipt.FromRow(
                        match,
                        surfaceKind: TenantAuditSurfaceKind.Ready,
                        auditState: TenantCommandAuditState.AuditAvailable);
                    bool receiptReady = receipt.State is TenantAuditReceiptState.Ready;
                    if (currentLifecycleBackedRow && receiptReady)
                    {
                        matchedReceipt = receipt;
                        continue;
                    }

                    weakMatchObserved = true;
                }

                if (!audit.HasMore)
                {
                    if (matchedReceipt is not null)
                    {
                        _removalProof = matchedReceipt;
                        SetSnapshot(_snapshot.ApplyRemovalProofMatch(
                            matched: true,
                            hasCurrentLifecycleBackedEvidence: true,
                            hasReadyReceipt: true));
                        return;
                    }

                    if (_snapshot.AuditState is not TenantCommandAuditState.AuditAvailable)
                    {
                        _removalProof = null;
                    }

                    SetSnapshot(weakMatchObserved
                        ? _snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed)
                        : _snapshot.ApplyRemovalProofMatch(matched: false));
                    return;
                }

                if (string.IsNullOrWhiteSpace(audit.NextCursor) || !visitedCursors.Add(audit.NextCursor))
                {
                    SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed));
                    return;
                }

                request = request with { Cursor = audit.NextCursor, ETag = null };
            }

            if (CanApplyProof(proofGeneration, intent))
            {
                SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed));
            }
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
            // A superseded walk is not a read failure: the proof is only delayed.
            if (CanApplyProof(proofGeneration, intent))
            {
                SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditDelayed));
            }
        }
        catch
        {
            // The audit read itself failed, so the audit status could not be read.
            if (CanApplyProof(proofGeneration, intent))
            {
                SetSnapshot(_snapshot.ApplyRemovalProofQueryFailure(TenantCommandAuditState.AuditUnavailable));
            }
        }
        finally
        {
            CompleteProofCancellation(source);
        }
    }

    private bool CanApplyProof(long generation, RemoveUserFromTenant intent)
        => !_disposed
        && generation == Volatile.Read(ref _proofGeneration)
        && _proofAttemptGeneration == _attemptGeneration
        && string.Equals(_proofMessageId, _snapshot.MessageId, StringComparison.Ordinal)
        && string.Equals(_proofCorrelationId, _snapshot.CorrelationId, StringComparison.Ordinal)
        && _proofCommittedEventSequence == _snapshot.CommittedEventSequence
        && string.Equals(_proofCallerScope, _snapshot.ProjectionProofCallerScope, StringComparison.Ordinal)
        && (_retainedAttempt is null || Attempts.IsAttached(_retainedAttempt, this))
        && _snapshot.State is TenantCommandLifecycleState.Confirmed
        && Equals(_snapshot.Intent, intent);

    private CancellationTokenSource ReplaceProofCancellation()
    {
        var source = new CancellationTokenSource();
        lock (_proofCancellationLock)
        {
            _proofCancellation?.Cancel();
            _proofCancellation = source;
        }

        return source;
    }

    private void CancelProofSearch()
    {
        lock (_proofCancellationLock)
        {
            _proofCancellation?.Cancel();
            _proofCancellation = null;
        }
    }

    private void CompleteProofCancellation(CancellationTokenSource source)
    {
        lock (_proofCancellationLock)
        {
            if (ReferenceEquals(_proofCancellation, source))
            {
                _proofCancellation = null;
            }
        }

        source.Dispose();
    }

    private async Task ContinueReadOnlyAsync()
    {
        if (!CanContinueReadOnly || _disposed)
        {
            return;
        }
        _readOnlyDetached = true;
        _isSubmitting = false;
        Attempts.Detach(_retainedAttempt, this);
        _retainedAttempt = null;
        _attemptGeneration++;
        _removalProof = null;
        _receiptDismissed = false;
        _dismissed = true;
        SetSnapshot(TenantRemoveMemberCommandSnapshot.Idle());
        _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
        await InvokeAsync(() => OnCloseRequested.InvokeAsync()).ConfigureAwait(false);
    }

    /// <summary>
    /// Hides the WP-2A receipt without touching the confirmed lifecycle, the audit state or the retained
    /// tracking identifiers. The audit entry point stays reachable so the evidence can be re-opened.
    /// </summary>
    private Task DismissReceiptAsync()
    {
        _receiptDismissed = true;
        return Task.CompletedTask;
    }

    private Task InspectAuditAsync()
    {
        if (!CanInspectAudit || CommandAuditReturnUrl is not { } safeReturn)
        {
            return Task.CompletedTask;
        }

        string target = Uri.EscapeDataString(Member.UserId);
        string returnUrl = Uri.EscapeDataString(safeReturn);
        Navigation.NavigateTo(
            $"/tenants/{Uri.EscapeDataString(Detail.TenantId)}/audit?targetUserId={target}&source=command-result&returnUrl={returnUrl}&returnFocus=tenants-remove-member-lifecycle");
        return Task.CompletedTask;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await CloseAsync().ConfigureAwait(false);
        }
    }

    private async Task CloseAsync()
    {
        if (IsOwnedCommandInFlight)
        {
            // Returning silently made Escape read as a broken control: no dismissal, no message and no
            // announcement. The dialog still refuses to close while the command is in flight, but it now
            // says so assertively and points at the named recovery that is available.
            SetSnapshot(_snapshot with
            {
                SafeMessage = null,
                SafeMessageKey = "Tenants.RemoveMember.Dismiss.Blocked",
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                FocusTarget = TenantCommandFocusTarget.Refresh,
            });
            return;
        }

        _validationMessage = null;
        _focusCancelPending = true;
        InvalidateAdmission();
        _dismissed = true;
        _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
        await InvokeAsync(() => OnCloseRequested.InvokeAsync()).ConfigureAwait(false);
    }

    private async Task FocusEndSentinelAsync(FocusEventArgs args)
    {
        // Cancel is rendered outside the form and is therefore focusable at every width. The confirm
        // control sits inside .tenants-remove-member-flow__form, which the narrow rule sets to
        // display:none -- focusing it there is a silent no-op that lets focus escape an aria-modal
        // dialog. Width is not observable server-side, so the trap always lands on the control that is
        // guaranteed to exist.
        await FocusSafelyAsync(_cancelElement).ConfigureAwait(false);
    }

    private async Task FocusCancelAsync(FocusEventArgs args)
        => await FocusSafelyAsync(_cancelElement).ConfigureAwait(false);

    public void Dispose()
    {
        _disposed = true;
        InvalidateAdmission();
        if (_viewportObservation is not null)
        {
            _viewportObservation.StateChanged -= OnViewportStateChanged;
        }
        TenantCommandAttemptTracker? attempts = Services.GetService<TenantAggregateCommandAdmissionGate>() is null ? null : Services.GetService<TenantCommandAttemptTracker>();
        if (attempts is not null)
        {
            attempts.StateChanged -= OnRetainedAttemptChanged;
        }
        _attemptGeneration++;
        attempts?.Detach(_retainedAttempt, this);
        _ = Interlocked.Increment(ref _proofGeneration);
        CancelProofSearch();
    }
