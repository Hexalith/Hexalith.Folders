    private TenantHighImpactViewportObservation? _viewportObservation;

    private bool HasSafeMeasuredViewport
        => _viewportObservation is { HasMeasurement: true, State: TenantHighImpactViewportState.Safe };

    private void OnViewportStateChanged(object? sender, EventArgs args)
    {
        InvalidateAdmission();
        _ = RenderViewportAsync();
    }

    private async Task RenderViewportAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    InitializeIdlePreview();
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private readonly AsyncLocal<bool> _isProjectionRefreshCallback = new();
    private const int MaximumAuditProofPageCount = CursorHistory.DefaultMaximum;

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantMember Member { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public bool IsAuthorized { get; set; }

    /// <summary>Gets or sets the current live authority reflection.</summary>
    [Parameter]
    public TenantLifecycleAuthorizationReflectionState AuthorizationReflection { get; set; }
        = TenantLifecycleAuthorizationReflectionState.Indeterminate;

    /// <summary>Gets or sets the current authority and evidence revision.</summary>
    [Parameter]
    public long AuthorizationVersion { get; set; }

    /// <summary>Gets or sets the fresh current-caller authority resolver used before dispatch and retry.</summary>
    [Parameter]
    public Func<CancellationToken, Task<TenantLifecycleAuthorizationReflectionState>>? AuthorizationReflectionProvider { get; set; }

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
