    /// target is or is not a reflected platform administrator. Incomplete evidence stays Unknown.
    /// </summary>
    [Parameter]
    public bool TargetPlatformStandingResolved { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the parent has a connected authoritative audit read surface.
    /// Gateway registration alone is not capability evidence.
