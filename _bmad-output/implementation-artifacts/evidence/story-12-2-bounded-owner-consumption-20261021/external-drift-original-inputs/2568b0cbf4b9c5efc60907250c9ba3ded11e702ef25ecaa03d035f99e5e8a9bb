        for story_id, filename in VALIDATOR_MODULE.EPIC_11_CHILD_ARTIFACTS.items():
            key = VALIDATOR_MODULE.EPIC_11_CHILD_QUEUE_KEYS[story_id]
            rows.append(f"  {key}: done")
