        self.assertEqual(committed.returncode, 0, committed.stdout + committed.stderr)
        return {
            "baseline": baseline,
            "head": git(root, "rev-parse", "HEAD").stdout.strip(),
            "impl": impl,
            "planning": planning,
            "paths": paths,
        }

