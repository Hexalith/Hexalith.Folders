@using Hexalith.Tenants.Contracts.Identity
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.Tenants.UI.State.TenantList
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services
@implements IDisposable

<section class="tenants-change-role-flow"
         data-testid="tenants-change-role-flow"
         aria-labelledby="tenants-change-role-heading">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.65rem" Class="tenants-change-role-flow__heading">
        <h3 id="tenants-change-role-heading">@Localizer["Tenants.ChangeRole.Title"]</h3>
        <p>@Localizer["Tenants.ChangeRole.Description", Detail.TenantId, Member.UserId, RoleLabel(Member.Role)]</p>
    </FluentStack>

    <dl class="tenants-change-role-flow__context">
        <div>
            <dt>@Localizer["Tenants.ChangeRole.UserId.Label"]</dt>
            <dd data-testid="tenants-change-role-user-id">@Member.UserId</dd>
        </div>
        <div>
            <dt>@Localizer["Tenants.ChangeRole.CurrentRole.Label"]</dt>
            <dd data-testid="tenants-change-role-current-role">@RoleLabel(Member.Role)</dd>
        </div>
        <div>
            <dt>@Localizer["Tenants.ChangeRole.OwnerContext.Label"]</dt>
            <dd data-testid="tenants-change-role-owner-context">@OwnerContextText</dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(UnavailableReason))
    {
        <p class="tenants-change-role-flow__unavailable"
           id="tenants-change-role-unavailable"
           data-testid="tenants-change-role-unavailable-reason"
           role="alert">
            @UnavailableReason
        </p>
    }

    <EditForm Model="@_formModel"
              FormName="tenants-change-role-flow"
              class="tenants-change-role-flow__form"
              OnSubmit="SubmitAsync">
        <div class="tenants-change-role-flow__field" @ref="_roleElement" tabindex="-1">
            <FluentSelect TOption="string" TValue="string"
                          Id="tenants-change-role-new-role"
                          name="new-role"
                          Label="@Localizer["Tenants.ChangeRole.NewRole.Label"]"
                          Value="@_roleValue"
                          ValueChanged="OnRoleChanged"
                          data-testid="tenants-change-role-new-role"
                          aria-describedby="@RoleDescribedBy">
                @foreach (TenantRole role in AssignableRoles)
                {
                    <FluentOption TValue="string" Value="@role.ToString()">@RoleLabel(role)</FluentOption>
                }
            </FluentSelect>
            <span id="tenants-change-role-new-role-help">@Localizer["Tenants.ChangeRole.NewRole.Help"]</span>
        </div>

        @if (OwnerRiskVisible)
        {
            <p class="tenants-change-role-flow__risk"
               id="tenants-change-role-risk"
               data-testid="tenants-change-role-risk"
               role="status">
                <span aria-hidden="true">!</span>
                <span>@Localizer["Tenants.ChangeRole.OwnerRisk.LastOwner", OwnerCount]</span>
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <p id="tenants-change-role-validation"
               class="tenants-change-role-flow__validation"
               data-testid="tenants-change-role-validation"
               role="alert">
                @_validationMessage
            </p>
        }

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom" Class="tenants-change-role-flow__actions">
            <FluentButton Type="ButtonType.Submit"
                          Appearance="ButtonAppearance.Primary"
                          data-testid="tenants-change-role-submit"
                          Disabled="@IsSubmitDisabled">
                @Localizer["Tenants.ChangeRole.Submit"]
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          data-testid="tenants-change-role-refresh"
                          Disabled="@(!CanRefresh)"
                          OnClick="RefreshStatusAsync">
                @Localizer["Tenants.ChangeRole.Refresh"]
            </FluentButton>
            @if (CanContinueReadOnly)
            {
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-change-role-continue-read-only"
                              OnClick="ContinueReadOnlyAsync">
                    @Localizer["Tenants.ChangeRole.Action.ContinueReadOnly"]
                </FluentButton>
            }
            <FluentButton Appearance="ButtonAppearance.Outline"
                          data-testid="tenants-change-role-cancel"
                          Disabled="@IsOwnedCommandInFlight"
                          OnClick="CloseAsync">
                @Localizer["Tenants.ChangeRole.Cancel"]
            </FluentButton>
        </FluentStack>
    </EditForm>

    <section class="tenants-change-role-flow__lifecycle"
             @ref="_lifecycleElement"
             tabindex="-1"
             id="tenants-change-role-lifecycle" data-testid="tenants-change-role-lifecycle"
             aria-labelledby="tenants-change-role-state-label">
        <h4 id="tenants-change-role-state-label">@Localizer["Tenants.ChangeRole.Lifecycle.Title"]</h4>
        <p class="@StateClass" data-testid="tenants-change-role-state">
            <span aria-hidden="true">@StateSymbol</span>
            <span>@StateText</span>
        </p>
        <div data-testid="tenants-change-role-audit">
            @if (ShouldRenderAuditEntryPoint)
            {
                <AuditAvailabilityState AuditState="@_snapshot.AuditState"
                                        Source="change-role"
                                        OwnerRefreshIncludesAuditAuthority="true"
                                        OnRefresh="@(CanRequeryAudit ? EventCallback.Factory.Create(this, RefreshFromAuditControlAsync) : default(EventCallback))"
                                        OnContinueReadOnly="@(CanContinueReadOnly ? EventCallback.Factory.Create(this, ContinueReadOnlyAsync) : default(EventCallback))"
                                        InspectAuditAction="@CommandAuditEntryPoint" />
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(DisplaySafeMessage))
        {
            <p data-testid="tenants-change-role-safe-message">@DisplaySafeMessage</p>
        }
        <p class="tenants-change-role-flow__live"
           data-testid="tenants-change-role-live-region"
           aria-live="@LiveRegionMode"
           aria-atomic="true">
            @StateText
        </p>
    </section>
</section>

@code {
    [CascadingParameter(Name = "CurrentTenantCallerScope")]
    public string? CurrentCallerScope { get; set; }

    [CascadingParameter(Name = "AuditReadAvailable")]
    public bool AuditReadAvailable { get; set; }

    [CascadingParameter(Name = "AuditReadPending")]
    public bool AuditReadPending { get; set; }

    [CascadingParameter(Name = "AuditReadDenied")]
    public bool AuditReadDenied { get; set; }

    [CascadingParameter(Name = "AuditReadUnavailableReason")]
    public string? AuditReadUnavailableReason { get; set; }

    [CascadingParameter(Name = "DetailAuditReturnUrl")]
    public string? DetailAuditReturnUrl { get; set; }

    private static readonly TenantRole[] AssignableRoles =
    [
        TenantRole.TenantOwner,
        TenantRole.TenantContributor,
        TenantRole.TenantReader,
    ];

    private TenantRetainedCommandAttempt? _retainedAttempt;
    private string? _attemptMemberUserId;
    private int _attemptGeneration;
    private bool _readOnlyDetached;
    private bool _disposed;
    private readonly object _formModel = new();
    private TenantChangeRoleCommandSnapshot _snapshot = TenantChangeRoleCommandSnapshot.Idle();
    private string _roleValue = string.Empty;
    private string? _validationMessage;
    private bool _isSubmitting;
    private bool _hasRaisedCommandActivity;
    private ElementReference _roleElement;
    private ElementReference _lifecycleElement;
    private bool _focusRolePending;
    private bool _focusLifecyclePending;
    private readonly object _refreshLock = new();
    private TaskCompletionSource? _refreshCompletion;
    private int _refreshPending;
    private int _refreshPendingGeneration;
    private readonly AsyncLocal<bool> _isProjectionRefreshCallback = new();

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantMember Member { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public bool IsAuthorized { get; set; }

    /// <summary>Gets or sets the current live authority reflection.</summary>
    [Parameter]
    public TenantLifecycleAuthorizationReflectionState AuthorizationReflection { get; set; }
        = TenantLifecycleAuthorizationReflectionState.Indeterminate;

    /// <summary>Gets or sets the current authority and evidence revision.</summary>
    [Parameter]
    public long AuthorizationVersion { get; set; }

    /// <summary>Gets or sets the fresh current-caller authority resolver used before dispatch and retry.</summary>
    [Parameter]
    public Func<CancellationToken, Task<TenantLifecycleAuthorizationReflectionState>>? AuthorizationReflectionProvider { get; set; }

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public string? CommandSurfaceUnavailableReason { get; set; }

    [Parameter]
    public string? ProjectionVersion { get; set; }

    /// <summary>
    /// Optional live projection-version reader used after parent refresh. Prefer this over the
    /// <see cref="ProjectionVersion"/> parameter, which can lag until the next render.
    /// </summary>
    [Parameter]
    public Func<string?>? ProjectionVersionProvider { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<bool, Task<bool>>? CommandActivityLease { get; set; }

    [Parameter]
    public Func<ChangeUserRole, Task<TenantDetailSnapshot?>>? ProjectionEvidenceProvider { get; set; }


    private long _admissionGeneration;
    private bool _authorityResolutionInProgress;
    private readonly Lock _authorityCancellationLock = new();
    private CancellationTokenSource? _authorityCancellation;
    private object? _admissionParameters;
    private TenantLifecycleAuthorizationReflectionState? _submissionAuthority;

    private string AuthorizationUnavailableReason
        => Localizer[_submissionAuthority is TenantLifecycleAuthorizationReflectionState.MissingPermission
            || AuthorizationReflection is TenantLifecycleAuthorizationReflectionState.MissingPermission
            || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
                ? "Tenants.ChangeRole.Unavailable.Authorization"
                : "Tenants.Mutation.Unavailable.AuthorityIndeterminate"].Value;

    private void ObserveAdmissionParameters()
    {
        object current = (Detail, Member, CurrentCallerScope, IsAuthorized, AuthorizationReflection, AuthorizationVersion, SurfaceKind, Freshness, ProjectionVersion, AuthorizationReflectionProvider);
        if (!Equals(current, _admissionParameters))
        {
            _admissionParameters = current;
            InvalidateAdmission();
            _submissionAuthority = null;
        }
    }

    private void InvalidateAdmission()
    {
        Interlocked.Increment(ref _admissionGeneration);
        lock (_authorityCancellationLock)
        {
            _authorityCancellation?.Cancel();
        }
    }

    private async Task<bool> ReauthorizeInitialAdmissionAsync(long generation)
    {
        _authorityResolutionInProgress = true;
        try
        {
            return await ReauthorizeAdmissionAsync(generation).ConfigureAwait(false);
        }
        finally
        {
            _authorityResolutionInProgress = false;
        }
    }

    private async Task<bool> ReauthorizeAdmissionAsync(long generation)
    {
        TenantLifecycleAuthorizationReflectionState authority = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        // Bound admission independently of provider cooperation; cancellation never cancels dispatched work.
        using var source = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        lock (_authorityCancellationLock)
        {
            _authorityCancellation?.Cancel();
            _authorityCancellation = source;
        }
        try
        {
            if (AuthorizationReflectionProvider is { } provider)
            {
                authority = await provider(source.Token).WaitAsync(source.Token).ConfigureAwait(false);
                source.Token.ThrowIfCancellationRequested();
            }
        }
        catch (Exception)
        {
            // Missing, cancelled or faulted current authority never permits a dispatch.
            authority = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        finally
        {
            lock (_authorityCancellationLock)
            {
                if (ReferenceEquals(_authorityCancellation, source))
                {
                    _authorityCancellation = null;
                }
            }
        }

        if (_disposed || generation != Volatile.Read(ref _admissionGeneration))
        {
            return false;
        }
        _submissionAuthority = authority;
        return !_disposed && generation == _admissionGeneration && IsAuthorized
            && AuthorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized
            && authority is TenantLifecycleAuthorizationReflectionState.Authorized;
    }

    private void RefuseAuthorityAdmission()
        => SetSnapshot(_snapshot with
        {
            SafeMessage = EligibilityUnavailableReason ?? AuthorizationUnavailableReason,
            SafeMessageKey = null,
            FocusTarget = TenantCommandFocusTarget.Submit,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        });

    internal TenantChangeRoleCommandSnapshot Snapshot => _snapshot;

    private void SynchronizeRetainedAttempt()
    {
        if (_retainedAttempt is { } attempt
            && Attempts.TryRead<TenantChangeRoleCommandSnapshot>(attempt, this, out TenantChangeRoleCommandSnapshot? latest) && latest is not null)
        {
            _snapshot = latest;
        }
    }

    private void OnRetainedAttemptChanged(object? sender, EventArgs args)
    {
        if (_disposed || _retainedAttempt is null)
        {
            return;
        }
        _ = RenderRetainedAttemptAsync();
    }

    private async Task RenderRetainedAttemptAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    SynchronizeRetainedAttempt();
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
        }
    }


    private TenantCommandAttemptTracker Attempts
        => Services.GetRequiredService<TenantCommandAttemptTracker>();

    private bool CanRetryDelivery
        => !_isSubmitting && _snapshot.State is TenantCommandLifecycleState.RequestSent
            && _snapshot.MessageId is not null && _snapshot.CorrelationId is null
            && _retainedAttempt?.DeliveryInFlight is not true;

    private void RestoreRetainedAttempt()
    {
        if (_retainedAttempt is { } current && (!string.Equals(current.TenantId, Detail.TenantId, StringComparison.Ordinal) || !string.Equals(_attemptMemberUserId, Member.UserId, StringComparison.Ordinal)))
        {
            Attempts.Detach(current, this);
            _retainedAttempt = null;
            _attemptGeneration++;
            _hasRaisedCommandActivity = false;
            _isSubmitting = false;
            _snapshot = TenantChangeRoleCommandSnapshot.Idle();
        }
        if (_readOnlyDetached || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null || !IsAuthorized)
        {
            return;
        }
        SynchronizeRetainedAttempt();
        if (_retainedAttempt is null && Attempts.Find<TenantChangeRoleCommandSnapshot>(Detail.TenantId) is { } candidate && string.Equals(candidate.Intent?.UserId, Member.UserId, StringComparison.Ordinal)
            && Attempts.TryAdopt<TenantChangeRoleCommandSnapshot>(Detail.TenantId, this, out TenantRetainedCommandAttempt? attempt, out TenantChangeRoleCommandSnapshot? retained)
            && retained is not null)
        {
            _retainedAttempt = attempt;
            _attemptMemberUserId = retained.Intent?.UserId;
            _attemptGeneration++;
            _snapshot = retained;
            _roleValue = retained.Intent?.NewRole.ToString() ?? string.Empty;
        }
    }

    private bool PublishResult(TenantRetainedCommandAttempt? attempt, int generation,
        TenantChangeRoleCommandSnapshot expected, TenantChangeRoleCommandSnapshot result, bool delivery = false)
    {
        bool retained = attempt is null || (delivery
            ? Attempts.TryCompleteDelivery(attempt, expected, result)
            : Attempts.TryUpdate(attempt, expected, result));
        if (!retained || _disposed || generation != _attemptGeneration
            || !ReferenceEquals(_retainedAttempt, attempt)
            || attempt is not null && !Attempts.IsAttached(attempt, this)
            || attempt is null && !delivery && !TenantCommandAttemptTracker.HasSameEvidence(_snapshot, expected) && !ReferenceEquals(_snapshot, result))
        {
            return false;
        }
        _snapshot = result;
        SynchronizeRetainedAttempt();
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || result.FocusTarget is TenantCommandFocusTarget.Lifecycle)
        {
            _focusLifecyclePending = true;
        }
        return true;
    }

    private bool IsCurrentContinuation(int generation, TenantChangeRoleCommandSnapshot expected)
        => !_disposed && generation == _attemptGeneration
            && (_retainedAttempt is { } attempt
                ? Attempts.IsAttached(attempt, this) && Attempts.IsExpectedEvidence(attempt, expected)
                : TenantCommandAttemptTracker.HasSameEvidence(_snapshot, expected));


    private int OwnerCount
        => Detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private string OwnerContextText
        => OwnerCount switch
        {
            0 => Localizer["Tenants.ChangeRole.OwnerContext.NoOwners"],
            1 => Localizer["Tenants.ChangeRole.OwnerContext.LastOwner", OwnerCount],
            _ => Localizer["Tenants.ChangeRole.OwnerContext.MultipleOwners", OwnerCount],
        };

    private string? EligibilityUnavailableReason
        => !IsAuthorized || AuthorizationReflection is not TenantLifecycleAuthorizationReflectionState.Authorized
            || _submissionAuthority is TenantLifecycleAuthorizationReflectionState.MissingPermission or TenantLifecycleAuthorizationReflectionState.Indeterminate
            || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
            ? AuthorizationUnavailableReason
            : SurfaceKind is TenantDetailSurfaceKind.Stale
                or TenantDetailSurfaceKind.Unavailable
                or TenantDetailSurfaceKind.Unknown
                or TenantDetailSurfaceKind.Degraded
                || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.ChangeRole.Unavailable.Freshness"].Value
                : Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown
                    ? Localizer["Tenants.ChangeRole.Unavailable.TenantLifecycle"].Value
                    : (!IsCommandSurfaceAvailable && !IsOwnAggregateAdmissionUnavailable) || CommandGateway is null || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null
                        ? CommandSurfaceUnavailableReason ?? Localizer["Tenants.ChangeRole.Unavailable.CommandSurface"].Value
                        : Member.Role is TenantRole.Unknown
                                ? Localizer["Tenants.ChangeRole.Unavailable.UnknownRole"].Value
                                : null;

    private string? UnavailableReason
        => EligibilityUnavailableReason ?? (_isSubmitting ? Localizer["Tenants.ChangeRole.Unavailable.InFlight"].Value : null);

    private bool IsSubmitDisabled
        => _authorityResolutionInProgress || (IsOwnedCommandInFlight && !CanRetryDelivery)
        || !string.IsNullOrWhiteSpace(UnavailableReason);

    private bool IsOwnAggregateAdmissionUnavailable
        => _retainedAttempt is { } attempt && Attempts.IsAttached(attempt, this)
            && Services.GetService<TenantAggregateCommandAdmissionGate>()?.IsOwnedBy(
                TenantCommandAggregateLock.ForTenant(Detail.TenantId), attempt.LeaseOwner) is true
            && string.Equals(CommandSurfaceUnavailableReason,
                Localizer["Tenants.Members.UnavailableReason.AggregateLocked"].Value, StringComparison.Ordinal);

    private bool IsOwnedCommandInFlight
        => (_retainedAttempt is not null && !TenantCommandAttemptTracker.IsTerminal(_snapshot))
            || TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State, _isSubmitting);

    private bool CanRefresh
        => !string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
        && _snapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded;

    private bool CanContinueReadOnly
        => (!_isSubmitting || _snapshot.State is TenantCommandLifecycleState.UnableToVerify && _snapshot.ProjectionWaitExpired)
            && _retainedAttempt?.DeliveryInFlight is not true
            && (_snapshot.State is TenantCommandLifecycleState.UnableToVerify or TenantCommandLifecycleState.Degraded
                || TenantCommandAttemptTracker.IsTerminal(_snapshot));

    private string? DisplaySafeMessage
        => !string.IsNullOrWhiteSpace(_snapshot.SafeMessageKey)
            ? Localizer[_snapshot.SafeMessageKey].Value
            : _snapshot.SafeMessage;

    private bool OwnerRiskVisible
        => Member.Role is TenantRole.TenantOwner
        && OwnerCount <= 1
        && TryParseAssignableRole(_roleValue, out TenantRole role)
        && role is not TenantRole.TenantOwner;

    private ITenantCommandGateway? CommandGateway
        => Services.GetService<ITenantCommandGateway>();

    private string StateClass
        => $"tenants-change-role-flow__state tenants-change-role-flow__state--{_snapshot.State.ToString().ToLowerInvariant()}";

    private string StateSymbol
        => _snapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed or TenantCommandLifecycleState.AlreadyApplied => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            _ => ">",
        };

    private string StateText
        => Localizer[$"Tenants.ChangeRole.State.{_snapshot.State}"];

    // The entry point names the audit state with the shared availability label, never a flow-local duplicate.
    private string AuditStateLabel
        => TenantAuditAvailability.StateLabelKeyFor(_snapshot.AuditState) is { } key ? Localizer[key] : string.Empty;

    // Refresh is offered only while the attempt can actually be re-queried; a no-op control would only
    // exhaust the retry bound behind a misleading limit note.
    private bool CanRequeryAudit
        => !string.IsNullOrWhiteSpace(_snapshot.MessageId) && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId);

    // No fragment at all when audit read is denied, so the shared control renders no empty Inspect-audit shell.
    private RenderFragment? CommandAuditEntryPoint
        => AuditReadDenied ? null : CommandAuditEntryPointTemplate;

    private RenderFragment CommandAuditEntryPointTemplate
        => @<AuditEvidenceEntryPoint TenantId="@Detail.TenantId"
                                     TargetUserId="@Member.UserId"
                                     SourceKind="command-result"
                                     SourceTestId="tenants-command-audit-entrypoint"
                                     Label="@Localizer["Tenants.Audit.Availability.Action.InspectAudit"]"
                                     AccessibleName="@Localizer["Tenants.Audit.EntryPoint.Accessible.Command", AuditStateLabel, Detail.TenantId]"
                                     ReturnUrl="@CommandAuditReturnUrl"
                                     ReturnFocus="tenants-change-role-lifecycle"
                                     AuthorityPending="@AuditReadPending"
                                     UnavailableReason="@AuditReadUnavailableReason"
                                     IsAvailable="@AuditReadAvailable" />;

    // The shared control's Refresh can resolve the audit state to NotStarted, which unmounts the control and its
    // focused Refresh button; focus then moves to the lifecycle section instead of falling back to the document body.
    private async Task RefreshFromAuditControlAsync()
    {
        await RefreshStatusAsync().ConfigureAwait(false);
        await InvokeAsync(() =>
        {
            if (!ShouldRenderAuditEntryPoint)
            {
                _focusLifecyclePending = true;
            }
        }).ConfigureAwait(false);
    }

    private bool ShouldRenderAuditEntryPoint
        => _snapshot.AuditState is not TenantCommandAuditState.NotStarted;

    private string? CommandAuditReturnUrl => DetailAuditReturnUrl;

    private string LiveRegionMode
        => _snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string RoleDescribedBy
    {
        get
        {
            List<string> ids = ["tenants-change-role-new-role-help"];
            if (OwnerRiskVisible)
            {
                ids.Add("tenants-change-role-risk");
            }

            if (!string.IsNullOrWhiteSpace(UnavailableReason))
            {
                ids.Add("tenants-change-role-unavailable");
            }

            if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                ids.Add("tenants-change-role-validation");
            }

            return string.Join(" ", ids);
        }
    }

    protected override void OnInitialized()
    {
        TenantCommandAttemptTracker? attempts = Services.GetService<TenantAggregateCommandAdmissionGate>() is null ? null : Services.GetService<TenantCommandAttemptTracker>();
        if (attempts is not null)
        {
            attempts.StateChanged += OnRetainedAttemptChanged;
        }
    }

    protected override void OnParametersSet()
    {
        ObserveAdmissionParameters();
        RestoreRetainedAttempt();
        if (string.IsNullOrEmpty(_roleValue) || !AssignableRoles.Any(role => string.Equals(_roleValue, role.ToString(), StringComparison.Ordinal)))
        {
            _roleValue = Member.Role is TenantRole.Unknown ? TenantRole.TenantReader.ToString() : Member.Role.ToString();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRolePending)
        {
            _focusRolePending = false;
            await _roleElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusLifecyclePending)
        {
            _focusLifecyclePending = false;
            await _lifecycleElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private void SetSnapshot(TenantChangeRoleCommandSnapshot snapshot)
    {
        if (_retainedAttempt is { } attempt && !Attempts.TryUpdate(attempt, _snapshot, snapshot))
        {
            return;
        }

        _snapshot = snapshot;
        SynchronizeRetainedAttempt();
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _snapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle)
        {
            _focusLifecyclePending = true;
        }
    }

    // A first attempt refused before dispatch sent nothing. A refused retry keeps the failed attempt it retried:
    // that identity may already have reached the server, so its status stays unknown and the next submit must
    // reuse it. The Blocked() factory builds a fresh record and would drop it, minting a new ULID next time.
    private static TenantChangeRoleCommandSnapshot RefuseDispatch(
        string reason,
        TenantChangeRoleCommandSnapshot retriedAttempt,
        string? retryMessageId)
        => retryMessageId is null
            ? TenantChangeRoleCommandSnapshot.Blocked(reason, TenantCommandFocusTarget.Submit)
            : retriedAttempt with
            {
                SafeMessage = reason,
                SafeMessageKey = null,
                AuditState = TenantCommandAuditStates.Unverifiable,
                FocusTarget = TenantCommandFocusTarget.Submit,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            };

    private async Task<bool> SetCommandActivityRaisedAsync(bool isActive)
    {
        if (_disposed)
        {
            return !isActive;
        }
        if (isActive && _retainedAttempt is null)
        {
            _attemptMemberUserId = Member.UserId;
        }
        if (isActive && _retainedAttempt is null
            && !Attempts.TryBegin(Detail.TenantId, this, _snapshot, out _retainedAttempt))
        {
            return false;
        }
        if (_hasRaisedCommandActivity == isActive)
        {
            return true;
        }

        int generation = _attemptGeneration;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        TenantCommandAttemptTracker tracker = Attempts;
        bool accepted;
        try
        {
            if (CommandActivityLease is { } lease)
            {
                accepted = await lease(isActive).ConfigureAwait(false);
            }
            else
            {
                await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
                accepted = true;
            }
        }
        catch (Exception)
        {
            if (!isActive)
            {
                throw;
            }
            tracker.Detach(attempt, this);
            if (!_disposed && generation == _attemptGeneration && ReferenceEquals(_retainedAttempt, attempt))
            {
                _retainedAttempt = null;
            }
            return false;
        }
        if (_disposed || generation != _attemptGeneration || !ReferenceEquals(_retainedAttempt, attempt))
        {
            return !isActive;
        }
        if (isActive && !accepted)
        {
            tracker.Detach(attempt, this);
            _retainedAttempt = null;
            return false;
        }
        _hasRaisedCommandActivity = isActive;
        return true;
    }

    private async Task UpdateCommandActivityForSnapshotAsync()
        => _ = await SetCommandActivityRaisedAsync(IsOwnedCommandInFlight).ConfigureAwait(false);

    internal void ApplySignalRNudge()
        => SetSnapshot(_snapshot.SignalRNudge());

    /// <summary>
    /// SignalR / read-refresh path: nudge lifecycle, then re-query authoritative status/evidence.
    /// Does not confirm from the notification alone.
    /// </summary>
    internal async Task HandleAuthoritativeRefreshNudgeAsync()
    {
        ApplySignalRNudge();
        if (_isProjectionRefreshCallback.Value
            || (_isSubmitting && _snapshot.State is TenantCommandLifecycleState.RequestSent))
        {
            return;
        }

        await RefreshCommandStatusAsync(requestProjectionRefresh: false, waitForRunningRefresh: false).ConfigureAwait(false);
    }

    internal void ApplyProjectionEvidence(TenantDetailSnapshot? detail)
        => SetSnapshot(_snapshot.ConfirmProjection(detail));

    private string? ResolveCurrentProjectionVersion()
        => ProjectionVersionProvider?.Invoke() ?? ProjectionVersion;

    private string RoleLabel(TenantRole role)
        => Localizer[$"Tenants.ChangeRole.Role.{role}"];

    private void OnRoleChanged(string? value)
    {
        InvalidateAdmission();
        _roleValue = value ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        SynchronizeRetainedAttempt();
        if (_disposed || _isSubmitting || _authorityResolutionInProgress)
        {
            return;
        }
        string submittedRoleValue = _roleValue;
        TenantChangeRoleCommandSnapshot initialEvidence = _snapshot;
        TenantRetainedCommandAttempt? initialAttempt = _retainedAttempt;
        int initialAttemptGeneration = _attemptGeneration;
        long admissionGeneration = _admissionGeneration;
        if (!await ReauthorizeInitialAdmissionAsync(admissionGeneration).ConfigureAwait(false))
        {
            if (!_disposed && admissionGeneration == Volatile.Read(ref _admissionGeneration)
                && initialAttemptGeneration == _attemptGeneration && ReferenceEquals(initialAttempt, _retainedAttempt)
                && TenantCommandAttemptTracker.HasSameEvidence(initialEvidence, _snapshot))
            {
                RefuseAuthorityAdmission();
            }
            return;
        }
        if (_disposed || initialAttemptGeneration != _attemptGeneration
            || !ReferenceEquals(initialAttempt, _retainedAttempt)
            || !TenantCommandAttemptTracker.HasSameEvidence(initialEvidence, _snapshot))
        {
            return;
        }

        _readOnlyDetached = false;
        RestoreRetainedAttempt();
        _roleValue = submittedRoleValue;

        if (CanRetryDelivery)
        {
            if (!(TryParseAssignableRole(_roleValue, out TenantRole retryRole)
                && _snapshot.Intent == new ChangeUserRole(Detail.TenantId, Member.UserId, retryRole)))
            {
                SetSnapshot(_snapshot with
                {
                    SafeMessage = Localizer["Tenants.ChangeRole.Unavailable.InFlight"].Value,
                    SafeMessageKey = null,
                    FocusTarget = TenantCommandFocusTarget.Submit,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
                return;
            }
            await RetryDeliveryAsync().ConfigureAwait(false);
            return;
        }
        _validationMessage = null;

        if (!_isSubmitting && IsOwnedCommandInFlight)
        {
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            SetSnapshot(_snapshot with { SafeMessage = Localizer["Tenants.ChangeRole.Unavailable.InFlight"].Value, FocusTarget = TenantCommandFocusTarget.Refresh });
            return;
        }

        if (_snapshot.State is TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded)
        {
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            // Tracking is gone, so this attempt can neither be re-queried nor safely re-dispatched. Say so:
            // returning silently left the enabled submit button doing nothing at all -- no state change, no
            // message, no announcement -- which reads as a broken control rather than a safety stop.
            SetSnapshot(_snapshot with
            {
                SafeMessage = null,
                SafeMessageKey = "Tenants.Members.Submit.TrackingLost",
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            });
            return;
        }

        if (!string.IsNullOrWhiteSpace(UnavailableReason))
        {
            SetSnapshot(TenantChangeRoleCommandSnapshot.Blocked(UnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        if (!TryParseAssignableRole(_roleValue, out TenantRole newRole))
        {
            _validationMessage = Localizer["Tenants.ChangeRole.Validation.RoleRequired"];
            _focusRolePending = true;
            return;
        }

        var request = new ChangeUserRole(Detail.TenantId, Member.UserId, newRole);
        if (Member.Role == newRole)
        {
            SetSnapshot(_snapshot.AlreadyApplied(
                request,
                Member.Role,
                OwnerCount,
                Localizer["Tenants.ChangeRole.AlreadyApplied.Message", Member.UserId, RoleLabel(newRole)].Value));
            return;
        }

        string? retryMessageId = _snapshot.State is TenantCommandLifecycleState.Failed
            && string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
            && !string.IsNullOrWhiteSpace(_snapshot.MessageId)
            && Equals(_snapshot.Intent, request)
                ? _snapshot.MessageId
                : null;
        TenantChangeRoleCommandSnapshot retriedAttempt = _snapshot;
        Attempts.Detach(_retainedAttempt, this);
        _retainedAttempt = null;
        _attemptGeneration++;
        _snapshot = TenantChangeRoleCommandSnapshot.Idle().RequestSent(
            request,
            Member.Role,
            OwnerCount,
            ResolveCurrentProjectionVersion(),
            baselinePostconditionMet: Member.Role == newRole) with
        {
            MessageId = retryMessageId ?? Services.GetService<Hexalith.FrontComposer.Contracts.Lifecycle.IUlidFactory>()?.NewUlid()
                ?? NUlid.Ulid.NewUlid().ToString(),
            CorrelationId = null,
        };

        int submitGeneration = _attemptGeneration;
        _isSubmitting = true;
        bool admitted = await SetCommandActivityRaisedAsync(true).ConfigureAwait(false);
        if (_disposed || submitGeneration != _attemptGeneration)
        {
            return;
        }
        bool authorityAdmitted = admitted && await ReauthorizeAdmissionAsync(admissionGeneration).ConfigureAwait(false);
        if (_disposed || submitGeneration != _attemptGeneration)
        {
            return;
        }
        string? eligibilityReason = authorityAdmitted ? EligibilityUnavailableReason : AuthorizationUnavailableReason;
        if (admitted && (eligibilityReason is not null))
        {
            Attempts.Detach(_retainedAttempt, this);
            _retainedAttempt = null;
            _isSubmitting = false;
            _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
            if (_disposed || submitGeneration != _attemptGeneration)
            {
                return;
            }
            SetSnapshot(RefuseDispatch(eligibilityReason!, retriedAttempt, retryMessageId));
            return;
        }
        if (!admitted)
        {
            _isSubmitting = false;
            SetSnapshot(RefuseDispatch(
                CommandSurfaceUnavailableReason ?? Localizer["Tenants.ChangeRole.Unavailable.InFlight"].Value,
                retriedAttempt,
                retryMessageId));
            return;
        }

        try
        {
            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                Attempts.Detach(_retainedAttempt, this);
                _retainedAttempt = null;
                SetSnapshot(RefuseDispatch(
                    Localizer["Tenants.ChangeRole.Unavailable.CommandSurface"].Value,
                    retriedAttempt,
                    retryMessageId));
                return;
            }

            TenantChangeRoleCommandSnapshot expected = _snapshot;
            TenantRetainedCommandAttempt? attempt = _retainedAttempt;
            int generation = _attemptGeneration;
            if (attempt is null || !Attempts.TryStartDelivery(attempt, this))
            {
                return;
            }
            TenantCommandSubmissionResult result;
            try
            {
                result = await gateway.ChangeUserRoleAsync(request, expected.MessageId, CancellationToken.None).ConfigureAwait(false);
            }
            catch (Exception)
            {
                result = TenantCommandSubmissionResult.Failed(Localizer["Tenants.ChangeRole.Unavailable.CommandSurface"].Value)
                    with { MessageId = expected.MessageId, IsAmbiguousFailure = true };
            }
            TenantChangeRoleCommandSnapshot completion = result.State is TenantCommandLifecycleState.Accepted
                ? expected.Accepted(result)
                : expected with
                {
                    State = result.IsAmbiguousFailure ? TenantCommandLifecycleState.RequestSent : result.State,
                    MessageId = result.MessageId ?? expected.MessageId,
                    CorrelationId = result.CorrelationId ?? expected.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = result.SafeMessageKey,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result, retryMessageId),
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            if (PublishResult(attempt, generation, expected, completion, delivery: true)
                && completion.CorrelationId is not null && !TenantCommandAttemptTracker.IsTerminal(completion))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed && submitGeneration == _attemptGeneration)
            {
                _isSubmitting = false;
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
        }
    }

    private async Task RetryDeliveryAsync()
    {
        if (_disposed || _authorityResolutionInProgress)
        {
            return;
        }
        TenantChangeRoleCommandSnapshot expected = _snapshot;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        int generation = _attemptGeneration;
        long admissionGeneration = _admissionGeneration;
        if (!await ReauthorizeInitialAdmissionAsync(admissionGeneration).ConfigureAwait(false))
        {
            if (!_disposed && admissionGeneration == Volatile.Read(ref _admissionGeneration))
            {
                RefuseAuthorityAdmission();
            }
            return;
        }
        ITenantCommandGateway? gateway = CommandGateway;
        if (_disposed || generation != _attemptGeneration || !ReferenceEquals(attempt, _retainedAttempt)
            || !TenantCommandAttemptTracker.HasSameEvidence(expected, _snapshot) || !CanRetryDelivery
            || _isSubmitting || expected.Intent is null || attempt is null || gateway is null
            || !string.IsNullOrWhiteSpace(UnavailableReason)
            || !Attempts.TryStartDelivery(attempt, this))
        {
            return;
        }
        _isSubmitting = true;
        try
        {
            TenantCommandSubmissionResult result;
            try
            {
                result = await gateway.ChangeUserRoleAsync(expected.Intent, expected.MessageId, CancellationToken.None).ConfigureAwait(false);
            }
            catch (Exception)
            {
                result = TenantCommandSubmissionResult.Failed(Localizer["Tenants.ChangeRole.Unavailable.CommandSurface"].Value)
                    with { MessageId = expected.MessageId, IsAmbiguousFailure = true };
            }
            TenantChangeRoleCommandSnapshot completion = result.State is TenantCommandLifecycleState.Accepted
                ? expected.Accepted(result)
                : expected with
                {
                    State = result.IsAmbiguousFailure ? TenantCommandLifecycleState.RequestSent : result.State,
                    MessageId = result.MessageId ?? expected.MessageId,
                    CorrelationId = result.CorrelationId ?? expected.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = result.SafeMessageKey,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result, expected.MessageId),
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            if (PublishResult(attempt, generation, expected, completion, delivery: true)
                && completion.CorrelationId is not null && !TenantCommandAttemptTracker.IsTerminal(completion))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed && generation == _attemptGeneration)
            {
                _isSubmitting = false;
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
        }
    }

    private Task RefreshStatusAsync()
        => RefreshCommandStatusAsync(requestProjectionRefresh: true);

    private async Task RefreshCommandStatusAsync(bool requestProjectionRefresh, bool waitForRunningRefresh = true)
    {
        SynchronizeRetainedAttempt();
        TaskCompletionSource completion;
        bool ownsRefresh;
        lock (_refreshLock)
        {
            if (_disposed || TenantCommandAttemptTracker.IsTerminal(_snapshot))
            {
                return;
            }

            // A replacement attempt may enqueue while an older generation still owns the drain.
            // Keep only requests for the current attempt, without making it wait for another user action.
            if (_refreshPendingGeneration != _attemptGeneration)
            {
                _refreshPending = 0;
                _refreshPendingGeneration = _attemptGeneration;
            }
            // Work and projection intent form one batch. A status-only nudge cannot clear a manual request.
            _refreshPending |= requestProjectionRefresh ? 3 : 1;
            ownsRefresh = _refreshCompletion is null;
            completion = _refreshCompletion ??= new(TaskCreationOptions.RunContinuationsAsynchronously);
        }

        if (!ownsRefresh)
        {
            // Manual recovery waits for the owner and its queued batches; notification nudges never wait.
            if (waitForRunningRefresh)
            {
                await completion.Task.ConfigureAwait(false);
            }
            return;
        }

        Exception? failure = null;
        try
        {
            while (true)
            {
                int pending;
                lock (_refreshLock)
                {
                    pending = _refreshPending;
                    _refreshPending = 0;
                    if (_disposed || TenantCommandAttemptTracker.IsTerminal(_snapshot) || pending == 0)
                    {
                        // Enqueue and idle handoff share the lock: there is no release-window replay to lose.
                        _refreshCompletion = null;
                        break;
                    }
                    if (_refreshPendingGeneration != _attemptGeneration)
                    {
                        continue;
                    }
                }

                try
                {
                    await RefreshCommandStatusCoreAsync((pending & 2) != 0).ConfigureAwait(false);
                }
                catch (Exception exception)
                {
                    // The failed batch is consumed, never automatically retried. Explicit requests queued
                    // during it still run; all waiting callers observe the failure after the drain retires.
                    failure ??= exception;
                }
            }
        }
        finally
        {
            lock (_refreshLock)
            {
                if (ReferenceEquals(_refreshCompletion, completion))
                {
                    _refreshCompletion = null;
                }
            }
            if (failure is null)
            {
                completion.TrySetResult();
            }
            else
            {
                completion.TrySetException(failure);
            }
        }
        await completion.Task.ConfigureAwait(false);
    }

    private async Task RefreshCommandStatusCoreAsync(bool requestProjectionRefresh)
    {
        if (_disposed || TenantCommandAttemptTracker.IsTerminal(_snapshot))
        {
            return;
        }
        // Delivery ambiguity has a reusable message id but no status correlation. A nudge cannot
        // turn that recovery basis into a status lookup or a different attempt.
        if (_snapshot.State is TenantCommandLifecycleState.RequestSent && _snapshot.MessageId is not null
            && _snapshot.CorrelationId is null && _retainedAttempt?.Lease.IsDispatchMarked is true)
        {
            return;
        }
        int generation = _attemptGeneration;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        TenantChangeRoleCommandSnapshot expected = _snapshot;
        if (string.IsNullOrWhiteSpace(_snapshot.MessageId) || string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
        {
            if (TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State)
                || _snapshot.State is TenantCommandLifecycleState.UnableToVerify
                    or TenantCommandLifecycleState.Degraded)
            {
                SetSnapshot(_snapshot with
                {
                    State = TenantCommandLifecycleState.UnableToVerify,
                    SafeMessage = Localizer["Tenants.ChangeRole.Unavailable.CommandSurface"].Value,
                    SafeMessageKey = null,
                    AuditState = TenantCommandAuditStates.Unverifiable,
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }

            return;
        }

        ITenantCommandGateway? gateway = CommandGateway;
        if (gateway is null)
        {
            SetSnapshot(_snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(Localizer["Tenants.ChangeRole.Unavailable.CommandSurface"].Value)));
            await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            return;
        }

        TenantCommandStatusResult status = await gateway
            .GetStatusAsync(new TenantCommandTrackingHandle(_snapshot.MessageId, _snapshot.CorrelationId, _snapshot.Intent?.TenantId) { ExpectedDomain = TenantIdentity.Domain }, CancellationToken.None)
            .ConfigureAwait(false);
        if (!PublishResult(attempt, generation, expected, expected.ApplyStatus(status)))
        {
            return;
        }
        expected = _snapshot;

        if (!IsCurrentContinuation(generation, expected))
        {
            return;
        }
        if (requestProjectionRefresh)
        {
            _isProjectionRefreshCallback.Value = true;
            try
            {
                await InvokeAsync(() => OnProjectionRefreshRequested.InvokeAsync()).ConfigureAwait(false);
            }
            finally
            {
                _isProjectionRefreshCallback.Value = false;
            }
        }

        if (!IsCurrentContinuation(generation, expected))
        {
            return;
        }
        if (expected.Intent is not null && ProjectionEvidenceProvider is not null)
        {
            TenantDetailSnapshot? evidence = await ProjectionEvidenceProvider(expected.Intent).ConfigureAwait(false);
            if (!PublishResult(attempt, generation, expected, expected.ConfirmProjection(evidence)))
            {
                return;
            }
        }

        await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
    }

    private async Task ContinueReadOnlyAsync()
    {
        if (!CanContinueReadOnly || _disposed)
        {
            return;
        }
        _readOnlyDetached = true;
        _isSubmitting = false;
        Attempts.Detach(_retainedAttempt, this);
        _retainedAttempt = null;
        _attemptGeneration++;
        SetSnapshot(TenantChangeRoleCommandSnapshot.Idle());

        // The polite Idle snapshot unmounts the shared control and the button that had focus, so focus moves to
        // the lifecycle section instead of falling back to the document body.
        _focusLifecyclePending = true;
        _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
    }

    private async Task CloseAsync()
    {
        if (IsOwnedCommandInFlight)
        {
            // Returning silently left a dead control: Cancel is disabled, Submit is disabled and
            // CanContinueReadOnly is false for RequestSent/Accepted/ProjectionPending, so Escape was the only
            // remaining exit and it did nothing at all. Say so assertively and point at the one named
            // recovery that is still live, matching the remove flow's blocked-dismissal behaviour.
            SetSnapshot(_snapshot with
            {
                SafeMessage = null,
                SafeMessageKey = "Tenants.ChangeRole.Dismiss.Blocked",
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                FocusTarget = TenantCommandFocusTarget.Refresh,
            });
            return;
        }

        InvalidateAdmission();
        _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
        await InvokeAsync(() => OnCloseRequested.InvokeAsync()).ConfigureAwait(false);
    }

    private static bool TryParseAssignableRole(string value, out TenantRole role)
    {
        if (Enum.TryParse(value, ignoreCase: false, out role)
            && AssignableRoles.Contains(role))
        {
            return true;
        }

        role = TenantRole.Unknown;
        return false;
    }
    public void Dispose()
    {
        _disposed = true;
        InvalidateAdmission();
        TenantCommandAttemptTracker? attempts = Services.GetService<TenantAggregateCommandAdmissionGate>() is null ? null : Services.GetService<TenantCommandAttemptTracker>();
        if (attempts is not null)
        {
            attempts.StateChanged -= OnRetainedAttemptChanged;
        }
        _attemptGeneration++;
        attempts?.Detach(_retainedAttempt, this);
    }
}
