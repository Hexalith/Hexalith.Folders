@using Hexalith.Tenants.Contracts.Identity
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State.TenantAudit
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.Tenants.UI.State.TenantList
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services
@implements IDisposable

<section class="tenants-edit-metadata"
         data-testid="tenants-edit-metadata-flow"
         aria-labelledby="tenants-edit-metadata-heading"
         @onkeydown="HandleKeyDownAsync">
    <header class="tenants-edit-metadata__header">
        <div>
            <h2 id="tenants-edit-metadata-heading">@Localizer["Tenants.EditMetadata.Title"]</h2>
            <p>@Localizer["Tenants.EditMetadata.Description", Detail.TenantId]</p>
        </div>
        @if (CanOpen)
        {
            <span class="tenants-edit-metadata__open-focus" tabindex="-1" @ref="_openElement">
                <FluentButton Appearance="ButtonAppearance.Primary"
                              data-testid="tenants-edit-metadata-open"
                              aria-controls="tenants-edit-metadata-editor"
                              OnClick="OpenEditorAsync">
                    @Localizer["Tenants.EditMetadata.Open"]
                </FluentButton>
            </span>
        }
    </header>

    <dl class="tenants-edit-metadata__confirmed"
        data-testid="tenants-edit-metadata-confirmed">
        <div>
            <dt>@Localizer["Tenants.EditMetadata.ConfirmedName.Label"]</dt>
            <dd>@ConfirmedName</dd>
        </div>
        <div>
            <dt>@Localizer["Tenants.EditMetadata.ConfirmedDescription.Label"]</dt>
            <dd>@ConfirmedDescriptionText</dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(UnavailableReason))
    {
        <p class="tenants-edit-metadata__unavailable"
           id="tenants-edit-metadata-unavailable"
           data-testid="tenants-edit-metadata-unavailable-reason"
           role="alert">
            @UnavailableReason
        </p>
    }

    @if (_isOpen)
    {
        <EditForm Model="@_formModel"
                  FormName="tenants-edit-metadata-editor"
                  id="tenants-edit-metadata-editor"
                  class="tenants-edit-metadata__form"
                  OnSubmit="SubmitAsync">
            <div class="tenants-edit-metadata__field">
                <FluentTextInput Id="tenants-edit-metadata-name"
                                 @ref="_nameElement"
                                 name="tenant-name"
                                 Label="@Localizer["Tenants.EditMetadata.Name.Label"]"
                                 Value="@_name"
                                 ValueChanged="OnNameInput"
                                 data-testid="tenants-edit-metadata-name"
                                 aria-describedby="@NameDescribedBy" />
                <span id="tenants-edit-metadata-name-help">@Localizer["Tenants.EditMetadata.Name.Help"]</span>
            </div>

            <div class="tenants-edit-metadata__field">
                <FluentTextArea Id="tenants-edit-metadata-description"
                                @ref="_descriptionElement"
                                name="tenant-description"
                                Label="@Localizer["Tenants.EditMetadata.Description.Label"]"
                                Value="@_description"
                                ValueChanged="OnDescriptionInput"
                                data-testid="tenants-edit-metadata-description"
                                aria-describedby="@DescriptionDescribedBy" />
                <span id="tenants-edit-metadata-description-help">@Localizer["Tenants.EditMetadata.Description.Help"]</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <p id="tenants-edit-metadata-validation"
                   class="tenants-edit-metadata__validation"
                   data-testid="tenants-edit-metadata-validation"
                   role="alert">
                    @_validationMessage
                </p>
            }

            <div class="tenants-edit-metadata__actions">
                <FluentButton Type="ButtonType.Submit"
                              Appearance="ButtonAppearance.Primary"
                              data-testid="tenants-edit-metadata-submit"
                              Disabled="@IsSubmitDisabled">
                    @Localizer["Tenants.EditMetadata.Submit"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-edit-metadata-refresh"
                              Disabled="@(!CanRefresh)"
                              OnClick="RefreshStatusAsync">
                    @Localizer["Tenants.EditMetadata.Refresh"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-edit-metadata-cancel"
                              OnClick="CloseEditorAsync">
                    @Localizer["Tenants.EditMetadata.Cancel"]
                </FluentButton>
            </div>
        </EditForm>
    }

    <section class="tenants-edit-metadata__lifecycle"
             @ref="_lifecycleElement"
             tabindex="-1"
             id="tenants-edit-metadata-lifecycle" data-testid="tenants-edit-metadata-lifecycle"
             aria-labelledby="tenants-edit-metadata-state-label">
        <h3 id="tenants-edit-metadata-state-label">@Localizer["Tenants.EditMetadata.Lifecycle.Title"]</h3>
        <p class="@StateClass" data-testid="tenants-edit-metadata-state">
            <span aria-hidden="true">@StateSymbol</span>
            <span>@StateText</span>
        </p>
        <div data-testid="tenants-edit-metadata-audit">
            @if (ShouldRenderAuditEntryPoint)
            {
                <AuditAvailabilityState AuditState="@_snapshot.AuditState"
                                        Source="edit-metadata"
                                        OwnerRefreshIncludesAuditAuthority="true"
                                        OnRefresh="@(CanRequeryAudit ? EventCallback.Factory.Create(this, RefreshFromAuditControlAsync) : default(EventCallback))"
                                        OnContinueReadOnly="@(CanContinueReadOnly ? EventCallback.Factory.Create(this, CloseEditorAsync) : default(EventCallback))"
                                        InspectAuditAction="@CommandAuditEntryPoint" />
            }
        </div>
        <p data-testid="tenants-edit-metadata-recovery">@RecoveryText</p>
        @if (!string.IsNullOrWhiteSpace(SafeMessageText))
        {
            <p data-testid="tenants-edit-metadata-safe-message">@SafeMessageText</p>
        }
        <p class="tenants-edit-metadata__live"
           data-testid="tenants-edit-metadata-live-region"
           aria-live="@LiveRegionMode"
           aria-atomic="true">
            @StateText
        </p>
    </section>
</section>

@code {
    [CascadingParameter(Name = "CurrentTenantCallerScope")]
    public string? CurrentCallerScope { get; set; }

    private bool _adoptedReadEvidence;

    [CascadingParameter(Name = "AuditReadAvailable")]
    public bool AuditReadAvailable { get; set; }

    [CascadingParameter(Name = "AuditReadPending")]
    public bool AuditReadPending { get; set; }

    [CascadingParameter(Name = "AuditReadDenied")]
    public bool AuditReadDenied { get; set; }

    [CascadingParameter(Name = "AuditReadUnavailableReason")]
    public string? AuditReadUnavailableReason { get; set; }

    [CascadingParameter(Name = "DetailAuditReturnUrl")]
    public string? DetailAuditReturnUrl { get; set; }

    private TenantRetainedCommandAttempt? _retainedAttempt;
    private int _attemptGeneration;
    private bool _readOnlyDetached;
    private bool _disposed;
    private readonly object _formModel = new();
    private TenantUpdateMetadataCommandSnapshot _snapshot = TenantUpdateMetadataCommandSnapshot.Idle();
    private string? _name;
    private string? _description;
    private string? _validationMessage;
    private bool _isOpen;
    private bool _isSubmitting;
    private bool _isRefreshing;
    private TaskCompletionSource? _refreshCompletion;
    private bool _hasRaisedCommandActivity;
    private ElementReference _openElement;
    private FluentTextInput _nameElement = default!;
    private FluentTextArea _descriptionElement = default!;
    private ElementReference _lifecycleElement;
    private bool _focusOpenPending;
    private bool _focusNamePending;
    private bool _focusLifecyclePending;

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    [Parameter]
    public bool IsAuthorized { get; set; }

    /// <summary>Gets or sets the current live authority reflection.</summary>
    [Parameter]
    public TenantLifecycleAuthorizationReflectionState AuthorizationReflection { get; set; }
        = TenantLifecycleAuthorizationReflectionState.Indeterminate;

    /// <summary>Gets or sets the current authority and evidence revision.</summary>
    [Parameter]
    public long AuthorizationVersion { get; set; }

    /// <summary>Gets or sets the fresh current-caller authority resolver used before dispatch and retry.</summary>
    [Parameter]
    public Func<CancellationToken, Task<TenantLifecycleAuthorizationReflectionState>>? AuthorizationReflectionProvider { get; set; }

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public string? CommandSurfaceUnavailableReason { get; set; }


    [Parameter]
    public string? ProjectionVersion { get; set; }

    /// <summary>
    /// Optional live reader for the parent detail snapshot's projection version.
    /// Prefer this during confirmation so refresh can observe the post-requery version before the next render.
    /// </summary>
    [Parameter]
    public Func<string?>? ProjectionVersionProvider { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    /// <summary>
    /// Gets or sets the aggregate command-activity lease. Returns false when the parent refuses the
    /// acquisition because another surface holds the tenant aggregate, which must abort the dispatch.
    /// </summary>
    [Parameter]
    public Func<bool, Task<bool>>? CommandActivityLease { get; set; }

    [Parameter]
    public Func<UpdateTenant, Task<TenantDetailSnapshot?>>? ProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<UpdateTenant, string?, DateTimeOffset?, Task<TenantAuditRow?>>? AuditEvidenceProvider { get; set; }


    private long _admissionGeneration;
    private bool _authorityResolutionInProgress;
    private readonly Lock _authorityCancellationLock = new();
    private CancellationTokenSource? _authorityCancellation;
    private object? _admissionParameters;
    private TenantLifecycleAuthorizationReflectionState? _submissionAuthority;

    private string AuthorizationUnavailableReason
        => Localizer[_submissionAuthority is TenantLifecycleAuthorizationReflectionState.MissingPermission
            || AuthorizationReflection is TenantLifecycleAuthorizationReflectionState.MissingPermission
            || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
                ? "Tenants.EditMetadata.Unavailable.Authorization"
                : "Tenants.Mutation.Unavailable.AuthorityIndeterminate"].Value;

    private void ObserveAdmissionParameters()
    {
        object current = (Detail, CurrentCallerScope, IsAuthorized, AuthorizationReflection, AuthorizationVersion, SurfaceKind, Freshness, Lifecycle, ProjectionVersion, AuthorizationReflectionProvider);
        if (!Equals(current, _admissionParameters))
        {
            _admissionParameters = current;
            InvalidateAdmission();
            _submissionAuthority = null;
        }
    }

    private void InvalidateAdmission()
    {
        Interlocked.Increment(ref _admissionGeneration);
        lock (_authorityCancellationLock)
        {
            _authorityCancellation?.Cancel();
        }
    }

    private async Task<bool> ReauthorizeInitialAdmissionAsync(long generation)
    {
        _authorityResolutionInProgress = true;
        try
        {
            return await ReauthorizeAdmissionAsync(generation).ConfigureAwait(false);
        }
        finally
        {
            _authorityResolutionInProgress = false;
        }
    }

    private async Task<bool> ReauthorizeAdmissionAsync(long generation)
    {
        TenantLifecycleAuthorizationReflectionState authority = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        // Bound admission independently of provider cooperation; cancellation never cancels dispatched work.
        using var source = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        lock (_authorityCancellationLock)
        {
            _authorityCancellation?.Cancel();
            _authorityCancellation = source;
        }
        try
        {
            if (AuthorizationReflectionProvider is { } provider)
            {
                authority = await provider(source.Token).WaitAsync(source.Token).ConfigureAwait(false);
                source.Token.ThrowIfCancellationRequested();
            }
        }
        catch (Exception)
        {
            // Missing, cancelled or faulted current authority never permits a dispatch.
            authority = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        finally
        {
            lock (_authorityCancellationLock)
            {
                if (ReferenceEquals(_authorityCancellation, source))
                {
                    _authorityCancellation = null;
                }
            }
        }

        if (_disposed || generation != Volatile.Read(ref _admissionGeneration))
        {
            return false;
        }
        _submissionAuthority = authority;
        return !_disposed && generation == _admissionGeneration && IsAuthorized
            && AuthorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized
            && authority is TenantLifecycleAuthorizationReflectionState.Authorized;
    }

    private void RefuseAuthorityAdmission()
        => SetSnapshot(_snapshot with
        {
            SafeMessage = EligibilityUnavailableReason ?? AuthorizationUnavailableReason,
            SafeMessageKey = null,
            FocusTarget = TenantCommandFocusTarget.Submit,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        });

    internal TenantUpdateMetadataCommandSnapshot Snapshot => _snapshot;

    private void SynchronizeRetainedAttempt()
    {
        if (_retainedAttempt is { } attempt
            && Attempts.TryRead<TenantUpdateMetadataCommandSnapshot>(attempt, this, out TenantUpdateMetadataCommandSnapshot? latest) && latest is not null)
        {
            _snapshot = latest;
        }
    }

    private void OnRetainedAttemptChanged(object? sender, EventArgs args)
    {
        if (_disposed || _retainedAttempt is null)
        {
            return;
        }
        _ = RenderRetainedAttemptAsync();
    }

    private async Task RenderRetainedAttemptAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    SynchronizeRetainedAttempt();
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
        }
    }


    private TenantCommandAttemptTracker Attempts
        => Services.GetRequiredService<TenantCommandAttemptTracker>();

    private bool CanRetryDelivery
        => !_isSubmitting && _snapshot.State is TenantCommandLifecycleState.RequestSent
            && _snapshot.MessageId is not null && _snapshot.CorrelationId is null
            && _retainedAttempt?.DeliveryInFlight is not true;

    private void RestoreRetainedAttempt()
    {
        if (_retainedAttempt is { } current && (!string.Equals(current.TenantId, Detail.TenantId, StringComparison.Ordinal)))
        {
            Attempts.Detach(current, this);
            _retainedAttempt = null;
            _attemptGeneration++;
            _hasRaisedCommandActivity = false;
            _isSubmitting = false;
            _snapshot = TenantUpdateMetadataCommandSnapshot.Idle();
        }
        if (_readOnlyDetached || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null || !IsAuthorized)
        {
            return;
        }
        SynchronizeRetainedAttempt();
        if (_retainedAttempt is null && Attempts.Find<TenantUpdateMetadataCommandSnapshot>(Detail.TenantId) is { } candidate
            && Attempts.TryAdopt<TenantUpdateMetadataCommandSnapshot>(Detail.TenantId, this, out TenantRetainedCommandAttempt? attempt, out TenantUpdateMetadataCommandSnapshot? retained)
            && retained is not null)
        {
            _retainedAttempt = attempt;
            _attemptGeneration++;
            _snapshot = retained;
            _adoptedReadEvidence = true;
            _name = retained.Intent?.Name;
            _description = retained.Intent?.Description;
            _isOpen = !TenantCommandAttemptTracker.IsTerminal(retained);
        }
    }

    private bool PublishResult(TenantRetainedCommandAttempt? attempt, int generation,
        TenantUpdateMetadataCommandSnapshot expected, TenantUpdateMetadataCommandSnapshot result, bool delivery = false)
    {
        bool retained = attempt is null || (delivery
            ? Attempts.TryCompleteDelivery(attempt, expected, result)
            : Attempts.TryUpdate(attempt, expected, result));
        if (!retained || _disposed || generation != _attemptGeneration
            || !ReferenceEquals(_retainedAttempt, attempt)
            || attempt is not null && !Attempts.IsAttached(attempt, this)
            || !delivery && !TenantCommandAttemptTracker.HasSameEvidence(_snapshot, expected) && !ReferenceEquals(_snapshot, result))
        {
            return false;
        }
        _snapshot = result;
        if (result.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || result.FocusTarget is TenantCommandFocusTarget.Lifecycle)
        {
            _focusLifecyclePending = true;
        }
        return true;
    }

    private bool IsCurrentContinuation(int generation, TenantUpdateMetadataCommandSnapshot expected)
        => !_disposed && generation == _attemptGeneration && TenantCommandAttemptTracker.HasSameEvidence(_snapshot, expected)
            && (_retainedAttempt is null || Attempts.IsAttached(_retainedAttempt, this));


    // Retained read facts belong to the caller that read them; command intent and tracking remain retained.
    private bool CanPresentConfirmedReadEvidence
        => !_adoptedReadEvidence && _snapshot.LastConfirmedCallerScope is null && CurrentCallerScope is null
            || !string.IsNullOrWhiteSpace(CurrentCallerScope)
                && string.Equals(_snapshot.LastConfirmedCallerScope, CurrentCallerScope, StringComparison.Ordinal);

    private string ConfirmedName
        => CanPresentConfirmedReadEvidence
            ? _snapshot.LastConfirmedDetailProjection?.Name ?? _snapshot.LastConfirmedName ?? Detail.Name
            : Detail.Name;

    private string? ConfirmedDescription
        => CanPresentConfirmedReadEvidence && _snapshot.LastConfirmedDetailProjection is { } projection
            ? projection.Description
            : Detail.Description;

    private string ConfirmedDescriptionText
        => string.IsNullOrWhiteSpace(ConfirmedDescription)
            ? Localizer["Tenants.EditMetadata.Description.Empty"]
            : ConfirmedDescription!;

    private string? EligibilityUnavailableReason
        => !IsAuthorized || AuthorizationReflection is not TenantLifecycleAuthorizationReflectionState.Authorized
            || _submissionAuthority is TenantLifecycleAuthorizationReflectionState.MissingPermission or TenantLifecycleAuthorizationReflectionState.Indeterminate
            || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
            ? AuthorizationUnavailableReason
            // Decision D-F: strict lifecycle gate retained, evaluated after the surface and freshness
            // clause so a failed read reports why it failed. See SetTenantConfigurationFlow.
            : SurfaceKind is TenantDetailSurfaceKind.Stale
                or TenantDetailSurfaceKind.Unavailable
                or TenantDetailSurfaceKind.Unknown
                or TenantDetailSurfaceKind.Degraded
                || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.EditMetadata.Unavailable.Freshness"].Value
            : Lifecycle is not ProjectionLifecycleState.Current
                ? Localizer["Tenants.EditMetadata.Unavailable.ProjectionLifecycle"].Value
                : Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown
                    ? Localizer["Tenants.EditMetadata.Unavailable.TenantLifecycle"].Value
                    : (!IsCommandSurfaceAvailable && !IsOwnAggregateAdmissionUnavailable) || CommandGateway is null || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null
                        ? Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value
                        : string.IsNullOrWhiteSpace(Detail.TenantId)
                                ? Localizer["Tenants.EditMetadata.Unavailable.Identity"].Value
                                : null;

    private string? UnavailableReason
        => EligibilityUnavailableReason ?? (_isSubmitting ? Localizer["Tenants.EditMetadata.Unavailable.InFlight"].Value : null);

    private bool CanOpen
        => !_isOpen && string.IsNullOrWhiteSpace(UnavailableReason);

    private bool IsOwnAggregateAdmissionUnavailable
        => _retainedAttempt is { } attempt && Attempts.IsAttached(attempt, this)
            && Services.GetService<TenantAggregateCommandAdmissionGate>()?.IsOwnedBy(
                TenantCommandAggregateLock.ForTenant(Detail.TenantId), attempt.LeaseOwner) is true
            && string.Equals(CommandSurfaceUnavailableReason,
                Localizer["Tenants.Members.UnavailableReason.AggregateLocked"].Value, StringComparison.Ordinal);

    private bool IsOwnedCommandInFlight
        => (_retainedAttempt is not null && !TenantCommandAttemptTracker.IsTerminal(_snapshot))
            || TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State, _isSubmitting);

    private bool IsSubmitDisabled
        => _authorityResolutionInProgress || (IsOwnedCommandInFlight && !CanRetryDelivery)
        || !string.IsNullOrWhiteSpace(UnavailableReason);

    private bool CanRefresh
        => !_isRefreshing && IsRefreshableAttempt;

    // The attempt can still be re-queried: it carries its tracking identity and has not settled.
    private bool IsRefreshableAttempt
        => !string.IsNullOrWhiteSpace(_snapshot.MessageId)
        && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
        && _snapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded;

    private ITenantCommandGateway? CommandGateway
        => Services.GetService<ITenantCommandGateway>();

    private string StateClass
        => $"tenants-edit-metadata__state tenants-edit-metadata__state--{_snapshot.State.ToString().ToLowerInvariant()}";

    private string StateSymbol
        => _snapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            _ => ">",
        };

    private string StateText
        => Localizer[$"Tenants.EditMetadata.State.{_snapshot.State}"];

    // The entry point names the audit state with the shared availability label, never a flow-local duplicate.
    private string AuditStateLabel
        => TenantAuditAvailability.StateLabelKeyFor(_snapshot.AuditState) is { } key ? Localizer[key] : string.Empty;

    // Refresh is offered only while the attempt can actually be re-queried; a no-op control would only
    // exhaust the retry bound behind a misleading limit note.
    private bool CanRequeryAudit
        => !string.IsNullOrWhiteSpace(_snapshot.MessageId) && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId);

    // Continue read-only closes the editor through the Cancel path, and is offered only while the editor is open
    // and no owned command is in flight, so it never renders as a control that does nothing or leaves a retained
    // attempt behind.
    private bool CanContinueReadOnly
        => _isOpen && !_isSubmitting && _retainedAttempt?.DeliveryInFlight is not true
            && (!IsOwnedCommandInFlight || _snapshot.State is TenantCommandLifecycleState.UnableToVerify or TenantCommandLifecycleState.Degraded);

    // No fragment at all when audit read is denied, so the shared control renders no empty Inspect-audit shell.
    private RenderFragment? CommandAuditEntryPoint
        => AuditReadDenied ? null : CommandAuditEntryPointTemplate;

    private RenderFragment CommandAuditEntryPointTemplate
        => @<AuditEvidenceEntryPoint TenantId="@Detail.TenantId"
                                     SourceKind="command-result"
                                     SourceTestId="tenants-command-audit-entrypoint"
                                     Label="@Localizer["Tenants.Audit.Availability.Action.InspectAudit"]"
                                     AccessibleName="@Localizer["Tenants.Audit.EntryPoint.Accessible.Command", AuditStateLabel, Detail.TenantId]"
                                     ReturnUrl="@CommandAuditReturnUrl"
                                     ReturnFocus="tenants-edit-metadata-lifecycle"
                                     AuthorityPending="@AuditReadPending"
                                     UnavailableReason="@AuditReadUnavailableReason"
                                     IsAvailable="@AuditReadAvailable" />;

    private string? SafeMessageText
        => !string.IsNullOrWhiteSpace(_snapshot.SafeMessageKey)
            ? ResolveSafeMessageKey(_snapshot.SafeMessageKey)
            : _snapshot.SafeMessage;

    // A drifted or missing key must not surface its raw resource id to the user.
    private string ResolveSafeMessageKey(string key)
    {
        var localized = Localizer[key];
        return localized.ResourceNotFound
            ? Localizer["Tenants.EditMetadata.State.UnableToVerify"].Value
            : localized.Value;
    }

    private string? ProjectionConfirmationUnavailableReason
    {
        get
        {
            if (!IsAuthorized || SurfaceKind is TenantDetailSurfaceKind.Unauthorized)
            {
                return AuthorizationUnavailableReason;
            }

            bool isStaleSurface = SurfaceKind is TenantDetailSurfaceKind.Stale
                or TenantDetailSurfaceKind.Unavailable
                or TenantDetailSurfaceKind.Unknown
                or TenantDetailSurfaceKind.Degraded;
            if (isStaleSurface || Freshness is not ReadModelFreshnessState.Current)
            {
                return Localizer["Tenants.EditMetadata.Unavailable.Freshness"].Value;
            }

            if (Lifecycle is not ProjectionLifecycleState.Current)
            {
                return Localizer["Tenants.EditMetadata.Unavailable.ProjectionLifecycle"].Value;
            }

            if (Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown)
            {
                return Localizer["Tenants.EditMetadata.Unavailable.TenantLifecycle"].Value;
            }

            // The parent lowers command-surface admission while this flow owns the aggregate lease.
            // That blocks sibling/new commands, but must not disqualify the owner's reconciliation.
            if ((!IsCommandSurfaceAvailable && !IsOwnedCommandInFlight) || CommandGateway is null || Services.GetService<TenantAggregateCommandAdmissionGate>() is null || Services.GetService<TenantCommandAttemptTracker>() is null)
            {
                return Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value;
            }

            return string.IsNullOrWhiteSpace(Detail.TenantId)
                ? Localizer["Tenants.EditMetadata.Unavailable.Identity"].Value
                : null;
        }
    }

    // The shared control's Refresh can resolve the audit state to NotStarted, which unmounts the control and its
    // focused Refresh button; focus then moves to the lifecycle section instead of falling back to the document body.
    private async Task RefreshFromAuditControlAsync()
    {
        await RefreshStatusAsync().ConfigureAwait(false);
        await InvokeAsync(() =>
        {
            if (!ShouldRenderAuditEntryPoint)
            {
                _focusLifecyclePending = true;
            }
        }).ConfigureAwait(false);
    }

    private bool ShouldRenderAuditEntryPoint
        => _snapshot.AuditState is not TenantCommandAuditState.NotStarted;

    private string? CommandAuditReturnUrl => DetailAuditReturnUrl;

    private string RecoveryText
        => Localizer[$"Tenants.EditMetadata.Recovery.{_snapshot.State}"];

    private string LiveRegionMode
        => _snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string NameDescribedBy
    {
        get
        {
            List<string> ids = ["tenants-edit-metadata-name-help"];
            if (!string.IsNullOrWhiteSpace(UnavailableReason))
            {
                ids.Add("tenants-edit-metadata-unavailable");
            }

            if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                ids.Add("tenants-edit-metadata-validation");
