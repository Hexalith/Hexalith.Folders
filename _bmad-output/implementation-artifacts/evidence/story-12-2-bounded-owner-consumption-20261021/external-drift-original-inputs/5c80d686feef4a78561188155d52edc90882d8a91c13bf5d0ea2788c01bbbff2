    private async Task SubmitAsync()
    {
        SynchronizeRetainedAttempt();
        if (_disposed || _isSubmitting || _authorityResolutionInProgress)
        {
            return;
        }
        TenantUpdateMetadataCommandSnapshot initialEvidence = _snapshot;
        TenantRetainedCommandAttempt? initialAttempt = _retainedAttempt;
        int initialAttemptGeneration = _attemptGeneration;
        long admissionGeneration = _admissionGeneration;
        if (!await ReauthorizeInitialAdmissionAsync(admissionGeneration).ConfigureAwait(false))
        {
            if (!_disposed && admissionGeneration == Volatile.Read(ref _admissionGeneration)
                && initialAttemptGeneration == _attemptGeneration && ReferenceEquals(initialAttempt, _retainedAttempt)
                && TenantCommandAttemptTracker.HasSameEvidence(initialEvidence, _snapshot))
            {
                RefuseAuthorityAdmission();
            }
            return;
        }
        if (_disposed || initialAttemptGeneration != _attemptGeneration
            || !ReferenceEquals(initialAttempt, _retainedAttempt)
            || !TenantCommandAttemptTracker.HasSameEvidence(initialEvidence, _snapshot))
        {
            return;
        }

        string? submittedNameDraft = _name;
        string? submittedDescriptionDraft = _description;
        _readOnlyDetached = false;
        RestoreRetainedAttempt();
        _name = submittedNameDraft;
        _description = submittedDescriptionDraft;

        if (CanRetryDelivery)
        {
            if (!(!string.IsNullOrWhiteSpace(_name)
                && _snapshot.Intent == new UpdateTenant(Detail.TenantId, _name, string.IsNullOrWhiteSpace(_description) ? null : _description)))
            {
                SetSnapshot(_snapshot with
                {
                    SafeMessage = Localizer["Tenants.EditMetadata.Unavailable.InFlight"].Value,
                    SafeMessageKey = null,
                    FocusTarget = TenantCommandFocusTarget.Submit,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
                return;
            }
            await RetryDeliveryAsync().ConfigureAwait(false);
            return;
        }
        // A queued form event can re-enter while the active dispatch still awaits the gateway. It belongs
        // to the same physical submit, not a retry decision, so it must not replace RequestSent (and its
        // intent/baseline) with the `_isSubmitting` unavailable state or dispatch a second command.
        if (_isSubmitting)
        {
            return;
        }

        _validationMessage = null;

        if (IsOwnedCommandInFlight)
        {
            // Same logical attempt still in flight: re-query status with stored tracking; never mint a second dispatch.
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            // Keep last-confirmed metadata visible: the static Blocked factory builds a fresh record and would
            // drop LastConfirmed*/Intent, letting the display fall back to ambient Detail. Update command
            // activity too, or the terminal state silently retains the aggregate lock for the whole circuit.
            SetSnapshot(_snapshot with
            {
                State = TenantCommandLifecycleState.UnableToVerify,
                SafeMessage = Localizer["Tenants.EditMetadata.Unavailable.InFlight"].Value,
                SafeMessageKey = null,
                AuditState = TenantCommandAuditStates.Unverifiable,
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            });
            await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            return;
        }

        if (!string.IsNullOrWhiteSpace(UnavailableReason))
        {
            SetSnapshot(BlockCurrentSnapshot(UnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        string? submittedName = _name;
        if (string.IsNullOrWhiteSpace(submittedName))
        {
            _validationMessage = Localizer["Tenants.EditMetadata.Validation.NameRequired"];
            _focusNamePending = true;
            return;
        }

        var request = new UpdateTenant(
            Detail.TenantId,
            submittedName,
            string.IsNullOrWhiteSpace(_description) ? null : _description);
        bool isSameRecoverableAttempt = _snapshot.State is (
            TenantCommandLifecycleState.Failed
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded)
            && Equals(_snapshot.Intent, request)
            && !string.IsNullOrWhiteSpace(_snapshot.MessageId);
        if (isSameRecoverableAttempt && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
        {
            // The attempt is already tracked. Treat an unchanged resubmit as reconnect/status recovery;
            // changed form values below remain a deliberate new attempt with a new identity.
            await RefreshStatusAsync().ConfigureAwait(false);
            return;
        }

        // Reuse the attempt identity only for a genuine retry of the same logical attempt whose correlation
        // was never established. Every changed request is a deliberate new attempt and must mint a fresh ULID,
        // otherwise an idempotent command bus dedupes the new values away. Mirrors AddTenantMemberFlow.
        string? retryMessageId = isSameRecoverableAttempt
            && string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
                ? _snapshot.MessageId
                : null;
        // Capture the rendered detail snapshot as the pre-submit baseline. ProjectionVersionProvider may
        // retain the version from a prior proof read so confirmation can pair evidence and version from one
        // response; using that sticky proof value here would let already-observed ambient churn qualify a
        // later same-value attempt.
        string? attemptBaselineProjectionVersion = isSameRecoverableAttempt
            ? _snapshot.BaselineProjectionVersion
            : ProjectionVersion;
        DateTimeOffset? attemptStartedAtUtc = isSameRecoverableAttempt
            ? _snapshot.AttemptStartedAtUtc
            : null;
        Attempts.Detach(_retainedAttempt, this);
        _retainedAttempt = null;
        _attemptGeneration++;
        _snapshot = _snapshot.RequestSent(request, attemptBaselineProjectionVersion, attemptStartedAtUtc) with
        {
            MessageId = retryMessageId ?? Services.GetService<Hexalith.FrontComposer.Contracts.Lifecycle.IUlidFactory>()?.NewUlid()
                ?? NUlid.Ulid.NewUlid().ToString(),
            CorrelationId = null,
        };

        int submitGeneration = _attemptGeneration;
        _isSubmitting = true;
        bool admitted = await SetCommandActivityRaisedAsync(true).ConfigureAwait(false);
        if (_disposed || submitGeneration != _attemptGeneration)
        {
            return;
        }
        bool authorityAdmitted = admitted && await ReauthorizeAdmissionAsync(admissionGeneration).ConfigureAwait(false);
        if (_disposed || submitGeneration != _attemptGeneration)
        {
            return;
        }
        string? eligibilityReason = authorityAdmitted ? EligibilityUnavailableReason : AuthorizationUnavailableReason;
        if (admitted && (eligibilityReason is not null))
        {
            Attempts.Detach(_retainedAttempt, this);
            _retainedAttempt = null;
            _isSubmitting = false;
            _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
            if (_disposed || submitGeneration != _attemptGeneration)
            {
                return;
            }
            SetSnapshot(BlockCurrentSnapshot(eligibilityReason!, TenantCommandFocusTarget.Submit) with
            {
                AuditState = retryMessageId is null ? TenantCommandAuditStates.NotStarted : TenantCommandAuditStates.Unverifiable,
            });
            return;
        }
        if (!admitted)
        {
            _isSubmitting = false;
            SetSnapshot(BlockCurrentSnapshot(
                Localizer["Tenants.Commands.Unavailable.AggregateInFlight"].Value,
                TenantCommandFocusTarget.Submit) with
            {
                // A retry reuses an identity that may already have reached the server, so its status is unknown.
                AuditState = retryMessageId is null
                    ? TenantCommandAuditStates.NotStarted
                    : TenantCommandAuditStates.Unverifiable,
            });
            return;
        }

        try
        {
            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                Attempts.Detach(_retainedAttempt, this);
                _retainedAttempt = null;
                SetSnapshot(BlockCurrentSnapshot(
                    Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value,
                    TenantCommandFocusTarget.Submit) with
                {
                    // A retry reuses an identity that may already have reached the server, so its status is unknown.
                    AuditState = retryMessageId is null
                        ? TenantCommandAuditStates.NotStarted
                        : TenantCommandAuditStates.Unverifiable,
                });
                return;
            }

            TenantUpdateMetadataCommandSnapshot expected = _snapshot;
            TenantRetainedCommandAttempt? attempt = _retainedAttempt;
            int generation = _attemptGeneration;
            if (attempt is null || !Attempts.TryStartDelivery(attempt, this))
            {
                return;
            }
            TenantCommandSubmissionResult result;
            try
            {
                result = await gateway.UpdateTenantAsync(request, expected.MessageId, CancellationToken.None).ConfigureAwait(false);
            }
            catch (Exception)
            {
                result = TenantCommandSubmissionResult.Failed(Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value)
                    with { MessageId = expected.MessageId, IsAmbiguousFailure = true };
            }
            TenantUpdateMetadataCommandSnapshot completion = result.State is TenantCommandLifecycleState.Accepted
                ? expected.Accepted(result)
                : expected with
                {
                    State = result.IsAmbiguousFailure ? TenantCommandLifecycleState.RequestSent : result.State,
                    MessageId = result.MessageId ?? expected.MessageId,
                    CorrelationId = result.CorrelationId ?? expected.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = result.SafeMessageKey,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result, retryMessageId),
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            if (PublishResult(attempt, generation, expected, completion, delivery: true)
                && completion.CorrelationId is not null && !TenantCommandAttemptTracker.IsTerminal(completion))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed && submitGeneration == _attemptGeneration)
            {
                _isSubmitting = false;
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
        }
    }

    // A user-initiated refresh that arrives while one is running waits for it and then runs a lookup of its own, so
    // the shared control's bounded Refresh never counts a merged click as an unchanged retry that no lookup served.
    // SignalR nudges, and anything reachable from inside a running refresh, must pass false: waiting there would
    // deadlock.
    private async Task RetryDeliveryAsync()
    {
        if (_disposed || _authorityResolutionInProgress)
        {
            return;
        }
        TenantUpdateMetadataCommandSnapshot expected = _snapshot;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        int generation = _attemptGeneration;
        long admissionGeneration = _admissionGeneration;
        if (!await ReauthorizeInitialAdmissionAsync(admissionGeneration).ConfigureAwait(false))
        {
            if (!_disposed && admissionGeneration == Volatile.Read(ref _admissionGeneration))
            {
                RefuseAuthorityAdmission();
            }
            return;
        }
        ITenantCommandGateway? gateway = CommandGateway;
        if (_disposed || generation != _attemptGeneration || !ReferenceEquals(attempt, _retainedAttempt)
            || !TenantCommandAttemptTracker.HasSameEvidence(expected, _snapshot) || !CanRetryDelivery
            || _isSubmitting || expected.Intent is null || attempt is null || gateway is null
            || !string.IsNullOrWhiteSpace(UnavailableReason)
            || !Attempts.TryStartDelivery(attempt, this))
        {
            return;
        }
        _isSubmitting = true;
        try
        {
            TenantCommandSubmissionResult result;
            try
            {
                result = await gateway.UpdateTenantAsync(expected.Intent, expected.MessageId, CancellationToken.None).ConfigureAwait(false);
            }
            catch (Exception)
            {
                result = TenantCommandSubmissionResult.Failed(Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value)
                    with { MessageId = expected.MessageId, IsAmbiguousFailure = true };
            }
            TenantUpdateMetadataCommandSnapshot completion = result.State is TenantCommandLifecycleState.Accepted
                ? expected.Accepted(result)
                : expected with
                {
                    State = result.IsAmbiguousFailure ? TenantCommandLifecycleState.RequestSent : result.State,
                    MessageId = result.MessageId ?? expected.MessageId,
                    CorrelationId = result.CorrelationId ?? expected.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = result.SafeMessageKey,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result, expected.MessageId),
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            if (PublishResult(attempt, generation, expected, completion, delivery: true)
                && completion.CorrelationId is not null && !TenantCommandAttemptTracker.IsTerminal(completion))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed && generation == _attemptGeneration)
            {
                _isSubmitting = false;
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
        }
    }

    private Task RefreshStatusAsync()
        => RefreshAttemptStatusAsync(waitForRunningRefresh: true);

    private async Task RefreshAttemptStatusAsync(bool waitForRunningRefresh)
    {
        SynchronizeRetainedAttempt();
        if (_disposed || TenantCommandAttemptTracker.IsTerminal(_snapshot))
        {
            return;
        }
        int generation = _attemptGeneration;
        TenantRetainedCommandAttempt? attempt = _retainedAttempt;
        TenantUpdateMetadataCommandSnapshot expected = _snapshot;
        if (_isRefreshing)
        {
            if (waitForRunningRefresh && _refreshCompletion is { } running)
            {
                // The running refresh started before this request, so its lookup cannot serve it: wait for it,
                // then run a lookup of its own on the renderer dispatcher. The running refresh may have settled the
                // attempt (confirmed, rejected, failed); a settled attempt has no status to re-apply, so the
                // follow-up runs only while the attempt is still refreshable.
                await running.Task.ConfigureAwait(false);
                await InvokeAsync(() => IsRefreshableAttempt
                        ? RefreshAttemptStatusAsync(waitForRunningRefresh: true)
                        : Task.CompletedTask)
                    .ConfigureAwait(false);
            }

            return;
        }

        _isRefreshing = true;
        TaskCompletionSource completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        _refreshCompletion = completion;
        try
        {
            if (string.IsNullOrWhiteSpace(_snapshot.MessageId) || string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                if (TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State)
                    || _snapshot.State is TenantCommandLifecycleState.UnableToVerify
                        or TenantCommandLifecycleState.Degraded)
                {
                    SetSnapshot(_snapshot with
                    {
                        State = TenantCommandLifecycleState.UnableToVerify,
                        SafeMessage = Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value,
                        SafeMessageKey = null,
                        AuditState = TenantCommandAuditStates.Unverifiable,
                        FocusTarget = TenantCommandFocusTarget.Refresh,
                        LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                    });
                }

                return;
            }

            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                SetSnapshot(_snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(Localizer["Tenants.EditMetadata.Unavailable.CommandSurface"].Value)));
                return;
            }

            TenantCommandStatusResult status;
            try
            {
                status = await gateway
                    .GetStatusAsync(new TenantCommandTrackingHandle(_snapshot.MessageId, _snapshot.CorrelationId, _snapshot.Intent?.TenantId) { ExpectedDomain = TenantIdentity.Domain }, CancellationToken.None)
                    .ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception)
            {
                if (IsCurrentContinuation(generation, expected))
                {
                    SetUnableToVerify("Tenants.EditMetadata.Status.UnableToVerify.OperationalFailure");
                }
                return;
            }

            if (!PublishResult(attempt, generation, expected, expected.ApplyStatus(status)))
            {
                return;
            }
            expected = _snapshot;

            await InvokeAsync(() => OnProjectionRefreshRequested.InvokeAsync()).ConfigureAwait(false);

            if (!IsCurrentContinuation(generation, expected) || expected.Intent is null
                || expected.State is not TenantCommandLifecycleState.ProjectionPending)
            {
                return;
            }

            try
            {
                string? confirmationUnavailableReason = ProjectionConfirmationUnavailableReason;
                if (!string.IsNullOrWhiteSpace(confirmationUnavailableReason))
                {
                    // The projection surface cannot confirm right now; no audit read happened, so the audit
                    // dimension keeps what command status established.
                    SetSnapshot(_snapshot with
                    {
                        State = TenantCommandLifecycleState.UnableToVerify,
                        SafeMessage = confirmationUnavailableReason,
                        SafeMessageKey = null,
                        FocusTarget = TenantCommandFocusTarget.Refresh,
                        LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                    });
                    return;
                }

                if (ProjectionEvidenceProvider is null)
                {
                    SetProjectionUnverified("Tenants.EditMetadata.Confirm.UnableToVerify.MissingProvenance");
                    return;
                }

                UpdateTenant intent = expected.Intent;
                TenantDetailSnapshot? evidence = await ProjectionEvidenceProvider(intent).ConfigureAwait(false);
                if (!IsCurrentContinuation(generation, expected))
                {
                    return;
                }
                if (evidence is null)
                {
                    SetProjectionUnverified("Tenants.EditMetadata.Confirm.UnableToVerify.MissingProvenance");
                    return;
                }

                TenantAuditRow? auditEvidence = null;
                if (_snapshot.IsSameValueAttempt && AuditEvidenceProvider is not null)
                {
                    auditEvidence = await AuditEvidenceProvider(
                        intent,
                        _snapshot.MessageId,
                        _snapshot.AttemptStartedAtUtc).ConfigureAwait(false);
                }

                _ = PublishResult(attempt, generation, expected, expected.ConfirmProjection(evidence, auditEvidence));
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception)
            {
                if (IsCurrentContinuation(generation, expected))
                {
                    SetProjectionUnverified("Tenants.EditMetadata.Confirm.UnableToVerify.OperationalFailure");
                }
            }
        }
        finally
        {
            _isRefreshing = false;
            try
            {
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }
            finally
            {
                if (ReferenceEquals(_refreshCompletion, completion))
                {
                    _refreshCompletion = null;
                }

                completion.TrySetResult();
            }
        }
    }

    // A failed command status read: the status after dispatch cannot be verified.
    private void SetUnableToVerify(string safeMessageKey)
        => SetSnapshot(_snapshot with
        {
            State = TenantCommandLifecycleState.UnableToVerify,
            SafeMessage = null,
            SafeMessageKey = safeMessageKey,
            RejectionCode = null,
            AuditState = TenantCommandAuditStates.Unverifiable,
            FocusTarget = TenantCommandFocusTarget.Refresh,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        });

    // A projection or proof read that failed, or that could not prove this attempt: the command stays unverified,
    // and the audit dimension keeps what command status established, because no audit read happened.
    private void SetProjectionUnverified(string safeMessageKey)
        => SetSnapshot(_snapshot with
        {
            State = TenantCommandLifecycleState.UnableToVerify,
            SafeMessage = null,
            SafeMessageKey = safeMessageKey,
            RejectionCode = null,
            FocusTarget = TenantCommandFocusTarget.Refresh,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        });

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal) && _isOpen)
        {
            await CloseEditorAsync().ConfigureAwait(false);
        }
    }
    public void Dispose()
    {
        _disposed = true;
        InvalidateAdmission();
        TenantCommandAttemptTracker? attempts = Services.GetService<TenantAggregateCommandAdmissionGate>() is null ? null : Services.GetService<TenantCommandAttemptTracker>();
        if (attempts is not null)
        {
            attempts.StateChanged -= OnRetainedAttemptChanged;
        }
        _attemptGeneration++;
        attempts?.Detach(_retainedAttempt, this);
    }
