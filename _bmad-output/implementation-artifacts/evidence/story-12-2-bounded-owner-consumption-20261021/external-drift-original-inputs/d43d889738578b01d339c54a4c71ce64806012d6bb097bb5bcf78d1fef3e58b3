    private async Task OnActiveTabChanged(string? activeTabId)
    {
        if (!IsInteractiveCircuit || _disposed || string.IsNullOrWhiteSpace(activeTabId))
        {
            return;
        }

        string previousTab = _activeTabId;

        // Preserve the complete state owned by the panel being left. Each retained panel stays mounted, and
        // its parameters must remain that panel's last normalized state while the other tab owns the URL.
        if (string.Equals(previousTab, TenantWorkspaceState.UsersTab, StringComparison.Ordinal))
        {
            _usersWorkspaceState = _workspaceState;
        }

        if (string.Equals(NormalizeTab(activeTabId), TenantWorkspaceState.UsersTab, StringComparison.Ordinal))
        {
            TenantWorkspaceState usersState = _usersWorkspaceState;
            ApplyWorkspaceState(usersState, clearCursorHistory: true);
            NavigateToCanonicalWorkspaceIfNeeded(usersState);
            return;
        }

        TenantWorkspaceState tenantsState = _tenantWorkspaceState;
        ApplyWorkspaceState(tenantsState, clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false);
        }
    }

    private async Task OnTenantScopeChanged(string? scope)
    {
        ApplyWorkspaceState(CurrentWorkspaceState().WithScope(scope), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();

        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false);
        }
    }

    private static string NormalizeTab(string? value)
        => string.Equals(value, "workspace-users", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, TenantWorkspaceState.UsersTab, StringComparison.OrdinalIgnoreCase)
            ? TenantWorkspaceState.UsersTab
            : TenantWorkspaceState.TenantsTab;

    private async Task OnTenantSortChanged(DataGridSortEventArgs<TenantListRow> args)
    {
        string? primaryColumnId = args.SortColumns.Count > 0 ? args.SortColumns[0].Column.ColumnId : null;
        string sortColumn = primaryColumnId switch
        {
            "tenant-id" => TenantListSortColumns.Name,
            "tenant-status" => TenantListSortColumns.Status,
            _ => TenantListSortColumns.TenantId,
        };
        ApplyWorkspaceState(
            CurrentWorkspaceState().WithSort(sortColumn, descending: args.SortColumns.Count > 0 && !args.SortColumns[0].Ascending),
            clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    private TenantWorkspaceState CurrentWorkspaceState()
        => IsUsersTab
            ? _workspaceState
            : TenantWorkspaceState.FromQuery(
                _activeTabId,
                _tenantScope,
                userId: null,
                _search,
                _statusFilter,
                _sortColumn,
                _sortDescending ? bool.TrueString : null,
                _currentCursor,
                _selectedTenantId,
                _returnAnchor);

    private void ApplyWorkspaceState(TenantWorkspaceState state, bool clearCursorHistory = false)
    {
        if (_workspaceState != state)
        {
            // Only undispatched admission follows the active view. Retained command tracking and
            // optional workspace entry resolution keep their independent lifetimes.
            Interlocked.Increment(ref _workspaceVersion);
            CancelAuthorizationWait(ref _createAuthorizationCancellation);
        }

        _workspaceState = state;
        _activeTabId = state.Tab;
        if (clearCursorHistory)
        {
            // No pending-recovery clear here. It was unreachable on the path that mattered -- this runs from
            // RestoreContextFromQuery before SearchPaging is ever resolved, so the null-conditional made it a
            // guaranteed no-op on a fresh instance -- and it is redundant everywhere else: EnsureScope resets
            // PendingRecoveryScope whenever the search scope actually changes. Clearing it on a transition
            // that keeps the same scope would destroy copy the operator is still owed.
            _cursorHistory.Clear();
            if (state.Tab == TenantWorkspaceState.TenantsTab && !string.IsNullOrWhiteSpace(state.Cursor))
            {
                _cursorHistory.Push(null);
            }
        }

        if (state.Tab == TenantWorkspaceState.UsersTab)
        {
            _usersWorkspaceState = state;
            return;
        }

        _tenantWorkspaceState = state;
        _tenantScope = state.Scope;
        _search = state.Search;
        _statusFilter = state.Status;
        _sortColumn = state.Sort;
        _sortDescending = state.SortDescending;
        _currentCursor = state.Cursor;
        _selectedTenantId = state.SelectedTenantId;
        _returnAnchor = state.Anchor;
    }

    private void NavigateToCanonicalWorkspace()
    {
        _workspaceState = CurrentWorkspaceState();
        if (_workspaceState.Tab == TenantWorkspaceState.TenantsTab)
        {
            _tenantWorkspaceState = _workspaceState;
        }

        NavigateToCanonicalWorkspaceIfNeeded(_workspaceState);
    }

    private bool NavigateToCanonicalWorkspaceIfNeeded(TenantWorkspaceState state)
    {
        string canonicalUrl = state.ToCanonicalUrl(routeBacked: true);
        if (TenantAuditNavigationSafety.IsSafeFocus(QueryAuditFocus))
        {
            canonicalUrl += (canonicalUrl.Contains('?', StringComparison.Ordinal) ? "&" : "?")
                + "auditFocus=" + Uri.EscapeDataString(QueryAuditFocus!);
            if (QueryAuditPartialReturn)
            {
                canonicalUrl += "&auditPartialReturn=true";
            }
        }
        else if (QueryAuditReturnUnavailable)
        {
            canonicalUrl += (canonicalUrl.Contains('?', StringComparison.Ordinal) ? "&" : "?")
                + "auditReturnUnavailable=true";
        }
        if (QueryAuditPartialReturn && !canonicalUrl.Contains("auditPartialReturn=", StringComparison.Ordinal))
        {
            canonicalUrl += (canonicalUrl.Contains('?', StringComparison.Ordinal) ? "&" : "?")
                + "auditPartialReturn=true";
        }
        string currentUrl = HttpContext is null
            ? Navigation.ToBaseRelativePath(Navigation.Uri)
            : $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
        int fragmentIndex = currentUrl.IndexOf('#', StringComparison.Ordinal);
        if (fragmentIndex >= 0)
        {
            currentUrl = currentUrl[..fragmentIndex];
        }

        currentUrl = $"/{currentUrl.TrimStart('/')}";
        if (string.Equals(currentUrl, canonicalUrl, StringComparison.Ordinal))
        {
            return false;
        }

        Navigation.NavigateTo(canonicalUrl, replace: true);
        return true;
    }

    private PendingLoadOperation BeginLoad()
    {
        var source = new CancellationTokenSource();
        lock (_loadCancellationLock)
        {
            _loadCancellation?.Cancel();
            _loadCancellation = source;
        }

        return new(source, () => CompleteLoad(source));
    }

    private void CompleteLoad(CancellationTokenSource source)
    {
        lock (_loadCancellationLock)
        {
            if (ReferenceEquals(_loadCancellation, source))
            {
                _loadCancellation = null;
            }
        }

        source.Dispose();
    }

    private void CancelActiveLoad()
    {
        lock (_loadCancellationLock)
        {
            _loadCancellation?.Cancel();
            _loadCancellation = null;
        }
    }

    private CancellationTokenSource ReplaceAuthorizationWait(ref CancellationTokenSource? active)
    {
        var source = new CancellationTokenSource();
        lock (_loadCancellationLock)
        {
            if (_disposed)
            {
                source.Cancel();
            }
            else
            {
                active?.Cancel();
                active = source;
            }
        }
        return source;
    }

    private void CancelAuthorizationWait(ref CancellationTokenSource? active)
    {
        lock (_loadCancellationLock)
        {
            active?.Cancel();
            active = null;
        }
    }

    private void CompleteAuthorizationWait(ref CancellationTokenSource? active, CancellationTokenSource source)
    {
        lock (_loadCancellationLock)
        {
            if (ReferenceEquals(active, source))
            {
                active = null;
            }
        }
        source.Dispose();
    }

    public void Dispose()
    {
        // The pending recovery scope is deliberately NOT cleared here. It is owed copy explaining that
        // protected paging restarted at page one, it is bound to the exact search scope that owes it, and
        // it lives in the circuit-scoped service precisely so it survives the component disposal a
        // tenant-detail navigation causes. Clearing it here destroyed it on the way out and the operator
        // came back to a silently restarted search with no notice -- the invariant ExplainsSearchRestart
        // exists to prevent. A later load for a different scope discards it through EnsureScope.
        _disposed = true;
        Navigation.LocationChanged -= OnWorkspaceLocationChanged;
        CancelAuthorizationWait(ref _entryAuthorizationCancellation);
        CancelAuthorizationWait(ref _authenticationStateCancellation);
        CancelAuthorizationWait(ref _createAuthorizationCancellation);
        Interlocked.Increment(ref _authorizationVersion);
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            _authenticationStateProvider = null;
        }
        CancelActiveLoad();
    }

    private sealed class PendingLoadOperation : IDisposable
    {
        private Action? _complete;

        public PendingLoadOperation(CancellationTokenSource source, Action complete)
        {
            CancellationToken = source.Token;
            _complete = complete;
        }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }
}
