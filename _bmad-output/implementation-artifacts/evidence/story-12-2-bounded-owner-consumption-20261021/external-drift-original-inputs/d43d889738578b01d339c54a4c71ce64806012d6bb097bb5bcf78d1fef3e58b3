    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnWorkspaceLocationChanged;
        _authenticationStateProvider = Services.GetService(typeof(AuthenticationStateProvider)) as AuthenticationStateProvider;
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        }

        if (_authenticationStateProvider is not null)
        {
            StartAuditCallerResolution();
        }
        else
        {
            _auditAuthorityResolved = true;
        }
        bool querySearchTermTooLong = TenantWorkspaceState.IsSearchTooLong(QuerySearch);
        RestoreContextFromQuery();
        CaptureAuditReturn();
        NavigateToCanonicalWorkspaceIfNeeded(_workspaceState);
        _initialized = true;

        // When returning from a tenant detail surface the launching row may no longer be visible
        // after the list reloads, so move keyboard focus to the list heading and let the visible
        // return-context message explain that filters/sort/cursor/selection were restored.
        _focusHeadingPending = _pendingAuditFocus is null && _pendingDetailFocus is null
            && (QueryAuditReturnUnavailable || !string.IsNullOrWhiteSpace(_selectedTenantId));

        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false, searchTermTooLong: querySearchTermTooLong);
        }
    }

    private void StartGlobalAdministratorsEntryResolution()
    {
        if (_disposed)
        {
            return;
        }

        Interlocked.Increment(ref _auditRefreshVersion);
        if (_authenticationStateProvider is null)
        {
            _canReviewGlobalAdministrators = false;
            _auditReadDenied = false;
            _auditAuthorityResolved = true;
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        if (Volatile.Read(ref _pendingAuditCallerVersion) != 0)
        {
            // Explicit recovery replaces the pending wait with the provider's current evidence.
            // A still-pending or faulty provider remains closed under the same shared bound.
            StartAuditCallerResolution();
            return;
        }

        if (Volatile.Read(ref _resolvedAuditCallerVersion) != Volatile.Read(ref _auditCallerVersion))
        {
            StartAuditCallerResolution();
            return;
        }

        long version = Interlocked.Increment(ref _authorizationVersion);
        CancelAuthorizationWait(ref _entryAuthorizationCancellation);
        _canReviewGlobalAdministrators = false;
        _auditReadDenied = false;
        _auditAuthorityResolved = false;
        Task callback = InvokeAsync(() => ResolveGlobalAdministratorsEntryAsync(version));
        _ = ObserveAuthorizationCallbackAsync(callback);
    }

    private async Task ResolveGlobalAdministratorsEntryAsync(long version)
    {
        if (_disposed || version != Volatile.Read(ref _authorizationVersion))
        {
            return;
        }
        string? caller = AuthenticatedUserId;
        _createAuthorization = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        _createAuthorityUserId = null;
        if (Services.GetService(typeof(ITenantsBffComposition)) is not ITenantsBffComposition bffComposition)
        {
            await InvokeAsync(() =>
            {
                if (!_disposed && version == Volatile.Read(ref _authorizationVersion))
                {
                    _canReviewGlobalAdministrators = false;
                    _auditAuthorityResolved = true;
                    StateHasChanged();
                }
            });
            return;
        }

        TenantLifecycleAuthorizationReflectionState reflection;
        CancellationTokenSource source = ReplaceAuthorizationWait(ref _entryAuthorizationCancellation);
        try
        {
            reflection = await TenantUiOperationPolicy.FromServices(Services).RunAsync(
                token => bffComposition.ResolveGlobalAdministratorsAuthorizationAsync(token).AsTask(), source.Token);
        }
        catch
        {
            await InvokeAsync(() =>
            {
                if (!_disposed && version == Volatile.Read(ref _authorizationVersion))
                {
                    _auditAuthorityResolved = true;
                    StateHasChanged();
                }
            });
            return;
        }
        finally
        {
            CompleteAuthorizationWait(ref _entryAuthorizationCancellation, source);
        }

        await InvokeAsync(() =>
        {
            if (_disposed || version != Volatile.Read(ref _authorizationVersion)
                || string.IsNullOrWhiteSpace(caller)
                || !string.Equals(caller, AuthenticatedUserId, StringComparison.Ordinal)
                || Volatile.Read(ref _pendingAuditCallerVersion) != 0)
            {
                return;
            }

            _createAuthorization = reflection;
            _createAuthorityUserId = caller;
            _canReviewGlobalAdministrators = reflection == TenantLifecycleAuthorizationReflectionState.Authorized;
            _auditReadDenied = reflection == TenantLifecycleAuthorizationReflectionState.MissingPermission;
            _auditAuthorityResolved = true;
            StateHasChanged();
        });
    }

    private async Task<TenantLifecycleAuthorizationReflectionState> ReauthorizeCreateAsync(CancellationToken cancellationToken)
    {
        long version = Volatile.Read(ref _authorizationVersion);
        long callerVersion = Volatile.Read(ref _auditCallerVersion);
        long workspaceVersion = Volatile.Read(ref _workspaceVersion);
        string? caller = AuthenticatedUserId;
        TenantListSnapshot snapshot = _snapshot;
        if (!IsTenantListView || !HasCurrentCallerAuthority || string.IsNullOrWhiteSpace(caller)
            || Volatile.Read(ref _pendingAuditCallerVersion) != 0
            || Services.GetService<ITenantsBffComposition>() is not { } bffComposition)
        {
            return TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        CancellationTokenSource source = ReplaceAuthorizationWait(ref _createAuthorizationCancellation);
        using var linked = CancellationTokenSource.CreateLinkedTokenSource(source.Token, cancellationToken);
        try
        {
            TenantLifecycleAuthorizationReflectionState reflection = await TenantUiOperationPolicy.FromServices(Services).RunAsync(
                token => bffComposition.ResolveGlobalAdministratorsAuthorizationAsync(token).AsTask(), linked.Token).ConfigureAwait(false);
            linked.Token.ThrowIfCancellationRequested();
            return !_disposed && IsTenantListView && version == Volatile.Read(ref _authorizationVersion)
                && workspaceVersion == Volatile.Read(ref _workspaceVersion)
                && callerVersion == Volatile.Read(ref _auditCallerVersion)
                && Volatile.Read(ref _pendingAuditCallerVersion) == 0
                && string.Equals(caller, AuthenticatedUserId, StringComparison.Ordinal)
                && ReferenceEquals(snapshot, _snapshot)
                ? reflection : TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception)
        {
            return TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        finally
        {
            CompleteAuthorizationWait(ref _createAuthorizationCancellation, source);
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        if (_disposed)
        {
            return;
        }

        long callerVersion = Interlocked.Increment(ref _auditCallerVersion);
        Interlocked.Exchange(ref _pendingAuditCallerVersion, callerVersion);
        long version = Interlocked.Increment(ref _authorizationVersion);
        CancelAuthorizationWait(ref _entryAuthorizationCancellation);
        CancelAuthorizationWait(ref _authenticationStateCancellation);
        CancelAuthorizationWait(ref _createAuthorizationCancellation);
        Task callback = InvokeAsync(() => ApplyAuthenticationStateChangedAsync(authenticationStateTask, version, callerVersion));
        _ = ObserveAuthorizationCallbackAsync(callback);
    }

    private void StartAuditCallerResolution()
    {
        try
        {
            OnAuthenticationStateChanged(_authenticationStateProvider!.GetAuthenticationStateAsync());
        }
        catch
        {
            Interlocked.Increment(ref _auditCallerVersion);
            Interlocked.Exchange(ref _pendingAuditCallerVersion, 0);
            Interlocked.Increment(ref _authorizationVersion);
            CancelAuthorizationWait(ref _entryAuthorizationCancellation);
            CancelAuthorizationWait(ref _authenticationStateCancellation);
            CancelAuthorizationWait(ref _createAuthorizationCancellation);
            _canReviewGlobalAdministrators = false;
            _auditReadDenied = false;
            _auditAuthorityResolved = true;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyAuthenticationStateChangedAsync(
        Task<AuthenticationState> authenticationStateTask,
        long version,
        long callerVersion)
    {
        if (_disposed || version != Volatile.Read(ref _authorizationVersion))
        {
            return;
        }

        _canReviewGlobalAdministrators = false;
        _auditReadDenied = false;
        _auditAuthorityResolved = false;
        // An authentication transition invalidates the authority scope of retained loading evidence,
        // including while the replacement caller is still unresolved.
        if (_snapshot.Kind is TenantListSurfaceKind.Loading && _snapshot.Rows.Count > 0)
        {
            _snapshot = TenantListSnapshot.Loading();
            _refreshingListKind = null;
            ApplyVisibleRows();
        }
        StateHasChanged();

        CancellationTokenSource source = ReplaceAuthorizationWait(ref _authenticationStateCancellation);
        try
        {
            await TenantUiOperationPolicy.FromServices(Services).RunAsync(_ => authenticationStateTask, source.Token);
        }
        catch
        {
            if (_disposed || callerVersion != Volatile.Read(ref _auditCallerVersion))
            {
                return;
            }

            Interlocked.CompareExchange(ref _pendingAuditCallerVersion, 0, callerVersion);
            _auditAuthorityResolved = true;
            StateHasChanged();
            return;
        }
        finally
        {
            CompleteAuthorizationWait(ref _authenticationStateCancellation, source);
        }

        if (_disposed || callerVersion != Volatile.Read(ref _auditCallerVersion))
        {
            return;
        }

        Interlocked.Exchange(ref _resolvedAuditCallerVersion, callerVersion);
        Interlocked.CompareExchange(ref _pendingAuditCallerVersion, 0, callerVersion);
        if (version == Volatile.Read(ref _authorizationVersion))
        {
            await ResolveGlobalAdministratorsEntryAsync(version);
        }
    }

    private static async Task ObserveAuthorizationCallbackAsync(Task callback)
    {
        try
        {
            await callback;
        }
        catch
        {
            // Authentication transitions fail closed in the component callback.
        }
    }

    private void OnWorkspaceLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed || !_initialized)
        {
            return;
        }

        string destination = args.Location;
        Task callback = InvokeAsync(async () =>
        {
            if (_disposed || !string.Equals(destination, Navigation.Uri, StringComparison.Ordinal))
            {
                return;
            }

            string path = Navigation.ToBaseRelativePath(destination).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            if (path is not ("" or "tenants" or "tenants/tenants" or "tenants/workspace-users"))
            {
                return;
            }

            // RouteView can skip parameter delivery between literal aliases of this same component.
            // The tabs still follow the URI, so reconcile their active view from that exact URI too.
            // Query-only changes retain their existing parameter lifecycle and paging ownership.
            var query = QueryHelpers.ParseQuery(new Uri(destination).Query);
            string? Value(string key) => query.TryGetValue(key, out var value) ? value.ToString() : null;
            TenantWorkspaceState incoming = TenantWorkspaceState.FromQuery(
                RouteTabFromLocation ?? Value("tab"), Value("scope"), Value("userId"),
                Value("search"), Value("status"), Value("sort"), Value("desc"),
                Value("cursor"), Value("selected"), Value("anchor"));
            if (incoming.Tab == _workspaceState.Tab)
            {
                return;
            }

            ApplyWorkspaceState(incoming, clearCursorHistory: true);
            if (IsTenantListView)
            {
                await LoadAsync(reuseETag: false, searchTermTooLong: TenantWorkspaceState.IsSearchTooLong(Value("search")));
            }
            if (!_disposed && string.Equals(destination, Navigation.Uri, StringComparison.Ordinal))
            {
                StateHasChanged();
            }
        });
        _ = ObserveAuthorizationCallbackAsync(callback);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || _disposed)
        {
            return;
        }

        CaptureAuditReturn();

        bool incomingSearchTermTooLong = TenantWorkspaceState.IsSearchTooLong(QuerySearch);
        TenantWorkspaceState incoming = WorkspaceStateFromQuery();
        if (incoming == _workspaceState)
        {
            NavigateToCanonicalWorkspaceIfNeeded(incoming);
            if (incomingSearchTermTooLong && IsTenantListView)
            {
                await LoadAsync(reuseETag: false, searchTermTooLong: true);
            }

            return;
        }

        ApplyWorkspaceState(incoming, clearCursorHistory: true);
        NavigateToCanonicalWorkspaceIfNeeded(incoming);
        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false, searchTermTooLong: incomingSearchTermTooLong);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsRetainedTenantListView)
        {
            string label = Localizer[StatusFilterLabelKey];
            if (!string.Equals(_renderedStatusFilterLabel, label, StringComparison.Ordinal))
            {
                try
                {
                    await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsStatusFilter.js");
                    if (await module.InvokeAsync<bool>("syncStatusFilterLabel"))
                    {
                        _renderedStatusFilterLabel = label;
                    }
                }
                catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
                {
                    // The interactive circuit ended before its native label could be synchronized.
                }
            }
        }
        else
        {
            _renderedStatusFilterLabel = null;
        }

        if (_pendingDetailFocus is { } detailFocus)
        {
            _pendingDetailFocus = null;
            _ = RestoreDetailFocusAsync(detailFocus);
        }

        if (_pendingAuditFocus is { } focus
            && (!string.Equals(focus, "tenants-create-lifecycle", StringComparison.Ordinal)
                || CreateAuthorization is not TenantLifecycleAuthorizationReflectionState.Indeterminate))
        {
            // Let the child restore retained create evidence before consuming its one-shot return marker.
            _pendingAuditFocus = null;
            _ = RestoreAuditFocusAsync(focus);
        }

        if (_focusHeadingPending)
        {
            _focusHeadingPending = false;
            await _listPage.FocusHeadingAsync();
        }

        if (_pendingAuditFocus is null && QueryAuditFocus is null
            && (QueryAuditPartialReturn || QueryAuditReturnUnavailable) && !_consumedFocuslessReturn)
        {
            _consumedFocuslessReturn = true;
            try
            {
                await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
                await module.InvokeVoidAsync("consumeReturnMarkers");
                QueryAuditPartialReturn = false;
                QueryAuditReturnUnavailable = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended before the URL markers could be consumed.
            }
            catch (Exception exception) when (exception is JSException or TaskCanceledException)
            {
                // Keep the visible return notices when browser cleanup is unavailable.
            }
        }
    }

    private void CaptureAuditReturn()
    {
        if (QueryAnchor is { } detailFocus
            && detailFocus.StartsWith("tenants-my-detail-", StringComparison.Ordinal)
            && TenantAuditNavigationSafety.IsSafeFocus(detailFocus)
            && !string.Equals(_handledDetailFocus, detailFocus, StringComparison.Ordinal))
        {
            _handledDetailFocus = detailFocus;
            _pendingDetailFocus = detailFocus;
            _focusHeadingPending = false;
        }
        else if (QueryAnchor is null)
        {
            _handledDetailFocus = null;
            _pendingDetailFocus = null;
        }

        if (QueryAuditFocus is null || !TenantAuditNavigationSafety.IsSafeFocus(QueryAuditFocus))
        {
            _handledAuditFocus = null;
            _pendingAuditFocus = null;
            _auditPartialReturn = QueryAuditPartialReturn;
            if (!QueryAuditPartialReturn && !QueryAuditReturnUnavailable)
            {
                _consumedFocuslessReturn = false;
            }
            _auditStalledNotice = false;
            if (QueryAuditReturnUnavailable)
            {
                _auditReturnNotice = true;
                if (!_handledMissingAuditReturn)
                {
                    _focusHeadingPending = true;
                }

                _handledMissingAuditReturn = true;
            }
            else
            {
                _auditReturnNotice = false;
                _handledMissingAuditReturn = false;
            }

            return;
        }

        _handledMissingAuditReturn = false;

        if (QueryAuditFocus is { } focus && TenantAuditNavigationSafety.IsSafeFocus(focus)
            && !string.Equals(_handledAuditFocus, focus, StringComparison.Ordinal))
        {
            _handledAuditFocus = focus;
            // Latch the create accordion open: the one-shot marker is cleared after focus is restored,
            // and binding Expanded to it collapsed the flow around the restored launcher.
            _createAccordionExpanded |= IsCreateAuditReturn;
            _pendingAuditFocus = focus;
            _focusHeadingPending = false;
            _auditReturnNotice = false;
            _auditStalledNotice = false;
            _auditPartialReturn = QueryAuditPartialReturn;
        }
    }

    private async Task RestoreDetailFocusAsync(string focus)
    {
        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
            string? outcome = await module.InvokeAsync<string>("restoreDetailFocus", focus, "tenants-my-page", "tenants-list-heading");
            if (outcome != "cancelled" && string.Equals(QueryAnchor, focus, StringComparison.Ordinal))
            {
                await module.InvokeVoidAsync("consumeReturnMarkers", focus, null, true);
                QueryAnchor = null;
            }
            if (outcome is "missing" or "stalled" && !_disposed && string.Equals(_handledDetailFocus, focus, StringComparison.Ordinal))
            {
                await InvokeAsync(() => { _auditReturnNotice = outcome == "missing"; _auditStalledNotice = outcome == "stalled"; StateHasChanged(); });
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigation ended before focus restoration.
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            if (!_disposed && string.Equals(QueryAnchor, focus, StringComparison.Ordinal))
            {
                await InvokeAsync(() => { _auditReturnNotice = true; _auditStalledNotice = false; StateHasChanged(); });
            }
        }
    }

    private async Task RestoreAuditFocusAsync(string focus)
    {
        string origin = focus.StartsWith("tenants-user-row-", StringComparison.Ordinal)
            ? "tenants-user-lookup"
            : focus.StartsWith("tenants-my-row-", StringComparison.Ordinal)
                ? "tenants-my-page"
                : "tenants-workspace-tenants-panel-content";
        string? targetUserId = origin == "tenants-user-lookup" ? _usersWorkspaceState.UserId : null;
        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
            string? outcome = await module.InvokeAsync<string>("restoreAuditFocus", focus, origin,
                "tenants-list-heading", targetUserId);
            if (outcome != "cancelled"
                && (origin != "tenants-user-lookup" || string.Equals(_usersWorkspaceState.UserId, targetUserId, StringComparison.Ordinal)))
            {
                await module.InvokeVoidAsync("consumeReturnMarkers", focus, targetUserId);
                if (string.Equals(QueryAuditFocus, focus, StringComparison.Ordinal))
                {
                    QueryAuditFocus = null;
                    QueryAuditPartialReturn = false;

                    // Re-render so child panels stop carrying the consumed markers into later URLs.
                    if (!_disposed)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            if (outcome is "missing" or "stalled"
                && !_disposed && string.Equals(_handledAuditFocus, focus, StringComparison.Ordinal)
                && (origin != "tenants-user-lookup" || string.Equals(_usersWorkspaceState.UserId, targetUserId, StringComparison.Ordinal)))
            {
                await InvokeAsync(() =>
                {
                    _auditReturnNotice = outcome == "missing";
                    _auditStalledNotice = outcome == "stalled";
                    StateHasChanged();
                });
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit ended before focus restoration.
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            if (!_disposed && string.Equals(QueryAuditFocus, focus, StringComparison.Ordinal)
                && (origin != "tenants-user-lookup" || string.Equals(_usersWorkspaceState.UserId, targetUserId, StringComparison.Ordinal)))
            {
                await InvokeAsync(() => { _auditReturnNotice = true; _auditStalledNotice = false; StateHasChanged(); });
            }
        }
    }

    private async Task LoadAsync(bool reuseETag, bool searchTermTooLong = false)
    {
        // A disposed component must never issue another load: it would keep consuming and mutating the
        // circuit-scoped paging state it no longer renders, so its outcome could retire a paging mode or
        // clear protected history behind a surface that no operator can see.
        if (_disposed)
        {
            return;
        }

        using PendingLoadOperation operation = BeginLoad();
        long loadVersion = System.Threading.Interlocked.Increment(ref _loadVersion);
        CancellationToken cancellationToken = operation.CancellationToken;
        TenantListSnapshot previous = _lastConfirmedSnapshot ?? _snapshot;
        string? authenticatedUserId = AuthenticatedUserId;
        // Retain only this displayed page for the same caller, never an older confirmed page after a
        // hard load or refusal. Loading/Unknown keeps create, audit and paging closed while rows remain.
        bool retainDisplayedPage = reuseETag
            && _snapshot.Rows.Count > 0
            && _snapshot.Kind is (TenantListSurfaceKind.Ready or TenantListSurfaceKind.Stale
                or TenantListSurfaceKind.Degraded or TenantListSurfaceKind.Loading)
            && !string.IsNullOrWhiteSpace(authenticatedUserId)
            && string.Equals(_snapshot.CallerScope, TenantQueryGateway.AuditCallerScope(authenticatedUserId), StringComparison.Ordinal);
        _refreshingListKind = retainDisplayedPage ? _refreshingListKind ?? _snapshot.Kind : null;
        _snapshot = retainDisplayedPage
            ? _snapshot with { Kind = TenantListSurfaceKind.Loading, Freshness = ReadModelFreshnessState.Unknown }
            : TenantListSnapshot.Loading();
        ApplyVisibleRows();

        TenantStatus? status = Enum.TryParse(_statusFilter, out TenantStatus parsedStatus) ? parsedStatus : null;
        bool interactiveCircuit = IsInteractiveCircuit;
        bool restoreSearchPagingContext = interactiveCircuit && _restoreSearchPagingContextPending;
        bool eligibleDetailReturn = HasValidatedTenantDetailReturnContext
            && HasActiveSearch
            && !string.IsNullOrWhiteSpace(authenticatedUserId);
        bool retainedPagingMatched = false;
        bool discardedRetainedPosition = false;
        bool discardedAuthoritativePosition = false;
        if (restoreSearchPagingContext)
        {
            if (eligibleDetailReturn)
            {
                // The retained page size is server-held, so the exact retained scope is identified by
                // probing the supported page sizes instead of trusting anything from the URL.
                foreach (int retainedPageSize in _pageSizes)
                {
                    string retainedScope = TenantSearchCursorScopes.Create(
                        authenticatedUserId!,
                        _search!,
                        status?.ToString(),
                        _sortColumn,
                        _sortDescending,
                        retainedPageSize);
                    if (!SearchPaging.MatchesScope(retainedScope))
                    {
                        continue;
                    }

                    _pageSize = retainedPageSize;
                    retainedPagingMatched = true;
                    break;
                }
            }

            if (!eligibleDetailReturn)
            {
                // Returning by browser Back lands on /tenants?search=... with no selected/anchor, so the
                // return context cannot be validated and retained paging is discarded. That is correct, but
                // it was silent: the operator who was on search page 4 arrived at page 1 with no bar
                // explaining why. Only an actual retained position is worth a notice -- a first visit with
                // nothing retained has restarted nothing.
                // Which mode's position was discarded decides the copy: explaining an ordinary-list discard
                // as protected search paging restarting asserts a protected search page that never existed.
                discardedAuthoritativePosition = SearchPaging.SearchCursor is not null
                    || SearchPaging.HasPrevious(authoritative: true);
                discardedRetainedPosition = discardedAuthoritativePosition
                    || SearchPaging.FallbackCursor is not null
                    || SearchPaging.HasPrevious(authoritative: false);

                SearchPaging.Reset();
            }

            _restoreSearchPagingContextPending = false;
        }

        string? searchScope = HasActiveSearch && !string.IsNullOrWhiteSpace(authenticatedUserId)
            ? TenantSearchCursorScopes.Create(
                authenticatedUserId!,
                _search!,
                status?.ToString(),
                _sortColumn,
                _sortDescending,
                _pageSize)
            : null;
        if (interactiveCircuit)
        {
            SearchPaging.EnsureScope(searchScope);

            // Armed strictly after EnsureScope: that call resets positions when the scope changes, and a
            // pending scope set before it would be wiped by the very reset it is meant to explain.
            if (discardedRetainedPosition && searchScope is not null)
            {
                SearchPaging.SetPendingRecoveryScope(searchScope, discardedAuthoritativePosition);
            }
        }

        if (restoreSearchPagingContext
            && eligibleDetailReturn
            && searchScope is not null
            && !retainedPagingMatched)
        {
            // Retained protected paging could not be validated. The honest page-one recovery notice stays
            // pending until a load for this exact scope actually resolves, so a superseding load cannot
            // silently discard it. The decision lives in the circuit-scoped paging service beside the
            // cursors it governs, never in a component field.
            SearchPaging.SetPendingRecoveryScope(searchScope);
        }

        string? recoveryScopeForLoad = interactiveCircuit ? SearchPaging.PendingRecoveryScope : null;

        // The authoritative/fallback crossing is resolved before the outgoing request is built: only the
        // currently active paging mode may contribute a retained cursor. If this load crosses the boundary,
        // the mode it enters therefore starts at its own first page instead of resuming the stale cursor it
        // left behind, which is what makes the "paging restarted from the first page" notice honest about
        // the very load that carried it. A null mode means no load has resolved yet, so nothing is retained.
        bool? activeMode = interactiveCircuit ? SearchPaging.ActiveModeAuthoritative : null;
        TenantListRequest request = new(
            Cursor: HasActiveSearch
                ? activeMode is false ? SearchPaging.FallbackCursor : null
                : _currentCursor,
            PageSize: _pageSize,
            Search: _search,
            Status: status,
            SortColumn: _sortColumn,
            SortDescending: _sortDescending,
            ETag: reuseETag ? previous.ETag : null,
            SearchCursor: HasActiveSearch && interactiveCircuit && activeMode is not false
                ? SearchPaging.SearchCursor
                : null);

        TenantListSnapshot snapshot;
        try
        {
            snapshot = await QueryGateway.ListTenantsAsync(request, previous, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            // The disposal guard covers the post-await apply block as well as the load entry: a load that
            // returns after disposal must mutate no paging state, or it could retire a paging mode and
            // clear protected history behind a surface no operator can see.
            if (_disposed || loadVersion != _loadVersion)
            {
                return;
            }

            // The pending decision is consumed only when the notice is actually applied. A transient error
            // on the detail-return load must not silently swallow it: the next same-scope load reports it.
            if (recoveryScopeForLoad is not null
                && snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized)
                && string.Equals(searchScope, recoveryScopeForLoad, StringComparison.Ordinal)
                && string.Equals(SearchPaging.PendingRecoveryScope, recoveryScopeForLoad, StringComparison.Ordinal))
            {
                // Read the owed mode before clearing it: an ordinary-list discard gets the source-changed
                // copy, because the protected-search copy would assert a protected search page that never
                // existed in fallback mode.
                bool owedAuthoritative = SearchPaging.PendingRecoveryAuthoritative ?? true;
                SearchPaging.ClearPendingRecoveryScope();
                snapshot = snapshot with
                {
                    PagingRecovered = true,
                    PagingNotice = snapshot.PagingNotice is TenantListReason.None
                        ? owedAuthoritative
                            ? TenantListReason.SearchRefreshed
                            : TenantListReason.SearchPagingRestarted
                        : snapshot.PagingNotice,
                };
            }

            if (interactiveCircuit)
            {
                snapshot = ReconcileSearchPaging(snapshot);
            }

            // A term rejected for length is explained on the very load it caused, and only when nothing more
            // specific is already reported. Without this the operator watched their term vanish from the
            // input and the unfiltered list load, with no statement that a search had been refused at all.
            if (searchTermTooLong
                && snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized)
                && snapshot.Notice is TenantListReason.None)
            {
                snapshot = snapshot with { Notice = TenantListReason.SearchTermTooLong };
            }

            _snapshot = snapshot;
            _refreshingListKind = null;
            if (snapshot.Kind is TenantListSurfaceKind.Ready
                or TenantListSurfaceKind.Empty
                or TenantListSurfaceKind.FilteredEmpty
                or TenantListSurfaceKind.SearchPageEmpty
                or TenantListSurfaceKind.Stale
                or TenantListSurfaceKind.Degraded)
            {
                _lastConfirmedSnapshot = snapshot;
            }

            if (snapshot.Notice == TenantListReason.ListRefreshed)
            {
                TenantWorkspaceState recovered = CurrentWorkspaceState() with { Cursor = null };
                ApplyWorkspaceState(recovered, clearCursorHistory: true);
                NavigateToCanonicalWorkspaceIfNeeded(recovered);
            }

            ApplyVisibleRows();
        });
    }

    private async Task RefreshAsync()
    {
        StartGlobalAdministratorsEntryResolution();
        await LoadAsync(reuseETag: true);
    }

    private Task RefreshAuditAuthorityAsync()
    {
        StartGlobalAdministratorsEntryResolution();
        return Task.CompletedTask;
    }

    private bool AuditReadAvailable
        => CanReviewGlobalAdministrators
            && Services.GetService(typeof(ITenantsBffComposition)) is ITenantsBffComposition { IsReadSurfaceConnected: true };

    // Resolved authority that is neither authorized nor proven denied is indeterminate: say so rather than
    // blaming tenant scope. Pending authority and disconnection have their own entry-point copy.
    private string? AuditUnavailableReason
        => _auditAuthorityResolved && !AuditReadAvailable && !AuditReadDenied
            ? Localizer["Tenants.Audit.EntryPoint.Unavailable.AccessUnconfirmed"].Value
            : null;

    // Reconciles the two search paging modes. Crossing the authoritative/fallback boundary retires the
    // mode that is no longer active, so its Previous affordance cannot offer unreachable pages and a
    // retained protected cursor can never silently reactivate on a later recovery. Retiring a mode is
    // never silent: in both directions the operator gets a mapped, localized paging notice explaining why
    // paging jumped back to the first page, and the crossing notice yields its slot only to copy that
    // already explains a search restart. The mode itself lives in the circuit-scoped paging service, so
    // the crossing is still detected after a tenant-detail return recreates this component.
    private TenantListSnapshot ReconcileSearchPaging(TenantListSnapshot snapshot)
    {
        if (!HasActiveSearch)
        {
            SearchPaging.ClearActiveMode();
            return snapshot;
        }

        bool renderable = snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized);
        if (renderable)
        {
            bool authoritative = snapshot.IsAuthoritativeSearch;
            if (SearchPaging.ActiveModeAuthoritative is bool previousMode && previousMode != authoritative)
            {
                if (authoritative)
                {
                    SearchPaging.RecoverFallback();
                }
                else
                {
                    SearchPaging.RecoverSearch();
                }

                if (!ExplainsSearchRestart(snapshot.PagingNotice))
                {
                    snapshot = snapshot with { PagingNotice = TenantListReason.SearchPagingRestarted };
                }
            }

            SearchPaging.SetActiveMode(authoritative);
        }

        // Protected paging history is cleared on the very load that reports the invalidation, terminal
        // surfaces included: both bars render from the notice reasons alone and never consult Kind, so an
        // Error/Unauthorized surface still carries the copy that explains the clearing. No deferred or
        // pending mechanism exists, and none may be reintroduced -- a decision that outlives a load would
        // have to live in the circuit-scoped paging service, never in a component field a tenant-detail
        // return discards.
        if (snapshot.PagingRecovered || snapshot.Notice == TenantListReason.SearchRefreshed)
        {
            SearchPaging.RecoverSearch();
            if (!ExplainsSearchRestart(snapshot.Notice) && !ExplainsSearchRestart(snapshot.PagingNotice))
            {
                snapshot = snapshot with { PagingNotice = TenantListReason.SearchRefreshed };
            }
        }

        if (snapshot.FallbackPagingRecovered)
        {
            SearchPaging.RecoverFallback();
        }

        return snapshot;
    }

    // Copy that tells the operator protected search paging restarted from the first page. A load that
    // clears protected search history must always render one of these, in whichever slot carries it.
    private static bool ExplainsSearchRestart(TenantListReason reason)
        => reason is TenantListReason.SearchRefreshed or TenantListReason.SearchPagingRestarted;

    private async Task<TenantListSnapshot?> FindTenantProjectionEvidenceAsync(string tenantId)
    {
        string? caller = AuthenticatedUserId;
        if (string.IsNullOrWhiteSpace(caller))
        {
            return null;
        }

        // Proof always comes from this refresh, including its failure state, never retained matching rows.
        await LoadAsync(reuseETag: false);
        TenantListSnapshot proof = _snapshot;
        return !_disposed && string.Equals(caller, AuthenticatedUserId, StringComparison.Ordinal)
            && string.Equals(proof.CallerScope, TenantQueryGateway.AuditCallerScope(caller), StringComparison.Ordinal)
            ? proof : null;
    }

    private async Task ResetFiltersAsync()
    {
        // Clearing the search term must reload the full cursor list from the server, not re-filter the
        // (now stale) search snapshot still held in _snapshot.
        ApplyWorkspaceState(TenantWorkspaceState.FromQuery(
            tab: TenantWorkspaceState.TenantsTab,
            scope: TenantWorkspaceState.AllScope,
            userId: null,
            search: null,
            status: null,
            sort: null,
            sortDescending: null,
            cursor: null,
            selectedTenantId: null,
            anchor: null), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    /// <summary>
    /// The confirmed snapshot paging decisions may be read from. The rendering snapshot is transient
    /// while loading, and only same-scope soft refreshes retain its search mode and cursor fields.
    /// </summary>
    private TenantListSnapshot PagingSnapshot => _lastConfirmedSnapshot ?? _snapshot;

    /// <summary>
    /// The active paging mode, taken from the circuit-scoped service that owns the cursors it describes and
    /// survives the component recreation a tenant-detail return causes.
    /// </summary>
    private bool ActivePagingModeAuthoritative
        => SearchPaging.ActiveModeAuthoritative ?? PagingSnapshot.IsAuthoritativeSearch;

    private async Task NextPageAsync()
    {
        if (_pagingInFlight || _snapshot.Kind is TenantListSurfaceKind.Loading)
        {
            return;
        }

        _pagingInFlight = true;
        try
        {
            TenantListSnapshot paging = PagingSnapshot;
            if (HasActiveSearch)
            {
                // Refused when there is no next cursor, so Next can never record a back-step it cannot
                // honour and then enable a Previous that lands on the same page.
                if (SearchPaging.MoveNext(ActivePagingModeAuthoritative, paging.NextCursor))
                {
                    await LoadAsync(reuseETag: false);
                }

                return;
            }

            if (paging.NextCursor is null)
            {
                return;
            }

            _cursorHistory.Push(_currentCursor);
            ApplyWorkspaceState(CurrentWorkspaceState() with { Cursor = paging.NextCursor });
            NavigateToCanonicalWorkspace();
            await LoadAsync(reuseETag: false);
        }
        finally
        {
            _pagingInFlight = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_pagingInFlight || _snapshot.Kind is TenantListSurfaceKind.Loading)
        {
            return;
        }

        _pagingInFlight = true;
        try
        {
            if (HasActiveSearch)
            {
                if (SearchPaging.TryMovePrevious(ActivePagingModeAuthoritative))
                {
                    await LoadAsync(reuseETag: false);
                }

                return;
            }

            if (_cursorHistory.Count > 0)
            {
                ApplyWorkspaceState(CurrentWorkspaceState() with { Cursor = _cursorHistory.Pop() });
                NavigateToCanonicalWorkspace();
                await LoadAsync(reuseETag: false);
            }
        }
        finally
        {
            _pagingInFlight = false;
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        bool searchTermTooLong = TenantWorkspaceState.IsSearchTooLong(value);
        ApplyWorkspaceState(CurrentWorkspaceState().WithSearch(value), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false, searchTermTooLong: searchTermTooLong);
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        // The current backend has no status field, so this is an explicitly page-local presentation filter.
        // Reload page one first so the filter never silently retains an older cursor page.
        ApplyWorkspaceState(CurrentWorkspaceState().WithStatus(value), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    private async Task OnPageSizeChanged(int value)
    {
        int normalized = _pageSizes.Contains(value) ? value : 20;
        if (normalized == _pageSize)
        {
            return;
        }

        _pageSize = normalized;
        ApplyWorkspaceState(CurrentWorkspaceState() with { Cursor = null }, clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    private void ApplyVisibleRows()
    {
        IEnumerable<TenantListRow> rows = _snapshot.Rows;

        if (_snapshot.IsAuthoritativeSearch)
        {
            _visibleRows = _snapshot.Rows;
            return;
        }

        // Ordinary-list fallback retains the existing page-local status and sorting semantics.
        if (Enum.TryParse(_statusFilter, out TenantStatus status))
        {
            rows = rows.Where(r => r.Status == status);
        }

        rows = _sortColumn switch
        {
            TenantListSortColumns.Name => _sortDescending
                ? rows.OrderByDescending(r => r.Name, StringComparer.OrdinalIgnoreCase)
                : rows.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
            TenantListSortColumns.Status => _sortDescending
                ? rows.OrderByDescending(r => r.Status)
                : rows.OrderBy(r => r.Status),
            _ => _sortDescending
                ? rows.OrderByDescending(r => r.TenantId, StringComparer.Ordinal)
                : rows.OrderBy(r => r.TenantId, StringComparer.Ordinal),
        };

        _visibleRows = rows.ToArray();
    }

