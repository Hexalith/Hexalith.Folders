@page "/"
@page "/tenants"
@page "/tenants/tenants"
@page "/tenants/workspace-users"
@implements IDisposable
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.UI.Components.Users
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject IJSRuntime JS

<CascadingValue Value="@AuditReadAvailable" Name="AuditReadAvailable">
<CascadingValue Value="@(!_auditAuthorityResolved)" Name="AuditReadPending">
<CascadingValue Value="@AuditReadDenied" Name="AuditReadDenied">
<CascadingValue Value="@AuditUnavailableReason" Name="AuditReadUnavailableReason">
<CascadingValue Value="@((Func<Task>)RefreshAuditAuthorityAsync)" Name="AuditAuthorityRefresh">
<CascadingValue Value="@((Func<long>)(() => Volatile.Read(ref _auditRefreshVersion)))" Name="AuditAuthorityRefreshVersion">
<span hidden data-audit-focus-page-terminal="@(_auditAuthorityResolved && (IsUsersTab || _snapshot.Kind is not TenantListSurfaceKind.Loading))"
      data-audit-focus-heading="tenants-list-heading"
      data-audit-focus-active-origin="@ActiveAuditOrigin"></span>
<FcAggregateListPage TItem="TenantListRow"
                     @ref="_listPage"
                     LayoutMode="FcPageLayoutMode.FullWidth"
                     RootTestId="tenants-workspace"
                     RootClass="tenants-workspace"
                     PageTitle="@Localizer["Tenants.Workspace.Title"]"
                     Heading="@Localizer["Tenants.Workspace.Title"]"
                     HeadingId="tenants-list-heading"
                     HeadingTabIndex="-1"
                     Eyebrow="@Localizer["Tenants.Workspace.Eyebrow"]"
                     HeaderTestId="tenants-list-page-header">
    <Toolbar>
        @if (CanReviewGlobalAdministrators)
        {
            <FluentAnchorButton Href="@GlobalAdministratorsHref"
                                Appearance="ButtonAppearance.Outline"
                                data-testid="tenants-global-administrators-entry">
                @Localizer["Tenants.Navigation.GlobalAdministrators"]
            </FluentAnchorButton>
        }
    </Toolbar>
    <Body>
        @if (_auditReturnNotice)
        {
            <p role="status" data-testid="tenants-audit-return-notice">@Localizer["Tenants.Audit.Return.MissingOrigin"]</p>
        }
        @if (_auditStalledNotice)
        {
            <p role="status" data-testid="tenants-audit-stalled-return">@Localizer["Tenants.Audit.Return.Stalled"]</p>
        }
        @if (_auditPartialReturn)
        {
            <p role="status" data-testid="tenants-audit-partial-return">@Localizer["Tenants.Audit.Return.Partial"]</p>
        }
        @* FcPageTabs owns tab semantics, selection, roving focus, and the association to its
           Fluent-generated "${Id}-panel" tab panel. Each FcPageTab.ChildContent is the real panel
           content: FcPageTab retains it (via DeferredLoading) after first activation, so switching
           tabs preserves the panel component instance, local state, and in-flight work without
           Tenants hand-rolling its own hidden/aria-hidden panel wrapper. *@
        <FcPageTabs ActiveTabId="@(IsUsersTab ? "workspace-users" : TenantWorkspaceState.TenantsTab)"
                    ModuleRoute="/tenants"
                    DefaultTabId="@TenantWorkspaceState.TenantsTab"
                    ActiveTabIdChanged="OnActiveTabChanged"
                    AriaLabel="@Localizer["Tenants.Workspace.Tabs.Label"]"
                    TestId="tenants-workspace-tabs">
            <FcPageTab Id="@TenantWorkspaceState.TenantsTab"
                       Header="@Localizer["Tenants.Workspace.Tabs.Tenants"]"
                       DeferredLoading="true">
                <div data-testid="tenants-workspace-tenants-panel">
                <FluentStack Orientation="Orientation.Vertical"
                             VerticalGap="24px"
                             Width="100%"
                             data-testid="tenants-workspace-tenants-panel-content"
                             data-audit-focus-terminal="@(_auditAuthorityResolved && _snapshot.Kind is not TenantListSurfaceKind.Loading)">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalGap="12px"
                                 VerticalGap="12px"
                                 VerticalAlignment="VerticalAlignment.Bottom"
                                 Wrap="true"
                                 Width="100%">
                        <FluentSelect TOption="string" TValue="string"
                                      Value="@_tenantScope"
                                      ValueChanged="OnTenantScopeChanged"
                                      Label="@Localizer["Tenants.Workspace.Scope.Label"]"
                                      data-testid="tenants-workspace-scope"
                                      aria-label="@Localizer["Tenants.Workspace.Scope.Label"]">
                            <FluentOption TValue="string" Value="@TenantWorkspaceState.AllScope">@Localizer["Tenants.Workspace.Scope.All"]</FluentOption>
                            <FluentOption TValue="string" Value="@TenantWorkspaceState.MyScope">@Localizer["Tenants.Workspace.Scope.Mine"]</FluentOption>
                        </FluentSelect>

                        @if (IsRetainedTenantListView)
                        {
                            @* Maxlength stops the interactive path reaching the rejection at all: without it a
                               pasted over-length term was accepted by the input, dropped by normalization, and
                               the operator watched their own text disappear. A URL-supplied term still bypasses
                               the input, which is why the rejection also raises a localized notice. *@
                            <FluentTextInput TextInputType="TextInputType.Search"
                                             Value="@_search"
                                             ValueChanged="OnSearchChanged"
                                             MaxLength="TenantWorkspaceState.MaximumSearchLength"
                                             Immediate="true"
                                             ImmediateDelay="350"
                                             Label="@Localizer["Tenants.List.SearchLabel"]"
                                             Placeholder="@Localizer["Tenants.List.SearchPlaceholder"]"
                                             data-testid="tenants-list-search"
                                             aria-label="@Localizer["Tenants.List.SearchLabel"]" />
                            <FluentSelect TOption="string" TValue="string"
                                          Value="@_statusFilter"
                                          ValueChanged="OnStatusFilterChanged"
                                          Label="@Localizer[StatusFilterLabelKey]"
                                          data-testid="tenants-list-status-filter"
                                          aria-label="@Localizer[StatusFilterLabelKey]">
                                <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.List.StatusFilter.All"]</FluentOption>
                                <FluentOption TValue="string" Value="@TenantStatus.Active.ToString()">@Localizer["Tenants.List.StatusFilter.Active"]</FluentOption>
                                <FluentOption TValue="string" Value="@TenantStatus.Disabled.ToString()">@Localizer["Tenants.List.StatusFilter.Disabled"]</FluentOption>
                                <FluentOption TValue="string" Value="@TenantStatus.Unknown.ToString()">@Localizer["Tenants.List.StatusFilter.Unknown"]</FluentOption>
                            </FluentSelect>
                            <FluentSelect TOption="int" TValue="int"
                                          Value="@_pageSize"
                                          ValueChanged="OnPageSizeChanged"
                                          Label="@Localizer["Tenants.List.PageSizeLabel"]"
                                          data-testid="tenants-list-page-size"
                                          aria-label="@Localizer["Tenants.List.PageSizeLabel"]">
                                @foreach (int pageSize in _pageSizes)
                                {
                                    <FluentOption TValue="int" Value="@pageSize">
                                        @Localizer["Tenants.List.PageSizeOption", pageSize]
                                    </FluentOption>
                                }
                            </FluentSelect>
                            <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-list-refresh" OnClick="RefreshAsync">
                                @Localizer["Tenants.List.Refresh"]
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-reset" OnClick="ResetFiltersAsync">
                                @Localizer["Tenants.List.Reset"]
                            </FluentButton>
                        }
                    </FluentStack>
                    @if (IsRetainedTenantListView)
                    {
                        <FluentText As="TextTag.Paragraph"
                                    Size="TextSize.Size200"
                                    Color="Color.Lightweight"
                                    data-testid="tenants-list-page-local-semantics">
                            @Localizer[_snapshot.IsAuthoritativeSearch
                                ? "Tenants.List.AuthoritativeSearchSemantics"
                                : "Tenants.List.PageLocalSemantics"]
                        </FluentText>
                    }
                    @if (IsRetainedTenantListView && !string.IsNullOrWhiteSpace(_selectedTenantId))
                    {
                        <FluentText As="TextTag.Paragraph"
                                    Size="TextSize.Size300"
                                    Color="Color.Lightweight"
                                    data-testid="tenants-list-return-context">
                            @Localizer["Tenants.List.ReturnContext", _selectedTenantId]
                        </FluentText>
                    }
                    @if (IsRetainedMyTenantsView && !string.IsNullOrWhiteSpace(_selectedTenantId))
                    {
                        <FluentText As="TextTag.Paragraph"
                                    Size="TextSize.Size300"
                                    Color="Color.Lightweight"
                                    data-testid="tenants-my-return-context">
                            @Localizer["Tenants.MyTenants.ReturnContext", _selectedTenantId]
                        </FluentText>
                    }
                    @if (IsRetainedTenantListView)
                    {
                        <FluentAccordion ExpandMode="AccordionExpandMode.Multi">
                            <FluentAccordionItem Header="@Localizer["Tenants.Create.Title"]"
                                                 Expanded="@_createAccordionExpanded"
                                                 ExpandedChanged="@((bool expanded) => _createAccordionExpanded = expanded)"
                                                 data-testid="tenants-create-accordion">
                                <CascadingValue Value="@CreateAuditReturnUrl" Name="WorkspaceAuditReturnUrl">
                                <CreateTenantFlow IsAuthorized="@(CreateAuthorization is TenantLifecycleAuthorizationReflectionState.Authorized)"
                                                  AuthorizationReflection="@CreateAuthorization"
                                                  AuthorizationVersion="@_authorizationVersion"
                                                  AuthorizationReflectionProvider="@ReauthorizeCreateAsync"
                                                  IsFresh="@IsCreateFresh"
                                                  IsCommandSurfaceAvailable="@IsCommandSurfaceConnected"
                                                  BaselineProjectionVersion="@_snapshot.ProjectionVersion"
                                                  BaselineTenantAbsent="@IsAuthoritativeFirstTenantEmpty"
                                                  IsFirstTenantBootstrap="@IsFirstTenantBootstrap"
                                                  ShowHeading="false"
                                                  RestoreAuditReturn="@IsCreateAuditReturn"
                                                  OnProjectionRefreshRequested="RefreshAsync"
                                                  ProjectionEvidenceProvider="FindTenantProjectionEvidenceAsync" />
                                </CascadingValue>
                            </FluentAccordionItem>
                        </FluentAccordion>
                    }
                    @* Both notices share exactly one polite live region. Two sibling live regions announcing together
                       are routinely coalesced or dropped by screen readers, so the region wraps the bars instead. The
                       region itself renders unconditionally -- including across a workspace tab round trip, which must
                       not re-insert it together with an already-populated notice -- because a live region inserted in
                       the same render that first populates it is routinely not announced. Only the bars inside are
                       conditional. *@
                    @* Lifecycle evidence owns its own live region. Nesting the badge inside the notices stack
                       re-announced paging/info bars on every lifecycle change and kept Unavailable polite. *@
                    @if (IsRetainedTenantListView)
                    {
                        <ProjectionLifecycleStatus Lifecycle="@_snapshot.Lifecycle"
                                                   TestId="tenants-list-projection-lifecycle-status"
                                                   BadgeTestId="tenants-list-projection-lifecycle-status-badge" />
                    }
                    <FluentStack Orientation="Orientation.Vertical"
                                 VerticalGap="8px"
                                 Width="100%"
                                 role="status"
                                 aria-live="polite"
                                 aria-atomic="true"
                                 data-testid="tenants-list-notices">
                        @if (HasPrimaryNotice)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Info"
                                              Title="@NoticeMessage"
                                              data-testid="@NoticeTestId" />
                        }
                        @if (HasSecondaryNotice)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Info"
                                              Title="@PagingNoticeMessage"
                                              data-testid="@PagingNoticeTestId" />
                        }
                    </FluentStack>
                    @if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.Loading)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.Loading" />
                        @if (_refreshingListKind is TenantListSurfaceKind.Stale or TenantListSurfaceKind.Degraded)
                        {
                            <ListSurfaceStates Kind="@_refreshingListKind.Value"
                                               Reason="@(_refreshingListKind is TenantListSurfaceKind.Degraded ? _snapshot.Reason : TenantListReason.None)"
                                               OnRefresh="RefreshAsync" />
                        }
                    }
                    else if (IsRetainedTenantListView && _visibleRows.Count == 0 && HasPageLocalFilter && _snapshot.Kind is not (TenantListSurfaceKind.Degraded or TenantListSurfaceKind.Stale))
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.FilteredEmpty" OnReset="ResetFiltersAsync" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.FilteredEmpty)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.FilteredEmpty" OnReset="ResetFiltersAsync" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.SearchPageEmpty)
                    {
                        @* This surface offers the same way out as the filtered-empty verdict, because the operator who
                           simply mistyped the term would otherwise reach a dead end. Reason is deliberately NOT passed:
                           ListSurfaceStates prefers a reason string over the state message, so a window emptied with a
                           dropped record attached would render different copy than a genuine no-match and re-disclose
                           that candidates existed -- the exact difference this surface exists to erase. *@
                        <ListSurfaceStates Kind="TenantListSurfaceKind.SearchPageEmpty"
                                           HasMore="@_snapshot.HasMore"
                                           OnReset="ResetFiltersAsync" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.Empty)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.Empty" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.Error)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.Error" Reason="@_snapshot.Reason" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.Unauthorized)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.Unauthorized" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.Stale)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.Stale" OnRefresh="RefreshAsync" />
                    }
                    else if (IsRetainedTenantListView && _snapshot.Kind is TenantListSurfaceKind.Degraded)
                    {
                        <ListSurfaceStates Kind="TenantListSurfaceKind.Degraded" Reason="@_snapshot.Reason" />
                    }
                    @if (IsRetainedTenantListView && ShowList)
                    {
                        <TenantDataGrid Rows="@_visibleRows"
                                        AuditReadAvailable="@(AuditReadAvailable && _snapshot.Kind is TenantListSurfaceKind.Ready
                                            && _snapshot.Freshness is ReadModelFreshnessState.Current
                                            && _snapshot.Lifecycle is ProjectionLifecycleState.Current)"
                                        AuditReadDenied="@AuditReadDenied"
                                        AuditReadPending="@(!_auditAuthorityResolved)"
                                        AuditUnavailableReason="@AuditUnavailableReason"
                                        OnAuditRefresh="@RefreshAsync"
                                        DetailHref="CreateDetailHref"
                                        AuditHref="CreateAuditHref"
                                        SortColumn="@_sortColumn"
                                        SortDescending="@_sortDescending"
                                        PreserveRowOrder="@_snapshot.IsAuthoritativeSearch"
                                        SortChanged="OnTenantSortChanged" />
                    }
                    else if (IsRetainedMyTenantsView)
                    {
                        <MyTenantsPanel InitialCursor="@_tenantWorkspaceState.Cursor" UseWorkspaceRoute="true" AuditReadAvailable="@AuditReadAvailable" AuditReadDenied="@AuditReadDenied" AuditReadResolved="@_auditAuthorityResolved" OnAuditRefresh="@RefreshAuditAuthorityAsync" />
                    }
                    @if (ShowPager)
                    {
                        <nav aria-label="@Localizer["Tenants.List.PaginationLabel"]">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="12px" Wrap="true">
                                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-previous" Disabled="@(!HasPreviousPage)" OnClick="PreviousPageAsync">
                                    @Localizer["Tenants.List.Previous"]
                                </FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-next" Disabled="@(!HasNextPage)" OnClick="NextPageAsync">
                                    @Localizer["Tenants.List.Next"]
                                </FluentButton>
                            </FluentStack>
                        </nav>
                    }
                </FluentStack>
                </div>
            </FcPageTab>
            <FcPageTab Id="workspace-users"
                       Header="@Localizer["Tenants.Workspace.Tabs.Users"]"
                       DeferredLoading="true">
                <div data-testid="tenants-workspace-users-panel">
                    <UserMembershipLookupPanel InitialUserId="@_usersWorkspaceState.UserId"
                                               InitialSort="@_usersWorkspaceState.Sort"
                                               InitialCursor="@_usersWorkspaceState.Cursor"
                                               AuditFocus="@QueryAuditFocus"
                                               AuditPartialReturn="@QueryAuditPartialReturn"
                                               AuditReturnUnavailable="@QueryAuditReturnUnavailable"
                                               AuditReadAvailable="@AuditReadAvailable"
                                               AuditReadDenied="@AuditReadDenied"
                                               AuditReadResolved="@_auditAuthorityResolved"
                                               OnAuditRefresh="@RefreshAuditAuthorityAsync"
                                               UseWorkspaceRoute="true"
                                               ShowBackLink="false" />
                </div>
            </FcPageTab>
        </FcPageTabs>
    </Body>
</FcAggregateListPage>
</CascadingValue>
</CascadingValue>
</CascadingValue>
</CascadingValue>
</CascadingValue>
</CascadingValue>

@code {
    private static readonly int[] _pageSizes = [20, 50, 100];
    private TenantListSnapshot _snapshot = TenantListSnapshot.Loading();
    private TenantListSurfaceKind? _refreshingListKind;
    private string? _renderedStatusFilterLabel;
    private long _auditRefreshVersion;
    private TenantListSnapshot? _lastConfirmedSnapshot;
    private TenantWorkspaceState _workspaceState = TenantWorkspaceState.FromQuery(
        tab: null,
        scope: null,
        userId: null,
        search: null,
        status: null,
        sort: null,
        sortDescending: null,
        cursor: null,
        selectedTenantId: null,
        anchor: null);
    private TenantWorkspaceState _tenantWorkspaceState = TenantWorkspaceState.FromQuery(
        tab: null,
        scope: null,
        userId: null,
        search: null,
        status: null,
        sort: null,
        sortDescending: null,
        cursor: null,
        selectedTenantId: null,
        anchor: null);
    private TenantWorkspaceState _usersWorkspaceState = TenantWorkspaceState.FromQuery(
        tab: TenantWorkspaceState.UsersTab,
        scope: null,
        userId: null,
        search: null,
        status: null,
        sort: null,
        sortDescending: null,
        cursor: null,
        selectedTenantId: null,
        anchor: null);
    private IReadOnlyList<TenantListRow> _visibleRows = [];
    private readonly Stack<string?> _cursorHistory = new();
    private string? _currentCursor;
    private int _pageSize = 20;
    private string? _search;
    private string? _statusFilter;
    private string _sortColumn = TenantListSortColumns.TenantId;
    private bool _sortDescending;
    private string? _selectedTenantId;
    private string? _returnAnchor;
    private string _activeTabId = TenantWorkspaceState.TenantsTab;
    private string _tenantScope = TenantWorkspaceState.AllScope;
    private FcAggregateListPage<TenantListRow> _listPage = default!;
    private bool _focusHeadingPending;
    private string? _pendingAuditFocus;
    private string? _handledAuditFocus;
    private string? _pendingDetailFocus;
    private string? _handledDetailFocus;
    private bool _auditReturnNotice;
    private bool _auditStalledNotice;
    private bool _auditPartialReturn;
    private bool _consumedFocuslessReturn;
    private bool _createAccordionExpanded;
    private bool _handledMissingAuditReturn;
    private bool _initialized;
    private bool _disposed;
    private bool _restoreSearchPagingContextPending = true;
    private TenantLifecycleAuthorizationReflectionState _createAuthorization = TenantLifecycleAuthorizationReflectionState.Indeterminate;
    private string? _createAuthorityUserId;
    private bool HasCurrentCallerAuthority
        => !_disposed && _auditAuthorityResolved && Volatile.Read(ref _pendingAuditCallerVersion) == 0
            && Volatile.Read(ref _resolvedAuditCallerVersion) == Volatile.Read(ref _auditCallerVersion)
            && !string.IsNullOrWhiteSpace(_createAuthorityUserId)
            && string.Equals(_createAuthorityUserId, AuthenticatedUserId, StringComparison.Ordinal);

    private bool CanReviewGlobalAdministrators
        => HasCurrentCallerAuthority && _canReviewGlobalAdministrators;

    private bool AuditReadDenied
        => HasCurrentCallerAuthority && _auditReadDenied;

    private TenantLifecycleAuthorizationReflectionState CreateAuthorization
        => IsTenantListView && HasCurrentCallerAuthority
            ? _createAuthorization : TenantLifecycleAuthorizationReflectionState.Indeterminate;

    private bool _canReviewGlobalAdministrators;
    private bool _auditAuthorityResolved;
    private bool _auditReadDenied;
    private long _auditCallerVersion;
    private long _resolvedAuditCallerVersion;
    private long _pendingAuditCallerVersion;

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditFocus")]
    public string? QueryAuditFocus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditPartialReturn")]
    public bool QueryAuditPartialReturn { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditReturnUnavailable")]
    public bool QueryAuditReturnUnavailable { get; set; }
    private AuthenticationStateProvider? _authenticationStateProvider;
    private long _authorizationVersion;
    private CancellationTokenSource? _entryAuthorizationCancellation;
    private CancellationTokenSource? _authenticationStateCancellation;
    private CancellationTokenSource? _createAuthorizationCancellation;
    private long _workspaceVersion;

    // Blazor Server does not serialise async event handlers, and a pager button stays live until the
    // render batch that disables it is acknowledged. Without this guard a second click landed while
    // _snapshot was the transient Loading() value and mutated the cursor stack of the wrong paging mode.
    private bool _pagingInFlight;

    private long _loadVersion;
    private CancellationTokenSource? _loadCancellation;
    private readonly Lock _loadCancellationLock = new();
    private TenantSearchPagingState? _searchPaging;

    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "scope")]
    public string? QueryScope { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? QuerySort { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "desc")]
    public string? QuerySortDescending { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "cursor")]
    public string? QueryCursor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "selected")]
    public string? QuerySelectedTenantId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "anchor")]
    public string? QueryAnchor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "userId")]
    public string? QueryUserId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RouteTabFromLocation
    {
        get
        {
            string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return path.Equals("tenants/workspace-users", StringComparison.OrdinalIgnoreCase)
                ? TenantWorkspaceState.UsersTab
                : path.Equals("tenants/tenants", StringComparison.OrdinalIgnoreCase)
                    ? TenantWorkspaceState.TenantsTab
                    : null;
        }
    }

    private bool IsTenantsTab
        => string.Equals(_activeTabId, TenantWorkspaceState.TenantsTab, StringComparison.Ordinal);

    private bool IsCreateAuditReturn
        => string.Equals(QueryAuditFocus, "tenants-create-lifecycle", StringComparison.Ordinal);

    private string ActiveAuditOrigin
        => IsUsersTab ? "tenants-user-lookup"
            : IsMyTenantsView ? "tenants-my-page"
            : "tenants-workspace-tenants-panel-content";

    private bool IsUsersTab
        => string.Equals(_activeTabId, TenantWorkspaceState.UsersTab, StringComparison.Ordinal);

    private bool IsTenantListView
        => IsTenantsTab && string.Equals(_tenantScope, TenantWorkspaceState.AllScope, StringComparison.Ordinal);

    private bool IsMyTenantsView
        => IsTenantsTab && string.Equals(_tenantScope, TenantWorkspaceState.MyScope, StringComparison.Ordinal);

    private bool IsRetainedTenantListView
        => string.Equals(_tenantWorkspaceState.Scope, TenantWorkspaceState.AllScope, StringComparison.Ordinal);

    private bool IsRetainedMyTenantsView
        => string.Equals(_tenantWorkspaceState.Scope, TenantWorkspaceState.MyScope, StringComparison.Ordinal);

    private bool HasPageLocalFilter
        => !_snapshot.IsAuthoritativeSearch && !string.IsNullOrWhiteSpace(_statusFilter);

    private bool HasActiveSearch
        => !string.IsNullOrWhiteSpace(_search);

    // The first-tenant exception is only for a list that is authoritatively empty for the whole
    // authorization scope. A page past the end of a non-empty list also reports Empty, and a projection
    // that is Rebuilding, Degraded, Stale, Unavailable, or LocalOnly is ambiguous rather than "no first
    // write yet", so both must fail closed instead of opening create.
    private bool IsAuthoritativeFirstTenantEmpty
        => _snapshot.Kind is TenantListSurfaceKind.Empty
            && _snapshot.IsAuthorizationScopedEmpty
            && _snapshot.Rows.Count == 0
            && string.IsNullOrWhiteSpace(_snapshot.RequestCursor)
            && _snapshot.Lifecycle is ProjectionLifecycleState.Unknown or ProjectionLifecycleState.Current;

    private bool IsCreateFresh
        => _snapshot.Freshness is ReadModelFreshnessState.Current
            || (_snapshot.Freshness is ReadModelFreshnessState.Unknown && IsAuthoritativeFirstTenantEmpty);

    private bool IsFirstTenantBootstrap
        => _snapshot.Freshness is ReadModelFreshnessState.Unknown && IsAuthoritativeFirstTenantEmpty;

    private bool IsCommandSurfaceConnected
        => Services.GetService(typeof(ITenantsBffComposition)) is ITenantsBffComposition bffComposition
            && bffComposition.IsCommandSurfaceConnected;

    // The scoped paging service resolved on a non-interactive (static SSR / prerender) render pass belongs
    // to that request's scope, not to the interactive circuit, so retained protected paging must neither be
    // restored nor reported from it. The cascading HttpContext cannot carry this signal: it does not cross
    // render-mode boundaries and is null on both passes of an InteractiveServer component.
    private bool IsInteractiveCircuit
        => RendererInfo.IsInteractive;

    private bool HasValidatedTenantDetailReturnContext
        => !string.IsNullOrWhiteSpace(_selectedTenantId)
            && string.Equals(QuerySelectedTenantId, _selectedTenantId, StringComparison.Ordinal)
            && string.Equals(QueryAnchor, _returnAnchor, StringComparison.Ordinal)
            && string.Equals(_returnAnchor, TenantDomIdentity.ElementId("tenant-row-", _selectedTenantId), StringComparison.Ordinal);

    private bool HasPreviousPage
        => _snapshot.Kind is not TenantListSurfaceKind.Loading && HasPreviousListPage;

    private bool HasPreviousListPage
        => HasActiveSearch
            ? IsInteractiveCircuit && SearchPaging.HasPrevious(ActivePagingModeAuthoritative)
            : _cursorHistory.Count > 0;

    // Next is offered only when the click can actually advance. Enablement read _snapshot.HasMore while both
    // branches of NextPageAsync require a non-null cursor, and the ordinary list path passes the server's
    // HasMore and Cursor through independently with no consistency check -- so HasMore = true beside a null
    // cursor produced a live button whose every click did nothing: no load, no re-render, no notice. The
    // Loading explicitly disables Next even when a soft refresh retains the previous page's cursor.
    private bool HasNextPage
        => _snapshot.Kind is not TenantListSurfaceKind.Loading
            && _snapshot.HasMore && PagingSnapshot.NextCursor is not null;

    // Resolved as a required service so a dropped registration fails loudly instead of silently degrading
    // to per-component paging that cannot survive tenant-detail navigation.
    private TenantSearchPagingState SearchPaging
        => _searchPaging ??= Services.GetRequiredService<TenantSearchPagingState>();

