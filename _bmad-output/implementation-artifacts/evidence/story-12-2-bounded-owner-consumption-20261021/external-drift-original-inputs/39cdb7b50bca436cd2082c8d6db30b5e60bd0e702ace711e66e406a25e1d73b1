    private async Task RefreshGlobalCorrectionEvidenceForLoadAsync(
        string tenantId, long generation, CancellationToken cancellationToken)
    {
        GlobalAdministratorsSnapshot projection;
        TenantLifecycleAuthorizationReflectionState authorization;
        try
        {
            authorization = await BffComposition.ResolveGlobalAdministratorsAuthorizationAsync(cancellationToken)
                .ConfigureAwait(false);
            projection = authorization is TenantLifecycleAuthorizationReflectionState.Authorized
                ? await GlobalAdministratorsProjectionLoader.LoadAsync(QueryGateway, cancellationToken: cancellationToken)
                    .ConfigureAwait(false)
                : GlobalAdministratorsSnapshot.Unauthorized();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            authorization = TenantLifecycleAuthorizationReflectionState.Indeterminate;
            projection = GlobalAdministratorsSnapshot.Unavailable();
        }

        await InvokeAsync(() =>
        {
            if (!CanApply(tenantId, generation))
            {
                return;
            }

            _globalAdministratorsProjection = projection;
            _globalCorrectionAuthorized = authorization is TenantLifecycleAuthorizationReflectionState.Authorized;
            if (_globalCorrectionIntent is { } active
                && _globalCorrectionPanel?.Snapshot is not { LifecycleState: TenantCommandLifecycleState.RequestSent }
                && _globalCorrectionPanel?.Snapshot?.HasCommandTracking != true)
            {
                TenantAuditRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
                    string.Equals(candidate.EventReference, active.OriginalAuditReference, StringComparison.Ordinal));
                if (row is not null)
                {
                    _globalCorrectionIntent = CreateCorrectionIntent(row);
                }
            }

            ResolveReceiptSelection();
            StateHasChanged();
        }).ConfigureAwait(false);
    }

