    private bool TryCreateRequest(
        string tenantId,
        string? cursor,
        string? eTag,
        out TenantAuditRequest? request)
    {
        if (!TenantAuditNavigationSafety.IsSafeTenantId(tenantId))
        {
            request = null;
            return false;
        }

        bool fromValid = TryParseDate(_fromText, out DateTimeOffset? from);
        bool toValid = TryParseDate(_toText, out DateTimeOffset? to);
        AuditEventCategory parsedCategory = default;
        bool categoryValid = string.IsNullOrEmpty(_categoryText)
            || (Enum.TryParse(_categoryText, ignoreCase: false, out parsedCategory)
                && Enum.IsDefined(parsedCategory));
        AuditEventCategory? category = categoryValid && !string.IsNullOrEmpty(_categoryText)
            ? parsedCategory
            : null;
        bool rangeValid = !fromValid || !toValid || from is null || to is null || from <= to;

        _fromValidationKey = !fromValid
            ? "Tenants.Audit.Filter.Validation.FromUtc"
            : !rangeValid
                ? "Tenants.Audit.Filter.Validation.Range"
                : null;
        _toValidationKey = !toValid
            ? "Tenants.Audit.Filter.Validation.ToUtc"
            : !rangeValid
                ? "Tenants.Audit.Filter.Validation.Range"
                : null;
        _categoryValidationKey = categoryValid
            ? null
            : "Tenants.Audit.Filter.Validation.Category";

        if (!fromValid || !toValid || !categoryValid || !rangeValid)
        {
            // A failed local edit invalidates any prior read, including one still in flight. Keep no
            // success chrome or rows under filters that were never submitted to the server.
            Interlocked.Increment(ref _loadGeneration);
            CancelActiveCancellation();
            _snapshot = TenantAuditSnapshot.Error(new TenantAuditRequest(tenantId), TenantAuditReason.InvalidFilters);
            ResolveReceiptSelection();
            request = null;
            return false;
        }

        request = new(
            tenantId,
            From: from,
            To: to,
            Category: category,
            Cursor: cursor,
            PageSize: PageSize,
            ETag: eTag);
        return true;
    }

