    private async Task RefreshFromNotificationAsync(string tenantId)
    {
        if (_disposed || _filtersDirty || !string.Equals(TenantId, tenantId, StringComparison.Ordinal))
        {
            return;
        }

        _isNotificationRefreshing = true;
        StateHasChanged();
        try
        {
            await LoadAsync(reuseETag: true, retainConfirmed: true, requestedTenantId: tenantId).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // Superseded or torn down; the newer load owns the surface.
        }
        catch
        {
            // This runs on a notification callback, not on a render path. An unhandled fault here would
            // escape into the SignalR dispatch loop rather than being rendered, and the nudge is optional
            // anyway -- the last-confirmed rows stay visible and manual refresh still works.
        }
        finally
        {
            // Guard disposal: a notification arriving as the circuit tears down would otherwise call
            // InvokeAsync on a disposed component and throw ObjectDisposedException.
            if (!_disposed)
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        _isNotificationRefreshing = false;
                        StateHasChanged();
                    });
                }
                catch (ObjectDisposedException)
                {
                    // Disposed between the check above and the dispatch; nothing left to update.
                }
            }
        }
    }

