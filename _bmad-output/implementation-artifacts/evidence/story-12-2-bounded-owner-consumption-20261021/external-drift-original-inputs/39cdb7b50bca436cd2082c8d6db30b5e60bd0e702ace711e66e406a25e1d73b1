    private async Task OpenGlobalCorrectionAsync(TenantCorrectionStartIntent intent, string origin)
    {
        if (!HasAuthorizedAuditSurface || !HasMeasuredSafeViewport || !intent.IsAvailable
            || !string.Equals(TenantId, "system", StringComparison.Ordinal)
            || _globalCorrectionIntent is not null
                && _globalCorrectionPanel?.Snapshot is { } activeSnapshot
                && (activeSnapshot.LifecycleState is TenantCommandLifecycleState.RequestSent
                    || activeSnapshot.HasCommandTracking))
        {
            return;
        }

        int generation = Interlocked.Increment(ref _correctionOpenGeneration);
        GlobalAdministratorsSnapshot? projection;
        TenantLifecycleAuthorizationReflectionState authorization;
