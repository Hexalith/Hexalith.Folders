    private async Task RefreshPairedGlobalReceiptAsync()
    {
        long generation = Interlocked.Increment(ref _pairedProofGeneration);
        GlobalAdministratorCorrectionProofRegistry? registry = Services.GetService<GlobalAdministratorCorrectionProofRegistry>();
        IReadOnlyList<GlobalAdministratorCorrectionSnapshot> retainedPairs = registry?.FindAll(_selectedReceiptReference ?? string.Empty) ?? [];
        IReadOnlyList<GlobalAdministratorReconciliationState> pendingCompletions = registry?.PendingCompletions() ?? [];
        string? selectedReference = _selectedReceiptReference;
        List<TenantCorrectionProofLink> verified = [];
        Dictionary<string, TenantAuditRow> rows = new(StringComparer.Ordinal);
        try
        {
            if (selectedReference is not null
                && (retainedPairs.Count > 0 || pendingCompletions.Count > 0)
                && string.Equals(TenantId, "system", StringComparison.Ordinal)
                && HasAuthorizedAuditSurface
                && await BffComposition.ResolveGlobalAdministratorsAuthorizationAsync(CancellationToken.None)
                    .ConfigureAwait(false) is TenantLifecycleAuthorizationReflectionState.Authorized)
            {
                GlobalAdministratorsSnapshot? completeProjection = pendingCompletions.Count > 0
                    ? await GlobalAdministratorsProjectionLoader.LoadAsync(QueryGateway, cancellationToken: CancellationToken.None)
                        .ConfigureAwait(false)
                    : null;
                if (completeProjection is { } projection
                    && GlobalAdministratorCorrectionSnapshot.ProjectionIsReadable(projection)
                    && projection.IsCompleteEvidence && !projection.HasMore)
                {
                    foreach (GlobalAdministratorReconciliationState pending in pendingCompletions)
                    {
                        try
                        {
                            string originalType = pending.ActionKind is GlobalAdministratorActionKind.Grant
                                ? "GlobalAdministratorRemoved" : "GlobalAdministratorSet";
                            TenantAuditRow? original = pending.SourceAuditReference is { } sourceReference
                                && pending.SourceAuditTimestampUtc is { } sourceTime
                                ? await FindOriginalGlobalAuditRowAsync(
                                    sourceReference, sourceTime, pending.TargetUserId, originalType).ConfigureAwait(false)
                                : null;
                            if (original is null || pending.CorrelationId is null
                                || pending.CommittedEventSequence is not > 0
                                || pending.SubmittedAtUtc is not { } submittedAt)
                            {
                                continue;
                            }

                            (GlobalAdministratorAuditProof? corrective, bool complete) = await QueryGateway
                                .FindGlobalAdministratorCorrectionProofAsync(
                                    pending.CorrelationId, pending.CommittedEventSequence.Value, pending.TargetUserId,
                                    pending.ActionKind is GlobalAdministratorActionKind.Grant
                                        ? "GlobalAdministratorSet" : "GlobalAdministratorRemoved",
                                    original.Timestamp, submittedAt, CancellationToken.None).ConfigureAwait(false);
                            GlobalAdministratorCorrectionSnapshot? proven = complete && corrective is not null
                                ? GlobalAdministratorCorrectionSnapshot.RebuildVerifiedCompletion(
                                    pending, original, projection, corrective)
                                : null;
                            if (proven?.ProofLink is not { } provenLink)
                            {
                                continue;
                            }

                            registry?.Remember(proven);
                            if (string.Equals(selectedReference, provenLink.OriginalAuditReference, StringComparison.Ordinal)
                                || string.Equals(selectedReference, provenLink.CorrectiveAuditReference, StringComparison.Ordinal))
                            {
                                verified.Add(provenLink);
                                rows[provenLink.OriginalAuditReference] = original;
                                rows[provenLink.CorrectiveAuditReference] = corrective!.Row;
                            }
                        }
                        catch (Exception)
                        {
                            // A pending completion remains available for the next authorized recheck.
                        }
                    }
                }

                foreach (GlobalAdministratorCorrectionSnapshot retained in retainedPairs)
                {
                    try
                    {
                        if (retained.ProofLink is not { } proof || retained.CorrelationId is null
                            || retained.CommittedEventSequence is not > 0
                            || retained.SubmittedAtUtc is not { } submittedAtUtc)
                        {
                            continue;
                        }

                        (GlobalAdministratorAuditProof? correctiveProof, bool complete) = await QueryGateway
                            .FindGlobalAdministratorCorrectionProofAsync(
                                retained.CorrelationId,
                                retained.CommittedEventSequence.Value,
                                retained.TargetUserId,
                                retained.CorrectiveEventType,
                                proof.OriginalTimestamp,
                                submittedAtUtc,
                                CancellationToken.None).ConfigureAwait(false);
                        TenantAuditRow? corrective = correctiveProof?.Row;
                        if (!complete || corrective is null
                            || !string.Equals(corrective.EventReference, proof.CorrectiveAuditReference, StringComparison.Ordinal))
                        {
                            continue;
                        }

                        TenantAuditRow? original = await FindOriginalGlobalAuditRowAsync(retained).ConfigureAwait(false);
                        if (original is null)
                        {
                            continue;
                        }

                        verified.Add(proof);
                        rows[proof.OriginalAuditReference] = original;
                        rows[proof.CorrectiveAuditReference] = corrective;
                    }
                    catch (Exception)
                    {
                        // One unavailable protected pair cannot hide independently verified neighbors.
                    }
                }
            }
        }
        catch (Exception)
        {
            // Missing or unstable protected evidence leaves the paired receipt unavailable.
        }

        await InvokeAsync(() =>
        {
            if (!_disposed && generation == Volatile.Read(ref _pairedProofGeneration)
                && string.Equals(_selectedReceiptReference, selectedReference, StringComparison.Ordinal))
            {
                _verifiedGlobalProofs.Clear();
                _verifiedGlobalRows.Clear();
                if (string.Equals(TenantId, "system", StringComparison.Ordinal) && HasAuthorizedAuditSurface)
                {
                    _verifiedGlobalProofs.AddRange(verified);
                    foreach (KeyValuePair<string, TenantAuditRow> row in rows)
                    {
                        _verifiedGlobalRows[row.Key] = row.Value;
                    }
                }
                ResolveReceiptSelection();
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    private async Task<TenantAuditRow?> FindOriginalGlobalAuditRowAsync(GlobalAdministratorCorrectionSnapshot retained)
    {
        TenantCorrectionProofLink proof = retained.ProofLink!;
        return await FindOriginalGlobalAuditRowAsync(
            proof.OriginalAuditReference,
            proof.OriginalTimestamp,
            retained.TargetUserId,
            retained.CorrectiveEventType is "GlobalAdministratorSet"
                ? "GlobalAdministratorRemoved" : "GlobalAdministratorSet").ConfigureAwait(false);
    }

    private async Task<TenantAuditRow?> FindOriginalGlobalAuditRowAsync(
        string reference, DateTimeOffset timestamp, string targetUserId, string originalEventType)
    {
        var visited = new HashSet<string>(StringComparer.Ordinal);
        string? cursor = null;
        string? version = null;
        TenantAuditRow? original = null;
        for (int page = 0; page < 50; page++)
        {
            TenantAuditRequest request = new("system", From: timestamp,
                To: timestamp, Cursor: cursor, Stream: "global-administrators");
            TenantAuditSnapshot audit = await QueryGateway.GetTenantAuditAsync(request, null, CancellationToken.None)
                .ConfigureAwait(false);
            if (audit.Kind is not TenantAuditSurfaceKind.Ready and not TenantAuditSurfaceKind.Empty
                and not TenantAuditSurfaceKind.FilteredEmpty
                || audit.Freshness is not ReadModelFreshnessState.Current
                || audit.Lifecycle is not ProjectionLifecycleState.Current
                || !audit.MatchesScope(request)
                || audit.Rows.Count > request.PageSize
                || !TenantLifecycleProjectionVersion.IsOrdered(audit.ProjectionVersion)
                || audit.HasMore == string.IsNullOrWhiteSpace(audit.NextCursor)
                || version is not null && !string.Equals(version, audit.ProjectionVersion, StringComparison.Ordinal))
            {
                return null;
            }

            version ??= audit.ProjectionVersion;
            foreach (TenantAuditRow row in audit.Rows)
            {
                if (string.Equals(row.EventReference, reference, StringComparison.Ordinal)
                    && string.Equals(row.TenantId, "system", StringComparison.Ordinal)
                    && string.Equals(row.Scope, "system", StringComparison.Ordinal)
                    && row.Category is AuditEventCategory.Access
                    && string.Equals(row.Target, targetUserId, StringComparison.Ordinal)
                    && row.Timestamp == timestamp
                    && string.Equals(row.EventType, originalEventType, StringComparison.Ordinal)
                    && TenantAuditReceipt.FromRow(row, audit.Kind).State is TenantAuditReceiptState.Ready)
                {
                    if (original is not null) return null;
                    original = row;
                }
            }

            if (!audit.HasMore) return original;
            if (string.IsNullOrWhiteSpace(audit.NextCursor) || !visited.Add(audit.NextCursor)) return null;
            cursor = audit.NextCursor;
        }

        return null;
    }

