@page "/tenants/{TenantId}/audit"
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.EventStore.Client.Gateway
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject ITenantsBffComposition BffComposition
@inject IJSRuntime JS
@inject IServiceProvider Services

<FcPageLayout Mode="FcPageLayoutMode.FullWidth">
    <FluentStack Orientation="Orientation.Vertical"
                 VerticalGap="16px"
                 Class="tenant-audit"
                 data-testid="tenants-audit-surface"
                 aria-labelledby="tenant-audit-heading">
    <FcPageHeader PageTitle="@Localizer["Tenants.Audit.Title", TenantDisplayName]"
                  Heading="@Localizer["Tenants.Audit.Title", TenantDisplayName]"
                  HeadingId="tenant-audit-heading"
                  HeadingTabIndex="-1"
                  Eyebrow="@Localizer["Tenants.Audit.Eyebrow"]"
                  Description="@Localizer["Tenants.Audit.Description"]"
                  TestId="tenants-audit-page-header">
        <Metadata>
        @if (HasContext)
        {
            <p class="tenant-audit__context"
               data-testid="tenants-audit-context"
               aria-live="@ContextLiveRegion">
                @ContextText
            </p>
        }
        @if (SafeBackReturnUrl is not null)
        {
            <p class="tenant-audit__return-context" data-testid="tenants-audit-return-context">
                @Localizer[HasBackLauncherFocus ? "Tenants.Audit.ReturnContext" : "Tenants.Audit.ReturnContext.NoFocus", BackOriginLabel]
            </p>
        }
        </Metadata>
        <Actions>
            <a class="tenant-audit__back" href="@BackHref" data-testid="tenants-audit-back">@Localizer["Tenants.Audit.BackTo", BackOriginLabel]</a>
        </Actions>
    </FcPageHeader>

    <FluentAccordion Class="tenant-audit__support"
                     ExpandMode="AccordionExpandMode.Multi"
                     Block="true">
        <FluentAccordionItem Header="@Localizer["Tenants.Audit.ControlsLabel"]"
                             Expanded="true">
            <section class="tenant-audit__controls" aria-label="@Localizer["Tenants.Audit.ControlsLabel"]">
                <FluentGrid Spacing="3" Class="tenant-audit__controls-layout">
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        @* Fluent v5's TextInputType enum has no datetime-local member, so the native datetime-local
                           picker is requested with a splatted type attribute on the FluentTextInput. The bound value
                           stays a string and is interpreted as UTC by ParseDate, preserving the existing range logic. *@
                        <FluentTextInput Value="@_fromText"
                                         ValueChanged="OnFromChanged"
                                         Label="@Localizer["Tenants.Audit.Filter.FromUtc"]"
                                         type="datetime-local"
                                         data-testid="tenants-audit-filter-from"
                                         aria-label="@Localizer["Tenants.Audit.Filter.FromUtc"]"
                                         aria-invalid="@(_fromValidationKey is null ? "false" : "true")"
                                         aria-describedby="@(_fromValidationKey is null ? null : "tenants-audit-filter-from-error")" />
                        @if (_fromValidationKey is not null)
                        {
                            <p id="tenants-audit-filter-from-error" role="alert" data-testid="tenants-audit-filter-from-error">
                                @Localizer[_fromValidationKey]
                            </p>
                        }
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        <FluentTextInput Value="@_toText"
                                         ValueChanged="OnToChanged"
                                         Label="@Localizer["Tenants.Audit.Filter.ToUtc"]"
                                         type="datetime-local"
                                         data-testid="tenants-audit-filter-to"
                                         aria-label="@Localizer["Tenants.Audit.Filter.ToUtc"]"
                                         aria-invalid="@(_toValidationKey is null ? "false" : "true")"
                                         aria-describedby="@(_toValidationKey is null ? null : "tenants-audit-filter-to-error")" />
                        @if (_toValidationKey is not null)
                        {
                            <p id="tenants-audit-filter-to-error" role="alert" data-testid="tenants-audit-filter-to-error">
                                @Localizer[_toValidationKey]
                            </p>
                        }
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        <FluentSelect TOption="string" TValue="string"
                                      Value="@_categoryText"
                                      ValueChanged="OnCategoryChanged"
                                      Label="@Localizer["Tenants.Audit.Filter.Category"]"
                                      data-testid="tenants-audit-filter-category"
                                      aria-label="@Localizer["Tenants.Audit.Filter.Category"]"
                                      aria-invalid="@(_categoryValidationKey is null ? "false" : "true")"
                                      aria-describedby="@(_categoryValidationKey is null ? null : "tenants-audit-filter-category-error")">
                            <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.Audit.Filter.Category.All"]</FluentOption>
                            <FluentOption TValue="string" Value="@AuditEventCategory.Access.ToString()">@Localizer["Tenants.Audit.Category.Access"]</FluentOption>
                            <FluentOption TValue="string" Value="@AuditEventCategory.Administrative.ToString()">@Localizer["Tenants.Audit.Category.Administrative"]</FluentOption>
                        </FluentSelect>
                        @if (_categoryValidationKey is not null)
                        {
                            <p id="tenants-audit-filter-category-error" role="alert" data-testid="tenants-audit-filter-category-error">
                                @Localizer[_categoryValidationKey]
                            </p>
                        }
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalGap="12px" Wrap="true">
                            <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-audit-apply" OnClick="ApplyFiltersAsync">
                                @Localizer["Tenants.Audit.Apply"]
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-audit-refresh" OnClick="RefreshAsync">
                                @Localizer["Tenants.Audit.Refresh"]
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-audit-reset" OnClick="ResetFiltersAsync">
                                @Localizer["Tenants.Audit.Reset"]
                            </FluentButton>
                        </FluentStack>
                    </FluentGridItem>
                </FluentGrid>
                @if (_filtersDirty)
                {
                    <p data-testid="tenants-audit-filter-pending">@Localizer["Tenants.Audit.Filter.Pending"]</p>
                }
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@Localizer[$"Tenants.Audit.State.{ResourceState}.Title"]"
                             Expanded="true">
            <section class="tenant-audit__state tenant-audit__state--@ResourceState.ToLowerInvariant()"
                     role="@StatusRole"
                     aria-live="@StatusLive"
                     tabindex="0"
                     data-testid="@StateTestId">
                <span class="tenant-audit__state-icon" aria-hidden="true">@StateIcon</span>
                <div class="tenant-audit__state-copy">
                    <h2>@Localizer[$"Tenants.Audit.State.{ResourceState}.Title"]</h2>
                    <p data-testid="tenants-audit-live-region">@Localizer[$"Tenants.Audit.State.{ResourceState}.Message"]</p>
                </div>
            </section>
            @* Lifecycle evidence is a sibling of the state section, not a child. StatusRole/StatusLive
               resolve to alert/assertive for non-Ready states; nesting the badge re-announced the whole
               state block. The wrapper owns polite/alert escalation for Unavailable. *@
            <ProjectionLifecycleStatus Lifecycle="@_snapshot.Lifecycle"
                                       TestId="tenants-audit-projection-lifecycle-status"
                                       BadgeTestId="tenants-audit-projection-lifecycle-status-badge" />
            @if (HasStateRecovery)
            {
                <FluentStack Orientation="Orientation.Vertical"
                             VerticalGap="0.5rem"
                             data-testid="tenants-audit-recovery">
                    <p data-testid="tenants-audit-recovery-description">
                        @Localizer[$"Tenants.Audit.Recovery.{ResourceState}"]
                    </p>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true">
                        @if (CanResetForState)
                        {
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          data-testid="tenants-audit-recovery-reset"
                                          OnClick="ResetFiltersAsync">
                                @Localizer["Tenants.Audit.Recovery.Action.Reset"]
                            </FluentButton>
                        }
                        @if (CanRefreshForState)
                        {
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          data-testid="tenants-audit-recovery-refresh"
                                          OnClick="RefreshAsync">
                                @Localizer["Tenants.Audit.Recovery.Action.Refresh"]
                            </FluentButton>
                        }
                        @if (CanContinueReadOnlyForState)
                        {
                            <a href="#tenant-audit-grid-heading" data-testid="tenants-audit-recovery-continue">
                                @Localizer["Tenants.Audit.Recovery.Action.ContinueReadOnly"]
                            </a>
                        }
                        @if (_snapshot.Kind is TenantAuditSurfaceKind.Unauthorized && PermissionRecoveryHref is { } permissionHref)
                        {
                            <a href="@permissionHref" data-testid="tenants-audit-recovery-permission">
                                @Localizer["Tenants.Audit.Recovery.Action.RequestPermission"]
                            </a>
                        }
                        @if (EscalatesFailedRead)
                        {
                            <a href="@EscalationRecoveryHref" data-testid="tenants-audit-recovery-escalate">
                                @Localizer["Tenants.Audit.Recovery.Action.Escalate"]
                            </a>
                        }
                    </FluentStack>
                </FluentStack>
            }
            @* Rendered as a sibling of the state section, not a child. StatusRole/StatusLive resolve to
               alert/assertive for the non-Ready states, and inserting or removing a child mutates that
               region's own subtree -- so every projection nudge re-announced the whole state block
               assertively and interrupted the screen-reader user. The nudge is a polite, non-authoritative
               signal and must own its live region. *@
            @if (_isNotificationRefreshing)
            {
                <p class="tenant-audit__nudge" role="status" aria-live="polite" data-testid="tenants-audit-notification-refreshing">
                    @Localizer["Tenants.Audit.Freshness.Refreshing"]
                </p>
            }
        </FluentAccordionItem>
    </FluentAccordion>

    @if (ShouldRenderRows)
    {
        <section class="tenant-audit__grid-shell" aria-labelledby="tenant-audit-grid-heading"
                 data-audit-response-count="@_snapshot.Rows.Count"
                 data-audit-page-size="@PageSize"
                 data-audit-next-cursor-present="@(!string.IsNullOrWhiteSpace(_snapshot.NextCursor) ? "true" : "false")">
            <h2 id="tenant-audit-grid-heading">@Localizer["Tenants.Audit.GridTitle"]</h2>
            <AuditDataGrid Rows="@_snapshot.Rows"
                           HasViewportMeasurement="@(_viewportObservation?.HasMeasurement == true)"
                           IsCorrectionViewportSafe="@HasMeasuredSafeViewport"
                           OnOpenReceipt="OpenReceiptAsync"
                           CorrectionIntentProvider="CreateCorrectionIntent"
                           OnRoleSelected="SelectCorrectionRoleAsync"
                           OnStartCorrection="OpenGridCorrectionAsync" />
            @if (_activeCorrectionIntent is not null)
            {
                <TenantCorrectionStartPanel Intent="@_activeCorrectionIntent"
                                            OnHandoff="HandoffCorrectionAsync"
                                            OnClose="CloseCorrectionAsync" />
            }
            @if (_pagingJumpedToFirstPage)
            {
                <p role="status" aria-live="polite" data-testid="tenants-audit-history-truncated">
                    @Localizer["Tenants.Audit.Recovery.HistoryTruncated"]
                </p>
            }
            <nav class="tenant-audit__pager" aria-label="@Localizer["Tenants.Audit.PaginationLabel"]">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-audit-previous" Disabled="@(_filtersDirty || _pageLoadInFlight || _cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                        @Localizer["Tenants.Audit.Previous"]
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-audit-next" Disabled="@(_filtersDirty || _pageLoadInFlight || !_snapshot.HasMore || string.IsNullOrWhiteSpace(_snapshot.NextCursor))" OnClick="NextPageAsync">
                        @Localizer["Tenants.Audit.Next"]
                    </FluentButton>
                </FluentStack>
            </nav>
        </section>
    }
    @if (HasAuthorizedRetainedSurface && _previewCorrectionIntent is not null
        && (HasAuthorizedAuditSurface || HasDisplayedRetainedCorrection))
    {
        <CorrectionStartPanel Intent="@_previewCorrectionIntent"
                              @ref="_correctionPreview"
                              StartProjection="@_previewCorrectionIntent.CurrentProjection"
                              ShowCompetingAttemptNotice="@_competingCorrectionNotice"
                              RetainedAttemptMessageId="@_resumedCorrectionMessageId"
                              OnOpenOriginalReceipt="OpenOriginalCorrectionReceiptAsync"
                              OnClose="CloseCorrectionAsync" />
    }
    @if (HasAuthorizedRetainedSurface && _globalCorrectionIntent is not null)
    {
        <GlobalAdministratorCorrectionPanel Intent="@_globalCorrectionIntent"
                                            @ref="_globalCorrectionPanel"
                                            CurrentProjection="@_globalAdministratorsProjection"
                                            ProjectionRefreshProvider="RefreshGlobalAdministratorsProjectionAsync"
                                            OnProofAvailable="OnGlobalProofAvailableAsync"
                                            OnClose="CloseGlobalCorrectionAsync" />
    }
    @if (HasAuthorizedRetainedSurface && _previewCorrectionIntent is null && RetainedCorrectionAttempt is not null)
    {
        <FluentButton Appearance="ButtonAppearance.Outline"
                      data-testid="tenants-correction-resume"
                      OnClick="ResumeCorrectionAsync">
            @Localizer["Tenants.Correction.Resume"]
        </FluentButton>
    }
    @if (_selectedReceipt is not null && !Volatile.Read(ref _authenticationTransitionPending))
    {
        <AuditEvidenceReceipt Receipt="@_selectedReceipt"
                              PairedReceiptReferences="@PairedGlobalReceiptReferences"
                              OnOpenPairedReceipt="OpenPairedGlobalReceiptAsync"
                              CorrectionIntent="@(_selectedReceiptFromCorrectionPreview && _previewCorrectionIntent is not null ? null : _selectedReceiptCorrectionIntent)"
                              IsCorrectionViewportSafe="@HasMeasuredSafeViewport"
                              OnStartCorrection="OpenReceiptCorrectionAsync"
                              OnRoleSelected="SelectCorrectionRoleAsync"
                              OnRetry="RefreshAsync"
                              OnReset="ResetFiltersAsync"
                              UseResetRecovery="@HasFilterValidation"
                              HostEscalatesFailedRead="@EscalatesFailedRead"
                              OnClose="CloseReceiptAsync" />
    }
    </FluentStack>
</FcPageLayout>

@code {
    private const string FocusModulePath = "./js/tenantsFocus.js";
    private const int PageSize = 50;
    private bool _filtersDirty;
    /// <summary>Upper bound on retained paging history.</summary>
    private const int MaximumCursorHistory = CursorHistory.DefaultMaximum;

    private readonly Stack<string?> _cursorHistory = new();

    // Set when CursorHistory.Trim drops entries, cleared when the resulting jump has been announced. The
    // trim re-appends the first-page sentinel beneath the newest entries, so one later Previous click moves
    // the operator from the middle of the sequence to page one -- which the pager would otherwise render as
    // an ordinary one-page step back.
    private bool _pagingHistoryTruncated;
    private bool _pagingJumpedToFirstPage;
    private TenantAuditSnapshot _snapshot = TenantAuditSnapshot.Loading();
    private string? _currentCursor;
    private string? _fromText;
    private string? _toText;
    private string? _categoryText;
    private string? _fromValidationKey;
    private string? _toValidationKey;
    private string? _categoryValidationKey;
    private TenantAuditReceipt? _selectedReceipt;
    private string? _selectedReceiptReference;
    private string? _lastRouteReceiptReference;
    private string? _dismissedReceiptReference;
    private bool _selectedReceiptFromLauncher;
    private bool _selectedReceiptFromCorrectionPreview;
    private string? _pendingReceiptFocus;
    private long _receiptFocusGeneration;
    private TenantCorrectionStartIntent? _selectedReceiptCorrectionIntent;
    private TenantCorrectionStartIntent? _activeCorrectionIntent;
    private TenantCorrectionStartIntent? _previewCorrectionIntent;
    private bool _competingCorrectionNotice;
    private string? _resumedCorrectionMessageId;
    private CorrectionStartPanel? _correctionPreview;
    private TenantCorrectionStartIntent? _globalCorrectionIntent;
    private GlobalAdministratorCorrectionPanel? _globalCorrectionPanel;
    private readonly List<TenantCorrectionProofLink> _verifiedGlobalProofs = [];
    private readonly Dictionary<string, TenantAuditRow> _verifiedGlobalRows = new(StringComparer.Ordinal);
    private long _pairedProofGeneration;
    private GlobalAdministratorsSnapshot? _globalAdministratorsProjection;
    private bool _globalCorrectionAuthorized;
    private readonly Dictionary<string, TenantCorrectionProjection> _correctionProjections = new(StringComparer.Ordinal);
    private string? _activeCorrectionOrigin;
    private string? _pendingCorrectionOrigin;
    private int _correctionOpenGeneration;
    private long _correctionProjectionGeneration;
    private IAsyncDisposable? _readRefreshLease;
    private string? _loadedTenantId;
    private string? _initialLoadStartedTenantId;
    private string? _subscriptionTenantId;
    private bool _readRefreshSubscriptionInFlight;
    private string? _pendingSubscriptionTenantId;
    private readonly Lock _readRefreshSubscriptionLock = new();
    private bool _isNotificationRefreshing;
    private bool _pageLoadInFlight;
    private bool _disposed;
    private bool _authenticationTransitionPending;
    private long _authenticationTransitionVersion;
    private AuthenticationStateProvider? _authenticationStateProvider;
    private long _loadGeneration;
    private long _routeGeneration;
    private CancellationTokenSource? _loadCancellation;
    // Serialises the active-cancellation swap. A superseded source is cancelled immediately -- which is what
    // callers observe -- but NOT disposed there: disposing one at the moment it is replaced races the
    // request still inside SendAsync, where a CancellationToken.Register after Dispose throws
    // ObjectDisposedException, which is not an OperationCanceledException and so slips past every caller's
    // cancellation-only handler. Disposal is owned solely by CompleteCancellation, which the owning
    // PendingOperation calls when its operation finishes. A prior version also tracked superseded sources in
    // a List; nothing ever read it, so it is removed rather than left to read as a retention mechanism.
    private readonly Lock _cancellationLock = new();
    private readonly Dictionary<string, TenantRole> _selectedCorrectionRoles = new(StringComparer.Ordinal);
    private IJSObjectReference? _focusModule;
    private string? _activeCorrectionFocusReference;
    private string? _pendingCorrectionFocusReference;
    private long _correctionFocusGeneration;
    private TenantHighImpactViewportObservation? _viewportObservation;

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "targetUserId")]
    public string? TargetUserId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "supportSafeCommandReference")]
    public string? SupportSafeCommandReference { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnFocus")]
    public string? ReturnFocus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "source")]
    public string? SourceKind { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditPartialReturn")]
    public bool AuditPartialReturn { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "receiptReference")]
    public string? ReceiptReference { get; set; }

    private string? SafeBackReturnUrl
    {
        get
        {
            string? safe = TenantAuditNavigationSafety.SafeReturnUrlForTenant(ReturnUrl, TenantId, out _);
            if (safe is null)
            {
                return null;
            }

            string? anchor = TenantAuditNavigationSafety.ReturnQueryValue(safe, "anchor");
            string? existingFocus = TenantAuditNavigationSafety.ReturnQueryValue(safe, "auditFocus");
            return ReturnFocus is not null
                && (!TenantAuditNavigationSafety.IsFocusForReturnUrl(safe, ReturnFocus)
                    || (anchor is not null && !string.Equals(anchor, ReturnFocus, StringComparison.Ordinal))
                    || (existingFocus is not null && !string.Equals(existingFocus, ReturnFocus, StringComparison.Ordinal)))
                ? null
                : safe;
        }
    }

    private bool HasBackLauncherFocus
        => SafeBackReturnUrl is { } safe
            && (TenantAuditNavigationSafety.IsFocusForReturnUrl(safe, ReturnFocus)
                || TenantAuditNavigationSafety.ReturnQueryValue(safe, "auditFocus") is not null);

    private string BackOriginLabel
    {
        get
        {
            string? safe = SafeBackReturnUrl;
            if (safe is null)
            {
                return ReturnUrl is null && ReturnFocus is null
                    && TenantAuditNavigationSafety.IsSafeTenantId(TenantId)
                    && TenantId is not ("my" or "users")
                    ? Localizer["Tenants.Audit.Context.SourceKind.TenantDetail"]
                    : Localizer["Tenants.Audit.Context.SourceKind.TenantList"];
            }

            string path = safe.Split('?', 2)[0];
            return path switch
            {
                "/tenants/my" => Localizer["Tenants.Audit.Context.SourceKind.MyTenants"],
                "/tenants/users" => Localizer["Tenants.Audit.Context.SourceKind.UserLookup"],
                "/tenants" when TenantAuditNavigationSafety.ReturnQueryValue(safe, "tab") is "users"
                    => Localizer["Tenants.Audit.Context.SourceKind.UserLookup"],
                "/tenants" when TenantAuditNavigationSafety.ReturnQueryValue(safe, "scope") is "mine"
                    => Localizer["Tenants.Audit.Context.SourceKind.MyTenants"],
                "/tenants" => Localizer["Tenants.Audit.Context.SourceKind.TenantList"],
                _ => Localizer["Tenants.Audit.Context.SourceKind.TenantDetail"],
            };
        }
    }

    private string BackHref
    {
        get
        {
            if (ReturnFocus is not null && !TenantAuditNavigationSafety.IsSafeFocus(ReturnFocus))
            {
                return "/tenants?auditReturnUnavailable=true";
            }

            string? safe = SafeBackReturnUrl;
            _ = TenantAuditNavigationSafety.SafeReturnUrlForTenant(ReturnUrl, TenantId, out bool strippedCursor);
            if (safe is null)
            {
                return ReturnUrl is null && ReturnFocus is null && TenantAuditNavigationSafety.IsSafeTenantId(TenantId)
                    && TenantId is not ("my" or "users")
                    ? $"/tenants/{Uri.EscapeDataString(TenantId)}"
                    : "/tenants?auditReturnUnavailable=true";
            }

            // SafeBackReturnUrl already rejected a return focus that conflicts with the route, anchor, or nested focus.
            string? existingFocus = TenantAuditNavigationSafety.ReturnQueryValue(safe, "auditFocus");
            if (ReturnFocus is not null && existingFocus is null)
            {
                safe += (safe.Contains('?', StringComparison.Ordinal) ? "&" : "?")
                    + "auditFocus=" + Uri.EscapeDataString(ReturnFocus!);
            }

            if ((AuditPartialReturn || strippedCursor) && !safe.Contains("auditPartialReturn=", StringComparison.Ordinal))
            {
                safe += (safe.Contains('?', StringComparison.Ordinal) ? "&" : "?") + "auditPartialReturn=true";
            }

            return safe;
        }
    }

    private string? PermissionRecoveryHref
        => TenantAuditNavigationSafety.SafeRecoveryHref(BffComposition.AuditPermissionRecoveryHref);

    private string? EscalationRecoveryHref
        => TenantAuditNavigationSafety.SafeRecoveryHref(BffComposition.AuditEscalationRecoveryHref);

    // The one condition under which the page renders its escalation link for a failed read. The markup renders
    // the link from this property, and the receipt receives it, so the receipt never offers a second link for
    // the same failure and never drops the only one.
    private bool EscalatesFailedRead
        => HasStateRecovery
            && _snapshot.Kind is TenantAuditSurfaceKind.Unavailable or TenantAuditSurfaceKind.Error
            && EscalationRecoveryHref is not null;

    // Never echo an unsafe direct-route identifier into the heading or document title.
    private string TenantDisplayName
        => TenantAuditNavigationSafety.IsSafeTenantId(TenantId)
            ? TenantId
            : Localizer["Tenants.Audit.UnknownTenant"].Value;

    private bool HasContext
        => SafeTargetUserId is not null
            || SafeCommandReference is not null
            || !string.IsNullOrWhiteSpace(SourceKind);

    private string? SafeTargetUserId
        => TenantAuditNavigationSafety.IsSafeIdentifier(TargetUserId) ? TargetUserId : null;

    private string? SafeCommandReference
        => TenantAuditNavigationSafety.IsSafeHint(SupportSafeCommandReference) ? SupportSafeCommandReference : null;

    // Context restoration is informational, never a blocking state, so it is always polite.
    private string ContextLiveRegion
        => "polite";

    private string ContextText
        => SafeTargetUserId is { } safeTarget
            ? Localizer["Tenants.Audit.Context.User", GlobalAdministratorIdentityDisplay.Encode(safeTarget)]
            : SafeCommandReference is { } safeCommand
                ? Localizer["Tenants.Audit.Context.Command", safeCommand]
                : Localizer["Tenants.Audit.Context.Source", SourceLabel];

    // Resolve the machine source kind to a localized whole phrase so raw tokens never reach visible copy.
    private string SourceLabel
        => SourceKind switch
        {
            "tenant-list" => Localizer["Tenants.Audit.Context.SourceKind.TenantList"],
            "tenant-detail" => Localizer["Tenants.Audit.Context.SourceKind.TenantDetail"],
            "member-row" => Localizer["Tenants.Audit.Context.SourceKind.MemberRow"],
            "user-lookup" => Localizer["Tenants.Audit.Context.SourceKind.UserLookup"],
            "my-tenants" => Localizer["Tenants.Audit.Context.SourceKind.MyTenants"],
            "command-result" => Localizer["Tenants.Audit.Context.SourceKind.CommandResult"],
            _ => Localizer["Tenants.Audit.Context.SourceKind.Default"],
        };

    private bool ShouldRenderRows
        => !Volatile.Read(ref _authenticationTransitionPending)
            && (_snapshot.Kind is TenantAuditSurfaceKind.Ready
            or TenantAuditSurfaceKind.Stale
            or TenantAuditSurfaceKind.Degraded
            or TenantAuditSurfaceKind.ListRefreshed)
            && _snapshot.Rows.Count > 0
            && !HasFilterValidation;

    private bool HasAuthorizedAuditSurface
        => HasAuthorizedRetainedSurface
            && (_snapshot.Kind is TenantAuditSurfaceKind.Ready
            or TenantAuditSurfaceKind.Empty
            or TenantAuditSurfaceKind.FilteredEmpty
            or TenantAuditSurfaceKind.ListRefreshed)
            && _snapshot.Freshness is ReadModelFreshnessState.Current;

    private bool HasAuthorizedRetainedSurface
        => !Volatile.Read(ref _authenticationTransitionPending)
            && (_snapshot.Kind is TenantAuditSurfaceKind.Ready
            or TenantAuditSurfaceKind.Empty
            or TenantAuditSurfaceKind.FilteredEmpty
            or TenantAuditSurfaceKind.ListRefreshed
            or TenantAuditSurfaceKind.Stale
            or TenantAuditSurfaceKind.Degraded)
            && string.Equals(_snapshot.TenantId, TenantId, StringComparison.Ordinal);

    private bool HasFilterValidation
        => _fromValidationKey is not null
            || _toValidationKey is not null
            || _categoryValidationKey is not null;

    private bool HasMeasuredSafeViewport
        => _viewportObservation is { HasMeasurement: true, State: TenantHighImpactViewportState.Safe };

    private bool HasStateRecovery
        => HasFilterValidation || _snapshot.Kind is TenantAuditSurfaceKind.Empty
            or TenantAuditSurfaceKind.FilteredEmpty
            or TenantAuditSurfaceKind.Stale
            or TenantAuditSurfaceKind.Degraded
            or TenantAuditSurfaceKind.Unauthorized
            or TenantAuditSurfaceKind.InvalidCursor
            or TenantAuditSurfaceKind.ListRefreshed
            or TenantAuditSurfaceKind.Unavailable
            or TenantAuditSurfaceKind.Error;

    private bool CanResetForState
        => HasFilterValidation || _snapshot.Kind is TenantAuditSurfaceKind.FilteredEmpty;

    private bool CanRefreshForState
        => !HasFilterValidation && _snapshot.Kind is TenantAuditSurfaceKind.Empty
            or TenantAuditSurfaceKind.FilteredEmpty
            or TenantAuditSurfaceKind.Stale
            or TenantAuditSurfaceKind.Degraded
            or TenantAuditSurfaceKind.InvalidCursor
            or TenantAuditSurfaceKind.ListRefreshed
            or TenantAuditSurfaceKind.Unavailable
            or TenantAuditSurfaceKind.Error;

    private bool CanContinueReadOnlyForState
        => ShouldRenderRows
            && _snapshot.Kind is TenantAuditSurfaceKind.Stale
                or TenantAuditSurfaceKind.Degraded
                or TenantAuditSurfaceKind.ListRefreshed;

    private string ResourceState => HasFilterValidation ? "InvalidFilters" : _snapshot.Kind switch
    {
        TenantAuditSurfaceKind.Loading => "Loading",
        TenantAuditSurfaceKind.Ready => "Ready",
        TenantAuditSurfaceKind.Empty => "Empty",
        TenantAuditSurfaceKind.FilteredEmpty => "FilteredEmpty",
        TenantAuditSurfaceKind.Stale => "Stale",
        TenantAuditSurfaceKind.Degraded => "Degraded",
        TenantAuditSurfaceKind.Unauthorized => "Unauthorized",
        TenantAuditSurfaceKind.InvalidCursor => "InvalidCursor",
        TenantAuditSurfaceKind.ListRefreshed => "ListRefreshed",
        TenantAuditSurfaceKind.Unavailable => "Unavailable",
        TenantAuditSurfaceKind.Error => "Error",
        _ => "Error",
    };

    private string StateTestId
        => $"tenants-audit-{TestIdState(ResourceState)}";

    private string StatusRole
        => HasFilterValidation || _snapshot.Kind is TenantAuditSurfaceKind.Unauthorized
            or TenantAuditSurfaceKind.InvalidCursor
            or TenantAuditSurfaceKind.Degraded
            or TenantAuditSurfaceKind.Unavailable
            or TenantAuditSurfaceKind.Error
                ? "alert"
                : "status";

    private string StatusLive => StatusRole == "alert" ? "assertive" : "polite";

    private string StateIcon => _snapshot.Kind switch
    {
        TenantAuditSurfaceKind.Ready => "OK",
        TenantAuditSurfaceKind.Empty => "0",
        TenantAuditSurfaceKind.FilteredEmpty => "0",
        TenantAuditSurfaceKind.Loading => "...",
        TenantAuditSurfaceKind.ListRefreshed => "R",
        TenantAuditSurfaceKind.Stale => "!",
        TenantAuditSurfaceKind.Degraded => "!",
        TenantAuditSurfaceKind.InvalidCursor => "!",
        _ => "?",
    };

    protected override void OnInitialized()
    {
        _authenticationStateProvider = Services.GetService<AuthenticationStateProvider>();
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        }

        _viewportObservation = Services.GetService<TenantHighImpactViewportObservation>();
        if (_viewportObservation is not null)
        {
            _viewportObservation.StateChanged += OnViewportObservationChanged;
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        long version = Interlocked.Increment(ref _authenticationTransitionVersion);
        Volatile.Write(ref _authenticationTransitionPending, true);
        Interlocked.Increment(ref _correctionOpenGeneration);
        Interlocked.Increment(ref _pairedProofGeneration);
        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation();
        Task callback = InvokeAsync(() => ApplyAuthenticationStateChangedAsync(authenticationStateTask, version));
        _ = ObserveAuthenticationStateChangeAsync(callback);
    }

    private async Task ApplyAuthenticationStateChangedAsync(Task<AuthenticationState> authenticationStateTask, long version)
    {
        IAsyncDisposable? previousLease = null;
        await InvokeAsync(() =>
        {
            if (_disposed || version != Volatile.Read(ref _authenticationTransitionVersion))
            {
                return;
            }

            previousLease = _readRefreshLease;
            _readRefreshLease = null;
            _subscriptionTenantId = null;
            _initialLoadStartedTenantId = null;
            ClearPaging();
            _snapshot = TenantAuditSnapshot.Loading(TenantId);
            _selectedReceipt = null;
            _selectedReceiptCorrectionIntent = null;
            _activeCorrectionIntent = null;
            _previewCorrectionIntent = null;
            _globalCorrectionIntent = null;
            _globalAdministratorsProjection = null;
            _globalCorrectionAuthorized = false;
            _verifiedGlobalProofs.Clear();
            _verifiedGlobalRows.Clear();
            StateHasChanged();
        }).ConfigureAwait(false);
        if (previousLease is not null)
        {
            await DisposeLeaseSupportSafelyAsync(previousLease).ConfigureAwait(false);
        }

        try
        {
            _ = await authenticationStateTask.ConfigureAwait(false);
        }
        catch
        {
            await InvokeAsync(() =>
            {
                if (_disposed || version != Volatile.Read(ref _authenticationTransitionVersion))
                {
                    return;
                }

                _snapshot = TenantAuditSnapshot.Unavailable(new TenantAuditRequest(TenantId));
                Volatile.Write(ref _authenticationTransitionPending, false);
                StateHasChanged();
            }).ConfigureAwait(false);
            return;
        }

        if (_disposed || version != Volatile.Read(ref _authenticationTransitionVersion))
        {
            return;
        }

        string? tenantId = null;
        await InvokeAsync(() =>
        {
            if (!_disposed && version == Volatile.Read(ref _authenticationTransitionVersion))
            {
                tenantId = TenantId;
                _initialLoadStartedTenantId = tenantId;
                Volatile.Write(ref _authenticationTransitionPending, false);
            }
        }).ConfigureAwait(false);
        if (tenantId is not null && !_disposed && version == Volatile.Read(ref _authenticationTransitionVersion))
        {
            await LoadAsync(reuseETag: false, retainConfirmed: false, requestedTenantId: tenantId)
                .ConfigureAwait(false);
            await EnsureReadRefreshSubscriptionAsync(tenantId).ConfigureAwait(false);
        }
    }

    private static async Task ObserveAuthenticationStateChangeAsync(Task callback)
    {
        try
        {
            await callback.ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // The renderer was disposed while the authentication callback was queued.
        }
    }

    private void OnViewportObservationChanged(object? sender, EventArgs args)
        => _ = RenderViewportChangeAsync();

    private async Task RenderViewportChangeAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (!HasMeasuredSafeViewport && _selectedReceiptCorrectionIntent?.IsAvailable is true)
            {
                await CaptureReceiptFocusForReplacementAsync(correctionOnly: true).ConfigureAwait(false);
            }

            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                if (!HasMeasuredSafeViewport && !HasSubmittedCorrection && !HasDisplayedRetainedCorrection)
                {
                    Interlocked.Increment(ref _correctionOpenGeneration);
                    if (_activeCorrectionIntent is not null || _previewCorrectionIntent is not null)
                    {
                        ScheduleCorrectionFocus(_activeCorrectionFocusReference, _activeCorrectionOrigin);
                    }
                    _activeCorrectionIntent = null;
                    _previewCorrectionIntent = null;
                    _activeCorrectionFocusReference = null;
                }

                ResolveReceiptSelection();
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // Navigation disposed the renderer between the alive check and queued callback.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        string tenantId = TenantId;
        long routeGeneration = Interlocked.Increment(ref _routeGeneration);
        if (!TenantAuditNavigationSafety.IsSafeTenantId(tenantId))
        {
            Interlocked.Increment(ref _loadGeneration);
            CancelActiveCancellation();
            IAsyncDisposable? invalidLease = _readRefreshLease;
            _readRefreshLease = null;
            _subscriptionTenantId = null;
            await InvokeAsync(() =>
            {
                ClearPaging();
                _snapshot = TenantAuditSnapshot.Unavailable(new TenantAuditRequest("invalid"));
                _loadedTenantId = null;
                _initialLoadStartedTenantId = null;
                _selectedReceiptReference = null;
                _selectedReceiptFromLauncher = false;
                _selectedReceiptFromCorrectionPreview = false;
                _selectedReceipt = null;
                _selectedReceiptCorrectionIntent = null;
                _activeCorrectionIntent = null;
                _previewCorrectionIntent = null;
                _globalCorrectionIntent = null;
                _globalAdministratorsProjection = null;
                _globalCorrectionAuthorized = false;
                Interlocked.Increment(ref _pairedProofGeneration);
                _verifiedGlobalProofs.Clear();
                _verifiedGlobalRows.Clear();
                _dismissedReceiptReference = null;
                _lastRouteReceiptReference = ReceiptReference;
                StateHasChanged();
            }).ConfigureAwait(false);
            if (invalidLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(invalidLease).ConfigureAwait(false);
            }
            return;
        }

        bool tenantChanged = !string.Equals(_loadedTenantId, tenantId, StringComparison.Ordinal);
        bool receiptRouteChanged = !string.Equals(_lastRouteReceiptReference, ReceiptReference, StringComparison.Ordinal);
        if (tenantChanged)
        {
            IAsyncDisposable? previousLease = _readRefreshLease;
            _readRefreshLease = null;
            _subscriptionTenantId = null;
            await InvokeAsync(() =>
            {
                ClearPaging();
                _filtersDirty = false;
                _snapshot = TenantAuditSnapshot.Loading(tenantId);
                _loadedTenantId = tenantId;
                _initialLoadStartedTenantId = null;
                _dismissedReceiptReference = null;
                _selectedReceiptReference = null;
                _selectedReceiptFromLauncher = false;
                _selectedReceiptFromCorrectionPreview = false;
                _activeCorrectionIntent = null;
                _globalCorrectionIntent = null;
                _globalAdministratorsProjection = null;
                _globalCorrectionAuthorized = false;
                Interlocked.Increment(ref _pairedProofGeneration);
                _verifiedGlobalProofs.Clear();
                _verifiedGlobalRows.Clear();
                TenantCorrectionAttempt? retained = RetainedCorrectionAttempt;
                _previewCorrectionIntent = retained is { BlocksAdmission: true } ? retained.Snapshot.Intent : null;
                _resumedCorrectionMessageId = _previewCorrectionIntent is null ? null : retained?.MessageId;
                _activeCorrectionFocusReference = _previewCorrectionIntent?.OriginalAuditReference;
                _activeCorrectionOrigin = _previewCorrectionIntent is null ? null : "grid";
                _competingCorrectionNotice = false;
                _lastRouteReceiptReference = ReceiptReference;
                ResolveReceiptSelection();
                if (ReceiptReference is not null)
                {
                    ScheduleReceiptHeadingFocus();
                }
                StateHasChanged();
            }).ConfigureAwait(false);
            if (previousLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(previousLease).ConfigureAwait(false);
            }
            if (routeGeneration != Volatile.Read(ref _routeGeneration))
            {
                return;
            }
        }

        bool needsInitialLoad = !string.Equals(_initialLoadStartedTenantId, tenantId, StringComparison.Ordinal);
        if (!tenantChanged)
        {
            if (receiptRouteChanged)
            {
                bool hadReceipt = _selectedReceipt is not null;
                string? previousReference = _selectedReceiptReference;
                _lastRouteReceiptReference = ReceiptReference;
                _dismissedReceiptReference = null;
                _selectedReceiptReference = null;
                _selectedReceiptFromLauncher = false;
                _selectedReceiptFromCorrectionPreview = false;
                ResolveReceiptSelection();
                if (ReceiptReference is null && hadReceipt)
                {
                    ScheduleReceiptFocus(previousReference);
                }
                else if (ReceiptReference is not null)
                {
                    ScheduleReceiptHeadingFocus();
                }
            }

            if (!needsInitialLoad)
            {
                await EnsureReadRefreshSubscriptionAsync(tenantId).ConfigureAwait(false);
                if (receiptRouteChanged)
                {
                    await RefreshPairedGlobalReceiptAsync().ConfigureAwait(false);
                }
                return;
            }
        }

        // Only a tenant change may discard the retained validator and blank the grid. The route carries six
        // [SupplyParameterFromQuery] parameters, none of which feed CreateRequest -- it is built from the
        // filter fields (_fromText/_toText/_categoryText) -- so the member "open audit for this user" entry
        // point re-enters here with an unchanged TenantId and an identical request. Re-reading
        // unconditionally discarded the conditional-read validator, reset the grid to Loading and cancelled
        // any in-flight notification or paging load on every such navigation.
        _initialLoadStartedTenantId = tenantId;
        await LoadAsync(
            reuseETag: false,
            retainConfirmed: false,
            requestedTenantId: tenantId).ConfigureAwait(false);
        await EnsureReadRefreshSubscriptionAsync(tenantId).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string? pendingCorrectionFocusReference = _pendingCorrectionFocusReference;
        string? pendingCorrectionOrigin = _pendingCorrectionOrigin;
        long correctionFocusGeneration = _correctionFocusGeneration;
        _pendingCorrectionFocusReference = null;
        _pendingCorrectionOrigin = null;

        if (_pendingReceiptFocus is { } pendingReceiptFocus)
        {
            _pendingReceiptFocus = null;
            long focusGeneration = _receiptFocusGeneration;
            try
            {
                IJSObjectReference focusModule = _focusModule
                    ??= await JS.InvokeAsync<IJSObjectReference>("import", FocusModulePath).ConfigureAwait(false);
                if (!_disposed && focusGeneration == _receiptFocusGeneration)
                {
                    bool focused = pendingReceiptFocus is "heading"
                        ? await focusModule.InvokeAsync<bool>("focusElementById", "tenants-audit-receipt-heading").ConfigureAwait(false)
                        : await focusModule.InvokeAsync<bool>("focusElementById", pendingReceiptFocus).ConfigureAwait(false);
                    if (!_disposed && focusGeneration == _receiptFocusGeneration && !focused)
                    {
                        _ = await focusModule.InvokeAsync<bool>("focusElementById", "tenant-audit-heading").ConfigureAwait(false);
                    }
                }
            }
            catch (JSDisconnectedException)
            {
                // Focus is no longer observable after the circuit disconnects.
            }
            catch (JSException)
            {
                // The audit read remains usable if the focus module is unavailable.
            }
            catch (ObjectDisposedException)
            {
                // Navigation disposed the focus module during the handoff.
            }
            catch (OperationCanceledException)
            {
                // Renderer or circuit teardown cancelled the focus handoff.
            }
        }

        if (string.IsNullOrWhiteSpace(pendingCorrectionFocusReference))
        {
            return;
        }

        try
        {
            IJSObjectReference module = _focusModule
                ??= await JS.InvokeAsync<IJSObjectReference>("import", FocusModulePath).ConfigureAwait(false);
            if (_disposed || correctionFocusGeneration != _correctionFocusGeneration)
            {
                return;
            }
            bool focused = await module
                .InvokeAsync<bool>("focusCorrectionLauncher", pendingCorrectionFocusReference, pendingCorrectionOrigin)
                .ConfigureAwait(false);
            if (!_disposed && correctionFocusGeneration == _correctionFocusGeneration && !focused)
            {
                string fallback = _selectedReceipt is null
                    ? "tenant-audit-heading"
                    : "tenants-audit-receipt-heading";
                _ = await module.InvokeAsync<bool>("focusElementById", fallback).ConfigureAwait(false);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; focus return is no longer observable.
        }
        catch (JSException)
        {
            // The audit read remains usable if the focus module is unavailable.
        }
        catch (ObjectDisposedException)
        {
            // Navigation disposed the focus module during the handoff.
        }
        catch (OperationCanceledException)
        {
            // Renderer or circuit teardown cancelled the focus handoff.
        }
    }

    private async Task<TenantAuditSnapshot?> LoadAsync(
        bool reuseETag,
        bool retainConfirmed = false,
        string? requestedTenantId = null,
        string? requestedCursor = null,
        bool useRequestedCursor = false)
    {
        string tenantId = requestedTenantId ?? TenantId;
        TenantAuditSnapshot previous = _snapshot;
        if (!TryCreateRequest(
            tenantId,
            useRequestedCursor ? requestedCursor : _currentCursor,
            reuseETag ? previous.ETag : null,
            out TenantAuditRequest? request))
        {
            return null;
        }

        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        if (!retainConfirmed)
        {
            Task receiptFocusProbe = CaptureReceiptFocusForReplacementAsync();
            // Marshalled and generation-guarded like every other _snapshot write in this file. Callers reach
            // here from ConfigureAwait(false) continuations, so a manual Refresh or filter change running on
            // the dispatcher could interleave between this call's BeginLoad and this write and have its
            // applied page overwritten with Loading. The sibling global-administrators page guards its
            // equivalent write for the same reason.
            await InvokeAsync(() =>
            {
                if (CanApply(tenantId, generation))
                {
                    _snapshot = TenantAuditSnapshot.Loading(tenantId);
                    ResolveReceiptSelection();
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
            await receiptFocusProbe.ConfigureAwait(false);
        }

        TenantAuditSnapshot result;
        try
        {
            result = await QueryGateway
                .GetTenantAuditAsync(request!, previous, cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return null;
        }

        if (!CanApply(tenantId, generation))
        {
            return null;
        }

        bool receiptStateChanges = false;
        bool removesReceiptCorrection = false;
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation))
            {
                receiptStateChanges = _selectedReceipt is not null && ReceiptStateForSnapshot(result) != _selectedReceipt.State;
                removesReceiptCorrection = !receiptStateChanges && WillRemoveReceiptCorrectionControl(result);
            }
        }).ConfigureAwait(false);
        if (receiptStateChanges)
        {
            await CaptureReceiptFocusForReplacementAsync().ConfigureAwait(false);
        }
        else if (removesReceiptCorrection)
        {
            await CaptureReceiptFocusForReplacementAsync(correctionOnly: true).ConfigureAwait(false);
        }

        // Re-checked inside the dispatcher callback: the CanApply above ran on a thread-pool continuation,
        // so a newer load can win between that check and this write.
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation))
            {
                CaptureCorrectionAuthority(result);
                if (result.Kind is TenantAuditSurfaceKind.ListRefreshed or TenantAuditSurfaceKind.InvalidCursor)
                {
                    ClearPaging();
                }

                _snapshot = result;
                ResolveReceiptSelection();
            }
        }).ConfigureAwait(false);

        // Page-load enrichment only. The gateway
        // rethrows OperationCanceledException unfiltered, so without this handler a Refresh or paging click
        // during the in-flight detail read let the cancellation escape LoadAsync and OnParametersSetAsync
        // and tear down the circuit. The audit list itself has already been applied above.
        try
        {
            await RefreshTenantProjectionForLoadAsync(tenantId, generation, cancellationToken).ConfigureAwait(false);
        }
        catch (Exception ex) when (ex is EventStoreGatewayException or HttpRequestException or JsonException or OperationCanceledException)
        {
            // Supplementary tenant-detail evidence unavailable; the audit page stays usable.
        }

        if (string.Equals(tenantId, "system", StringComparison.Ordinal)
            && (_globalCorrectionIntent is not null
                || _snapshot.Rows.Any(static row => row.EventType is "GlobalAdministratorSet" or "GlobalAdministratorRemoved")))
        {
            await RefreshGlobalCorrectionEvidenceForLoadAsync(tenantId, generation, cancellationToken).ConfigureAwait(false);
        }

        if (!CanApply(tenantId, generation))
        {
            return null;
        }

        removesReceiptCorrection = false;
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation))
            {
                removesReceiptCorrection = WillRemoveReceiptCorrectionControl(_snapshot);
            }
        }).ConfigureAwait(false);
        if (removesReceiptCorrection)
        {
            await CaptureReceiptFocusForReplacementAsync(correctionOnly: true).ConfigureAwait(false);
        }

        // Marshalled for the same reason the _snapshot write above is: these fields are read by
        // NextPageAsync/PreviousPageAsync and ResolveReceiptSelection on the renderer dispatcher, but this
        // continuation runs on a thread-pool thread after ConfigureAwait(false).
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation))
            {
                ResolveReceiptSelection();
            }
        }).ConfigureAwait(false);
        if (CanApply(tenantId, generation) && string.Equals(tenantId, "system", StringComparison.Ordinal))
        {
            await RefreshPairedGlobalReceiptAsync().ConfigureAwait(false);
        }
        return result;
    }

    private async Task EnsureReadRefreshSubscriptionAsync(string tenantId)
    {
        // _subscriptionTenantId is only written after the await below, so without an in-flight guard a second
        // OnParametersSetAsync for the same tenant passes the entry check mid-setup, subscribes again and
        // overwrites _readRefreshLease -- orphaning the first lease, whose callback stays registered until
        // the circuit ends.
        if (_disposed
            || string.IsNullOrWhiteSpace(tenantId)
            || !BffComposition.IsReadSurfaceConnected
            || string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal)
            || Services.GetService(typeof(TenantReadRefreshSubscription)) is not TenantReadRefreshSubscription refreshSubscription)
        {
            return;
        }

        // Claim setup and hand a later tenant to the current owner atomically. Clearing a pending target in a
        // finally block used to race a navigation arriving between the owner's last read and that clear,
        // silently losing the newer tenant's subscription request.
        lock (_readRefreshSubscriptionLock)
        {
            if (_disposed || string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal))
            {
                return;
            }

            if (_readRefreshSubscriptionInFlight)
            {
                _pendingSubscriptionTenantId = tenantId;
                return;
            }

            _readRefreshSubscriptionInFlight = true;
        }

        bool released = false;
        try
        {
            string? target = tenantId;
            while (target is not null)
            {
                await SubscribeReadRefreshAsync(refreshSubscription, target).ConfigureAwait(false);
                lock (_readRefreshSubscriptionLock)
                {
                    target = _disposed ? null : _pendingSubscriptionTenantId;
                    _pendingSubscriptionTenantId = null;
                    if (target is not null && string.Equals(_subscriptionTenantId, target, StringComparison.Ordinal))
                    {
                        target = null;
                    }

                    if (target is null)
                    {
                        _readRefreshSubscriptionInFlight = false;
                        released = true;
                    }
                }
            }
        }
        finally
        {
            if (!released)
            {
                lock (_readRefreshSubscriptionLock)
                {
                    _readRefreshSubscriptionInFlight = false;
                }
            }
        }
    }

    private async Task SubscribeReadRefreshAsync(TenantReadRefreshSubscription refreshSubscription, string tenantId)
    {
        {
            // Deliberately NOT _loadCancellation.Token. Subscription setup is independent of any one load:
            // binding it to the load token meant a Refresh during setup cancelled SubscribeAsync, the catch
            // below returned without recording _subscriptionTenantId, and nothing retried for the same
            // tenant -- silently disabling projection auto-refresh for the rest of the circuit. Reading
            // _loadCancellation?.Token here could also throw ObjectDisposedException on a concurrent
            // supersession. The sibling global-administrators page already passes None.
            TenantReadRefreshLease lease;
            try
            {
                lease = await refreshSubscription.SubscribeAsync(
                    GetTenantAuditQuery.ProjectionType,
                    tenantId,
                    () => InvokeAsync(() => RefreshFromNotificationAsync(tenantId)),
                    CancellationToken.None).ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch
            {
                // Optional refresh only. A transport fault here must not escape OnParametersSetAsync and
                // tear down the circuit; the surface stays usable through manual and command refresh.
                return;
            }

            if (_disposed || !string.Equals(TenantId, tenantId, StringComparison.Ordinal))
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
                return;
            }

            if (!lease.IsSubscribed)
            {
                // Setup failed and registered no callback. Recording it would satisfy the "already
                // subscribed" guard forever and permanently disable auto-refresh for this circuit.
                return;
            }

            IAsyncDisposable? previousLease = _readRefreshLease;
            _readRefreshLease = lease;
            _subscriptionTenantId = tenantId;
            if (previousLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(previousLease).ConfigureAwait(false);
            }
        }
    }

    /// <summary>Disposes an optional refresh lease without surfacing transport detail.</summary>
    private static async Task DisposeLeaseSupportSafelyAsync(IAsyncDisposable lease)
    {
        try
        {
            await lease.DisposeAsync().ConfigureAwait(false);
        }
        catch
        {
            // Lease cleanup must never disclose transport details or block fail-closed rendering.
        }
    }

    private async Task RefreshAsync()
    {
        if (_filtersDirty)
        {
            await ApplyFiltersAsync().ConfigureAwait(false);
            return;
