    private void ResumeCorrection(bool competing)
    {
        if (!HasAuthorizedRetainedSurface || RetainedCorrectionAttempt is not { } attempt)
        {
            return;
        }

        _activeCorrectionIntent = null;
        _previewCorrectionIntent = attempt.Snapshot.Intent;
        _resumedCorrectionMessageId = attempt.MessageId;
        _competingCorrectionNotice = competing;
        _activeCorrectionFocusReference = attempt.Snapshot.OriginalAuditReference;
        _activeCorrectionOrigin ??= "grid";
        _receiptFocusGeneration++;
        _pendingReceiptFocus = "tenants-correction-title";
    }

    private async Task<bool> OpenCorrectionAsync(TenantCorrectionStartIntent intent, string origin, bool retainStart = false)
    {
        if (!HasAuthorizedAuditSurface) return false;

        if (RetainedCorrectionAttempt is { BlocksAdmission: true } retained)
        {
            ResumeCorrection(competing: !retained.Matches(intent));
            return false;
        }

        if (HasSubmittedCorrection || !HasMeasuredSafeViewport || !intent.IsAvailable
            || intent.IntendedCommandDomain is not TenantCorrectionCommandDomain.Tenants)
        {
            return false;
        }

        int generation = Interlocked.Increment(ref _correctionOpenGeneration);
        _competingCorrectionNotice = false;
        _resumedCorrectionMessageId = null;
        InvalidateCorrectionFocus();
        long projectionGeneration = Interlocked.Increment(ref _correctionProjectionGeneration);
        string tenantId = TenantId;
        long loadGeneration = Volatile.Read(ref _loadGeneration);
        if (!retainStart)
        {
            _activeCorrectionIntent = null;
        }
        _previewCorrectionIntent = null;
        bool installed = false;
        TenantCorrectionProjection projection = await QueryGateway.GetTenantCorrectionProjectionAsync(
            tenantId, intent.TargetUserId, CancellationToken.None).ConfigureAwait(false);
        await InvokeAsync(() =>
        {
            if (_disposed || generation != _correctionOpenGeneration
                || projectionGeneration != Volatile.Read(ref _correctionProjectionGeneration) || !HasMeasuredSafeViewport
                || !CanApply(tenantId, loadGeneration))
            {
                return;
            }

            _correctionProjections[intent.TargetUserId] = projection;
            TenantAuditRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
                string.Equals(candidate.EventReference, intent.OriginalAuditReference, StringComparison.Ordinal));
            TenantCorrectionStartIntent? refreshed = row is null ? null : CreateCorrectionIntent(row);
            _activeCorrectionFocusReference = intent.OriginalAuditReference;
            _activeCorrectionOrigin = origin;
            if (refreshed?.IsAvailable is true)
            {
                _activeCorrectionIntent = refreshed;
                installed = true;
            }
            else
            {
                _activeCorrectionIntent = null;
                ScheduleCorrectionFocus(intent.OriginalAuditReference, origin);
            }
            ResolveReceiptSelection();
            StateHasChanged();
        }).ConfigureAwait(false);
        return installed;
    }

    private async Task HandoffCorrectionAsync(TenantCorrectionStartIntent intent)
    {
        // Handoff refreshes the same safety gates, then opens the existing preview. It never dispatches.
        string? origin = _activeCorrectionOrigin;
        int expectedGeneration = _correctionOpenGeneration + 1;
        bool installed = await OpenCorrectionAsync(intent, origin ?? "grid", retainStart: true).ConfigureAwait(false);
        await InvokeAsync(() =>
        {
            if (installed && _correctionOpenGeneration == expectedGeneration && _activeCorrectionIntent?.IsAvailable is true
                && _activeCorrectionIntent.OriginalAuditReference == intent.OriginalAuditReference
                && _activeCorrectionIntent.IntendedRole == intent.IntendedRole)
            {
                _previewCorrectionIntent = _activeCorrectionIntent;
                _competingCorrectionNotice = false;
                _resumedCorrectionMessageId = null;
                _activeCorrectionIntent = null;
                _receiptFocusGeneration++;
                _pendingReceiptFocus = "tenants-correction-title";
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    private Task CloseCorrectionAsync()
    {
        Interlocked.Increment(ref _correctionOpenGeneration);
        ScheduleCorrectionFocus(_activeCorrectionFocusReference, _activeCorrectionOrigin);
        _activeCorrectionFocusReference = null;
        _activeCorrectionIntent = null;
        _previewCorrectionIntent = null;
        _competingCorrectionNotice = false;
        _resumedCorrectionMessageId = null;
        return Task.CompletedTask;
    }

    private void ResolveReceiptSelection()
    {
        CaptureCorrectionAuthority(_snapshot);
        if (_selectedReceiptReference is null
            && !_selectedReceiptFromLauncher
            && ReceiptReference is not null
            && !string.Equals(_dismissedReceiptReference, ReceiptReference, StringComparison.Ordinal))
        {
            _selectedReceiptReference = TenantAuditSupportSafety.SafeApprovedReference(ReceiptReference);
            if (_selectedReceiptReference is null)
            {
                _selectedReceipt = TenantAuditReceipt.Unavailable(
                    surfaceKind: _snapshot.Kind, checkedPage: false);
                _selectedReceiptCorrectionIntent = null;
                return;
            }
        }

        if (_selectedReceiptReference is null)
        {
            _selectedReceipt = null;
            _selectedReceiptCorrectionIntent = null;
            return;
        }

        TenantAuditRow? selectedRow = _snapshot.Rows.FirstOrDefault(row =>
            string.Equals(row.EventReference, _selectedReceiptReference, StringComparison.Ordinal));
        if (selectedRow is null && string.Equals(TenantId, "system", StringComparison.Ordinal)
            && HasAuthorizedRetainedSurface
            && _verifiedGlobalRows.TryGetValue(_selectedReceiptReference, out TenantAuditRow? verifiedRow))
        {
            selectedRow = string.Equals(verifiedRow.TenantId, "system", StringComparison.Ordinal)
                && string.Equals(verifiedRow.Scope, "system", StringComparison.Ordinal)
                    ? verifiedRow : null;
        }
        _selectedReceipt = selectedRow is null
            ? TenantAuditReceipt.Unavailable(
                surfaceKind: _snapshot.Kind, checkedPage: IsCheckedPage(_snapshot.Kind))
            : TenantAuditReceipt.FromRow(selectedRow, surfaceKind: _snapshot.Kind);
        _selectedReceiptCorrectionIntent = selectedRow is null
            || !_snapshot.Rows.Contains(selectedRow)
            || _selectedReceipt.State is not TenantAuditReceiptState.Ready
            ? null : CreateCorrectionIntent(selectedRow);
    }

    private bool WillRemoveReceiptCorrectionControl(TenantAuditSnapshot nextSnapshot)
    {
        if (_selectedReceiptCorrectionIntent?.IsAvailable is not true)
        {
            return false;
        }

        TenantAuditRow? nextRow = nextSnapshot.Rows.FirstOrDefault(row =>
            string.Equals(row.EventReference, _selectedReceiptReference, StringComparison.Ordinal));
        return nextRow is null
            || TenantAuditReceipt.FromRow(nextRow, surfaceKind: nextSnapshot.Kind).State is not TenantAuditReceiptState.Ready
            || !CreateCorrectionIntent(nextRow).IsAvailable;
    }

    private static bool IsCheckedPage(TenantAuditSurfaceKind kind)
        => kind is TenantAuditSurfaceKind.Ready or TenantAuditSurfaceKind.Empty
            or TenantAuditSurfaceKind.FilteredEmpty or TenantAuditSurfaceKind.Stale
            or TenantAuditSurfaceKind.Degraded or TenantAuditSurfaceKind.ListRefreshed;

    private TenantAuditReceiptState ReceiptStateForSnapshot(TenantAuditSnapshot snapshot)
    {
        TenantAuditRow? row = snapshot.Rows.FirstOrDefault(candidate =>
            string.Equals(candidate.EventReference, _selectedReceiptReference, StringComparison.Ordinal));
        return row is null
            ? TenantAuditReceipt.Unavailable(
                surfaceKind: snapshot.Kind, checkedPage: IsCheckedPage(snapshot.Kind)).State
            : TenantAuditReceipt.FromRow(row, surfaceKind: snapshot.Kind).State;
    }

    private void CaptureCorrectionAuthority(TenantAuditSnapshot snapshot)
    {
        if (HasSubmittedCorrection || HasDisplayedRetainedCorrection)
        {
            return;
        }

        TenantCorrectionStartIntent? active = _activeCorrectionIntent ?? _previewCorrectionIntent;
        if (active is null)
        {
            return;
        }

        TenantAuditRow? source = snapshot.Rows.FirstOrDefault(row =>
            string.Equals(row.EventReference, active.OriginalAuditReference, StringComparison.Ordinal));
        if (source is not null && TenantAuditReceipt.FromRow(source, surfaceKind: snapshot.Kind).State is TenantAuditReceiptState.Ready)
        {
            return;
        }

        Interlocked.Increment(ref _correctionOpenGeneration);
        ScheduleCorrectionFocus(_activeCorrectionFocusReference ?? active.OriginalAuditReference, _activeCorrectionOrigin);
        _previewCorrectionIntent = null;
        _activeCorrectionIntent = null;
        _activeCorrectionFocusReference = null;
    }

    private void ScheduleReceiptHeadingFocus()
    {
        _receiptFocusGeneration++;
        _pendingReceiptFocus = "heading";
    }

    private void InvalidateCorrectionFocus()
    {
        _correctionFocusGeneration++;
        _pendingCorrectionFocusReference = null;
        _pendingCorrectionOrigin = null;
        _receiptFocusGeneration++;
        _pendingReceiptFocus = null;
    }

    private void ScheduleCorrectionFocus(string? reference, string? origin)
    {
        InvalidateCorrectionFocus();
        _pendingCorrectionFocusReference = reference;
        _pendingCorrectionOrigin = origin;
    }

    private void ScheduleReceiptFocus(string? reference, bool fromCorrectionPreview = false)
    {
        _receiptFocusGeneration++;
        if (fromCorrectionPreview && _previewCorrectionIntent is not null
            && string.Equals(_previewCorrectionIntent.OriginalAuditReference, reference, StringComparison.Ordinal))
        {
            _pendingReceiptFocus = "tenants-correction-original-receipt";
            return;
        }
        int index = reference is null ? -1 : _snapshot.Rows.ToList().FindIndex(row =>
            string.Equals(row.EventReference, reference, StringComparison.Ordinal));
        _pendingReceiptFocus = index >= 0 && ShouldRenderRows
            ? $"tenants-audit-receipt-launcher-{index}"
            : "tenant-audit-heading";
    }

    private async Task CaptureReceiptFocusForReplacementAsync(bool correctionOnly = false)
    {
        TenantAuditReceipt? receipt = _selectedReceipt;
        if (receipt is null)
        {
            return;
        }

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        long focusGeneration = _receiptFocusGeneration;
        string? receiptReference = _selectedReceiptReference;
        try
        {
            IJSObjectReference focusModule = _focusModule
                ??= await JS.InvokeAsync<IJSObjectReference>("import", FocusModulePath).ConfigureAwait(false);
            if (!IsCurrentReceiptFocusProbe(focusGeneration, receiptReference))
            {
                return;
            }

            string probe = correctionOnly
                ? "isFocusInsideAuditReceiptCorrection"
                : "isFocusInsideAuditReceipt";
            if (await focusModule.InvokeAsync<bool>(probe).ConfigureAwait(false)
                && IsCurrentReceiptFocusProbe(focusGeneration, receiptReference))
            {
                await InvokeAsync(() =>
                {
                    if (IsCurrentReceiptFocusProbe(focusGeneration, receiptReference))
                    {
                        ScheduleReceiptHeadingFocus();

                        // The Loading write may already have painted and removed the focused control; render
                        // now so the heading takes focus instead of waiting for the read to finish.
                        StateHasChanged();
                    }
                }).ConfigureAwait(false);
            }
        }
        catch (JSDisconnectedException)
        {
            // No focus handoff is observable after circuit loss.
        }
        catch (JSException)
        {
            // Focus failure must not block the audit read.
        }
        catch (ObjectDisposedException)
        {
            // The component was disposed while checking focus.
        }
        catch (OperationCanceledException)
        {
            // Renderer or circuit teardown cancelled the replacement-control probe.
        }
    }

    private bool IsCurrentReceiptFocusProbe(long focusGeneration, string? receiptReference)
        => !_disposed && focusGeneration == Volatile.Read(ref _receiptFocusGeneration)
            && _selectedReceipt is not null
            && string.Equals(_selectedReceiptReference, receiptReference, StringComparison.Ordinal);

    private TenantCorrectionStartIntent CreateCorrectionIntent(TenantAuditRow row)
    {
        bool global = row.EventType is "GlobalAdministratorSet" or "GlobalAdministratorRemoved";
        string target = row.Narrative?.UserId ?? string.Empty;
        _correctionProjections.TryGetValue(target, out TenantCorrectionProjection? projection);
        TenantRole? intendedRole = _selectedCorrectionRoles.TryGetValue(row.EventReference, out TenantRole selectedRole)
            ? selectedRole : null;
        return TenantCorrectionStartIntent.Evaluate(new(
            TenantAuditReceipt.FromRow(row, surfaceKind: _snapshot.Kind), row,
            IsAuthorized: global ? _globalCorrectionAuthorized : projection?.IsAuthorized is true,
            HasCurrentProjectionSnapshot: (global
                ? _globalAdministratorsProjection is { IsCompleteEvidence: true, IsMutationEvidenceBacked: true } globalProjection
                    && TenantLifecycleProjectionVersion.IsOrdered(globalProjection.ProjectionVersion)
                : projection?.IsCurrent is true)
                && _snapshot.Lifecycle is ProjectionLifecycleState.Current
                && _snapshot.Freshness is ReadModelFreshnessState.Current,
            CurrentProjectionSnapshotReference: global && _globalAdministratorsProjection is not null
                ? _globalAdministratorsProjection.ProjectionVersion ?? string.Empty : string.Empty,
            TenantStatus: projection?.TenantStatus ?? TenantStatus.Unknown,
            CurrentRole: projection?.CurrentRole,
            IntendedRole: intendedRole,
            HasTenantCommandSupport: QueryGateway.SupportsTenantCorrectionStart
                && BffComposition.IsReadSurfaceConnected && BffComposition.IsCommandSurfaceConnected,
            HasGlobalAdministratorCommandSupport: global
                && string.Equals(TenantId, "system", StringComparison.Ordinal)
                && string.Equals(row.TenantId, "system", StringComparison.Ordinal)
                && Services.GetService<ITenantCommandGateway>() is { SupportsCommandStatusLookup: true } globalCommandGateway
                && (row.EventType is "GlobalAdministratorRemoved"
                    ? globalCommandGateway.SupportsTrackedGlobalAdministratorDispatch
                    : row.EventType is "GlobalAdministratorSet"
                        && globalCommandGateway.SupportsTrackedGlobalAdministratorRemoveDispatch)
                && BffComposition.IsGlobalAdministratorDispatchConnected
                && BffComposition.IsGlobalAdministratorStatusConnected
                && BffComposition.IsGlobalAdministratorRequeryConnected,
            IsNarrowViewportSafe: HasMeasuredSafeViewport,
            Projection: projection));
    }

    private Task SelectCorrectionRoleAsync(TenantCorrectionRoleSelection selection)
    {
        if (HasSubmittedCorrection || !HasMeasuredSafeViewport)
        {
            return Task.CompletedTask;
        }
        TenantAuditRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
            string.Equals(candidate.EventReference, selection.AuditReference, StringComparison.Ordinal));
        if (row is null || !string.Equals(row.TenantId, TenantId, StringComparison.Ordinal)
            || row.EventType is not ("UserRemovedFromTenant" or "UserRoleChanged"))
        {
            return Task.CompletedTask;
        }
        Interlocked.Increment(ref _correctionOpenGeneration);
        if (_activeCorrectionIntent is not null || _previewCorrectionIntent is not null)
        {
            ScheduleCorrectionFocus(_activeCorrectionFocusReference, _activeCorrectionOrigin);
        }
        _activeCorrectionIntent = null;
        _previewCorrectionIntent = null;
        if (selection.Role is TenantRole.TenantOwner or TenantRole.TenantContributor or TenantRole.TenantReader)
        {
            _selectedCorrectionRoles[selection.AuditReference] = selection.Role;
        }
        else
        {
            _selectedCorrectionRoles.Remove(selection.AuditReference);
        }
        ResolveReceiptSelection();
        return Task.CompletedTask;
    }

    private async Task RefreshTenantProjectionForLoadAsync(
        string tenantId,
        long generation,
        CancellationToken cancellationToken)
    {
        long projectionGeneration = Interlocked.Increment(ref _correctionProjectionGeneration);
        string[] targets = _snapshot.Rows.Where(row => row.EventType is "UserRemovedFromTenant" or "UserRoleChanged")
            .Select(row => row.Narrative?.UserId ?? string.Empty).Where(target => !string.IsNullOrWhiteSpace(target))
            .Distinct(StringComparer.Ordinal).ToArray();
        IReadOnlyList<TenantCorrectionProjection> projections = await QueryGateway.GetTenantCorrectionProjectionsAsync(
            tenantId, targets, cancellationToken).ConfigureAwait(false);
        Dictionary<string, TenantCorrectionProjection> captures = projections
            .GroupBy(projection => projection.TargetUserId, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Count() == 1 ? group.Single()
                : TenantCorrectionProjection.Unavailable(tenantId, group.Key), StringComparer.Ordinal);
        bool removesReceiptCorrection = false;
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation) && projectionGeneration == Volatile.Read(ref _correctionProjectionGeneration))
            {
                _correctionProjections.Clear();
                foreach (var capture in captures)
                {
                    _correctionProjections[capture.Key] = capture.Value;
                }
                removesReceiptCorrection = WillRemoveReceiptCorrectionControl(_snapshot);
            }
        }).ConfigureAwait(false);
        if (removesReceiptCorrection)
        {
            await CaptureReceiptFocusForReplacementAsync(correctionOnly: true).ConfigureAwait(false);
        }
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation) && projectionGeneration == Volatile.Read(ref _correctionProjectionGeneration))
            {
                if (_activeCorrectionIntent is not null)
                {
                    TenantAuditRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
                        string.Equals(candidate.EventReference, _activeCorrectionIntent.OriginalAuditReference, StringComparison.Ordinal));
                    TenantCorrectionStartIntent? updated = row is null ? null : CreateCorrectionIntent(row);
                    if (updated?.IsAvailable is not true)
                    {
                        _ = CloseCorrectionAsync();
                    }
                    else
                    {
                        _activeCorrectionIntent = updated;
                    }
                }
                if (_previewCorrectionIntent is not null)
                {
                    TenantAuditRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
                        string.Equals(candidate.EventReference, _previewCorrectionIntent.OriginalAuditReference, StringComparison.Ordinal));
                    if (row is not null)
                    {
                        // Keep the child mounted so it can preserve submitted/terminal snapshots. Pre-submit
                        // previews receive even unavailable captures and immediately lose their old authority.
                        _previewCorrectionIntent = CreateCorrectionIntent(row);
                    }
                }
                ResolveReceiptSelection();
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    // The datetime-local filter input carries no timezone. Interpret it as UTC so the absolute
    // date-range filter stays deterministic and aligns with the UTC-rendered timestamp column,
    // rather than depending on the InteractiveServer host's local timezone.
    private static bool TryParseDate(string? value, out DateTimeOffset? parsed)
    {
        if (string.IsNullOrEmpty(value))
        {
            parsed = null;
            return true;
        }

        string[] formats =
        [
            "yyyy-MM-dd'T'HH:mm",
            "yyyy-MM-dd'T'HH:mm:ss",
            "yyyy-MM-dd'T'HH:mm:ss.F",
            "yyyy-MM-dd'T'HH:mm:ss.FF",
            "yyyy-MM-dd'T'HH:mm:ss.FFF",
            "yyyy-MM-dd'T'HH:mm:ss.FFFF",
            "yyyy-MM-dd'T'HH:mm:ss.FFFFF",
            "yyyy-MM-dd'T'HH:mm:ss.FFFFFF",
            "yyyy-MM-dd'T'HH:mm:ss.FFFFFFF",
        ];
        if (!DateTime.TryParseExact(
            value,
            formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out DateTime local))
        {
            string[] offsetFormats =
            [
                "yyyy-MM-dd'T'HH:mmK",
                "yyyy-MM-dd'T'HH:mm:ssK",
                "yyyy-MM-dd'T'HH:mm:ss.FK",
                "yyyy-MM-dd'T'HH:mm:ss.FFK",
                "yyyy-MM-dd'T'HH:mm:ss.FFFK",
                "yyyy-MM-dd'T'HH:mm:ss.FFFFK",
                "yyyy-MM-dd'T'HH:mm:ss.FFFFFK",
                "yyyy-MM-dd'T'HH:mm:ss.FFFFFFK",
                "yyyy-MM-dd'T'HH:mm:ss.FFFFFFFK",
            ];
            if (DateTimeOffset.TryParseExact(
                value,
                offsetFormats,
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal,
                out DateTimeOffset absolute))
            {
                parsed = absolute.ToUniversalTime();
                return parsed.Value != default(DateTimeOffset);
            }

            parsed = null;
            return false;
        }

        parsed = new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), TimeSpan.Zero);
        return parsed.Value != default(DateTimeOffset);
    }

    private static string TestIdState(string resourceState)
    {
        string result = string.Empty;
        foreach (char character in resourceState)
        {
            if (char.IsUpper(character) && result.Length > 0)
            {
                result += "-";
            }

            result += char.ToLowerInvariant(character);
        }

        return result;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _authenticationTransitionVersion);
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            _authenticationStateProvider = null;
        }
        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation();

        if (_viewportObservation is not null)
        {
            _viewportObservation.StateChanged -= OnViewportObservationChanged;
            _viewportObservation = null;
        }

        if (_readRefreshLease is not null)
        {
            await _readRefreshLease.DisposeAsync().ConfigureAwait(false);
            _readRefreshLease = null;
        }

        _subscriptionTenantId = null;
        _loadedTenantId = null;

        if (_focusModule is null)
        {
            return;
        }

        try
        {
            await _focusModule.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; no support-safe value is logged or surfaced here.
        }
    }

    private PendingOperation BeginLoad()
    {
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = source;
        }

        // Interlocked, not ++: OnParametersSetAsync reaches BeginLoad from a ConfigureAwait(false)
        // continuation (it awaits the previous lease's DisposeAsync, a remote unsubscribe) while Refresh
        // reaches it on the dispatcher. A lost increment gives two loads the same generation, and the older
        // completion then passes CanApply and writes its stale page over the newer rows.
        return new(
            Interlocked.Increment(ref _loadGeneration),
            source,
            () => CompleteCancellation(source));
    }

    private void CancelActiveCancellation()
    {
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = null;
        }
    }

    private void RetireCancellationCore(CancellationTokenSource? source)
    {
        if (source is null)
        {
            return;
        }

        source.Cancel();
    }

    private void CompleteCancellation(CancellationTokenSource source)
    {
        lock (_cancellationLock)
        {
            if (ReferenceEquals(_loadCancellation, source))
            {
                _loadCancellation = null;
            }
        }

        source.Dispose();
    }

    private bool CanApply(string tenantId, long generation)
        => !_disposed
            && generation == Volatile.Read(ref _loadGeneration)
            && string.Equals(TenantId, tenantId, StringComparison.Ordinal);

    private static bool IsAppliedRequestedPage(TenantAuditSnapshot? snapshot, string? requestedCursor)
        => snapshot is not null
            && (snapshot.Kind is TenantAuditSurfaceKind.Ready
                or TenantAuditSurfaceKind.Stale
                or TenantAuditSurfaceKind.Empty
                or TenantAuditSurfaceKind.FilteredEmpty
                or TenantAuditSurfaceKind.Degraded)
            && string.Equals(snapshot.RequestCursor, requestedCursor, StringComparison.Ordinal);

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }
