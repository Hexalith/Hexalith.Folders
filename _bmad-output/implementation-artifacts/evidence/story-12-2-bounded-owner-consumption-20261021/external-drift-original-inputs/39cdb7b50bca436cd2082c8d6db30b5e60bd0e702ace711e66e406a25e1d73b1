        {
            projection = await RefreshGlobalAdministratorsProjectionAsync().ConfigureAwait(false);
            authorization = await BffComposition
                .ResolveGlobalAdministratorsAuthorizationAsync(CancellationToken.None).ConfigureAwait(false);
        }
        catch
        {
            projection = null;
            authorization = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        await InvokeAsync(() =>
        {
            if (_disposed || generation != _correctionOpenGeneration
                || Volatile.Read(ref _authenticationTransitionPending)
                || !HasAuthorizedAuditSurface
                || !HasMeasuredSafeViewport || !string.Equals(TenantId, "system", StringComparison.Ordinal))
            {
                return;
            }

            _globalAdministratorsProjection = projection;
            _globalCorrectionAuthorized = authorization is TenantLifecycleAuthorizationReflectionState.Authorized;
