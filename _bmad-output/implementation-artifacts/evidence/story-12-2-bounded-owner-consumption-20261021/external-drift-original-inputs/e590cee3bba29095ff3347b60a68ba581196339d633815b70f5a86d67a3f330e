@code {
    private const string FocusModulePath = "./js/tenantsFocus.js";
    private const string RemoveCancelButtonId = "tenants-global-admin-remove-cancel-button";
    private const int PageSize = 20;
    private readonly object _grantFormModel = new();
    private GlobalAdministratorsSnapshot _snapshot = GlobalAdministratorsSnapshot.Loading();
    private GlobalAdministratorsSnapshot _completeSnapshot = GlobalAdministratorsSnapshot.Unavailable();
    private IAsyncDisposable? _readRefreshLease;

    /// <summary>Upper bound on optional notification-setup attempts between explicit refreshes.</summary>
    private const int MaximumReadRefreshAttempts = 3;

    private int _readRefreshAttempts;
    private GlobalAdministratorGrantCommandSnapshot _grantSnapshot = GlobalAdministratorGrantCommandSnapshot.Idle();
    private GlobalAdministratorRemoveCommandSnapshot _removeSnapshot = GlobalAdministratorRemoveCommandSnapshot.Idle();
    /// <summary>Upper bound on retained paging history.</summary>
    private const int MaximumCursorHistory = CursorHistory.DefaultMaximum;

    private readonly Stack<string?> _cursorHistory = new();

    // Set when CursorHistory.Trim drops entries, cleared when the resulting jump has been announced. The trim
    // re-appends the first-page sentinel beneath the newest entries, so one later Previous click moves the
    // operator from the middle of the sequence to page one -- which the pager would otherwise render as an
    // ordinary one-page step back.
    private bool _pagingHistoryTruncated;
    private bool _pagingJumpedToFirstPage;
    private bool _authorizationPagingReset;
    private string? _currentCursor;
    private string? _grantUserId;
    private string? _grantValidationMessage;
    private bool _isGrantSubmitting;
    private bool _isRemoveSubmitting;
    private bool _isNotificationRefreshing;
    private int _pageLoadInFlight;
    private int _readRefreshSubscriptionInFlight;
    private bool _disposed;
    private long _loadGeneration;
    private long _grantMutationGeneration;
    private long _removeMutationGeneration;
    private long _authorizationTransitionVersion;
    private CancellationTokenSource? _loadCancellation;
    private CancellationTokenSource? _authorizationCancellation;
    private CancellationTokenSource? _authenticationStateCancellation;
    private CancellationTokenSource? _readRefreshSetupCancellation;
    private CancellationTokenSource? _grantMutationCancellation;
    private CancellationTokenSource? _removeMutationCancellation;

    private bool PageLoadInFlight => Volatile.Read(ref _pageLoadInFlight) != 0;

    private bool TryBeginPageLoad()
        => Interlocked.CompareExchange(ref _pageLoadInFlight, 1, 0) == 0;

    private void EndPageLoad()
        => Volatile.Write(ref _pageLoadInFlight, 0);

    // Serialises the active-cancellation swap. A superseded source is cancelled immediately -- which is what
    // callers observe -- but NOT disposed there: disposing one at the moment it is replaced races the
    // request still inside SendAsync, where a CancellationToken.Register after Dispose throws
    // ObjectDisposedException, which is not an OperationCanceledException and so slips past every caller's
    // cancellation-only handler. Disposal is owned solely by CompleteCancellation, which the owning
    // PendingOperation calls when its operation finishes. A prior version also tracked superseded sources in
    // a List; nothing ever read it, so it is removed rather than left to read as a retention mechanism.
    private readonly Lock _cancellationLock = new();
    private readonly Lock _focusModuleLock = new();
    private FluentTextInput _grantUserIdElement = default!;
    private FluentCheckbox _grantAcknowledgementElement = default!;
    private ElementReference _grantLauncherElement;
    private ElementReference _grantPreviewCancelElement;
    private ElementReference _grantLifecycleElement;
    private ElementReference _removeLifecycleElement;
    private FluentTextInput _removeAcknowledgementElement = default!;
    private IJSObjectReference? _focusModule;
    private GlobalAdministratorRemoveLauncher? _removeLauncher;
    private bool _focusGrantUserIdPending;
    private bool _focusGrantLauncherPending;
    private bool _focusGrantLifecyclePending;
    private bool _focusGrantAcknowledgementPending;
    private bool _focusRemoveAcknowledgementPending;
    private bool _focusRemoveLauncherPending;
    private bool _focusRemoveLifecyclePending;
    private TenantLifecycleAuthorizationReflectionState _authorizationReflection = TenantLifecycleAuthorizationReflectionState.Indeterminate;
    private AuthenticationStateProvider? _authenticationStateProvider;
    private TenantAggregateCommandAdmissionGate? _aggregateAdmissionGate;
    private TenantHighImpactViewportObservation? _viewportObservation;
    private TenantAggregateCommandLease? _grantAdmissionLease;
    private TenantAggregateCommandLease? _removeAdmissionLease;
    private readonly object _fixedAggregateOwner = new();
    private bool _grantAcknowledged;
    private int _grantPreviewInFlight;
    private int _grantConfirmationInFlight;
    private long _grantPreviewGeneration;
    private int _removePreviewInFlight;
    private int _removeSubmissionInFlight;
    private int _removeStatusNudgeDrainInFlight;
    private readonly Lock _removeStatusNudgeLock = new();
    private (GlobalAdministratorRemoveCommandSnapshot Attempt, TenantAggregateCommandLease Lease)?
        _pendingRemoveStatusNudge;
    private string? _removeAcknowledgement;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool IsAuthorized
        => _authorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized;

    private bool ShouldRenderRows
        => (_snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
            or GlobalAdministratorsSurfaceKind.Stale
            or GlobalAdministratorsSurfaceKind.Unknown
            or GlobalAdministratorsSurfaceKind.Degraded)
            && _snapshot.Rows.Count > 0;

    private string PageTitleText
        => IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Title"]
            : Localizer["Tenants.GlobalAdministrators.RestrictedTitle"];

    private string StatusHeading
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Title"]
            : Localizer[$"Tenants.GlobalAdministrators.State.{ResourceState}.Title"];

    private string StatusMessage
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Message"]
            : Localizer[$"Tenants.GlobalAdministrators.State.{ResourceState}.Message"];

    private string ResourceState => _snapshot.Kind switch
    {
        GlobalAdministratorsSurfaceKind.Loading => "Loading",
        GlobalAdministratorsSurfaceKind.Ready => "Ready",
        GlobalAdministratorsSurfaceKind.Empty => "Empty",
        GlobalAdministratorsSurfaceKind.Unknown => "Unknown",
        GlobalAdministratorsSurfaceKind.Stale => "Stale",
        GlobalAdministratorsSurfaceKind.Degraded => "Degraded",
        GlobalAdministratorsSurfaceKind.Error => "Error",
        GlobalAdministratorsSurfaceKind.Unauthorized => "Unauthorized",
        GlobalAdministratorsSurfaceKind.Unavailable => "Unavailable",
        GlobalAdministratorsSurfaceKind.Invalid => "Invalid",
        _ => "Unavailable",
    };

    private string StateTestId
        => IsAuthorized
            ? $"tenants-global-admins-{ResourceState.ToLowerInvariant()}"
            : "tenants-global-admins-unavailable";

    private string StateCss
        => IsAuthorized ? ResourceState.ToLowerInvariant() : "unauthorized";

    private string StatusRole
        => !IsAuthorized
            || _snapshot.Kind is GlobalAdministratorsSurfaceKind.Invalid
                or GlobalAdministratorsSurfaceKind.Stale
                or GlobalAdministratorsSurfaceKind.Unknown
                or GlobalAdministratorsSurfaceKind.Degraded
                or GlobalAdministratorsSurfaceKind.Error
                or GlobalAdministratorsSurfaceKind.Unauthorized
                or GlobalAdministratorsSurfaceKind.Unavailable
            ? "alert"
            : "status";

    private string StatusLive => StatusRole == "alert" ? "assertive" : "polite";

    private string StateIcon => _snapshot.Kind switch
    {
        GlobalAdministratorsSurfaceKind.Ready => "OK",
        GlobalAdministratorsSurfaceKind.Empty => "0",
        GlobalAdministratorsSurfaceKind.Loading => "...",
        GlobalAdministratorsSurfaceKind.Stale => "!",
        GlobalAdministratorsSurfaceKind.Unknown => "?",
        GlobalAdministratorsSurfaceKind.Degraded => "!",
        GlobalAdministratorsSurfaceKind.Error => "!",
        GlobalAdministratorsSurfaceKind.Invalid => "!",
        _ => "?",
    };

    // Removed: UnavailableActionReason had no call site anywhere in src/ or tests/, so the surface never
    // rendered either of its two strings, and a mutation swapping its IsMutationEvidenceBacked gate for
    // Freshness alone could not fail a test -- while the same swap in the grant and remove gates is caught.
    // The loop-6 change log listed it as a consumer of IsMutationEvidenceBacked; the real consumers are
    // GrantUnavailableReason, RemoveUnavailableReasonForUser and grant projection confirmation. Its two
    // resource keys were removed with it.
    private bool IsGrantInFlight
        => _isGrantSubmitting
        || _grantAdmissionLease?.IsDispatchMarked == true
        || _grantSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending;

    private bool IsRemoveInFlight
        => _isRemoveSubmitting
        || _removeAdmissionLease?.IsDispatchMarked == true
        || _removeSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending;

    private string SafeReturnUrl => NormalizeReturnUrl(ReturnUrl);

    // ConfirmProjection stores Tenants.* resource keys so EN/FR stay whole-string parity; gateway/status
    // SafeMessages remain support-safe English prose and pass through unchanged.
    private string ResolveSafeMessage(string? safeMessage)
        => string.IsNullOrWhiteSpace(safeMessage)
            ? string.Empty
            : safeMessage.StartsWith("Tenants.", StringComparison.Ordinal)
                ? Localizer[safeMessage].Value
                : safeMessage;

    // Empty is included deliberately. ShouldRenderRows requires Rows.Count > 0, and the pager, Refresh and
    // grid all live inside that branch, so an Empty page renders no controls at all. Paging into a page that
    // was emptied by a concurrent removal is a normal outcome (IsSuccessfulPage accepts Empty, so the cursor
    // commits), and without Reset the operator is stranded on that cursor with only a browser reload to
    // recover.
    // Incomplete paging (HasMore with a blank cursor) and Ready pages that lack complete population evidence
    // are included by owner decision (loop 5): do not broaden bare Ready into CanRecover.
    private bool CanRecover
        => IsAuthorized
        && (HasIncompletePagingEvidence
            || HasIncompletePopulationOnReady
            || _snapshot.Kind is GlobalAdministratorsSurfaceKind.Unknown
            or GlobalAdministratorsSurfaceKind.Stale
            or GlobalAdministratorsSurfaceKind.Degraded
            or GlobalAdministratorsSurfaceKind.Error
            or GlobalAdministratorsSurfaceKind.Unavailable
            or GlobalAdministratorsSurfaceKind.Invalid
            or GlobalAdministratorsSurfaceKind.Empty);

    // Ready claims more administrators exist but supplies no usable continuation cursor.
    private bool HasIncompletePagingEvidence
        => _snapshot.HasMore && string.IsNullOrWhiteSpace(_snapshot.NextCursor);

    // Ready page that is not complete evidence and cannot claim further pages — Remove stays blocked by
    // Incomplete, and without Reset the operator cannot return to a complete first-page population.
    private bool HasIncompletePopulationOnReady
        => _snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
            && !_snapshot.IsCompleteEvidence
            && !_snapshot.HasMore
            && _snapshot.Rows.Count > 0;

    private GlobalAdministratorActionAvailability GrantAvailability
        => GlobalAdministratorActionAvailabilityEvaluator.EvaluateGrant(ActionEvidence());

    private string? GrantUnavailableReason
    {
        get
        {
            GlobalAdministratorActionAvailability availability = GrantAvailability;
            if (availability.IsAvailable)
            {
                return null;
            }

            string key = availability.UnavailableReason is GlobalAdministratorActionUnavailableReason.MissingConsequencePreview
                && TryGetGrantPreviewLocalizationOverride(out string reasonKey, out _)
                    ? reasonKey
                    : availability.ReasonKey;
            return Localizer[key].Value;
        }
    }

    private string? GrantRecovery
    {
        get
        {
            GlobalAdministratorActionAvailability availability = GrantAvailability;
            if (availability.IsAvailable)
            {
                return null;
            }

            string key = availability.UnavailableReason is GlobalAdministratorActionUnavailableReason.MissingConsequencePreview
                && TryGetGrantPreviewLocalizationOverride(out _, out string recoveryKey)
                    ? recoveryKey
                    : availability.RecoveryKey;
            return Localizer[key].Value;
        }
    }

    private bool TryGetGrantPreviewLocalizationOverride(out string reasonKey, out string recoveryKey)
    {
        reasonKey = BffComposition.GlobalAdministratorGrantPreviewUnavailableReasonKey ?? string.Empty;
        recoveryKey = BffComposition.GlobalAdministratorGrantPreviewRecoveryKey ?? string.Empty;
        return !string.IsNullOrWhiteSpace(reasonKey) && !string.IsNullOrWhiteSpace(recoveryKey);
    }

    private string? RemoveUnavailableReason(GlobalAdministratorRow? row)
        => RemoveUnavailableReasonForUser(row?.UserId);

    // Evaluated against a user id rather than a row so the submit path can re-check the previewed intent
    // against the *current* snapshot. Preview alone is not a durable authorization: a notification refresh
    // replaces _snapshot underneath a Previewed intent without resetting it, so the last-administrator,
    // freshness and completeness gates must be re-evaluated at submit or Remove fails open through them.
    private string? RemoveUnavailableReasonForUser(string? userId)
        => RemoveAvailability(userId) is { IsAvailable: false } availability
            ? Localizer[availability.ReasonKey].Value
            : null;

    private string? RemoveRecoveryForUser(string? userId)
        => RemoveAvailability(userId) is { IsAvailable: false } availability
            ? Localizer[availability.RecoveryKey].Value
            : null;

    private GlobalAdministratorActionAvailability RemoveAvailability(
        string? userId,
        bool allowOwnedRemoveReconciliation = false)
        => GlobalAdministratorActionAvailabilityEvaluator.EvaluateRemove(
            ActionEvidence(allowOwnedRemoveReconciliation),
            userId);

    private GlobalAdministratorActionEvidence ActionEvidence(bool allowOwnedRemoveReconciliation = false)
        => new GlobalAdministratorActionEvidence(
            IsAuthorized,
            _snapshot.Kind,
            _snapshot.Freshness,
            _snapshot.Lifecycle,
            _snapshot.ProjectionVersion,
            _snapshot.IsAuthorizationScopedEmpty,
            _snapshot.Rows,
            _completeSnapshot.Kind,
            _completeSnapshot.Freshness,
            _completeSnapshot.Lifecycle,
            _completeSnapshot.ProjectionVersion,
            _completeSnapshot.IsAuthorizationScopedEmpty,
            _completeSnapshot.Rows,
            _completeSnapshot.IsCompleteEvidence,
            BffComposition.IsGlobalAdministratorDispatchConnected
                && CommandGateway.SupportsGlobalAdministratorDispatch,
            BffComposition.IsGlobalAdministratorStatusConnected
                && CommandGateway.SupportsCommandStatusLookup,
            BffComposition.IsGlobalAdministratorRequeryConnected,
            _aggregateAdmissionGate is not null
                && !IsGrantInFlight
                && (!IsRemoveInFlight
                    || allowOwnedRemoveReconciliation
                        && _removeAdmissionLease?.IsDispatchMarked == true)
                && !_aggregateAdmissionGate.IsLockedByAnother(
                        TenantCommandAggregateLock.ForGlobalAdministrators(),
                        _fixedAggregateOwner),
            BffComposition.IsGlobalAdministratorRemovePreviewReady,
            _viewportObservation?.State ?? TenantHighImpactViewportState.Unknown,
            _viewportObservation?.HasMeasurement == true)
        {
            IsGrantPreviewReady = BffComposition.IsGlobalAdministratorGrantPreviewReady,
            SupportsTrackedGrantDispatch = CommandGateway.SupportsTrackedGlobalAdministratorDispatch,
            SupportsTrackedRemoveDispatch = CommandGateway.SupportsTrackedGlobalAdministratorRemoveDispatch,
        };

    private string RemoveReasonId(GlobalAdministratorRow row)
        => $"tenants-global-admin-remove-reason-{RowOrdinal(row)}";

    private string RemoveRecoveryId(GlobalAdministratorRow row)
        => $"tenants-global-admin-remove-recovery-{RowOrdinal(row)}";

    private string? RemoveDescribedBy(GlobalAdministratorRow row)
        => RemoveAvailability(row.UserId).IsAvailable
            ? null
            : $"{RemoveReasonId(row)} {RemoveRecoveryId(row)}";

    private int RowOrdinal(GlobalAdministratorRow row)
    {
        for (int index = 0; index < _snapshot.Rows.Count; index++)
        {
            if (ReferenceEquals(_snapshot.Rows[index], row))
            {
                return index;
            }
        }

        return -1;
    }

    private bool IsGrantSubmitDisabled
