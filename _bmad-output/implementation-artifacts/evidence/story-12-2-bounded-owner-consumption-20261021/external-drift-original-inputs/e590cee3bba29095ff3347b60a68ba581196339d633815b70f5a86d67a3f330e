    private async Task RetryAmbiguousRemoveDeliveryAsync(
        GlobalAdministratorRemoveCommandSnapshot expected)
    {
        if (expected.Intent is not { } request
            || expected.PreviewEvidence is not { IsComplete: true } retainedPreview
            || expected.MessageId is not { Length: > 0 } messageId
            || _removeAdmissionLease is not { IsDispatchMarked: true } lease)
        {
            return;
        }

        using PendingOperation operation = BeginRemoveMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        GlobalAdministratorsSnapshot current;
        try
        {
            if (!await ReauthorizeAsync(cancellationToken).ConfigureAwait(false))
            {
                return;
            }

            current = await LoadCompletePopulationSafelyAsync(cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A canceled retry preflight leaves the retained identity and dispatched lease intact.
            return;
        }
        GlobalAdministratorRemovePreview rebuilt;
        try
        {
            rebuilt = await BffComposition.ComposeGlobalAdministratorRemovePreviewAsync(
                request.UserId,
                current,
                cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            rebuilt = GlobalAdministratorRemovePreview.Unavailable(request.UserId);
        }

        if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized
            || string.Equals(
                rebuilt.UnavailableReasonKey,
                "Tenants.GlobalAdministrators.Remove.Preview.Unavailable.Authorization",
                StringComparison.Ordinal))
        {
            await CollapseAuthorizationIfCurrentAsync(
                TenantLifecycleAuthorizationReflectionState.MissingPermission,
                () => CanApplyRemoveMutation(generation)
                    && ReferenceEquals(_removeSnapshot, expected)
                    && ReferenceEquals(_removeAdmissionLease, lease)).ConfigureAwait(false);

            return;
        }

        bool retry = false;
        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (!CanApplyRemoveMutation(generation)
                || !ReferenceEquals(_removeSnapshot, expected)
                || !ReferenceEquals(_removeAdmissionLease, lease))
            {
                return;
            }

            _completeSnapshot = current;
            GlobalAdministratorActionAvailability availability = RemoveAvailability(
                request.UserId,
                allowOwnedRemoveReconciliation: true);
            if (!retainedPreview.Matches(current)
                || !rebuilt.IsComplete
                || !rebuilt.Matches(current)
                || !retainedPreview.Matches(rebuilt)
                || !availability.IsAvailable)
            {
                (string reasonKey, string recoveryKey) = RemovePreflightFailureEvidence(
                    rebuilt,
                    availability);
                SetRemoveSnapshot(expected.RetainAmbiguousPreflight(
                    reasonKey,
                    recoveryKey));
                StateHasChanged();
                return;
            }

            retry = true;
            _isRemoveSubmitting = true;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (!retry)
        {
            return;
        }

        if (CreateReconciliation(expected) is not { } dispatchBasis
            || !lease.TryBeginReconciliationDispatch(
                _fixedAggregateOwner,
                dispatchBasis,
                out long completionToken))
        {
            _ = await InvokeRendererSafelyAsync(() =>
            {
                if (!ReferenceEquals(_removeSnapshot, expected)
                    || !ReferenceEquals(_removeAdmissionLease, lease))
                {
                    return;
                }

                SetRemoveSnapshot(expected.RetainAmbiguousPreflight(
                    "Tenants.GlobalAdministrators.Availability.Remove.Unavailable.AggregateBusy",
                    "Tenants.GlobalAdministrators.Availability.Recovery.AggregateBusy"));
                StateHasChanged();
            }).ConfigureAwait(false);
            return;
        }

        TenantCommandSubmissionResult result;
        try
        {
            result = await CommandGateway.RemoveGlobalAdministratorTrackedAsync(
                request,
                messageId,
                cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            result = TenantCommandSubmissionResult.Ambiguous(
                messageId,
                "Tenants.GlobalAdministrators.Remove.SubmissionEvidence.Ambiguous");
        }
        catch
        {
            result = TenantCommandSubmissionResult.Ambiguous(
                messageId,
                "Tenants.GlobalAdministrators.Remove.SubmissionEvidence.Ambiguous");
        }

        GlobalAdministratorRemoveCommandSnapshot applied = expected.ApplySubmission(result);
        if (CreateCompletionReconciliation(applied) is not { } durableCompletion
            || !lease.TryCompleteReconciliationDispatch(completionToken, durableCompletion))
        {
            _ = lease.TryAbortReconciliationDispatch(completionToken);
            await PublishRemoveDeliveryCompletionAsync(expected, applied, lease, generation).ConfigureAwait(false);
        }

        // Successful completion publishes through the gate notification. Abort still applies the exact
