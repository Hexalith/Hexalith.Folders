    private void SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot snapshot, GlobalAdministratorsSnapshot? confirmedProjection = null)
    {
        _removeSnapshot = snapshot;
        if (CreateReconciliation(snapshot) is { } reconciliation)
        {
            _ = _removeAdmissionLease?.TryAdvanceReconciliation(_fixedAggregateOwner, reconciliation);
        }
        RememberCorrectionCompletion(_removeAdmissionLease, snapshot.State, snapshot.HasCommandEventEvidence, confirmedProjection);
        if (_removeAdmissionLease?.TryReleaseTerminal(_fixedAggregateOwner, snapshot.State) == true)
        {
            _removeAdmissionLease = null;
        }
        if (_removeSnapshot.State is TenantCommandLifecycleState.Previewed
            && _removeSnapshot.FocusTarget is TenantCommandFocusTarget.Submit)
        {
            _focusRemoveAcknowledgementPending = true;
        }
        else if (_removeSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _removeSnapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle
            || _removeSnapshot.FocusTarget is TenantCommandFocusTarget.Refresh)
        {
            _focusRemoveLifecyclePending = true;
        }
    }

    private bool RetainOrReleaseRemoveCompletion(
        GlobalAdministratorRemoveCommandSnapshot snapshot,
        TenantAggregateCommandLease submissionLease,
        GlobalAdministratorsSnapshot? confirmedProjection = null)
    {
        if (!ReferenceEquals(_removeAdmissionLease, submissionLease))
        {
            return false;
        }

        if (CreateReconciliation(snapshot) is { } reconciliation
            && submissionLease.TryRetainReconciliation(_fixedAggregateOwner, reconciliation))
        {
            _removeAdmissionLease = null;
            if (HasSameRemoveCommandIdentity(_removeSnapshot, snapshot))
            {
                AdoptRetainedReconciliation();
                return true;
            }

            return false;
        }
        else
        {
            RememberCorrectionCompletion(submissionLease, snapshot.State, snapshot.HasCommandEventEvidence, confirmedProjection);
            if (submissionLease.TryReleaseTerminal(_fixedAggregateOwner, snapshot.State))
            {
                _removeAdmissionLease = null;
            }
        }

        return false;
    }

