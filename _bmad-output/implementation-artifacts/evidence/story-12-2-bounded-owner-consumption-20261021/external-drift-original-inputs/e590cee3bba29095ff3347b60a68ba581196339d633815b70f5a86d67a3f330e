    private void InvalidateUndispatchedGrantPreview(
        GlobalAdministratorGrantCommandSnapshot expectedSnapshot,
        TenantAggregateCommandLease expectedLease,
        string reasonKey = "Tenants.GlobalAdministrators.Grant.Preview.Invalidated")
    {
        if (!ReferenceEquals(_grantSnapshot, expectedSnapshot)
            || !ReferenceEquals(_grantAdmissionLease, expectedLease)
            || expectedLease.IsDispatchMarked)
        {
            return;
        }

        _grantAcknowledged = false;
        _focusGrantAcknowledgementPending = false;
        if (expectedLease.TryAbandonBeforeDispatch(_fixedAggregateOwner)
            && ReferenceEquals(_grantAdmissionLease, expectedLease))
        {
            _grantAdmissionLease = null;
        }

        Interlocked.Increment(ref _grantPreviewGeneration);
        SetGrantSnapshot(expectedSnapshot.InvalidatePreview(reasonKey));
    }

    private void SurfaceAmbiguousGrantRetryUnavailable(
        GlobalAdministratorGrantCommandSnapshot expectedSnapshot,
        TenantAggregateCommandLease expectedLease)
    {
        if (!ReferenceEquals(_grantSnapshot, expectedSnapshot)
            || !ReferenceEquals(_grantAdmissionLease, expectedLease)
            || !expectedSnapshot.IsSubmissionAmbiguous)
        {
            return;
        }

        GlobalAdministratorGrantCommandSnapshot withdrawn = expectedSnapshot.WithdrawDeliveryRetry();
        if (ReferenceEquals(withdrawn, expectedSnapshot))
        {
            return;
        }

        SetGrantSnapshot(withdrawn);
        StateHasChanged();
    }

    private bool SynchronizeAmbiguousGrantDeliveryRetryAvailability()
    {
        if (!IsAmbiguousGrantDeliveryRetry)
        {
            return false;
        }

        bool shouldWithdraw = !AreAmbiguousGrantRetryPrerequisitesCurrent;
        if (shouldWithdraw == _grantSnapshot.IsDeliveryRetryWithdrawn)
        {
            return false;
        }

        SetGrantSnapshot(shouldWithdraw
            ? _grantSnapshot.WithdrawDeliveryRetry()
            : _grantSnapshot.RearmDeliveryRetry());
        return true;
    }

    private void SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot snapshot, GlobalAdministratorsSnapshot? confirmedProjection = null)
    {
        _grantSnapshot = snapshot;
        if (CreateReconciliation(snapshot) is { } reconciliation)
        {
            _ = _grantAdmissionLease?.TryAdvanceReconciliation(_fixedAggregateOwner, reconciliation);
        }
        RememberCorrectionCompletion(_grantAdmissionLease, snapshot.State, snapshot.HasCommandEventEvidence, confirmedProjection);
        if (_grantAdmissionLease?.TryReleaseTerminal(_fixedAggregateOwner, snapshot.State) == true)
        {
            _grantAdmissionLease = null;
        }
        if (_grantSnapshot.FocusTarget is TenantCommandFocusTarget.UserId)
        {
            _focusGrantUserIdPending = true;
        }
        else if (_grantSnapshot.FocusTarget is TenantCommandFocusTarget.Submit)
        {
            _focusGrantLauncherPending = true;
        }
        else if (_grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _grantSnapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle
            || _grantSnapshot.FocusTarget is TenantCommandFocusTarget.Refresh)
        {
            _focusGrantLifecyclePending = true;
        }
    }

    private bool RetainOrReleaseGrantCompletion(
        GlobalAdministratorGrantCommandSnapshot snapshot,
        TenantAggregateCommandLease submissionLease,
        GlobalAdministratorsSnapshot? confirmedProjection = null)
    {
        if (!ReferenceEquals(_grantAdmissionLease, submissionLease)
            || !string.Equals(_grantSnapshot.MessageId, snapshot.MessageId, StringComparison.Ordinal))
        {
            return false;
        }

        if (CreateReconciliation(snapshot) is { } reconciliation
            && submissionLease.TryRetainReconciliation(_fixedAggregateOwner, reconciliation))
        {
            _grantAdmissionLease = null;
            AdoptRetainedReconciliation();
            return true;
        }
        else
        {
            RememberCorrectionCompletion(submissionLease, snapshot.State, snapshot.HasCommandEventEvidence, confirmedProjection);
            if (submissionLease.TryReleaseTerminal(_fixedAggregateOwner, snapshot.State))
            {
                _grantAdmissionLease = null;
            }
        }

        return false;
    }

    private async Task PublishGrantDeliveryCompletionAsync(
        GlobalAdministratorGrantCommandSnapshot requestSentSnapshot,
        GlobalAdministratorGrantCommandSnapshot completionSnapshot,
        TenantAggregateCommandLease submissionLease,
        long generation)
    {
        if (await InvokeRendererSafelyAsync(() =>
            {
                if (!CanApplyGrantMutation(generation)
                    || !ReferenceEquals(_grantSnapshot, requestSentSnapshot)
                    || !ReferenceEquals(_grantAdmissionLease, submissionLease))
                {
                    _ = RetainOrReleaseGrantCompletion(completionSnapshot, submissionLease);
                    return;
                }

                SetGrantSnapshot(completionSnapshot);
                StateHasChanged();
            }).ConfigureAwait(false))
        {
            return;
        }

        _ = RetainOrReleaseGrantCompletion(completionSnapshot, submissionLease);
    }

    private async Task PreviewRemoveAsync(GlobalAdministratorRemoveLauncher launcher)
    {
        string userId = launcher.UserId;
        if (Interlocked.CompareExchange(ref _removePreviewInFlight, 1, 0) != 0)
        {
            return;
        }

        try
        {
            if (!await ReauthorizeAsync().ConfigureAwait(false))
            {
                return;
            }

            GlobalAdministratorRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
                string.Equals(candidate.UserId, userId, StringComparison.Ordinal));
            if (RemoveUnavailableReason(row) is { Length: > 0 } unavailableReason)
            {
                await InvokeAsync(() => SetRemoveSnapshot(
                    GlobalAdministratorRemoveCommandSnapshot.Blocked(
                        unavailableReason,
                        TenantCommandFocusTarget.Lifecycle))).ConfigureAwait(false);
                return;
            }

            using PendingOperation operation = BeginRemoveMutation();
            long generation = operation.Generation;
            CancellationToken cancellationToken = operation.CancellationToken;
            GlobalAdministratorsSnapshot current = await LoadCompletePopulationSafelyAsync(cancellationToken)
                .ConfigureAwait(false);
            GlobalAdministratorRemovePreview preview;
            try
            {
                preview = await BffComposition.ComposeGlobalAdministratorRemovePreviewAsync(
                    userId,
                    current,
                    cancellationToken).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch
            {
                preview = GlobalAdministratorRemovePreview.Unavailable(userId);
            }

            if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized
                || string.Equals(
                    preview.UnavailableReasonKey,
                    "Tenants.GlobalAdministrators.Remove.Preview.Unavailable.Authorization",
                    StringComparison.Ordinal))
            {
                await CollapseAuthorizationIfCurrentAsync(
                    TenantLifecycleAuthorizationReflectionState.MissingPermission,
                    () => CanApplyRemoveMutation(generation)).ConfigureAwait(false);

                return;
            }

            await InvokeAsync(() =>
            {
                if (!CanApplyRemoveMutation(generation))
                {
                    return;
                }

                _completeSnapshot = current;
                if (!preview.IsComplete
                    || !RemoveAvailability(userId).IsAvailable)
                {
                    SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.UnavailablePreview(preview));
                    return;
                }

                if (_aggregateAdmissionGate is null
                    || !_aggregateAdmissionGate.TryAcquireLease(
                        TenantCommandAggregateLock.ForGlobalAdministrators(),
                        _fixedAggregateOwner,
                        out TenantAggregateCommandLease? lease)
                    || lease is null)
                {
                    SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Blocked(
                        "Tenants.GlobalAdministrators.Availability.Remove.Unavailable.AggregateBusy",
                        TenantCommandFocusTarget.Lifecycle));
                    return;
                }

                string messageId = NUlid.Ulid.NewUlid().ToString();
                _removeAdmissionLease = lease;
                _removeLauncher = launcher;
                _removeAcknowledgement = null;
                SetRemoveSnapshot(_removeSnapshot.Preview(preview, messageId));
                _focusRemoveAcknowledgementPending = true;
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        finally
        {
            Interlocked.Exchange(ref _removePreviewInFlight, 0);
        }
    }

    private async Task SubmitRemoveAsync()
    {
        if (Interlocked.CompareExchange(ref _removeSubmissionInFlight, 1, 0) != 0)
        {
            return;
        }

        GlobalAdministratorRemoveCommandSnapshot expectedSnapshot = _removeSnapshot;
        GlobalAdministratorRemovePreview? expectedPreview = expectedSnapshot.PreviewEvidence;
        TenantAggregateCommandLease? submissionLease = _removeAdmissionLease;
        GlobalAdministratorRemoveCommandSnapshot? requestSentSnapshot = null;
        long completionToken = 0;
        long generation = 0;
        try
        {
            if (expectedSnapshot.State is not TenantCommandLifecycleState.Previewed
                || expectedSnapshot.Intent is not { } request
                || expectedPreview is not { IsComplete: true }
                || expectedSnapshot.MessageId is not { Length: > 0 } messageId
                || submissionLease is null
                || submissionLease.IsDispatchMarked
