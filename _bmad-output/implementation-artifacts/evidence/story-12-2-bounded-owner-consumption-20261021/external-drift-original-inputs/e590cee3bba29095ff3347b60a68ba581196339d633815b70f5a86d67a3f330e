    private void AdoptRetainedReconciliation()
    {
        if (_aggregateAdmissionGate?.TryAdoptRetainedLease(
                TenantCommandAggregateLock.ForGlobalAdministrators(),
                _fixedAggregateOwner,
                out TenantAggregateCommandLease? lease,
                out GlobalAdministratorReconciliationState? reconciliation) != true
            || lease is null
            || reconciliation is null)
        {
            return;
        }

        if (reconciliation.ActionKind is GlobalAdministratorActionKind.Grant)
        {
            _grantAdmissionLease = lease;
            SetGrantSnapshot(CreateGrantSnapshot(reconciliation));
        }
        else
        {
            _removeAdmissionLease = lease;
            // A delivery can finish while the retained lease has no owner. Publish its exact
            // terminal result to this page before releasing the newly adopted lease.
            SetRemoveSnapshot(CreateRemoveSnapshot(reconciliation));
        }
    }

