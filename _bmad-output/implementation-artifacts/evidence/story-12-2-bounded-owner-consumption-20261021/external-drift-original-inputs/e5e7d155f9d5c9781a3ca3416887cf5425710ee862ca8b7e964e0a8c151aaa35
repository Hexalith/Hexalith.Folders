    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelReadRefreshSetup();
        if (AggregateAdmissionGate is { } admissionGate)
        {
            admissionGate.StateChanged -= OnAggregateAdmissionChanged;
        }
        _ = Interlocked.Increment(ref _loadGeneration);
        _ = Interlocked.Increment(ref _lifecycleAuthorizationGeneration);
        ResetMetadataProofScope(tenantId: null);
        ResetLifecycleProofScope(tenantId: null);
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            _authenticationStateProvider = null;
        }

        if (_highImpactViewportObservation is not null)
        {
            _highImpactViewportObservation.StateChanged -= OnHighImpactViewportStateChanged;
            _highImpactViewportObservation = null;
        }

        if (_removeConfigurationAttemptTracker is not null)
        {
            // Attached lazily by the RemoveConfigurationAttemptTracker property. The tracker is
            // circuit-scoped while pages are per-navigation, so leaving the handler attached pinned one
            // disposed page per visit until some unrelated attempt happened to expire.
            // The field is deliberately kept: the aggregate-lease release below still reads the tracker
            // through the property, which would re-subscribe the handler it just detached.
            _removeConfigurationAttemptTracker.OwnershipExpired -= OnRemoveConfigurationOwnershipExpired;
        }

        CancelLifecycleAuthorizationCancellation();
        lock (_cancellationLock)
        {
            RetireCancellationCore(_mutationAuthorizationCancellation);
            _mutationAuthorizationCancellation = null;
        }
        Interlocked.Increment(ref _mutationAuthorizationGeneration);
        CancelActiveCancellation();
        CancelSupplementaryReads();

        if (_activeAggregateLockKey is not null)
        {
            bool lifecycleSurface = ReferenceEquals(_aggregateLeaseHolder, _lifecycleLeaseOwner);
            bool setConfigurationSurface = ReferenceEquals(_aggregateLeaseHolder, _setConfigurationLeaseOwner);
            bool removeConfigurationSurface = ReferenceEquals(_aggregateLeaseHolder, _removeConfigurationLeaseOwner);
            bool retainLifecycleLease = lifecycleSurface
                && _activeAggregateTenantId is not null
                && LifecycleAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            bool retainSetConfigurationLease = setConfigurationSurface
                && _activeAggregateTenantId is not null
                && SetConfigurationAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            bool retainRemoveConfigurationLease = removeConfigurationSurface
                && _activeAggregateTenantId is not null
                && RemoveConfigurationAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            if (!retainLifecycleLease && !retainSetConfigurationLease && !retainRemoveConfigurationLease)
            {
                object admissionOwner = lifecycleSurface && LifecycleAttemptTracker is not null
                    ? LifecycleAttemptTracker.LeaseOwner
                    : setConfigurationSurface && SetConfigurationAttemptTracker is not null
                        ? SetConfigurationAttemptTracker.LeaseOwner
                    : removeConfigurationSurface && RemoveConfigurationAttemptTracker is not null
                        ? RemoveConfigurationAttemptTracker.LeaseOwner
                    : _commandLockOwner;
                AggregateAdmissionGate?.Release(_activeAggregateLockKey, admissionOwner);
            }

            _activeAggregateLockKey = null;
            _activeAggregateTenantId = null;
            _aggregateLeaseHolder = null;
            _commandInFlight = false;
        }

        if (_readRefreshLease is not null)
        {
            // Teardown must not surface a transport fault either; the sibling page disposes safely here too.
            IAsyncDisposable lease = _readRefreshLease;
            _readRefreshLease = null;
            await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
        }

    }

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }

    private sealed class HighImpactRefreshObservation(
        TenantDetailPage owner,
        int generation) : IDisposable
    {
        private TenantDetailPage? _owner = owner;

        public void Dispose()
            => Interlocked.Exchange(ref _owner, null)?.EndHighImpactRefresh(generation);
    }
