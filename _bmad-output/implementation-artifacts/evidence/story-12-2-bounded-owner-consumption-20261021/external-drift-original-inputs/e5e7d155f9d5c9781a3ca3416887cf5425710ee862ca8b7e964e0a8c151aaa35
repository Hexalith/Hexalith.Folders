    {
        if (aggregateLockKey is null
            || AggregateAdmissionGate is not { } gate
            || SetConfigurationAttemptTracker is not { } tracker
            || !ReferenceEquals(_aggregateLeaseHolder, _setConfigurationLeaseOwner)
            || !string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal)
            || tracker.HasPendingOwnership(tenantId)
