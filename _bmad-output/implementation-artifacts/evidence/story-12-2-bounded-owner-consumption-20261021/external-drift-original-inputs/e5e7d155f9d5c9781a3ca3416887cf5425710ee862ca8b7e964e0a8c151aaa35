    private async Task<T> ReadConfigurationEvidenceAsync<T>(
        string tenantId, Func<CancellationToken, Task<T>> read, Func<T> unavailable)
    {
        using PendingOperation? operation = BeginMetadataProof(tenantId);
        if (operation is null)
        {
            return unavailable();
        }

        try
        {
            T proof = await read(operation.CancellationToken).ConfigureAwait(false);
            return CanApplyMetadataProof(operation.Generation, tenantId) ? proof : unavailable();
        }
        catch (OperationCanceledException) when (operation.CancellationToken.IsCancellationRequested)
        {
            return unavailable();
        }
    }

