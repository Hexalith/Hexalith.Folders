    private async Task<TenantDetailSnapshot?> GetLifecycleProjectionEvidenceAsync(
        TenantLifecycleCommandRequest request,
        CancellationToken cancellationToken)
    {
        using PendingOperation? operation = BeginLifecycleProof(request.TenantId);
        if (operation is null)
        {
            return null;
        }

        using var linked = CancellationTokenSource.CreateLinkedTokenSource(
            operation.CancellationToken,
            cancellationToken);
        TenantDetailSnapshot proof;
        try
        {
            proof = await QueryGateway
                .GetLifecycleProjectionProofAsync(request, linked.Token)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (linked.IsCancellationRequested)
        {
            return null;
        }

        return !linked.IsCancellationRequested
            && CanApplyLifecycleProof(operation.Generation, request.TenantId)
            && IsCurrentCallerScope(proof.CallerScope)
            ? proof
            : null;
    }

    private void StartMutationAuthorizationResolution()
    {
        TenantDetailSnapshot snapshot = _snapshot;
        if (snapshot.Detail is null || !IsCurrentCallerScope(snapshot.CallerScope)
            || ReferenceEquals(_mutationAuthorizationRequest, snapshot))
        {
            return;
        }
        _mutationAuthorizationRequest = snapshot;
        _mutationAuthorizationResolved = null;
        _mutationAuthorization = TenantMutationAuthorizationReflection.Indeterminate;
        long generation = Interlocked.Increment(ref _mutationAuthorizationGeneration);
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(_mutationAuthorizationCancellation);
            _mutationAuthorizationCancellation = source;
        }
        _ = ObserveLifecycleAuthorizationCallbackAsync(ResolveMutationAuthorizationAsync(snapshot, generation, source));
    }

    private async Task ResolveMutationAuthorizationAsync(
        TenantDetailSnapshot snapshot, long generation, CancellationTokenSource source)
    {
        TenantMutationAuthorizationReflection reflection = TenantMutationAuthorizationReflection.Indeterminate;
        try
        {
            reflection = await ReauthorizeMutationAsync(source.Token).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            lock (_cancellationLock)
            {
                if (ReferenceEquals(_mutationAuthorizationCancellation, source))
                {
                    _mutationAuthorizationCancellation = null;
                }
            }
            source.Dispose();
        }
        await InvokeAsync(() =>
        {
            if (!_disposed && generation == Volatile.Read(ref _mutationAuthorizationGeneration)
                && ReferenceEquals(snapshot, _snapshot) && IsCurrentCallerScope(snapshot.CallerScope))
            {
                _mutationAuthorization = reflection;
                _mutationAuthorizationResolved = snapshot;
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    private async Task<TenantMutationAuthorizationReflection> ReauthorizeMutationAsync(
        CancellationToken cancellationToken, bool refreshDetail = false)
    {
        TenantDetailSnapshot snapshot = _snapshot;
        string tenantId = TenantId;
        long callerVersion = Volatile.Read(ref _auditCallerVersion);
        if (_disposed || snapshot.Detail is null || !IsCurrentCallerScope(snapshot.CallerScope)
            || !string.Equals(tenantId, snapshot.Detail.TenantId, StringComparison.Ordinal))
        {
            return TenantMutationAuthorizationReflection.Indeterminate;
        }
        try
        {
            TenantDetail authorityDetail = snapshot.Detail;
            if (refreshDetail)
            {
                TenantDetailSnapshot current = await QueryGateway.GetTenantAsync(
                    new TenantDetailRequest(tenantId), null, cancellationToken).ConfigureAwait(false);
                cancellationToken.ThrowIfCancellationRequested();
                if (current.Kind is not TenantDetailSurfaceKind.Ready
                    || current.Freshness is not ReadModelFreshnessState.Current
                    || current.Lifecycle is not ProjectionLifecycleState.Current
                    || current.Detail is null || !IsCurrentCallerScope(current.CallerScope)
                    || !string.Equals(current.Detail.TenantId, tenantId, StringComparison.Ordinal))
                {
                    TenantMutationAuthorizationReflection unavailable = current.Kind is TenantDetailSurfaceKind.Unauthorized
                        ? new(TenantLifecycleAuthorizationReflectionState.MissingPermission,
                            TenantLifecycleAuthorizationReflectionState.MissingPermission)
                        : TenantMutationAuthorizationReflection.Indeterminate;
                    if (current.Kind is TenantDetailSurfaceKind.Unauthorized)
                    {
                        await InvalidateChangedMutationEvidenceAsync(snapshot, current, tenantId, callerVersion, cancellationToken).ConfigureAwait(false);
                        return unavailable;
                    }
                    return await ApplySubmissionMutationReflectionAsync(snapshot, tenantId, callerVersion, unavailable, cancellationToken)
                        .ConfigureAwait(false);
                }
                if (!HasSameMutationAdmissionEvidence(snapshot, current))
                {
                    await InvalidateChangedMutationEvidenceAsync(snapshot, current, tenantId, callerVersion, cancellationToken).ConfigureAwait(false);
                    return TenantMutationAuthorizationReflection.Indeterminate;
                }
                authorityDetail = current.Detail;
            }
            TenantMutationAuthorizationReflection reflection = await BffComposition.ResolveTenantMutationAuthorizationAsync(
                tenantId, authorityDetail, cancellationToken).ConfigureAwait(false);
            cancellationToken.ThrowIfCancellationRequested();
            if (refreshDetail)
            {
                return await ApplySubmissionMutationReflectionAsync(snapshot, tenantId, callerVersion, reflection, cancellationToken)
                    .ConfigureAwait(false);
            }
            return IsCurrentMutationScope(snapshot, tenantId, callerVersion)
                ? reflection : TenantMutationAuthorizationReflection.Indeterminate;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            return refreshDetail
                ? await ApplySubmissionMutationReflectionAsync(snapshot, tenantId, callerVersion,
                    TenantMutationAuthorizationReflection.Indeterminate, cancellationToken).ConfigureAwait(false)
                : TenantMutationAuthorizationReflection.Indeterminate;
        }
    }

    private static bool HasSameMutationAdmissionEvidence(TenantDetailSnapshot rendered, TenantDetailSnapshot current)
        => rendered.Detail is { } previous && current.Detail is { } next
            && string.Equals(rendered.ProjectionVersion, current.ProjectionVersion, StringComparison.Ordinal)
            && previous.Status == next.Status
            && string.Equals(previous.Name, next.Name, StringComparison.Ordinal)
            && string.Equals(previous.Description, next.Description, StringComparison.Ordinal)
            && previous.Members.SequenceEqual(next.Members)
            && previous.Configuration.Count == next.Configuration.Count
            && previous.Configuration.All(pair => next.Configuration.TryGetValue(pair.Key, out string? value)
                && string.Equals(pair.Value, value, StringComparison.Ordinal));

    private async Task InvalidateChangedMutationEvidenceAsync(
        TenantDetailSnapshot rendered, TenantDetailSnapshot current, string tenantId, long callerVersion,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        await InvokeAsync(() =>
        {
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrentMutationScope(rendered, tenantId, callerVersion))
            {
                return;
            }
            // A submission read is newer evidence. Older page reads and previews cannot overwrite it.
            Interlocked.Increment(ref _loadGeneration);
            CancelActiveCancellation();
            CancelSupplementaryReads();
            Interlocked.Increment(ref _mutationAuthorizationGeneration);
            lock (_cancellationLock)
            {
                RetireCancellationCore(_mutationAuthorizationCancellation);
                _mutationAuthorizationCancellation = null;
            }
            _snapshot = ForCurrentCaller(current);
            _tenantUsersSnapshot = current.Kind is TenantDetailSurfaceKind.Unauthorized
                ? TenantUsersSnapshot.Unauthorized(tenantId)
                : TenantUsersSnapshot.Degraded(tenantId, _tenantUsersSnapshot, TenantUsersReason.ProjectionStale);
            _memberPageLoadInFlight = false;
            _mutationAuthorization = current.Kind is TenantDetailSurfaceKind.Unauthorized
                ? new(TenantLifecycleAuthorizationReflectionState.MissingPermission,
                    TenantLifecycleAuthorizationReflectionState.MissingPermission)
                : TenantMutationAuthorizationReflection.Indeterminate;
            _mutationAuthorizationResolved = _snapshot;
            StateHasChanged();
        }).ConfigureAwait(false);
    }

    private bool IsCurrentMutationScope(TenantDetailSnapshot snapshot, string tenantId, long callerVersion)
        => !_disposed && callerVersion == Volatile.Read(ref _auditCallerVersion)
            && ReferenceEquals(snapshot, _snapshot) && string.Equals(TenantId, tenantId, StringComparison.Ordinal)
            && IsCurrentCallerScope(snapshot.CallerScope);

    private async Task<TenantMutationAuthorizationReflection> ApplySubmissionMutationReflectionAsync(
        TenantDetailSnapshot snapshot, string tenantId, long callerVersion, TenantMutationAuthorizationReflection reflection,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        if (!IsCurrentMutationScope(snapshot, tenantId, callerVersion))
        {
            return TenantMutationAuthorizationReflection.Indeterminate;
        }
        try
        {
            await InvokeAsync(() =>
            {
                cancellationToken.ThrowIfCancellationRequested();
                if (IsCurrentMutationScope(snapshot, tenantId, callerVersion))
                {
                    if (_mutationAuthorization != reflection || _mutationAuthorizationResolved is null
                        || _mutationAuthorizationCancellation is not null)
                    {
                        // A fresh admission result supersedes an older render probe on this same snapshot.
                        Interlocked.Increment(ref _mutationAuthorizationGeneration);
                        lock (_cancellationLock)
                        {
                            RetireCancellationCore(_mutationAuthorizationCancellation);
                            _mutationAuthorizationCancellation = null;
                        }
                    }
                    _mutationAuthorization = reflection;
                    _mutationAuthorizationResolved = snapshot;
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            return TenantMutationAuthorizationReflection.Indeterminate;
        }
        return IsCurrentMutationScope(snapshot, tenantId, callerVersion)
            ? reflection : TenantMutationAuthorizationReflection.Indeterminate;
    }

    private async Task<TenantLifecycleAuthorizationReflectionState> ReauthorizeMetadataAsync(CancellationToken cancellationToken)
        => (await ReauthorizeMutationAsync(cancellationToken, refreshDetail: true).ConfigureAwait(false)).Metadata;

    private async Task<TenantLifecycleAuthorizationReflectionState> ReauthorizeMembershipAsync(CancellationToken cancellationToken)
        => (await ReauthorizeMutationAsync(cancellationToken, refreshDetail: true).ConfigureAwait(false)).Membership;

    private async Task<TenantLifecycleAuthorizationReflectionState> ReauthorizeLifecycleAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            string? scope = _callerScope;
            long callerVersion = Volatile.Read(ref _auditCallerVersion);
            if (!IsCurrentCallerScope(scope))
            {
                return TenantLifecycleAuthorizationReflectionState.Indeterminate;
            }

            TenantLifecycleAuthorizationReflectionState reflection = await BffComposition.ResolveLifecycleAuthorizationAsync(cancellationToken)
                .ConfigureAwait(false);
            cancellationToken.ThrowIfCancellationRequested();
            return callerVersion == Volatile.Read(ref _auditCallerVersion) && IsCurrentCallerScope(scope)
                ? reflection : TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            return TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
    }

    private IDisposable BeginHighImpactRefresh()
    {
        int generation = Interlocked.Increment(ref _highImpactRefreshGeneration);
        _refreshingBaselineWasCurrent = _snapshot.Kind is TenantDetailSurfaceKind.Ready
            && _snapshot.Freshness is ReadModelFreshnessState.Current
            && _snapshot.Lifecycle is ProjectionLifecycleState.Current;
        _detailRefreshInFlight = true;
        return new HighImpactRefreshObservation(this, generation);
    }

    private void EndHighImpactRefresh(int generation)
    {
        if (generation != Volatile.Read(ref _highImpactRefreshGeneration))
        {
            return;
        }

        _detailRefreshInFlight = false;
        _refreshingBaselineWasCurrent = false;
        _ = RenderIfAliveAsync();
    }

    /// <summary>
    /// Releases an admission key whose tracker-owned lifecycle attempt has expired on the clock.
    /// </summary>
    /// <param name="aggregateLockKey">Aggregate lock key for <paramref name="tenantId"/>, or null when there is no route tenant.</param>
    /// <param name="tenantId">Literal tenant id whose retained attempt is being checked.</param>
    /// <returns><see langword="true"/> when a stale lease was reclaimed.</returns>
    /// <remarks>
    /// A retained attempt can expire on the clock with no state transition to release its lease: the tracker
    /// prunes its own maps but holds no reference to the admission gate, so nothing reclaims the key and every
    /// sibling command surface on this tenant stays disabled for the rest of the circuit. Invoked only on
    /// tenant or route change. Tracker-owned only, and only once the tracker reports no pending ownership.
    /// Same-route expiry is owned by TenantLifecycleActionAvailability.
    /// </remarks>
    /// <remarks>
    /// Route-change scoped on purpose. It cannot be hoisted to OnAfterRenderAsync: between a submit acquiring
    /// the lease and BeginDispatch registering the attempt, the tracker reports no pending ownership, so a
    /// render in that window would release the lease out from under an in-flight command. Same-route expiry is
    /// handled by TenantLifecycleActionAvailability, which can tell the two states apart because it observes
    /// the retained attempt going from present to absent.
    /// </remarks>
    private bool TryReclaimExpiredLifecycleLease(string? aggregateLockKey, string tenantId)
    {
        if (aggregateLockKey is null
            || AggregateAdmissionGate is not { } gate
            || LifecycleAttemptTracker is not { } tracker
            || !ReferenceEquals(_aggregateLeaseHolder, _lifecycleLeaseOwner)
            || !string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal)
            || tracker.HasPendingOwnership(tenantId)
            || !gate.IsOwnedBy(aggregateLockKey, tracker.LeaseOwner))
        {
            return false;
        }

        gate.Release(aggregateLockKey, tracker.LeaseOwner);
        _activeAggregateLockKey = null;
        _activeAggregateTenantId = null;
        _aggregateLeaseHolder = null;
        _commandInFlight = false;
        return true;
    }

