    private async Task<bool> SetCommandActivityLeaseAsync(string leaseTenantId, bool isActive, object surfaceOwner)
    {
        ArgumentNullException.ThrowIfNull(surfaceOwner);
        bool lifecycleSurface = ReferenceEquals(surfaceOwner, _lifecycleLeaseOwner);
        bool setConfigurationSurface = ReferenceEquals(surfaceOwner, _setConfigurationLeaseOwner);
        bool removeConfigurationSurface = ReferenceEquals(surfaceOwner, _removeConfigurationLeaseOwner);
        object admissionOwner = lifecycleSurface && LifecycleAttemptTracker is not null
            ? LifecycleAttemptTracker.LeaseOwner
            : setConfigurationSurface && SetConfigurationAttemptTracker is not null
                ? SetConfigurationAttemptTracker.LeaseOwner
            : removeConfigurationSurface && RemoveConfigurationAttemptTracker is not null
                ? RemoveConfigurationAttemptTracker.LeaseOwner
            : _commandLockOwner;
        if (isActive)
        {
            if (_disposed)
            {
                return false;
            }

            TenantAggregateCommandAdmissionGate? gate = AggregateAdmissionGate;
            if (string.IsNullOrWhiteSpace(leaseTenantId)
                || !string.Equals(leaseTenantId, TenantId, StringComparison.Ordinal)
                || gate is null)
            {
                return false;
            }

            string aggregateLockKey = TenantCommandAggregateLock.ForTenant(leaseTenantId);
            if (string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal))
            {
                // Re-entry is idempotent only for the surface that already holds the lease. A different
                // surface must be refused: granting it here made the lease multi-owner, and whichever
                // surface reported completion first released the aggregate while the other command was
                // still in flight, breaking one-at-a-time exclusivity (AD-12).
                if (!ReferenceEquals(_aggregateLeaseHolder, surfaceOwner))
                {
                    return false;
                }

                _commandInFlight = true;
                await RenderIfAliveAsync().ConfigureAwait(false);
                return true;
            }

            TenantCommandAttemptTracker? retainedTracker = Services.GetService<TenantCommandAttemptTracker>();
            bool retainedSurfaceOwnsAdmission = retainedTracker?.HasPendingOwnership(leaseTenantId) is true
                && (ReferenceEquals(surfaceOwner, _metadataLeaseOwner)
                    ? retainedTracker.Find<TenantUpdateMetadataCommandSnapshot>(leaseTenantId) is not null
                    : ReferenceEquals(surfaceOwner, _membershipLeaseOwner)
                        && (retainedTracker.Find<TenantAddMemberCommandSnapshot>(leaseTenantId) is not null
                            || retainedTracker.Find<TenantChangeRoleCommandSnapshot>(leaseTenantId) is not null
                            || retainedTracker.Find<TenantRemoveMemberCommandSnapshot>(leaseTenantId) is not null));
            if (!retainedSurfaceOwnsAdmission && !gate.TryAcquire(aggregateLockKey, admissionOwner)
                && !gate.IsOwnedBy(aggregateLockKey, admissionOwner))
            {
                _commandInFlight = false;
                return false;
            }

            _activeAggregateLockKey = aggregateLockKey;
            _activeAggregateTenantId = leaseTenantId;
            _aggregateLeaseHolder = surfaceOwner;
            _commandInFlight = true;
        }
        else
        {
            string? aggregateLockKey = string.IsNullOrWhiteSpace(leaseTenantId)
                ? null
                : TenantCommandAggregateLock.ForTenant(leaseTenantId);
            if (aggregateLockKey is not null
                && string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal)
                && ReferenceEquals(_aggregateLeaseHolder, surfaceOwner)
                && (!lifecycleSurface
                    || LifecycleAttemptTracker?.HasPendingOwnership(leaseTenantId) is not true)
                && (!setConfigurationSurface
                    || SetConfigurationAttemptTracker?.HasPendingOwnership(leaseTenantId) is not true)
                && (!removeConfigurationSurface
                    || RemoveConfigurationAttemptTracker?.HasPendingOwnership(leaseTenantId) is not true))
            {
                AggregateAdmissionGate?.Release(aggregateLockKey, admissionOwner);
                _commandInFlight = false;
                _activeAggregateLockKey = null;
                _activeAggregateTenantId = null;
                _aggregateLeaseHolder = null;
            }
            else if (aggregateLockKey is not null
                && (lifecycleSurface || setConfigurationSurface || removeConfigurationSurface)
                && (lifecycleSurface
                    ? LifecycleAttemptTracker is not null
                        && !LifecycleAttemptTracker.HasPendingOwnership(leaseTenantId)
                    : setConfigurationSurface
                        ? SetConfigurationAttemptTracker is not null
                            && !SetConfigurationAttemptTracker.HasPendingOwnership(leaseTenantId)
                        : RemoveConfigurationAttemptTracker is not null
                            && !RemoveConfigurationAttemptTracker.HasPendingOwnership(leaseTenantId)))
            {
                // Route change and page disposal deliberately clear page-local bookkeeping while a retained
                // lifecycle attempt keeps the tracker-owned gate lease. A late terminal callback must still
                // release that old key, but only after proving the tracker does not contain a newer retained
                // attempt for the same literal tenant id.
                AggregateAdmissionGate?.Release(aggregateLockKey, admissionOwner);
            }
        }

        // Command surfaces acquire the lease through a Func delegate rather than an EventCallback owned by
        // this component. Blazor therefore does not schedule a TenantDetailPage render when that child event
        // completes. Render explicitly so the owner-aware lock reason and disabled sibling surfaces become
        // visible immediately after acquisition (and disappear immediately after release).
        await RenderIfAliveAsync().ConfigureAwait(false);
        return true;
    }

