@code {
    private TenantDetailSnapshot _snapshot = TenantDetailSnapshot.Loading();
    private TenantUsersSnapshot _tenantUsersSnapshot = TenantUsersSnapshot.Loading();
    private GlobalAdministratorsSnapshot? _globalAdministratorsSnapshot;
    private bool _auditProofCapabilityAvailable;
    private long _auditRefreshVersion;
    private bool _auditCapabilityResolved;
    private bool _auditReadDenied;
    private string? _pendingAuditFocus;
    private string? _handledAuditFocus;
    private bool _auditReturnNotice;
    private bool _auditStalledNotice;
    private bool _auditPartialReturn;
    private bool _consumedFocuslessReturn;
    private string? _callerScope;
    private string? _loadCallerScope;
    private string? _metadataProofCallerScope;
    private string? _lifecycleProofCallerScope;
    private long _auditCallerVersion;
    private long _resolvedAuditCallerVersion;
    private long _pendingAuditCallerVersion;
    private long _lastAuditProbeGeneration = -1;
    private long _lastAuditProbeCallerVersion = -1;
    /// <summary>Upper bound on retained member paging history.</summary>
    private const int MaximumMemberCursorHistory = CursorHistory.DefaultMaximum;
    private const int MetadataAuditProofPageSize = 100;
    private const int MetadataAuditProofMaximumPageCount = 50;

    private readonly Stack<string?> _memberCursorHistory = new();

    // CursorHistory.Trim re-appends the first-page sentinel beneath the newest entries when it drops the
    // oldest, so one later Previous click walks the operator from mid-sequence straight to page one. The
    // audit and global-administrator pagers announce that; the member pager discarded Trim's return value and
    // rendered the jump as an ordinary step back, silently misstating where the operator is.
    private bool _memberPagingHistoryTruncated;
    private bool _memberPagingJumpedToFirstPage;
    private string? _memberCursor;
    private IAsyncDisposable? _readRefreshLease;
    private string? _subscriptionTenantId;
    private CancellationTokenSource? _loadCancellation;
    private CancellationTokenSource? _globalAdministratorsCancellation;
    private CancellationTokenSource? _auditCapabilityCancellation;
    private AuthenticationStateProvider? _authenticationStateProvider;
    private CancellationTokenSource? _mutationAuthorizationCancellation;
    private long _mutationAuthorizationGeneration;
    private TenantDetailSnapshot? _mutationAuthorizationRequest;
    private TenantDetailSnapshot? _mutationAuthorizationResolved;
    private TenantMutationAuthorizationReflection _mutationAuthorization = TenantMutationAuthorizationReflection.Indeterminate;

    private TenantMutationAuthorizationReflection MutationAuthorization
        => ReferenceEquals(_mutationAuthorizationResolved, _snapshot) && IsCurrentCallerScope(_snapshot.CallerScope)
            ? _mutationAuthorization : TenantMutationAuthorizationReflection.Indeterminate;

    private CancellationTokenSource? _lifecycleAuthorizationCancellation;
    private long _lifecycleAuthorizationGeneration;
    private TenantLifecycleAuthorizationReflectionState _lifecycleAuthorizationReflection
        = TenantLifecycleAuthorizationReflectionState.Indeterminate;
    // Serialises the active-cancellation swap. A superseded source is cancelled immediately -- which is what
    // callers observe -- but NOT disposed there: disposing one at the moment it is replaced races the
    // request still inside SendAsync, where a CancellationToken.Register after Dispose throws
    // ObjectDisposedException, which is not an OperationCanceledException and so slips past every caller's
    // cancellation-only handler. Disposal is owned solely by CompleteCancellation, which the owning
    // PendingOperation calls when its operation finishes. A prior version also tracked superseded sources in
    // a List; nothing ever read it, so it is removed rather than left to read as a retention mechanism.
    private readonly Lock _cancellationLock = new();
    private long _loadGeneration;
    private readonly Lock _metadataProofLock = new();
    private readonly HashSet<CancellationTokenSource> _metadataProofCancellations = [];
    private string? _metadataProofTenantId;
    private long _metadataProofGeneration;
    private readonly Lock _lifecycleProofLock = new();
    private readonly HashSet<CancellationTokenSource> _lifecycleProofCancellations = [];
    private string? _lifecycleProofTenantId;
    private long _lifecycleProofGeneration;
    private bool _disposed;

    /// <summary>Upper bound on optional notification-setup attempts for one route.</summary>
    private const int MaximumReadRefreshAttempts = 3;

    private string? _readRefreshAttemptTenantId;
    private int _readRefreshAttempts;
    private bool _memberPageLoadInFlight;
    private bool _commandInFlight;
    private string? _activeAggregateLockKey;
    private string? _activeAggregateTenantId;
    private MemberAccessReview? _memberAccessReview;
    private TenantAggregateCommandAdmissionGate? _aggregateAdmissionGate;
    private TenantLifecycleAttemptTracker? _lifecycleAttemptTracker;
    private TenantSetConfigurationAttemptTracker? _setConfigurationAttemptTracker;
    private TenantRemoveConfigurationAttemptTracker? _removeConfigurationAttemptTracker;
    private TenantLifecycleActionAvailability? _lifecycleActionAvailability;
    private TenantConfigurationManagement? _configurationManagement;
    private TenantHighImpactViewportObservation? _highImpactViewportObservation;
    private bool _detailRefreshInFlight;
    private bool _refreshingBaselineWasCurrent;
    private int _highImpactRefreshGeneration;
    private readonly object _commandLockOwner = new();

    // The page is a single owner to the circuit-scoped gate, but four command surfaces share it. Each gets a
    // distinct token so the lease can tell idempotent re-entry by its holder from a second surface trying to
    // share (and later release) a lock it never acquired.
    private readonly object _metadataLeaseOwner = new();
    private readonly object _lifecycleLeaseOwner = new();

    // The configuration landmark hosts two independent command flows. They must not share one token: a shared
    // token makes ReferenceEquals succeed for the second flow, so the lease goes multi-owner and whichever
    // flow reports completion first releases the aggregate while the other command is still in flight (AD-12).
    private readonly object _setConfigurationLeaseOwner = new();
    private readonly object _removeConfigurationLeaseOwner = new();
    private readonly object _membershipLeaseOwner = new();

    // Leases are cached per owner so the delegate identity is stable across renders; a fresh lambda every
    // render would look like a changed parameter to every child command surface.
    private readonly Dictionary<object, (string TenantId, Func<bool, Task<bool>> Lease)> _commandActivityLeases = [];
    private object? _aggregateLeaseHolder;
    private int _readRefreshSubscriptionInFlight;
    private long _readRefreshRouteVersion;
    private CancellationTokenSource? _readRefreshSetupCancellation;

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditFocus")]
    public string? QueryAuditFocus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditPartialReturn")]
    public bool QueryAuditPartialReturn { get; set; }

    private string BackHref
    {
        get
        {
            string? safe = TenantAuditNavigationSafety.SafeListReturnUrl(ReturnUrl, out bool strippedCursor);
            if (safe is null)
            {
                return ReturnUrl is null ? "/tenants" : "/tenants?auditReturnUnavailable=true";
            }

            if ((QueryAuditPartialReturn || strippedCursor) && !safe.Contains("auditPartialReturn=", StringComparison.Ordinal))
            {
                safe += (safe.Contains('?', StringComparison.Ordinal) ? "&" : "?") + "auditPartialReturn=true";
            }

            return safe;
        }
    }

    private bool DetailAuditReadAvailable
        => IsCurrentCallerScope(_snapshot.CallerScope)
            && _auditProofCapabilityAvailable
            && _snapshot.Kind is TenantDetailSurfaceKind.Ready
            && _snapshot.Freshness is ReadModelFreshnessState.Current
            && _snapshot.Lifecycle is ProjectionLifecycleState.Current;

    // A resolved capability probe that neither proved access nor denial is indeterminate. A stale tenant
    // snapshot keeps the entry point's tenant-scope reason, and pending or denied access has its own treatment.
    private string? DetailAuditUnavailableReason
        => _auditCapabilityResolved && !_auditProofCapabilityAvailable && !_auditReadDenied
            ? Localizer["Tenants.Audit.EntryPoint.Unavailable.AccessUnconfirmed"].Value
            : null;

    private bool IsAuditFocusTerminal
        => _auditCapabilityResolved
            && _snapshot.Kind is not TenantDetailSurfaceKind.Loading
            && _tenantUsersSnapshot.Kind is not TenantUsersSurfaceKind.Loading;

    private string? DetailReturnUrl
    {
        get
        {
            if (!TenantAuditNavigationSafety.IsSafeTenantId(TenantId))
            {
                return null;
            }

            string detail = $"/tenants/{Uri.EscapeDataString(TenantId)}";
            string? safeListReturn = TenantAuditNavigationSafety.SafeListReturnUrl(ReturnUrl, out bool strippedCursor);
            if (ReturnUrl is not null && safeListReturn is null)
            {
                return null;
            }
            if (safeListReturn is not null)
            {
                detail += "?returnUrl=" + Uri.EscapeDataString(safeListReturn);
            }

            if ((QueryAuditPartialReturn || strippedCursor) && safeListReturn is not null)
            {
                detail += "&auditPartialReturn=true";
            }

            return detail;
        }
    }

    private TenantDetail Detail => _snapshot.Detail ?? throw new InvalidOperationException("Detail is only used when a snapshot is available.");

    private bool IsCommandSurfaceAvailable
        => IsCurrentCallerScope(_snapshot.CallerScope)
        && !_commandInFlight
        && !IsCurrentAggregateLocked
        && AggregateAdmissionGate is not null
        && BffComposition.IsCommandSurfaceConnected;

    private TenantHighImpactAdmissionEvidence HighImpactAdmission
        => AggregateAdmissionGate is null
            ? TenantHighImpactAdmissionEvidence.Unknown
            : _commandInFlight || IsCurrentAggregateLocked
                ? TenantHighImpactAdmissionEvidence.Busy
                : TenantHighImpactAdmissionEvidence.Available;

    private TenantHighImpactActionEvidence HighImpactEvidence(TenantHighImpactAction action)
    {
        bool callerBound = IsCurrentCallerScope(_snapshot.CallerScope);
        TenantHighImpactBffEvidence bffEvidence = BffComposition.ComposeTenantHighImpactEvidence(
            Detail,
            _snapshot.ConfigurationManagement,
            _lifecycleAuthorizationReflection);
        bool configurationAction = action is TenantHighImpactAction.SetConfiguration
            or TenantHighImpactAction.RemoveConfiguration;
        TenantHighImpactTargetState targetState = configurationAction
            ? TenantHighImpactTargetState.Unknown
            : TenantHighImpactTargetState.NotApplicable;

        return new(
            Detail.TenantId,
            action,
            TenantHighImpactEvaluationStage.PreviewEntry,
            Detail.Status,
            !callerBound ? TenantHighImpactFreshnessState.Unknown : _detailRefreshInFlight
                ? TenantHighImpactFreshnessState.Refreshing
                : TenantHighImpactActionEvidence.FromReadModelFreshness(_snapshot.Freshness),
            callerBound && (_detailRefreshInFlight
                ? _refreshingBaselineWasCurrent
                : _snapshot.Freshness is ReadModelFreshnessState.Current),
            callerBound ? _snapshot.Kind : TenantDetailSurfaceKind.Unavailable,
            callerBound ? _snapshot.Lifecycle : ProjectionLifecycleState.Unknown,
            configurationAction ? bffEvidence.ConfigurationAuthority : bffEvidence.LifecycleAuthority,
            configurationAction
                ? bffEvidence.ConfigurationScope
                : TenantHighImpactNamespaceScopeEvidence.NotRequired,
            BffComposition.IsCommandSurfaceConnected
                ? TenantHighImpactSupportEvidence.Ready
                : TenantHighImpactSupportEvidence.Missing,
            HighImpactAdmission,
            configurationAction ? bffEvidence.ConfigurationPreview : bffEvidence.LifecyclePreview,
            TenantHighImpactProofEvidence.NotRequired,
            _highImpactViewportObservation?.State ?? TenantHighImpactViewportState.Unknown,
            IsInputComplete: false,
            targetState,
            callerBound ? _snapshot.ProjectionVersion : null);
    }

    private TenantAggregateCommandAdmissionGate? AggregateAdmissionGate
        => _aggregateAdmissionGate ??= Services.GetService<TenantAggregateCommandAdmissionGate>();

    private TenantLifecycleAttemptTracker? LifecycleAttemptTracker
        => _lifecycleAttemptTracker ??= Services.GetService<TenantLifecycleAttemptTracker>();

    private TenantSetConfigurationAttemptTracker? SetConfigurationAttemptTracker
        => _setConfigurationAttemptTracker ??= Services.GetService<TenantSetConfigurationAttemptTracker>();

    private TenantRemoveConfigurationAttemptTracker? RemoveConfigurationAttemptTracker
    {
        get
        {
            if (_removeConfigurationAttemptTracker is null)
            {
                _removeConfigurationAttemptTracker = Services.GetService<TenantRemoveConfigurationAttemptTracker>();
                if (_removeConfigurationAttemptTracker is not null)
                {
                    _removeConfigurationAttemptTracker.OwnershipExpired += OnRemoveConfigurationOwnershipExpired;
                }
            }

            return _removeConfigurationAttemptTracker;
        }
    }

    private void OnRemoveConfigurationOwnershipExpired(string tenantId)
    {
        TenantRemoveConfigurationAttemptTracker? tracker = _removeConfigurationAttemptTracker;
        if (tracker is null)
        {
            return;
        }

        string aggregateLockKey = TenantCommandAggregateLock.ForTenant(tenantId);
        AggregateAdmissionGate?.Release(aggregateLockKey, tracker.LeaseOwner);

        // The tenant lock key alone is not proof that the removal surface still holds the page lease. A
        // lifecycle or set-configuration command can own the same tenant's key while a stale remove
        // retention expires; clearing the bookkeeping then abandoned that surface's gate entry (Release
        // above is owner-scoped, so it is a no-op for a different holder) and lowered _commandInFlight
        // mid-command. TryReclaimExpiredRemoveConfigurationLease already guards on the same identity.
        if (ReferenceEquals(_aggregateLeaseHolder, _removeConfigurationLeaseOwner)
            && string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal))
        {
            _activeAggregateLockKey = null;
            _activeAggregateTenantId = null;
            _aggregateLeaseHolder = null;
            _commandInFlight = false;
        }

        if (_disposed)
        {
            tracker.OwnershipExpired -= OnRemoveConfigurationOwnershipExpired;
        }
        else
        {
            _ = RenderIfAliveAsync();
        }
    }

    private Func<bool, Task<bool>> MembershipCommandActivityLease
        => CommandActivityLeaseFor(_membershipLeaseOwner);

    private Func<bool, Task<bool>> MetadataCommandActivityLease
        => CommandActivityLeaseFor(_metadataLeaseOwner);

    private Func<bool, Task<bool>> LifecycleCommandActivityLease
        => CommandActivityLeaseFor(_lifecycleLeaseOwner);

    private Func<bool, Task<bool>> SetConfigurationCommandActivityLease
        => CommandActivityLeaseFor(_setConfigurationLeaseOwner);

    private Func<bool, Task<bool>> RemoveConfigurationCommandActivityLease
        => CommandActivityLeaseFor(_removeConfigurationLeaseOwner);

    // The lease is also lowered from child DisposeAsync during teardown, where the renderer may already be
    // gone. Every other dispatch on this page guards ObjectDisposedException; the lease path did not, so a
    // disposal race escaped as an unhandled exception instead of dying quietly with the circuit.
    private async Task RenderIfAliveAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // Renderer torn down between the lease change and the dispatch.
        }
    }

    // Every command surface acquires through this seam so a refusal is returned to the caller. An
    // EventCallback<bool> cannot carry the answer back, which let a refused surface dispatch anyway.
    private Func<bool, Task<bool>> CommandActivityLeaseFor(object surfaceOwner)
    {
        string tenantId = TenantId;
        if (!_commandActivityLeases.TryGetValue(surfaceOwner, out (string TenantId, Func<bool, Task<bool>> Lease) entry)
            || !string.Equals(entry.TenantId, tenantId, StringComparison.Ordinal))
        {
            entry = (tenantId, isActive => SetCommandActivityLeaseAsync(tenantId, isActive, surfaceOwner));
            _commandActivityLeases[surfaceOwner] = entry;
        }

        return entry.Lease;
    }

    private bool IsCurrentAggregateLocked
        => !string.IsNullOrWhiteSpace(TenantId)
            && AggregateAdmissionGate?.IsLocked(TenantCommandAggregateLock.ForTenant(TenantId)) == true;

    private bool IsCurrentAggregateLockedByAnother
        => !string.IsNullOrWhiteSpace(TenantId)
            && AggregateAdmissionGate?.IsLockedByAnother(TenantCommandAggregateLock.ForTenant(TenantId), _commandLockOwner) == true;

    private string? CommandSurfaceUnavailableReason
        => _commandInFlight || IsCurrentAggregateLockedByAnother
            ? Localizer["Tenants.Members.UnavailableReason.AggregateLocked"].Value
            : null;

    private bool MemberEvidenceIsVersionConsistent
        => IsCurrentCallerScope(_snapshot.CallerScope)
            && IsCurrentCallerScope(_tenantUsersSnapshot.CallerScope)
            && _snapshot.Kind is TenantDetailSurfaceKind.Ready
            && _snapshot.Freshness is ReadModelFreshnessState.Current
            && _snapshot.Lifecycle is ProjectionLifecycleState.Current
            && _tenantUsersSnapshot.Kind is TenantUsersSurfaceKind.Ready or TenantUsersSurfaceKind.Empty
            && _tenantUsersSnapshot.Freshness is ReadModelFreshnessState.Current
            && _tenantUsersSnapshot.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(_snapshot.ProjectionVersion)
            && string.Equals(
                _snapshot.ProjectionVersion,
                _tenantUsersSnapshot.ProjectionVersion,
                StringComparison.Ordinal);

    private string MemberSummary
        => MemberEvidenceIsVersionConsistent
            ? Localizer[
                "Tenants.Detail.Members.VisiblePageSummaryWithOwners",
                _tenantUsersSnapshot.Rows.Count,
                OwnerCount(Detail)]
            : Localizer[
                "Tenants.Detail.Members.VisiblePageSummary",
                _tenantUsersSnapshot.Rows.Count];

    // Maps the Tenants detail snapshot kind onto the domain-agnostic FC-DTL surface state the wrapper
    // routes. Kind takes precedence (loading/unauthorized/not-found/unavailable/unknown render their own
    // state regardless of payload); the ready body (Ready/Stale/Degraded) only renders with a payload, so a
    // missing payload fails closed to Unavailable instead of an optimistic ready surface.
    private FcAggregateDetailState DetailState
        => _snapshot.Kind switch
        {
            _ when _snapshot.Detail is not null && !IsCurrentCallerScope(_snapshot.CallerScope) => FcAggregateDetailState.Unavailable,
            TenantDetailSurfaceKind.Loading => FcAggregateDetailState.Loading,
            TenantDetailSurfaceKind.Unauthorized => FcAggregateDetailState.Unauthorized,
            TenantDetailSurfaceKind.NotFound => FcAggregateDetailState.NotFound,
            TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown => FcAggregateDetailState.Unavailable,
            _ when _snapshot.Detail is null => FcAggregateDetailState.Unavailable,
            TenantDetailSurfaceKind.Stale => FcAggregateDetailState.Stale,
            TenantDetailSurfaceKind.Degraded => FcAggregateDetailState.Degraded,
            _ => FcAggregateDetailState.Ready,
        };

