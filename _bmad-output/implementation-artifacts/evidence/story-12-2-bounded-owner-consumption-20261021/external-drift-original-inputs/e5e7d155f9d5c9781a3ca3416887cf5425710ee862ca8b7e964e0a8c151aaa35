            ? Task.FromResult(TenantConfigurationManagementContext.Unavailable(tenantId, TenantStatus.Unknown))
            : ReadConfigurationEvidenceAsync(tenantId,
                token => BffComposition.ReauthorizeConfigurationManagementAsync(
                    snapshot.Detail, snapshot.Configuration, token).AsTask(),
                () => TenantConfigurationManagementContext.Unavailable(tenantId, TenantStatus.Unknown));
