    private void OnAggregateAdmissionChanged(object? sender, EventArgs args)
        => _ = SynchronizeAggregateAdmissionAsync();

    private async Task SynchronizeAggregateAdmissionAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }
                if (_activeAggregateLockKey is { } key && AggregateAdmissionGate?.IsLocked(key) is false)
                {
                    _commandInFlight = false;
                    _activeAggregateLockKey = null;
                    _activeAggregateTenantId = null;
                    _aggregateLeaseHolder = null;
                }
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void OnHighImpactViewportStateChanged(object? sender, EventArgs args)
        => _ = RenderIfAliveAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (QueryAuditFocus is null || !TenantAuditNavigationSafety.IsSafeFocus(QueryAuditFocus))
        {
            _pendingAuditFocus = null;
            _handledAuditFocus = null;
            _auditReturnNotice = false;
            _auditStalledNotice = false;
            _auditPartialReturn = QueryAuditPartialReturn;
            if (!QueryAuditPartialReturn)
            {
                _consumedFocuslessReturn = false;
            }
        }

        if (QueryAuditFocus is { } focus && TenantAuditNavigationSafety.IsSafeFocus(focus)
            && !string.Equals(_handledAuditFocus, focus, StringComparison.Ordinal))
        {
            _pendingAuditFocus = focus;
            _handledAuditFocus = focus;
            _auditReturnNotice = false;
            _auditStalledNotice = false;
            _auditPartialReturn = QueryAuditPartialReturn;
        }

        string tenantId = TenantId;
        bool tenantRouteChanged = !string.Equals(_lifecycleProofTenantId, tenantId, StringComparison.Ordinal);
        if (tenantRouteChanged)
        {
            _ = Interlocked.Increment(ref _readRefreshRouteVersion);
            CancelReadRefreshSetup();
        }
        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;

        // Invalidate the prior route before the first await. Unsubscribing the previous tenant can genuinely
        // suspend, and allowing a render during that suspension retained the old detail (and therefore the old
        // metadata flow) under the new route parameter. The keyed flow is then constructed only from the
        // incoming tenant's completed detail, never from the outgoing tenant's intent or confirmed snapshot.
        ResetMetadataProofScope(tenantId);
        ResetLifecycleProofScope(tenantId);
        _snapshot = TenantDetailSnapshot.Loading();
        _ = Interlocked.Increment(ref _highImpactRefreshGeneration);
        _detailRefreshInFlight = false;
        _refreshingBaselineWasCurrent = false;
        _tenantUsersSnapshot = TenantUsersSnapshot.Loading(tenantId);
        _globalAdministratorsSnapshot = null;
        _auditProofCapabilityAvailable = false;
        _auditReadDenied = false;
        _memberCursor = null;
        _memberCursorHistory.Clear();
        _memberPagingHistoryTruncated = false;
        _memberPagingJumpedToFirstPage = false;

        if (!TenantAuditNavigationSafety.IsSafeTenantId(tenantId))
        {
            CancelAuditCapability();
            _auditCapabilityResolved = true;
            _snapshot = TenantDetailSnapshot.Unavailable(Localizer["Tenants.Audit.EntryPoint.Unavailable.InvalidContext"].Value);
            _tenantUsersSnapshot = TenantUsersSnapshot.Invalid("invalid");
            IAsyncDisposable? priorLease = _readRefreshLease;
            _readRefreshLease = null;
            _subscriptionTenantId = null;
            if (priorLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(priorLease).ConfigureAwait(false);
            }

            return;
        }

        if (!IsCurrentCallerScope(_callerScope))
        {
            if (Volatile.Read(ref _pendingAuditCallerVersion) == 0)
            {
                _snapshot = TenantDetailSnapshot.Unauthorized(tenantId);
                _tenantUsersSnapshot = TenantUsersSnapshot.Unauthorized(tenantId);
                _auditCapabilityResolved = true;
            }
            return;
        }

        string? incomingAggregateLockKey = string.IsNullOrWhiteSpace(tenantId)
            ? null
            : TenantCommandAggregateLock.ForTenant(tenantId);
        if (incomingAggregateLockKey is not null
            && LifecycleAttemptTracker is { } lifecycleTracker
            && !lifecycleTracker.HasPendingOwnership(tenantId)
            && !ReferenceEquals(_aggregateLeaseHolder, _lifecycleLeaseOwner)
            && AggregateAdmissionGate?.IsOwnedBy(incomingAggregateLockKey, lifecycleTracker.LeaseOwner) is true)
        {
            AggregateAdmissionGate.Release(incomingAggregateLockKey, lifecycleTracker.LeaseOwner);
        }

        if (incomingAggregateLockKey is not null
            && SetConfigurationAttemptTracker is { } setTracker
            && !setTracker.HasPendingOwnership(tenantId)
            && AggregateAdmissionGate?.IsOwnedBy(incomingAggregateLockKey, setTracker.LeaseOwner) is true)
        {
            AggregateAdmissionGate.Release(incomingAggregateLockKey, setTracker.LeaseOwner);
        }

        if (incomingAggregateLockKey is not null
            && RemoveConfigurationAttemptTracker is { } removeTracker
            && !removeTracker.HasPendingOwnership(tenantId)
            && AggregateAdmissionGate?.IsOwnedBy(incomingAggregateLockKey, removeTracker.LeaseOwner) is true)
        {
            AggregateAdmissionGate.Release(incomingAggregateLockKey, removeTracker.LeaseOwner);
        }

        // Route-change scoped companion to the reclamation above, for the case where this page's own
        // lifecycle surface still holds the key. Same-route expiry is owned by
        // TenantLifecycleActionAvailability, which observes a retained attempt going from present to absent.
        // This method is not called from OnAfterRenderAsync: between lease acquire and BeginDispatch the
        // tracker reports no pending ownership, so a same-route render would release the lease under an
        // in-flight submit.
        if (tenantRouteChanged)
        {
            _ = TryReclaimExpiredLifecycleLease(incomingAggregateLockKey, tenantId);
            _ = TryReclaimExpiredSetConfigurationLease(incomingAggregateLockKey, tenantId);
            _ = TryReclaimExpiredRemoveConfigurationLease(incomingAggregateLockKey, tenantId);
        }

        if (_activeAggregateLockKey is not null
            && !string.Equals(_activeAggregateLockKey, incomingAggregateLockKey, StringComparison.Ordinal))
        {
            bool lifecycleSurface = ReferenceEquals(_aggregateLeaseHolder, _lifecycleLeaseOwner);
            bool setConfigurationSurface = ReferenceEquals(_aggregateLeaseHolder, _setConfigurationLeaseOwner);
            bool removeConfigurationSurface = ReferenceEquals(_aggregateLeaseHolder, _removeConfigurationLeaseOwner);
            bool retainedLifecycleLease = lifecycleSurface
                && _activeAggregateTenantId is not null
                && LifecycleAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            bool retainedSetConfigurationLease = setConfigurationSurface
                && _activeAggregateTenantId is not null
                && SetConfigurationAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            bool retainedRemoveConfigurationLease = removeConfigurationSurface
                && _activeAggregateTenantId is not null
                && RemoveConfigurationAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            if (!retainedLifecycleLease && !retainedSetConfigurationLease && !retainedRemoveConfigurationLease)
            {
                object admissionOwner = lifecycleSurface && LifecycleAttemptTracker is not null
                    ? LifecycleAttemptTracker.LeaseOwner
                    : setConfigurationSurface && SetConfigurationAttemptTracker is not null
                        ? SetConfigurationAttemptTracker.LeaseOwner
                    : removeConfigurationSurface && RemoveConfigurationAttemptTracker is not null
                        ? RemoveConfigurationAttemptTracker.LeaseOwner
                    : _commandLockOwner;
                AggregateAdmissionGate?.Release(_activeAggregateLockKey, admissionOwner);
            }

            _activeAggregateLockKey = null;
            _activeAggregateTenantId = null;
            _aggregateLeaseHolder = null;
            _commandInFlight = false;
        }

        // Every parameter load refreshes projection evidence, including same-tenant audit returns.
        // Tenant/caller identity alone does not prove that the BFF authority decision is unchanged, so
        // resolve it again and fail closed while pending. Command admission also reauthorizes separately.
        StartLifecycleAuthorizationResolution(tenantId);
        if (!string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal)
            && _readRefreshLease is not null)
        {
            // Support-safe disposal: a throwing unsubscribe on a tenant switch used to escape
            // OnParametersSetAsync, so the incoming tenant's reads were never issued and the surface stayed on
            // the previous tenant's state. Lease cleanup must never block fail-closed rendering.
            IAsyncDisposable previousLease = _readRefreshLease;
            _readRefreshLease = null;
            _subscriptionTenantId = null;
            await DisposeLeaseSupportSafelyAsync(previousLease).ConfigureAwait(false);
        }

        if (!CanApply(generation, tenantId))
        {
            return;
        }

        Task<TenantDetailSnapshot> detailTask = QueryGateway
            .GetTenantAsync(new TenantDetailRequest(tenantId), null, cancellationToken);
        Task<TenantUsersSnapshot> membersTask = QueryGateway
            .GetTenantUsersAsync(new TenantUsersRequest(tenantId), null, cancellationToken);
        StartGlobalAdministratorsLoad(tenantId, generation, retained: null);
        StartAuditCapabilityProbe(tenantId, generation);
        // Observe each task regardless of which faults first: WhenAll surfaces only one exception, so the
        // others would go unobserved and their surfaces would keep whatever state they had -- Loading, in practice.
        TenantDetailSnapshot? detailResult = null;
        TenantUsersSnapshot? membersResult = null;
        bool cancelled = false;
        try
        {
            detailResult = await detailTask.ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            cancelled = true;
        }
        catch
        {
            detailResult = null;
        }

        try
        {
            membersResult = await membersTask.ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            cancelled = true;
        }
        catch
        {
            membersResult = null;
        }

        if (cancelled || !CanApply(generation, tenantId))
        {
            return;
        }

        // Marshalled with a re-check inside the dispatcher callback: CanApply above ran on a thread-pool
        // continuation, so a newer load can win between that check and this write.
        await InvokeAsync(() =>
        {
            if (!CanApply(generation, tenantId))
            {
                return;
            }

            // A faulted read resolves to its own terminal state rather than leaving the surface on Loading.
            _snapshot = ForCurrentCaller(detailResult);
            _tenantUsersSnapshot = MembersForCurrentCaller(membersResult);
            StateHasChanged();
        }).ConfigureAwait(false);

        await EnsureReadRefreshLeaseAsync(tenantId).ConfigureAwait(false);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        long callerVersion = Interlocked.Increment(ref _auditCallerVersion);
        CancelReadRefreshSetup();
        Interlocked.Exchange(ref _pendingAuditCallerVersion, callerVersion);
        bool hadPageLoad = Volatile.Read(ref _loadGeneration) != 0;
        long invalidatedGeneration = Interlocked.Increment(ref _loadGeneration);
        _callerScope = null;
        Task callback = InvokeAsync(() =>
        {
            if (_disposed || callerVersion != Volatile.Read(ref _auditCallerVersion))
            {
                return;
            }

            InvalidateCallerState();
            if (hadPageLoad)
            {
                StartLifecycleAuthorizationResolution(TenantId, authenticationStateTask);
            }
            _ = ObserveAuditCallerAsync(authenticationStateTask, callerVersion, hadPageLoad, invalidatedGeneration);
            StateHasChanged();
        });
        _ = ObserveLifecycleAuthorizationCallbackAsync(callback);
    }

    private void InvalidateCallerState()
    {
        IAsyncDisposable? lease = _readRefreshLease;
        _readRefreshLease = null;
        _subscriptionTenantId = null;
        if (lease is not null)
        {
            _ = DisposeLeaseSupportSafelyAsync(lease);
        }

        CancelActiveCancellation();
        CancelSupplementaryReads();
        ResetMetadataProofScope(tenantId: null);
        ResetLifecycleProofScope(tenantId: null);
        _snapshot = TenantDetailSnapshot.Loading();
        _tenantUsersSnapshot = TenantUsersSnapshot.Loading(TenantId);
        _globalAdministratorsSnapshot = null;
        _memberCursor = null;
        _memberCursorHistory.Clear();
        _memberPagingHistoryTruncated = false;
        _memberPagingJumpedToFirstPage = false;
        _memberPageLoadInFlight = false;
        _auditProofCapabilityAvailable = false;
        _auditReadDenied = false;
        _auditCapabilityResolved = false;
        _ = Interlocked.Increment(ref _highImpactRefreshGeneration);
        _detailRefreshInFlight = false;
        _refreshingBaselineWasCurrent = false;
    }

    private async Task ObserveAuditCallerAsync(
        Task<AuthenticationState> callerTask, long callerVersion, bool hadPageLoad, long invalidatedGeneration)
    {
        AuthenticationState? state = null;
        try
        {
            state = await callerTask.ConfigureAwait(false);
        }
        catch
        {
            // A faulted authentication task cannot authorize retained state or proof.
        }

        if (_disposed || callerVersion != Volatile.Read(ref _auditCallerVersion))
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            if (_disposed || callerVersion != Volatile.Read(ref _auditCallerVersion))
            {
                return;
            }

            _callerScope = ResolveCallerScope(state?.User);
            Interlocked.Exchange(ref _resolvedAuditCallerVersion, state is null ? 0 : callerVersion);
            Interlocked.CompareExchange(ref _pendingAuditCallerVersion, 0, callerVersion);
            if (_callerScope is null)
            {
                _snapshot = state is null
                    ? TenantDetailSnapshot.Unavailable("Authenticated caller could not be verified.")
                    : TenantDetailSnapshot.Unauthorized(TenantId);
                _tenantUsersSnapshot = TenantUsersSnapshot.Unauthorized(TenantId);
                _auditCapabilityResolved = true;
                StateHasChanged();
                return;
            }

            ResetMetadataProofScope(TenantId);
            ResetLifecycleProofScope(TenantId);
            if (hadPageLoad || Volatile.Read(ref _loadGeneration) > invalidatedGeneration)
            {
                if (!hadPageLoad)
                {
                    StartLifecycleAuthorizationResolution(TenantId);
                }
                await RefreshTenantReadsAsync(TenantId);
            }
        }).ConfigureAwait(false);
    }

    private static string? ResolveCallerScope(System.Security.Claims.ClaimsPrincipal? principal)
    {
        var evidence = TenantsGlobalAdministratorClaims.ResolvePrincipalEvidence(
            principal, corroboratedSubject: null, requireCorroboration: false);
        return string.IsNullOrWhiteSpace(evidence.Subject)
            ? null
            : TenantQueryGateway.AuditCallerScope(evidence.Subject);
    }

    private bool IsCurrentCallerScope(string? scope)
    {
        if (string.IsNullOrWhiteSpace(scope)
            || Volatile.Read(ref _pendingAuditCallerVersion) != 0
            || Volatile.Read(ref _resolvedAuditCallerVersion) != Volatile.Read(ref _auditCallerVersion)
            || !string.Equals(scope, _callerScope, StringComparison.Ordinal))
        {
            return false;
        }

        try
        {
            Task<AuthenticationState>? stateTask = _authenticationStateProvider?.GetAuthenticationStateAsync();
            return stateTask?.IsCompletedSuccessfully == true
                && string.Equals(scope, ResolveCallerScope(stateTask.Result.User), StringComparison.Ordinal);
        }
        catch
        {
            return false;
        }
    }

    private TenantDetailSnapshot ForCurrentCaller(TenantDetailSnapshot? snapshot)
        => snapshot is not null && (snapshot.Detail is null && snapshot.ETag is null && snapshot.ProjectionVersion is null
                && !snapshot.Configuration.IsAvailable || IsCurrentCallerScope(snapshot.CallerScope))
            ? snapshot
            : TenantDetailSnapshot.Unavailable("Tenant detail caller could not be verified.");

    private TenantUsersSnapshot MembersForCurrentCaller(TenantUsersSnapshot? snapshot)
        => snapshot is not null && (snapshot.Kind is TenantUsersSurfaceKind.Unauthorized or TenantUsersSurfaceKind.NotFound
                or TenantUsersSurfaceKind.Invalid or TenantUsersSurfaceKind.Unavailable or TenantUsersSurfaceKind.Error
                && snapshot.Rows.Count == 0 && snapshot.ETag is null && snapshot.ProjectionVersion is null
                || IsCurrentCallerScope(snapshot.CallerScope))
            ? snapshot
            : TenantUsersSnapshot.Unavailable(TenantId);

    private void StartLifecycleAuthorizationResolution(
        string tenantId,
        Task<AuthenticationState>? authenticationStateTask = null)
    {
        long generation = Interlocked.Increment(ref _lifecycleAuthorizationGeneration);

        // Interlocked.Exchange followed by a separate previous?.Cancel() raced the resolution's own finally:
        // the finally could win the CompareExchange race, dispose the source, and the Cancel() here then threw
        // ObjectDisposedException straight out of OnParametersSetAsync or DisposeAsync -- tearing down the
        // circuit. The load path on this page already serialises cancel-vs-dispose under _cancellationLock;
        // the lifecycle source now uses the same scheme.
        CancellationTokenSource source = ReplaceLifecycleAuthorizationCancellation();
        _lifecycleAuthorizationReflection = TenantLifecycleAuthorizationReflectionState.Indeterminate;

        Task resolution = ResolveLifecycleAuthorizationAsync(
            tenantId,
            generation,
            source,
            authenticationStateTask);
        _ = ObserveLifecycleAuthorizationCallbackAsync(resolution);
    }

    private async Task ResolveLifecycleAuthorizationAsync(
        string tenantId,
        long generation,
        CancellationTokenSource source,
        Task<AuthenticationState>? authenticationStateTask)
    {
        TenantLifecycleAuthorizationReflectionState reflection
            = TenantLifecycleAuthorizationReflectionState.Indeterminate;
        try
        {
            if (authenticationStateTask is not null)
            {
                _ = await authenticationStateTask.WaitAsync(source.Token).ConfigureAwait(false);
            }

            reflection = await BffComposition
                .ResolveLifecycleAuthorizationAsync(source.Token)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            // Authorization faults fail closed without exposing provider details. Indeterminate is rendered
            // to the operator as authority "not proven", with refresh-first recovery guidance.
        }
        finally
        {
            CompleteLifecycleAuthorizationCancellation(source);
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed
                    || generation != Volatile.Read(ref _lifecycleAuthorizationGeneration)
                    || !string.Equals(TenantId, tenantId, StringComparison.Ordinal))
                {
                    return;
                }

                _lifecycleAuthorizationReflection = reflection;
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // Disposed between the generation check and renderer dispatch.
        }
    }

    private static async Task ObserveLifecycleAuthorizationCallbackAsync(Task callback)
    {
        try
        {
            await callback.ConfigureAwait(false);
        }
        catch
        {
            // Authorization callbacks contain faults and leave lifecycle actions failed closed.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        StartMutationAuthorizationResolution();
        if (_pendingAuditFocus is { } focus)
        {
            _pendingAuditFocus = null;
            _ = RestoreAuditFocusAsync(focus);
        }

        if (QueryAuditFocus is null && QueryAuditPartialReturn && !_consumedFocuslessReturn)
        {
            _consumedFocuslessReturn = true;
            try
            {
                await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
                await module.InvokeVoidAsync("consumeReturnMarkers");
                QueryAuditPartialReturn = false;
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended before the URL marker could be consumed.
            }
            catch (Exception exception) when (exception is JSException or TaskCanceledException)
            {
                // Keep the visible partial-return notice when browser cleanup is unavailable.
            }
        }

        // Retry optional notification setup after later renders when an earlier attempt was superseded or
        // returned no lease. The method's in-flight and existing-lease guards keep successful setup
        // single-instance. Without this, one cancelled or empty setup disabled projection auto-refresh for
        // the rest of the circuit, because OnParametersSetAsync was its only entry point.
        //
        // Bounded, because a failing backend records neither _readRefreshLease nor _subscriptionTenantId, so
        // every guard passes again on the next render. RefreshTenantReadsAsync calls StateHasChanged, so an
        // unbounded retry was two remote round trips per render for the life of the circuit against a
        // subscription endpoint that is down. The counter resets with the route or an explicit projection
        // refresh, so a new tenant and a same-route operator recovery both get a bounded fresh opportunity.
        await EnsureReadRefreshLeaseAsync(TenantId).ConfigureAwait(false);
    }

    private async Task RestoreAuditFocusAsync(string focus)
    {
        string tenantId = TenantId;
        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
            string? outcome = await module.InvokeAsync<string>("restoreAuditFocus", focus, "tenants-detail-audit-origin", "tenants-detail-identity");
            if (outcome != "cancelled" && !_disposed && string.Equals(TenantId, tenantId, StringComparison.Ordinal)
                && string.Equals(_handledAuditFocus, focus, StringComparison.Ordinal))
            {
                await module.InvokeVoidAsync("consumeReturnMarkers", focus);
                QueryAuditFocus = null;
                QueryAuditPartialReturn = false;
            }
            if (outcome is "missing" or "stalled"
                && !_disposed && string.Equals(TenantId, tenantId, StringComparison.Ordinal)
                && string.Equals(_handledAuditFocus, focus, StringComparison.Ordinal))
            {
                await InvokeAsync(() =>
                {
                    _auditReturnNotice = outcome == "missing";
                    _auditStalledNotice = outcome == "stalled";
                    StateHasChanged();
                });
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit ended before focus restoration.
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            if (!_disposed && string.Equals(TenantId, tenantId, StringComparison.Ordinal)
                && string.Equals(_handledAuditFocus, focus, StringComparison.Ordinal))
            {
                await InvokeAsync(() => { _auditReturnNotice = true; _auditStalledNotice = false; StateHasChanged(); });
            }
        }
    }

    /// <summary>
    /// Records that optional notification setup failed, using a fixed reason code only.
    /// </summary>
    /// <remarks>
    /// The catch below is deliberately broad, so without this the surface could stop auto-refreshing for the
    /// whole circuit with no signal anywhere. The logger is resolved optionally and the message carries a
    /// constant reason code — no tenant id, projection scope, transport detail, or exception is emitted.
    /// </remarks>
    private void LogNotificationSetupFailure()
    {
        if (Services.GetService(typeof(ILoggerFactory)) is ILoggerFactory loggerFactory)
        {
            loggerFactory
                .CreateLogger<TenantDetailPage>()
                .LogWarning("Optional projection refresh setup failed. ReasonCode={NotificationReasonCode}", "notification-setup-failed");
        }
    }

    private void CancelReadRefreshSetup()
    {
        lock (_cancellationLock)
        {
            _readRefreshSetupCancellation?.Cancel();
        }
    }

    /// <summary>Subscribes this tenant's reads to projection notifications, at most once per tenant.</summary>
    /// <remarks>
    /// Deliberately does NOT take the load cancellation token. Binding setup to a load meant any Refresh,
    /// command-driven re-query or member pager click during setup cancelled <c>SubscribeAsync</c>, the catch
    /// returned without recording <c>_subscriptionTenantId</c>, and nothing retried for the same tenant --
    /// silently disabling projection auto-refresh for the rest of the circuit. Setup instead owns a
    /// separate cancellation source, replaced only by route/caller invalidation or disposal.
    /// </remarks>
    private Task EnsureReadRefreshLeaseAsync(string tenantId)
        => _disposed ? Task.CompletedTask : InvokeAsync(() => EnsureReadRefreshLeaseOnRendererAsync(tenantId));

    private bool IsReadRefreshScopeCurrent(string tenantId, long routeVersion, long callerVersion)
        => !_disposed
            && routeVersion == Volatile.Read(ref _readRefreshRouteVersion)
            && callerVersion == Volatile.Read(ref _auditCallerVersion)
            && string.Equals(TenantId, tenantId, StringComparison.Ordinal)
            && IsCurrentCallerScope(_callerScope);

    private async Task EnsureReadRefreshLeaseOnRendererAsync(string tenantId)
    {
        // Own setup/adoption/handoff on the renderer, including continuations after backend awaits.
        // Read generations change on refresh/paging; this epoch changes only with the route.
        long routeVersion = Volatile.Read(ref _readRefreshRouteVersion);
        long callerVersion = Volatile.Read(ref _auditCallerVersion);
        if (!IsReadRefreshScopeCurrent(tenantId, routeVersion, callerVersion))
        {
            return;
        }

        if (!string.Equals(_readRefreshAttemptTenantId, tenantId, StringComparison.Ordinal))
        {
            _readRefreshAttemptTenantId = tenantId;
            _readRefreshAttempts = 0;
        }

        if (_disposed
            || !TenantAuditNavigationSafety.IsSafeTenantId(tenantId)
            || !string.Equals(TenantId, tenantId, StringComparison.Ordinal)
            || string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal)
            || _readRefreshLease is not null
            || _readRefreshAttempts >= MaximumReadRefreshAttempts
            || Services.GetService(typeof(TenantReadRefreshSubscription)) is not TenantReadRefreshSubscription refreshSubscription)
        {
            return;
        }

        // Atomic test-and-set, matching GlobalAdministratorsPage. OnParametersSetAsync and OnAfterRenderAsync
        // both enter this method; a plain bool let both pass the guard, both subscribe, and the loser's finally
        // clear the flag while the winner was still in flight.
        if (Interlocked.CompareExchange(ref _readRefreshSubscriptionInFlight, 1, 0) != 0)
        {
            return;
        }

        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            _readRefreshSetupCancellation = source;
        }
        if (!IsReadRefreshScopeCurrent(tenantId, routeVersion, callerVersion)) source.Cancel();
        bool acceptsNotifications = true;
        bool adopted = false;
        TenantReadRefreshLease? lease = null;
        try
        {
            lease = await refreshSubscription.SubscribeAsync(
                GetTenantQuery.ProjectionType,
                tenantId,
                () => _disposed ? Task.CompletedTask : InvokeAsync(() =>
                    acceptsNotifications && IsReadRefreshScopeCurrent(tenantId, routeVersion, callerVersion)
                        ? RefreshTenantReadsAsync(tenantId)
                        : Task.CompletedTask),
                source.Token);
            if (!IsReadRefreshScopeCurrent(tenantId, routeVersion, callerVersion)
                || _readRefreshLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease);
                return;
            }

            if (!lease.IsSubscribed)
            {
                // Setup registered no callback. Recording it would satisfy the guards above forever and
                // permanently disable auto-refresh; leaving both fields unset lets the next render retry.
                _readRefreshAttempts++;
                await DisposeLeaseSupportSafelyAsync(lease);
                lease = null;
                return;
            }

            _readRefreshLease = lease;
            adopted = true;
            _subscriptionTenantId = tenantId;
            lease = null;

            // Re-checked after the assignment, not only before it. DisposeAsync sets _disposed and then reads
            // a still-null _readRefreshLease, so a continuation that passed the check above and was preempted
            // could assign the lease afterwards -- leaving the callback registered for the life of the
            // circuit and invoking InvokeAsync on a disposed component.
            if (_disposed)
            {
                IAsyncDisposable orphaned = _readRefreshLease;
                _readRefreshLease = null;
                _subscriptionTenantId = null;
                await DisposeLeaseSupportSafelyAsync(orphaned);
            }
        }
        catch
        {
            // Optional refresh only; a transport fault must not escape the render lifecycle. The next
            // render retries. The budget is charged here, not before the attempt.
            if (IsReadRefreshScopeCurrent(tenantId, routeVersion, callerVersion))
            {
                _readRefreshAttempts++;
            }
            LogNotificationSetupFailure();
            if (lease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease);
            }
        }
        finally
        {
            if (!adopted) acceptsNotifications = false;
            lock (_cancellationLock)
            {
                if (ReferenceEquals(_readRefreshSetupCancellation, source))
                {
                    _readRefreshSetupCancellation = null;
                }
            }
            source.Dispose();
            Volatile.Write(ref _readRefreshSubscriptionInFlight, 0);
            if (!_disposed
                && (routeVersion != Volatile.Read(ref _readRefreshRouteVersion)
                    || callerVersion != Volatile.Read(ref _auditCallerVersion)))
            {
                // OnAfterRender has no completion render. Release the obsolete owner's gate before
                // re-evaluating the latest authorized scope; current failures retain their render budget.
                await EnsureReadRefreshLeaseOnRendererAsync(TenantId);
            }
        }
    }

    private async Task RefreshTenantDetailAsync()
    {
        _auditProofCapabilityAvailable = false;
        // Detail-flow refreshes are explicit same-route recovery points. Reopen the optional notification
        // setup budget; successful subscriptions are never charged against it.
        _readRefreshAttempts = 0;
        string tenantId = TenantId;

        // BeginLoad cancels the shared token and clears member refresh intent. Reissue any outstanding
        // member read through the combined refresh so a detail-only refresh cannot silently discard it.
        // Navigation has not committed its requested cursor yet; both navigation and combined refresh
        // therefore re-read the current, last-confirmed cursor while retaining its rows and paging history.
        if (_memberPageLoadInFlight || _tenantUsersSnapshot.IsRefreshing)
        {
            await RefreshTenantReadsAsync(tenantId).ConfigureAwait(false);
            return;
        }

        using PendingOperation operation = BeginLoad();
        using IDisposable highImpactRefresh = BeginHighImpactRefresh();
        long generation = operation.Generation;
        StartAuditCapabilityProbe(tenantId, generation);
        CancellationToken cancellationToken = operation.CancellationToken;
        TenantDetailSnapshot previous = _snapshot;
        await RenderIfAliveAsync().ConfigureAwait(false);
        TenantDetailSnapshot snapshot;
        try
        {
            snapshot = await QueryGateway
                .GetTenantAsync(
                    new TenantDetailRequest(tenantId, previous.ETag),
                    previous,
                    cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        // Marshal back before the generation check. Testing and assigning on a thread-pool continuation let a
        // newer read that completed in between lose to this older one, which is why every sibling load path in
        // this file re-checks inside InvokeAsync.
        await InvokeAsync(() =>
        {
            if (CanApply(generation, tenantId))
            {
                _snapshot = ForCurrentCaller(snapshot);
            }
        }).ConfigureAwait(false);
    }

    private Task RefreshCallerBoundReadsAsync()
    {
        if (Volatile.Read(ref _pendingAuditCallerVersion) != 0)
        {
            return Task.CompletedTask;
        }

        if (!IsCurrentCallerScope(_callerScope))
        {
            StartAuditCallerResolution();
            return Task.CompletedTask;
        }

        return RefreshTenantReadsAsync(TenantId);
    }

    private Task RefreshTenantReadsAsync()
    {
        EnsureCurrentAuditCaller();
        // Member-flow refreshes are the equivalent recovery path for the combined detail/member read.
        // Notification callbacks call the tenant-id overload directly and therefore do not reset a failing
        // backend's budget on every nudge.
        _readRefreshAttempts = 0;
        return RefreshTenantReadsAsync(TenantId);
    }

    private void EnsureCurrentAuditCaller()
    {
        if (_authenticationStateProvider is not null
            && Volatile.Read(ref _pendingAuditCallerVersion) == 0
            && Volatile.Read(ref _resolvedAuditCallerVersion) != Volatile.Read(ref _auditCallerVersion))
        {
            StartAuditCallerResolution();
        }
    }

    private void StartAuditCallerResolution()
    {
        try
        {
            OnAuthenticationStateChanged(_authenticationStateProvider!.GetAuthenticationStateAsync());
        }
        catch
        {
            Interlocked.Increment(ref _auditCallerVersion);
            Interlocked.Increment(ref _loadGeneration);
            _callerScope = null;
            InvalidateCallerState();
            _snapshot = TenantDetailSnapshot.Unavailable("Authenticated caller could not be verified.");
            Interlocked.Exchange(ref _pendingAuditCallerVersion, 0);
            _auditProofCapabilityAvailable = false;
            _auditReadDenied = false;
            _auditCapabilityResolved = true;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshTenantReadsAsync(string tenantId)
    {
        if (!IsCurrentCallerScope(_callerScope)
            || !string.Equals(TenantId, tenantId, StringComparison.Ordinal)
            || !TenantAuditNavigationSafety.IsSafeTenantId(tenantId))
        {
            return;
        }

        using PendingOperation operation = BeginLoad();
        using IDisposable highImpactRefresh = BeginHighImpactRefresh();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        TenantDetailSnapshot retainedDetail = _snapshot;
        TenantUsersSnapshot retainedMembers = _tenantUsersSnapshot;
        GlobalAdministratorsSnapshot? retainedGlobalAdministrators = _globalAdministratorsSnapshot;
        _tenantUsersSnapshot = TenantUsersSnapshot.Refreshing(retainedMembers);
        _globalAdministratorsSnapshot = ToFailClosedGlobalAdministrators(retainedGlobalAdministrators);
        _auditProofCapabilityAvailable = false;
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        Task<TenantDetailSnapshot> detailTask = QueryGateway
            .GetTenantAsync(
                new TenantDetailRequest(tenantId, retainedDetail.ETag),
                retainedDetail,
                cancellationToken);
        Task<TenantUsersSnapshot> membersTask = QueryGateway
            .GetTenantUsersAsync(
                new TenantUsersRequest(tenantId, _memberCursor, ETag: retainedMembers.ETag),
                retainedMembers,
                cancellationToken);
        StartGlobalAdministratorsLoad(tenantId, generation, retainedGlobalAdministrators);
        EnsureCurrentAuditCaller();
        StartAuditCapabilityProbe(tenantId, generation);
        // Observe detail, members, and global-administrator reads independently. Task.WhenAll rethrew an
        // operational fault before either result could be applied, leaving the retained member page permanently
        // marked Refreshing. A failed refresh remains support-safe and fail-closed while still allowing a
        // successful sibling read to land.
        TenantDetailSnapshot detail;
        TenantUsersSnapshot members;
        bool cancelled = false;
        try
        {
            detail = await detailTask.ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            cancelled = true;
            detail = retainedDetail;
        }
        catch
        {
            detail = TenantDetailSnapshot.Degraded(
                retainedDetail.Detail,
                "Tenant detail query gateway returned a safe degraded state.",
                retainedDetail.ETag,
                ProjectionLifecycleState.Unknown,
                retainedDetail.ProjectionVersion).WithCallerScope(retainedDetail.CallerScope!);
        }

        try
        {
            members = await membersTask.ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            cancelled = true;
            members = retainedMembers;
        }
        catch
        {
            members = TenantUsersSnapshot.Error(tenantId, retainedMembers);
        }

        if (cancelled || !CanApply(generation, tenantId))
        {
            return;
        }

        detail = ForCurrentCaller(detail);
        members = MembersForCurrentCaller(members);
        bool resetMemberPaging = false;
        if (members.Reason is TenantUsersReason.InvalidCursor)
        {
            TenantUsersSnapshot recovered;
            bool recoveryFailed = false;
            try
            {
                recovered = await QueryGateway
                    .GetTenantUsersAsync(new TenantUsersRequest(tenantId), retainedMembers, cancellationToken)
                    .ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch
            {
                // A non-cancellation fault on the recovery read must not escape after members were already
                // painted Refreshing — that left the pager disabled with no degraded/error surface.
                recoveryFailed = true;
                recovered = retainedMembers;
            }

            if (recoveryFailed)
            {
                members = TenantUsersSnapshot.Degraded(tenantId, retainedMembers, retainedMembers.Reason);
            }
            else if (IsCurrentCallerScope(recovered.CallerScope)
                        && IsUsableMemberPage(recovered, requestedCursor: null))
            {
                members = recovered with
                {
                    PagingRecovered = true,
                    Reason = TenantUsersReason.ListRefreshed,
                };
                resetMemberPaging = true;
            }
            else if (IsTerminalMemberPage(recovered))
            {
                members = recovered;
                resetMemberPaging = true;
            }
            else
            {
                members = TenantUsersSnapshot.Degraded(tenantId, retainedMembers, recovered.Reason);
            }
        }
        else if (members.PagingRecovered && IsUsableMemberPage(members, requestedCursor: null))
        {
            // The gateway already recovered this read to page one, so the retained cursor and history no
            // longer describe what is on screen. Without this the refresh kept re-sending the dead cursor.
            //
            // The usability clause keeps this branch from preempting the retention branch below. The gateway
            // now stamps PagingRecovered only on a page that actually arrived, so the two can no longer
            // disagree -- but when they did, a recovery that mapped to zero-row Error or Degraded matched
            // here first, discarded the operator's last-confirmed rows and cleared their cursor history on a
            // read that had failed, while rendering the "restarted at the first page" notice over it.
            resetMemberPaging = true;
        }
        else if (!IsUsableMemberPage(members, _memberCursor) && !IsTerminalMemberPage(members))
        {
            // Symmetric with LoadMemberPageAsync. A terminal result (unauthorized, not-found, invalid) must
            // replace the retained rows so a refresh cannot keep showing membership the caller may no longer
            // be allowed to see; an operational failure must not blank a surface that was serving confirmed
            // rows a moment ago. Previously every non-usable result was applied verbatim on this path.
            members = TenantUsersSnapshot.Degraded(tenantId, retainedMembers, members.Reason);
        }

        await InvokeAsync(async () =>
        {
            if (!CanApply(generation, tenantId))
            {
                return;
            }

            _snapshot = ForCurrentCaller(detail);
            _tenantUsersSnapshot = MembersForCurrentCaller(members);
            // The jump announcement describes the immediately preceding Previous action. Once an
            // authoritative refresh completes it is no longer new recovery evidence and must not remain in
            // the polite live region indefinitely.
            _memberPagingJumpedToFirstPage = false;
            if (resetMemberPaging)
            {
                _memberCursor = null;
                _memberCursorHistory.Clear();
                _memberPagingHistoryTruncated = false;
                _memberPagingJumpedToFirstPage = false;
            }

            // SignalR / coalesced read refresh is a nudge only: forward into in-flight membership flows so
            // they re-query authoritative evidence without treating the notification as confirmation.
            // No ConfigureAwait(false) here: this lambda already runs on the renderer's dispatcher, the nudge
            // awaits an authoritative status/evidence re-query that yields, and resuming off the dispatcher
            // would make the StateHasChanged() below throw and tear the circuit down.
            if ((_commandInFlight || IsCurrentAggregateLocked) && _memberAccessReview is not null)
            {
                await _memberAccessReview.ApplySignalRNudgeAsync();
            }

            TenantConfigurationManagement? configurationManagement = _configurationManagement;
            if (CanApply(generation, tenantId)
                && (_commandInFlight || IsCurrentAggregateLocked)
                && configurationManagement is not null)
            {
                await configurationManagement.ApplySetConfigurationSignalRNudgeAsync();
                if (!CanApply(generation, tenantId)
                    || !ReferenceEquals(_configurationManagement, configurationManagement))
                {
                    return;
                }

                await configurationManagement.ApplyRemoveConfigurationSignalRNudgeAsync();
                if (!CanApply(generation, tenantId)
                    || !ReferenceEquals(_configurationManagement, configurationManagement))
                {
                    return;
                }
            }

            TenantLifecycleActionAvailability? lifecycleActionAvailability = _lifecycleActionAvailability;
            if (CanApply(generation, tenantId)
                && (_commandInFlight || IsCurrentAggregateLocked)
                && lifecycleActionAvailability is not null)
            {
                await lifecycleActionAvailability.ApplySignalRNudgeAsync();
                if (!CanApply(generation, tenantId)
                    || !ReferenceEquals(_lifecycleActionAvailability, lifecycleActionAvailability))
                {
                    return;
                }
            }

            if (CanApply(generation, tenantId))
            {
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    private async Task LoadNextMemberPageAsync()
    {
        if (_memberPageLoadInFlight
            || !_tenantUsersSnapshot.HasMore
            || string.IsNullOrWhiteSpace(_tenantUsersSnapshot.NextCursor))
        {
            return;
        }

        await LoadMemberPageAsync(_tenantUsersSnapshot.NextCursor, moveForward: true).ConfigureAwait(false);
    }

    private async Task LoadPreviousMemberPageAsync()
    {
        if (_memberPageLoadInFlight || _memberCursorHistory.Count == 0)
        {
            return;
        }

        await LoadMemberPageAsync(_memberCursorHistory.Peek(), moveForward: false).ConfigureAwait(false);
    }

    /// <summary>Disposes an optional refresh lease without surfacing transport detail.</summary>
    private static async Task DisposeLeaseSupportSafelyAsync(IAsyncDisposable lease)
    {
        try
        {
            await lease.DisposeAsync().ConfigureAwait(false);
        }
        catch
        {
            // Lease cleanup must never disclose transport details or block fail-closed rendering.
        }
    }

    private async Task LoadMemberPageAsync(string? requestedCursor, bool moveForward)
    {
        string tenantId = TenantId;
        string? priorCursor = _memberCursor;
        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;

        // BeginLoad supersedes the load generation, which drops an in-flight audit capability probe.
        // Restart an unresolved probe under the new generation so detail audit links do not stay disabled.
        if (!_auditCapabilityResolved)
        {
            StartAuditCapabilityProbe(tenantId, generation);
        }

        _memberPageLoadInFlight = true;
        TenantUsersSnapshot retained = _tenantUsersSnapshot;
        _tenantUsersSnapshot = TenantUsersSnapshot.Refreshing(retained);
        try
        {
            TenantUsersSnapshot snapshot = await QueryGateway
                .GetTenantUsersAsync(
                    // `retained` is passed so the gateway sees the prior page, but note it does NOT reach the
                    // gateway's conditional-read retention on a paging request: HasMatchingTenantUsers gates
                    // on MatchesPageScope, which compares the retained page's cursor to the requested one and
                    // is therefore false by construction whenever the cursor moves. Gateway retention applies
                    // to same-scope refreshes; the explicit retention below is what covers paging.
                    new TenantUsersRequest(tenantId, requestedCursor),
                    retained,
                    cancellationToken)
                .ConfigureAwait(false);

            if (!CanApply(generation, tenantId))
            {
                return;
            }

            snapshot = MembersForCurrentCaller(snapshot);

            // An explicitly signalled invalid cursor restarts at page one honestly instead of stranding the
            // table on an Invalid surface with no way back.
            if (snapshot.Reason is TenantUsersReason.InvalidCursor)
            {
                TenantUsersSnapshot recovered;
                bool recoveryFailed = false;
                try
                {
                    recovered = await QueryGateway
                        .GetTenantUsersAsync(new TenantUsersRequest(tenantId), retained, cancellationToken)
                        .ConfigureAwait(false);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    return;
                }
                catch
                {
                    // A non-cancellation fault on the recovery read must not escape after members were already
                    // painted Refreshing — that left the pager disabled with no degraded/error surface.
                    recoveryFailed = true;
                    recovered = retained;
                }

                // The recovery read gets the same usability guard as the primary read. Assigning it
                // unconditionally meant a transient failure on page one emptied the table *after* the history
                // had already been cleared, leaving neither rows nor a Previous control.
                await InvokeAsync(() =>
                {
                    if (!CanApply(generation, tenantId))
                    {
                        return;
                    }

                    if (recoveryFailed)
                    {
                        _tenantUsersSnapshot = TenantUsersSnapshot.Degraded(tenantId, retained, retained.Reason);
                    }
                    else if (IsCurrentCallerScope(recovered.CallerScope)
                        && IsUsableMemberPage(recovered, requestedCursor: null))
                    {
                        _memberCursor = null;
                        _memberCursorHistory.Clear();
                        _memberPagingHistoryTruncated = false;
                        _memberPagingJumpedToFirstPage = false;
                        _tenantUsersSnapshot = recovered with
                        {
                            PagingRecovered = true,
                            Reason = TenantUsersReason.ListRefreshed,
                        };
                    }
                    else if (IsTerminalMemberPage(recovered))
                    {
                        _memberCursor = null;
                        _memberCursorHistory.Clear();
                        _memberPagingHistoryTruncated = false;
                        _memberPagingJumpedToFirstPage = false;
                        _tenantUsersSnapshot = MembersForCurrentCaller(recovered);
                    }
                    else
                    {
                        _tenantUsersSnapshot = TenantUsersSnapshot.Degraded(tenantId, retained, recovered.Reason);
                    }
                }).ConfigureAwait(false);

                return;
            }

            // Marshalled and re-checked inside InvokeAsync. These writes previously ran on the thread-pool
            // continuation after a single CanApply check, so a superseded member page could overwrite newer
            // rows and mutate _memberCursorHistory while the renderer was reading its Count for CanGoPrevious.
            await InvokeAsync(() =>
            {
                if (!CanApply(generation, tenantId))
                {
                    return;
                }

                // Any non-usable page must leave paging state untouched. Advancing the cursor and pushing
                // history on Unauthorized/NotFound/Invalid built a history out of failed reads, so Previous
                // then walked back through pages that never rendered.
                if (IsTerminalMemberPage(snapshot))
                {
                    _tenantUsersSnapshot = MembersForCurrentCaller(snapshot);
                    return;
                }

                if (!IsUsableMemberPage(snapshot, requestedCursor))
                {
                    _tenantUsersSnapshot = TenantUsersSnapshot.Degraded(
                        tenantId,
                        retained,
                        snapshot.Reason);
                    return;
                }

                _tenantUsersSnapshot = MembersForCurrentCaller(snapshot);

                // A gateway-side page-one recovery answers page one, not the cursor that was requested, so
                // the requested cursor must never be committed. Doing so stored an expired cursor as the
                // current page, pushed a history entry that made Previous available on a page-one view, and
                // re-sent the dead cursor on every later refresh. The gateway does not surface an
                // InvalidCursor reason in this case -- it already recovered -- so PagingRecovered is the
                // only signal, and it is also what renders the recovery notice.
                if (snapshot.PagingRecovered)
                {
                    _memberCursor = null;
                    _memberCursorHistory.Clear();
                    _memberPagingHistoryTruncated = false;
                    _memberPagingJumpedToFirstPage = false;
                    return;
                }

                _memberCursor = requestedCursor;
                if (moveForward)
                {
                    _memberCursorHistory.Push(priorCursor);

                    // Bound the history so a long paging session cannot grow it without limit. Trim's return
                    // value is the signal that the first-page sentinel was re-appended; discarding it left the
                    // member pager unable to announce the jump its two siblings announce.
                    _memberPagingHistoryTruncated |= CursorHistory.Trim(_memberCursorHistory, MaximumMemberCursorHistory);
                    _memberPagingJumpedToFirstPage = false;
                }
                else if (_memberCursorHistory.Count > 0)
                {
                    _ = _memberCursorHistory.Pop();

                    // A trimmed history re-appends the first-page sentinel under the newest entries, so one
                    // Previous click walks the operator from the middle of the sequence straight to page one.
                    _memberPagingJumpedToFirstPage = _memberPagingHistoryTruncated
                        && _memberCursor is null
                        && _memberCursorHistory.Count == 0;
                    if (_memberPagingJumpedToFirstPage)
                    {
                        _memberPagingHistoryTruncated = false;
                    }
                }
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer load owns the surface.
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _memberPageLoadInFlight = false;
            }
        }
    }

    private CancellationTokenSource ReplaceActiveCancellation()
    {
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = source;
        }

        return source;
    }

    private void CancelActiveCancellation()
    {
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = null;
        }
    }

    private void RetireCancellationCore(CancellationTokenSource? source)
    {
        if (source is null)
        {
            return;
        }

        source.Cancel();
    }

    private void CompleteCancellation(CancellationTokenSource source)
    {
        lock (_cancellationLock)
        {
            if (ReferenceEquals(_loadCancellation, source))
            {
                _loadCancellation = null;
            }
        }

        source.Dispose();
    }

