        AggregateLocked,
    }

    private enum MemberCommandLeaseOwner
    {
        Add,
        ChangeRole,
        RemoveMember,
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await ReleaseChildCommandActivityAsync().ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // The release reaches the parent's InvokeAsync(StateHasChanged). On a torn-down renderer that
            // throws, and DisposeAsync must not propagate it -- the lease dies with the circuit anyway.
            // The page guards its own dispatches the same way.
        }
    }
