    private enum MemberAction
    {
        AddMember,
        ChangeRole,
        RemoveMember,
    }

    private enum UnavailableReason
    {
        MissingPermission,
        AuthorityIndeterminate,
        StaleData,
        MissingLifecycleSupport,
