    private string ReasonCatalogLabel(UnavailableReason reason)
        => reason is UnavailableReason.AggregateLocked
            ? Localizer["Tenants.Members.UnavailableReason.AggregateLocked.Catalog"]
            : Localizer[$"Tenants.Members.UnavailableReason.{reason}"];

