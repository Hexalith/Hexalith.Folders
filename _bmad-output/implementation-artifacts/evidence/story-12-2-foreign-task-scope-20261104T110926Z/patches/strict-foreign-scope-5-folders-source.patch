index 00000000..e14d6c57
--- /dev/null
+++ b/tests/tools/Task36FoldObserver/LifecycleActivityObservation.cs
@@ -0,0 +1,97 @@
+using System.Diagnostics;
+
+namespace Task36FoldObserver;
+
+/// <summary>Observes fixed late hosting notifications without enabling activity creation or reading event values.</summary>
+internal sealed class LifecycleActivityObservation : IObserver<DiagnosticListener>, IObserver<KeyValuePair<string, object?>>, IDisposable
+{
+    private const string Start = "Microsoft.AspNetCore.Hosting.HttpRequestIn.Start";
+    private const string Stop = "Microsoft.AspNetCore.Hosting.HttpRequestIn.Stop";
+    private readonly object _gate = new();
+    private readonly List<IDisposable> _subscriptions = [];
+    private readonly Action<bool> _observe;
+    private readonly IDisposable _listeners;
+    private int _disposed;
+    private long _subscriptionFailures;
+
+    /// <summary>Subscribes only to an existing hosting listener; every callback remains advisory.</summary>
+    internal LifecycleActivityObservation(Action<bool> observe)
+    {
+        _observe = observe;
+        _listeners = DiagnosticListener.AllListeners.Subscribe(this);
+    }
+
+    /// <summary>Refuses the unsuffixed creation predicate and every notification except the fixed late pair.</summary>
+    internal static bool IsEnabled(string name) => name is Start or Stop;
+
+    /// <inheritdoc/>
+    public void OnNext(DiagnosticListener listener)
+    {
+        if (Volatile.Read(ref _disposed) != 0 || listener is null || listener.Name != "Microsoft.AspNetCore") return;
+        if (!Monitor.TryEnter(_gate)) { Interlocked.Increment(ref _subscriptionFailures); return; }
+        try
+        {
+            if (_disposed == 0 && _subscriptions.Count < 8)
+                _subscriptions.Add(listener.Subscribe(this, IsEnabled));
+            else if (_disposed == 0) Interlocked.Increment(ref _subscriptionFailures);
+        }
+        catch { Interlocked.Increment(ref _subscriptionFailures); }
+        finally
+        {
+            if (Volatile.Read(ref _disposed) != 0) DisposeSubscriptions();
+            Monitor.Exit(_gate);
+        }
+    }
+
+    /// <inheritdoc/>
+    public void OnNext(KeyValuePair<string, object?> notification)
+    {
+        // Never read Value: hosting notifications carry request/context objects.
+        if (Volatile.Read(ref _disposed) != 0 || !IsEnabled(notification.Key)) return;
+        try { _observe(notification.Key == Start); }
+        catch { /* Correlation must not affect the existing request or activity. */ }
+    }
+
+    /// <inheritdoc/>
+    public void OnCompleted() { }
+
+    /// <inheritdoc/>
+    public void OnError(Exception error) { }
+
+    /// <summary>Reports incomplete subscription explicitly without resolving application objects.</summary>
+    internal object Snapshot()
+    {
+        if (!Monitor.TryEnter(_gate)) return new { status = "unavailable", reason = "observation_busy" };
+        try
+        {
+            long failures = Interlocked.Read(ref _subscriptionFailures);
+            return new
+            {
+                status = failures == 0 && _subscriptions.Count > 0 ? "available" : "unavailable",
+                reason = failures > 0 ? "subscription_incomplete" : _subscriptions.Count == 0 ? "listener_not_observed" : "fixed_late_notifications",
+                subscribedListeners = _subscriptions.Count, subscriptionFailures = failures, listenerCapacity = 8,
+            };
+        }
+        finally { Monitor.Exit(_gate); }
+    }
+
+    /// <summary>Unsubscribes without waiting on hosting, requests or the private file sink.</summary>
+    public void Dispose()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
+        try { _listeners.Dispose(); } catch { /* Advisory cleanup. */ }
+        if (!Monitor.TryEnter(_gate)) return;
+        try
+        {
+            DisposeSubscriptions();
+        }
+        finally { Monitor.Exit(_gate); }
+    }
+
+    private void DisposeSubscriptions()
+    {
+        foreach (IDisposable subscription in _subscriptions)
+            try { subscription.Dispose(); } catch { /* Advisory cleanup. */ }
+        _subscriptions.Clear();
+    }
+}
diff --git a/tests/tools/Task36FoldObserver/LifecycleRequestCorrelation.cs b/tests/tools/Task36FoldObserver/LifecycleRequestCorrelation.cs
new file mode 100644
index 00000000..7ff5a667
--- /dev/null
+++ b/tests/tools/Task36FoldObserver/LifecycleRequestCorrelation.cs
@@ -0,0 +1,124 @@
+using System.Diagnostics;
+
+namespace Task36FoldObserver;
+
+/// <summary>Tracks only opaque existing request activities with a bounded, non-waiting advisory inventory.</summary>
+internal sealed class LifecycleRequestCorrelation
+{
+    /// <summary>Bounds retained request identities independently of the existing sink capacity.</summary>
+    internal const int MaximumTrackedRequests = 64;
+
+    private readonly object _gate = new();
+    private readonly Dictionary<long, (string? Trace, string? Span, Guid Framework, Guid Related, long Started)> _active = [];
+    private long _sequence;
+    private long _unavailableStarts;
+    private long _unmatchedEnds;
+    private int _gap;
+
+    /// <summary>Copies existing trace/span and framework IDs only; never retains or inspects application objects.</summary>
+    internal object Observe(bool started, long inFlight, Guid frameworkActivityId, Guid relatedActivityId)
+    {
+        if (!Monitor.TryEnter(_gate))
+        {
+            Volatile.Write(ref _gap, 1);
+            return new { status = "unavailable", reason = "observation_busy" };
+        }
+        try
+        {
+            Activity? current = Activity.Current;
+            string? trace = current is not null && current.TraceId != default ? current.TraceId.ToHexString() : null;
+            string? span = current is not null && current.SpanId != default ? current.SpanId.ToHexString() : null;
+            if (Volatile.Read(ref _gap) != 0)
+            {
+                string reason = GapReason();
+                _active.Clear();
+                if (inFlight == 0) Volatile.Write(ref _gap, 0);
+                return Metadata("unavailable", reason, null, trace, span, frameworkActivityId, relatedActivityId);
+            }
+            if ((trace is null || span is null) && frameworkActivityId == Guid.Empty)
+            {
+                if (started) _unavailableStarts++; else _unmatchedEnds++;
+                return Metadata("unavailable", "identity_unavailable", null, trace, span, frameworkActivityId, relatedActivityId);
+            }
+            if (started)
+            {
+                if (_active.Count == MaximumTrackedRequests)
+                {
+                    _active.Clear();
+                    Volatile.Write(ref _gap, 2);
+                    return Metadata("unavailable", "tracking_capacity", null, trace, span, frameworkActivityId, relatedActivityId);
+                }
+                long ordinal = ++_sequence;
+                _active.Add(ordinal, (trace, span, frameworkActivityId, relatedActivityId, Stopwatch.GetTimestamp()));
+                if (Volatile.Read(ref _gap) != 0)
+                    return Metadata("unavailable", GapReason(), null, trace, span, frameworkActivityId, relatedActivityId);
+                return Metadata("tracked", "request_start", ordinal, trace, span, frameworkActivityId, relatedActivityId);
+            }
+
+            // A trace alone, related ID alone, or conflicting available trace/span pair never establishes a join.
+            long[] matches = _active.Where(entry => trace is not null && span is not null
+                    && entry.Value.Trace is not null && entry.Value.Span is not null
+                ? entry.Value.Trace == trace && entry.Value.Span == span
+                : frameworkActivityId != Guid.Empty && entry.Value.Framework == frameworkActivityId)
+                .Select(entry => entry.Key).ToArray();
+            if (matches.Length != 1)
+            {
+                _unmatchedEnds++;
+                if (matches.Length > 1)
+                {
+                    _active.Clear();
+                    Volatile.Write(ref _gap, 3);
+                    if (inFlight == 0) Volatile.Write(ref _gap, 0);
+                }
+                return Metadata("unmatched", matches.Length == 0 ? "start_not_observed" : "ambiguous_identity",
+                    null, trace, span, frameworkActivityId, relatedActivityId);
+            }
+            long matched = matches[0];
+            bool traceMatched = trace is not null && span is not null
+                && _active[matched].Trace is not null && _active[matched].Span is not null;
+            if (Volatile.Read(ref _gap) != 0)
+                return Metadata("unavailable", GapReason(), null, trace, span, frameworkActivityId, relatedActivityId);
+            _active.Remove(matched);
+            return Metadata("matched", traceMatched ? "trace_span" : "framework_activity",
+                matched, trace, span, frameworkActivityId, relatedActivityId);
+        }
+        finally { Monitor.Exit(_gate); }
+    }
+
+    /// <summary>Snapshots bounded primitive identities, explicitly reporting unavailable correlation.</summary>
+    internal object Snapshot()
+    {
+        if (!Monitor.TryEnter(_gate)) return new { status = "unavailable", reason = "observation_busy" };
+        try
+        {
+            int gap = Volatile.Read(ref _gap);
+            object[] active = gap == 0 ? _active.Select(entry => (object)new
+            {
+                requestOrdinal = entry.Key, traceId = entry.Value.Trace, spanId = entry.Value.Span,
+                frameworkActivityId = Id(entry.Value.Framework), relatedActivityId = Id(entry.Value.Related),
+                elapsedMilliseconds = Stopwatch.GetElapsedTime(entry.Value.Started).TotalMilliseconds,
+            }).ToArray() : [];
+            return new
+            {
+                status = gap == 0 ? "available" : "unavailable", reason = gap == 0 ? "observed_ids_only" : GapReason(),
+                capacity = MaximumTrackedRequests, unavailableStarts = _unavailableStarts, unmatchedEnds = _unmatchedEnds,
+                activeRequests = active,
+            };
+        }
+        finally { Monitor.Exit(_gate); }
+    }
+
+    private string GapReason() => Volatile.Read(ref _gap) switch
+    {
+        2 => "tracking_capacity", 3 => "ambiguous_identity", _ => "observation_busy",
+    };
+
+    private static object Metadata(string status, string reason, long? ordinal, string? trace, string? span,
+        Guid framework, Guid related) => new
+    {
+        status, reason, requestOrdinal = ordinal, traceId = trace, spanId = span,
+        frameworkActivityId = Id(framework), relatedActivityId = Id(related),
+    };
+
+    private static string? Id(Guid value) => value == Guid.Empty ? null : value.ToString("D");
+}
