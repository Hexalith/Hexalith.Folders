+        Dictionary<string, object> persisted = [];
+        if (exists)
+        {
+            persisted[Identity.MetadataKey] = new AggregateMetadata(head, DateTimeOffset.UnixEpoch, null)
+            {
+                SourceProof = scenario.StartsWith("legacy", StringComparison.Ordinal) ? null
