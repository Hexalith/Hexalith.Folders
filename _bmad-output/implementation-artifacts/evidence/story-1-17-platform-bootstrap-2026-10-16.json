  "change": {
    "owner": "Hexalith.Platform",
    "problem": "Existing file AppHost fails before composition on missing nested Builds tooling and a stale EventStore file pin.",
    "implementation": [
      "Resolve a single Builds root for catalog, tooling project and test seed, retaining sibling-first/default nested and runner-binary override paths. Normalize explicit relative roots against Platform.",
      "Align EventStore.Aspire file directive with existing central 3.122.0; preserve the existing SDK pin repair. Pin verifier follows the same default root precedence, supports --root ., and retains explicit --catalog.",
      "Correct only the null/await analyzer errors exposed by audited Debug host/test builds. Keep analyzer severity and all test expectations."
    ],
    "boundary": "Build-time bootstrap only. No new topology, domain behavior, authentication, release lane or deployer."
  },
