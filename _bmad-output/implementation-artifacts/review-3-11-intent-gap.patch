+        bool observationOnly)
+    {
+        if (exception is SecondaryRateLimitExceededException secondaryRateLimit)
+        {
+            return (GitHubApiFailureCondition.SecondaryRateLimit, RetryAfter(secondaryRateLimit.HttpResponse));
