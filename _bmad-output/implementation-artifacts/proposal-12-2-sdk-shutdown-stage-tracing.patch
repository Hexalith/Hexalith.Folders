diff --git a/tests/Hexalith.EventStore.Server.Tests/Telemetry/ShutdownStageScopeTests.cs b/tests/Hexalith.EventStore.Server.Tests/Telemetry/ShutdownStageScopeTests.cs
new file mode 100644
