<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <PackageReference Include="Hexalith.Commons.UniqueIds" ExcludeAssets="all" />
    <ProjectReference Include="$(HexalithCommonsRoot)/src/libraries/Hexalith.Commons.UniqueIds/Hexalith.Commons.UniqueIds.csproj" />
  </ItemGroup>
  <!-- CI leaves update=none roots uninitialized. Check out only this root before compiling its test double. -->
  <Target Name="PreparePinnedEventStoreTestDouble"
          BeforeTargets="PrepareForBuild"
          Condition="'$(CI)' == 'true'">
    <Exec Command="git -c submodule.recurse=false submodule update --init --checkout references/Hexalith.EventStore"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>
  <ItemGroup>
    <Compile Include="../shared/NativeContent/*.cs" Link="NativeContent/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Hexalith.Folders.Client/Hexalith.Folders.Client.csproj" />
    <Compile Include="../../references/Hexalith.EventStore/tests/Hexalith.EventStore.Client.Tests/Projections/RecordingDaprClient.cs" Link="Content/RecordingDaprClient.cs" />
    <!-- Reuse the pinned platform protocol harness; no package version changes. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore.Testing/Hexalith.EventStore.Testing.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Testing" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <Compile Include="../shared/OperationalStatus/*.cs" Link="OperationalStatus/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Folders.Server\Hexalith.Folders.Server.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Folders.Testing\Hexalith.Folders.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\event-evolution\*" Link="event-evolution\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Story 5.5: shared, test-only parity oracle (transport columns) + golden-lifecycle step list linked
       (not copied). Same file set Story 5.4 introduced for CLI/MCP; consumed here for REST transport-parity
       conformance against the in-process server host. -->
  <ItemGroup>
    <Compile Include="..\shared\Parity\ParityOracle.cs">
      <Link>Parity\ParityOracle.cs</Link>
    </Compile>
    <Compile Include="..\shared\Parity\ParityScenarios.cs">
      <Link>Parity\ParityScenarios.cs</Link>
    </Compile>
    <Compile Include="..\shared\Parity\GoldenLifecycle.cs">
      <Link>Parity\GoldenLifecycle.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
