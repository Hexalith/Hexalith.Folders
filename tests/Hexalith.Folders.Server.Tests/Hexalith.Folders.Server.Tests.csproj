<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(HexalithEventStoreFromSource)' == 'true'">$(DefineConstants);FOLDERS_OWNER_METADATA_SOURCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="FoldersSdkIdentityAuthority" Value="source" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <AssemblyMetadata Include="FoldersSdkIdentityAuthority" Value="package" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <AssemblyMetadata Include="FoldersSdkConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="FoldersSdkSourceRoot" Value="$(HexalithEventStoreRoot)" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
  </ItemGroup>
  <Target Name="BindSdkRestoreIdentity" BeforeTargets="GetAssemblyAttributes">
    <GetFileHash Files="$(ProjectAssetsFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_FoldersSdkAssetsIdentity" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="FoldersSdkAssetsSha256" Value="%(_FoldersSdkAssetsIdentity.FileHash)" />
    </ItemGroup>
  </Target>
  <Target Name="RecordSdkRestoreIdentity" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectAssetsFile)" DestinationFiles="$(TargetDir)sdk-binding.project.assets.json" />
  </Target>
  <!-- Restore provenance uses the same NuGet implementation as the pinned build SDK. -->
  <ItemGroup>
    <Reference Include="NuGet.Packaging" HintPath="$(MSBuildBinPath)/NuGet.Packaging.dll" Private="true" />
    <Reference Include="NuGet.Common" HintPath="$(MSBuildBinPath)/NuGet.Common.dll" Private="true" />
    <Reference Include="NuGet.Versioning" HintPath="$(MSBuildBinPath)/NuGet.Versioning.dll" Private="true" />
    <Reference Include="NuGet.Frameworks" HintPath="$(MSBuildBinPath)/NuGet.Frameworks.dll" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <PackageReference Include="Hexalith.Commons.UniqueIds" ExcludeAssets="all" Condition="'$(HexalithCommonsFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithCommonsRoot)/src/libraries/Hexalith.Commons.UniqueIds/Hexalith.Commons.UniqueIds.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Hexalith.Folders.EventStore.Tests/Fixtures/legacy-canonical-intents.json" Link="CatalogPolicies/legacy-canonical-intents.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../shared/NativeContent/*.cs" Link="NativeContent/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Hexalith.Folders.Client/Hexalith.Folders.Client.csproj" />
    <Compile Include="../shared/EventStore/RecordingDaprClient.cs" Link="Content/RecordingDaprClient.cs" />
    <!-- Reuse the pinned platform protocol harness; no package version changes. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore.Testing/Hexalith.EventStore.Testing.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Testing" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <Compile Include="../shared/OperationalStatus/*.cs" Link="OperationalStatus/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../tools/Task36FoldObserver/Task36FoldObserver.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Hexalith.Folders.Server\Hexalith.Folders.Server.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Folders.Testing\Hexalith.Folders.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\event-evolution\*" Link="event-evolution\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Story 5.5: shared, test-only parity oracle (transport columns) + golden-lifecycle step list linked
       (not copied). Same file set Story 5.4 introduced for CLI/MCP; consumed here for REST transport-parity
       conformance against the in-process server host. -->
  <ItemGroup>
    <Compile Include="..\shared\Parity\ParityOracle.cs">
      <Link>Parity\ParityOracle.cs</Link>
    </Compile>
    <Compile Include="..\shared\Parity\ParityScenarios.cs">
      <Link>Parity\ParityScenarios.cs</Link>
    </Compile>
    <Compile Include="..\shared\Parity\GoldenLifecycle.cs">
      <Link>Parity\GoldenLifecycle.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
