* text=auto

# C# source is kept LF to match the repository's Linux CI checkout and the
# dotnet format baseline gate.
*.cs text eol=lf

# Story 1.13 (C13 parity oracle) requires byte-stable LF output for fixtures the
# generator emits. Force LF on checkout so the committed-vs-generated equality
# assertion in ParityOracleGeneratorTests.GeneratorOutputIsByteStableAndMetadataOnly
# is independent of git's autocrlf setting.
tests/fixtures/parity-contract.yaml text eol=lf
tests/fixtures/parity-contract.schema.json text eol=lf
tests/fixtures/previous-spine.yaml text eol=lf

# Contract sources read by the generator must also be LF so the embedded
# contract_spine_sha256 / parity_schema_sha256 provenance is reproducible.
src/Hexalith.Folders.Contracts/openapi/*.yaml text eol=lf
src/Hexalith.Folders.Contracts/openapi/**/*.yaml text eol=lf

# C7 approvals bind the exact SHA-256 bytes of the canonical decision artifact.
docs/exit-criteria/c7-lock-authorization-timing.md text eol=lf

# OQ2 approvals bind the exact SHA-256 bytes of the canonical file-policy artifact.
docs/contract/file-context-contract-groups.md text eol=lf
docs/contract/oq2-file-policy-evidence.yaml text eol=lf

# OQ3 approvals bind the exact SHA-256 bytes of the canonical authorization matrix.
docs/contract/authorization-matrix.md text eol=lf
docs/contract/oq3-authorization-evidence.yaml text eol=lf

# OQ4 approvals bind the exact SHA-256 bytes of the canonical provider compatibility catalog.
docs/contract/provider-compatibility-catalog.md text eol=lf
docs/contract/oq4-provider-compatibility-evidence.yaml text eol=lf
docs/governance/approval-policy.md text eol=lf
tests/contracts/github/pinned-profile.json text eol=lf

# Unified-diff context lines intentionally contain one leading space. Disable
# whitespace diagnostics for the preserved review and renegotiation artifacts.
_bmad-output/implementation-artifacts/review-3-11-intent-gap.patch -whitespace
_bmad-output/implementation-artifacts/renegotiation-1-17-2026-09-23/spec-1-17-publish-renegotiation.diff -whitespace

# Story 1.17 qualification evidence binds the exact captured packet/proposal bytes.
eng/story117-platform-qualification/** -text whitespace=cr-at-eol
_bmad-output/implementation-artifacts/story-1-17-platform-rollout-proposal-2026-10-16.md -text whitespace=cr-at-eol
_bmad-output/implementation-artifacts/evidence/story-1-17-platform-qualification-2026-10-16.json -text whitespace=cr-at-eol

# Preserve exact qualification evidence bytes across checkouts.
_bmad-output/implementation-artifacts/evidence/story-1-17-platform-admission-2026-10-16* -text

# Bind the exact bytes of the Builds packaged-seed qualification handoff.
_bmad-output/implementation-artifacts/evidence/story-1-17-builds-package-qualification-2026-10-16* -text

# Byte-bound committed Builds qualification receipt and portable artifacts.
_bmad-output/implementation-artifacts/evidence/story-1-17-builds-clean-source-qualification-2026-10-16* -text whitespace=cr-at-eol
eng/story117-builds-clean-source/** text eol=lf

# Preserve signed publication observations and their retained archive bytes.
_bmad-output/implementation-artifacts/evidence/story-1-17-builds-publication-2026-10-16* -text whitespace=cr-at-eol
eng/story117-builds-publication/** text eol=lf

# Keep the separate current qualification proposal and its byte-bound receipt stable.
eng/story117-platform-qualification-current/** text eol=lf
_bmad-output/implementation-artifacts/evidence/story-1-17-current-qualification-2026-10-17.json text eol=lf
