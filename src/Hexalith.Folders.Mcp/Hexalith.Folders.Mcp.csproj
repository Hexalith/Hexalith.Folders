<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <RootNamespace>Hexalith.Folders.Mcp</RootNamespace>
    <AssemblyName>Hexalith.Folders.Mcp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Folders.Mcp.Tests" />
    <InternalsVisibleTo Include="Hexalith.Folders.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Folders.Client\Hexalith.Folders.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\AdapterCore\*.cs" Link="AdapterCore\%(Filename)%(Extension)" />
    <Using Include="Hexalith.Folders.AdapterCore.MutationSourcing" Alias="MutationSourcing" />
    <Using Include="Hexalith.Folders.AdapterCore.QuerySourcing" Alias="QuerySourcing" />
  </ItemGroup>
</Project>
