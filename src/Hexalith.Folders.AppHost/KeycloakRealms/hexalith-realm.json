  "users": [
    {
      "id": "admin-user",
      "username": "admin-user",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "email": "admin@hexalith.io",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "admin-pass",
          "temporary": false
        }
      ],
      "attributes": {
        "tenants": ["tenant-a", "tenant-b", "system"],
        "permissions": ["command:submit", "command:replay", "command:query"],
        "global_admin": ["true"]
